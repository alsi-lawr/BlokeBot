<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\BlokeBot.Plugins.Contracts.Testing\BlokeBot.Plugins.Contracts.Testing.csproj" />
    <ProjectReference Include="..\..\src\BlokeBot.Plugins.Runtime\BlokeBot.Plugins.Runtime.csproj" />
    <ProjectReference Include="..\..\src\BlokeBot.Persistence\BlokeBot.Persistence.csproj" />
    <ProjectReference
      Include="..\..\src\BlokeBot.PluginWorker\BlokeBot.PluginWorker.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="..\..\docs\plugin-authoring\**\*"
      Link="AuthoringArtifacts\docs\plugin-authoring\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\sdk\lua\**\*"
      Link="AuthoringArtifacts\sdk\lua\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\examples\plugins\**\*"
      Link="PublishedPluginExamples\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <Target Name="PublishPluginWorkerForTests" AfterTargets="Build">
    <PropertyGroup>
      <_PluginWorkerTestPublishDir>$([System.IO.Path]::GetFullPath('$(OutDir)plugin-worker'))</_PluginWorkerTestPublishDir>
    </PropertyGroup>
    <MSBuild
      Projects="..\..\src\BlokeBot.PluginWorker\BlokeBot.PluginWorker.csproj"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(NETCoreSdkRuntimeIdentifier);SelfContained=false;PublishDir=$(_PluginWorkerTestPublishDir);NoRestore=true"
    />
  </Target>
</Project>

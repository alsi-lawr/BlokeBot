@using BlokeBot.Core.Components.Layout

<div data-sticky-save-scope>
    <StickySaveRegion Scope="StickySaveScope.Editor" Active="@(ActiveEditor == 1)">
        <button type="button" data-editor="1" disabled="@Disabled">Action</button>
    </StickySaveRegion>
    <StickySaveRegion Scope="StickySaveScope.Editor" Active="@(ActiveEditor == 2)">
        <button type="button" data-editor="2" disabled="@Disabled">Action</button>
    </StickySaveRegion>
</div>

@code {
    [Parameter]
    public int ActiveEditor { get; set; }

    [Parameter]
    public bool Disabled { get; set; }
}

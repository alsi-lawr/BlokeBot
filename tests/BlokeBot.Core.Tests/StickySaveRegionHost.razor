@using BlokeBot.Core.Components.Layout

<div data-sticky-save-scope>
    <StickySaveRegion Scope="StickySaveScope.Editor" Active="@FirstActive">
        <button type="button" data-editor="1" disabled="@Disabled">Action</button>
    </StickySaveRegion>
    <StickySaveRegion Scope="StickySaveScope.Editor" Active="@SecondActive">
        <button type="button" data-editor="2" disabled="@Disabled">Action</button>
    </StickySaveRegion>
</div>

@code {
    [Parameter]
    public bool FirstActive { get; set; } = true;

    [Parameter]
    public bool SecondActive { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }
}

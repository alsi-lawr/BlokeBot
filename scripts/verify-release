#!/usr/bin/env python3
"""Run BlokeBot's repeatable release-review checks as one gate."""

from __future__ import annotations

import argparse
import hashlib
import pathlib
import re
import sqlite3
import subprocess
import sys
import tempfile
from collections.abc import Sequence


ROOT = pathlib.Path(__file__).resolve().parents[1]
SOLUTION = "BlokeBot.slnx"
PERSISTENCE_PROJECT = "src/BlokeBot.Persistence/BlokeBot.Persistence.csproj"
DEFAULT_BASELINE_SCHEMA = ROOT / "scripts/fixtures/hetzner-f2e32ed-schema.sql"
DEFAULT_BASELINE_MIGRATION = "20260722162847_20260722_InitialHetznerBaseline"
DEFAULT_BASELINE_SHA256 = "48045a99dea44349d793aea47256f276e4bf0bb68548d5f3ad95603ecdbff7a7"
DEFAULT_BASELINE_SEMANTIC_SHA256 = (
    "c1d341153310cd5c13838e8535e79d2035c4918267e9ed0d104e7e568b3bf03f"
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Run the clean-tree, format, build, MTP, EF migration, and deployed-baseline "
            "schema-equivalence checks used for BlokeBot release review."
        )
    )
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="Allow tracked or untracked changes (intended only while developing the gate).",
    )
    parser.add_argument(
        "--no-restore",
        action="store_true",
        help="Skip dotnet solution and local-tool restore.",
    )
    parser.add_argument(
        "--base-ref",
        help="Git ref used for diff checking and optional added-test counting (default: HEAD^).",
    )
    parser.add_argument("--expected-head", help="Require HEAD to equal this commit.")
    parser.add_argument("--expected-parent", help="Require HEAD^ to equal this commit.")
    parser.add_argument(
        "--max-new-test-methods",
        type=int,
        help="Fail when the [Test] method-count increase from --base-ref exceeds this value.",
    )
    parser.add_argument(
        "--expected-migration-count",
        type=int,
        help="Require exactly this many EF migrations.",
    )
    parser.add_argument(
        "--baseline-schema",
        type=pathlib.Path,
        default=DEFAULT_BASELINE_SCHEMA,
        help="Schema-only SQL captured from the minimum supported deployment.",
    )
    parser.add_argument(
        "--baseline-migration",
        default=DEFAULT_BASELINE_MIGRATION,
        help="EF migration stamped onto a matching historyless deployed database.",
    )
    parser.add_argument(
        "--baseline-schema-sha256",
        default=DEFAULT_BASELINE_SHA256,
        help="Expected SHA-256 for --baseline-schema.",
    )
    parser.add_argument(
        "--baseline-semantic-sha256",
        default=DEFAULT_BASELINE_SEMANTIC_SHA256,
        help="Expected canonical semantic SHA-256 for the deployed baseline.",
    )
    args = parser.parse_args()
    if args.max_new_test_methods is not None and args.base_ref is None:
        parser.error("--max-new-test-methods requires --base-ref")
    if args.max_new_test_methods is not None and args.max_new_test_methods < 0:
        parser.error("--max-new-test-methods must be non-negative")
    if args.expected_migration_count is not None and args.expected_migration_count < 1:
        parser.error("--expected-migration-count must be positive")
    return args


def command_text(command: Sequence[str]) -> str:
    return " ".join(subprocess.list2cmdline([part]) for part in command)


def run(
    command: Sequence[str],
    *,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    print(f"\n$ {command_text(command)}", flush=True)
    result = subprocess.run(
        command,
        cwd=ROOT,
        check=False,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
    )
    if capture and result.stdout:
        print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
    if check and result.returncode != 0:
        raise GateFailure(f"Command failed with exit code {result.returncode}: {command_text(command)}")
    return result


def git_value(*arguments: str) -> str:
    return run(["git", *arguments], capture=True).stdout.strip()


def quiet_output(command: Sequence[str]) -> str:
    result = subprocess.run(
        command,
        cwd=ROOT,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode != 0:
        raise GateFailure(f"Command failed with exit code {result.returncode}: {command_text(command)}")
    return result.stdout


def require_equal(label: str, actual: object, expected: object) -> None:
    if actual != expected:
        raise GateFailure(f"{label}: expected {expected!r}, got {actual!r}")


def test_methods(ref: str) -> set[str]:
    files = quiet_output(
        ["git", "ls-tree", "-r", "--name-only", ref, "--", "tests"]
    ).splitlines()
    pattern = re.compile(
        r"\[Test(?:\([^\]]*\))?\]\s*"
        r"(?:\[[^\]]+\]\s*)*"
        r"(?:public|internal|private)\s+"
        r"(?:static\s+)?(?:async\s+)?"
        r"(?:[\w<>,?.\[\]]+\s+)+"
        r"(?P<name>\w+)\s*\(",
        flags=re.MULTILINE,
    )
    methods: set[str] = set()
    for path in files:
        if not path.endswith(".cs"):
            continue
        source = quiet_output(["git", "show", f"{ref}:{path}"])
        methods.update(f"{path}:{match.group('name')}" for match in pattern.finditer(source))
    return methods


def check_git(args: argparse.Namespace) -> tuple[str, str, str]:
    status = git_value("status", "--porcelain=v1", "--untracked-files=all")
    if status and not args.allow_dirty:
        raise GateFailure(f"Working tree is not clean:\n{status}")

    head = git_value("rev-parse", "HEAD")
    parent = git_value("rev-parse", "HEAD^")
    base_ref = args.base_ref or "HEAD^"
    base = git_value("rev-parse", base_ref)
    if args.expected_head:
        require_equal("HEAD", head, git_value("rev-parse", args.expected_head))
    if args.expected_parent:
        require_equal("HEAD^", parent, git_value("rev-parse", args.expected_parent))
    run(["git", "diff", "--check", base, head])

    print(f"HEAD:   {head}")
    print(f"Parent: {parent}")
    print(f"Base:   {base}")
    if args.max_new_test_methods is not None:
        added_methods = sorted(test_methods(head) - test_methods(base))
        if len(added_methods) > args.max_new_test_methods:
            raise GateFailure(
                f"Added [Test] methods: {len(added_methods)}; "
                f"allowed maximum: {args.max_new_test_methods}\n"
                + "\n".join(added_methods)
            )
        print(
            f"Added [Test] methods: {len(added_methods)} "
            f"(maximum {args.max_new_test_methods})"
        )
        for method in added_methods:
            print(f"  {method}")
    return head, parent, base


def migration_ids(output: str) -> list[str]:
    ids: list[str] = []
    for line in output.splitlines():
        match = re.fullmatch(r"(\d{14}_[^\s]+)(?:\s+\(Pending\))?", line.strip())
        if match:
            ids.append(match.group(1))
    return ids


def split_definitions(sql: str) -> list[str]:
    start = sql.index("(")
    end = sql.rindex(")")
    definition = sql[start + 1 : end]
    definitions: list[str] = []
    segment_start = 0
    depth = 0
    quote: str | None = None
    index = 0
    while index < len(definition):
        character = definition[index]
        if quote:
            if character == quote:
                if index + 1 < len(definition) and definition[index + 1] == quote:
                    index += 1
                else:
                    quote = None
        elif character in "'\"`":
            quote = character
        elif character == "[":
            quote = "]"
        elif character == "(":
            depth += 1
        elif character == ")":
            depth -= 1
        elif character == "," and depth == 0:
            definitions.append(definition[segment_start:index])
            segment_start = index + 1
        index += 1
    definitions.append(definition[segment_start:])
    return definitions


def normalize_sql(sql: str) -> str:
    output: list[str] = []
    in_string = False
    index = 0
    while index < len(sql):
        character = sql[index]
        if in_string:
            output.append(character)
            if character == "'":
                if index + 1 < len(sql) and sql[index + 1] == "'":
                    output.append("'")
                    index += 1
                else:
                    in_string = False
        elif character == "'":
            in_string = True
            output.append(character)
        elif character not in '\"`[]' and not character.isspace():
            output.append(character.lower())
        index += 1
    return "".join(output)


def canonical_schema(connection: sqlite3.Connection) -> tuple[str, str, int]:
    rows = connection.execute(
        """
        SELECT type, name, sql
        FROM sqlite_schema
        WHERE name NOT LIKE 'sqlite_%'
          AND NOT (type = 'table' AND name = '__EFMigrationsHistory')
          AND sql IS NOT NULL
        ORDER BY type, name
        """
    ).fetchall()
    values: list[str] = []
    for object_type, name, sql in rows:
        if object_type == "table":
            body = ",".join(sorted(normalize_sql(part) for part in split_definitions(sql)))
        elif object_type == "index":
            body = normalize_sql(re.sub(r"IF\s+NOT\s+EXISTS", "", sql, flags=re.IGNORECASE))
        else:
            body = normalize_sql(sql)
        values.append(f"{object_type.lower()}:{name.lower()}:{body}")
    canonical = "\n".join(values)
    signature = hashlib.sha256(canonical.encode()).hexdigest()
    return signature, canonical, len(rows)


def product_version(full_script: str, baseline_migration: str) -> str:
    pattern = re.compile(
        r'INSERT\s+INTO\s+"__EFMigrationsHistory"\s*'
        r'\("MigrationId",\s*"ProductVersion"\)\s*'
        rf"VALUES\s*\('{re.escape(baseline_migration)}',\s*'([^']+)'\)",
        flags=re.IGNORECASE,
    )
    match = pattern.search(full_script)
    if match is None:
        raise GateFailure("Could not read the baseline migration ProductVersion from EF SQL")
    return match.group(1)


def execute_schema(path: pathlib.Path, sql: str) -> sqlite3.Connection:
    connection = sqlite3.connect(path)
    connection.executescript(sql.lstrip("\ufeff"))
    return connection


def verify_database(
    connection: sqlite3.Connection,
    expected_migrations: list[str],
    label: str,
) -> tuple[str, str, int]:
    require_equal(f"{label} integrity", connection.execute("PRAGMA integrity_check").fetchone()[0], "ok")
    foreign_key_failures = connection.execute("PRAGMA foreign_key_check").fetchall()
    require_equal(f"{label} foreign-key failures", foreign_key_failures, [])
    history = [
        row[0]
        for row in connection.execute(
            'SELECT "MigrationId" FROM "__EFMigrationsHistory" ORDER BY "MigrationId"'
        )
    ]
    require_equal(f"{label} migration history", history, expected_migrations)
    return canonical_schema(connection)


def verify_migrations(args: argparse.Namespace) -> tuple[list[str], str]:
    list_result = run(
        [
            "dotnet",
            "ef",
            "migrations",
            "list",
            "--project",
            PERSISTENCE_PROJECT,
            "--configuration",
            "Release",
            "--no-build",
        ],
        capture=True,
    )
    ids = migration_ids(list_result.stdout)
    if not ids:
        raise GateFailure("No EF migrations were reported")
    if args.expected_migration_count is not None:
        require_equal("EF migration count", len(ids), args.expected_migration_count)
    require_equal("First EF migration", ids[0], args.baseline_migration)

    pending = run(
        [
            "dotnet",
            "ef",
            "migrations",
            "has-pending-model-changes",
            "--project",
            PERSISTENCE_PROJECT,
            "--configuration",
            "Release",
            "--no-build",
        ],
        capture=True,
    )
    if "No changes have been made to the model since the last migration." not in pending.stdout:
        raise GateFailure("EF reported pending model changes")

    schema_path = args.baseline_schema.resolve()
    schema_bytes = schema_path.read_bytes()
    require_equal(
        "Deployed baseline schema SHA-256",
        hashlib.sha256(schema_bytes).hexdigest(),
        args.baseline_schema_sha256,
    )
    captured_sql = schema_bytes.decode("utf-8-sig").replace(
        "CREATE TABLE sqlite_sequence(name,seq);\n", ""
    )

    with tempfile.TemporaryDirectory(prefix="blokebot-release-gate-") as temporary:
        temp = pathlib.Path(temporary)
        full_script_path = temp / "full.sql"
        release_script_path = temp / "release.sql"
        run(
            [
                "dotnet",
                "ef",
                "migrations",
                "script",
                "--project",
                PERSISTENCE_PROJECT,
                "--configuration",
                "Release",
                "--no-build",
                "--output",
                str(full_script_path),
            ]
        )
        run(
            [
                "dotnet",
                "ef",
                "migrations",
                "script",
                args.baseline_migration,
                ids[-1],
                "--project",
                PERSISTENCE_PROJECT,
                "--configuration",
                "Release",
                "--no-build",
                "--output",
                str(release_script_path),
            ]
        )
        full_script = full_script_path.read_text(encoding="utf-8-sig")
        release_script = release_script_path.read_text(encoding="utf-8-sig")

        captured = execute_schema(temp / "captured.db", captured_sql)
        baseline_signature, _, baseline_count = canonical_schema(captured)
        require_equal(
            "Deployed baseline semantic SHA-256",
            baseline_signature,
            args.baseline_semantic_sha256,
        )
        version = product_version(full_script, args.baseline_migration)
        captured.execute(
            'CREATE TABLE "__EFMigrationsHistory" ('
            '"MigrationId" TEXT NOT NULL CONSTRAINT "PK___EFMigrationsHistory" PRIMARY KEY, '
            '"ProductVersion" TEXT NOT NULL)'
        )
        captured.execute(
            'INSERT INTO "__EFMigrationsHistory" ("MigrationId", "ProductVersion") VALUES (?, ?)',
            (args.baseline_migration, version),
        )
        captured.commit()
        captured.executescript(release_script)
        upgraded_signature, upgraded_schema, upgraded_count = verify_database(
            captured, ids, "captured-baseline upgrade"
        )
        captured.close()

        fresh = execute_schema(temp / "fresh.db", full_script)
        fresh_signature, fresh_schema, fresh_count = verify_database(
            fresh, ids, "fresh migration"
        )
        fresh.close()

        require_equal("Upgraded/fresh semantic schema", upgraded_schema, fresh_schema)
        require_equal("Upgraded/fresh semantic SHA-256", upgraded_signature, fresh_signature)
        print(f"Baseline objects: {baseline_count}")
        print(f"Final objects:    {upgraded_count} upgraded / {fresh_count} fresh")
        print(f"Final semantic SHA-256: {fresh_signature}")
    return ids, fresh_signature


def main() -> int:
    args = parse_args()
    try:
        head, parent, base = check_git(args)
        if not args.no_restore:
            run(["dotnet", "restore", SOLUTION])
            run(["dotnet", "tool", "restore"])
        run(["dotnet", "csharpier", "check", "."])
        run(
            [
                "dotnet",
                "build",
                SOLUTION,
                "--configuration",
                "Release",
                "--no-restore",
                "-warnaserror",
            ]
        )
        run(
            [
                "dotnet",
                "test",
                SOLUTION,
                "--configuration",
                "Release",
                "--no-build",
                "--",
                "--no-ansi",
                "--no-progress",
                "--output",
                "Normal",
            ]
        )
        ids, final_signature = verify_migrations(args)
    except (GateFailure, FileNotFoundError, sqlite3.Error, UnicodeError) as error:
        print(f"\nRELEASE GATE FAILED: {error}", file=sys.stderr)
        return 1

    print("\nRELEASE GATE PASSED")
    print(f"HEAD: {head}")
    print(f"Parent: {parent}")
    print(f"Diff base: {base}")
    print(f"EF migrations ({len(ids)}): {', '.join(ids)}")
    print(f"Final semantic SHA-256: {final_signature}")
    return 0


class GateFailure(RuntimeError):
    pass


if __name__ == "__main__":
    raise SystemExit(main())

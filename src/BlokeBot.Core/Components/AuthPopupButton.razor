@implements IAsyncDisposable

<button class="@Class"
        type="button"
        disabled="@(Disabled || _opening)"
        @onclick="OpenAsync">
    @(_opening && !string.IsNullOrWhiteSpace(OpeningText) ? OpeningText : null)
    @if (!_opening || string.IsNullOrWhiteSpace(OpeningText))
    {
        @ChildContent
    }
</button>

@if (Label is { Length: > 0 } label)
{
    <section class="studio-replies" aria-label="@label">
        <p class="studio-replies__group mb-[0.45rem] text-[0.7rem] font-bold tracking-[0.08em] text-[var(--app-text-muted)] uppercase">@label</p>
        @ChildContent
    </section>
}
else
{
    <div class="studio-replies">
        @ChildContent
    </div>
}

<div class="field" data-field>
    <label class="field__label" for="@_inputId">@Label</label>
    <input id="@_inputId"
           class="field__input"
           placeholder="@Placeholder"
           maxlength="@MaxLength"
           value="@Value"
           aria-describedby="@_errorId"
           aria-invalid="@(_hasError ? "true" : "false")"
           @ref="_input"
           @oninput="OnInput" />
    @if (_hasError)
    {
        <p id="@_errorId" class="text-sm font-semibold text-red-700" role="alert">@ErrorMessage</p>
    }
</div>

@using BlokeBot.Core.Features.ViewerPortal.Boundary
@inject PublicViewerCircuit PublicCircuit

<Router AppAssembly="typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @if (PublicDocument == PublicDocumentProtector.IsPublicPage(routeData.PageType, routeData.RouteValues.Keys))
        {
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="routeAuth">
                <AuthorizeView>
                    <Authorized Context="signedInUser">
                        <main class="flex min-h-screen items-center justify-center bg-background px-4 text-foreground">
                            <section class="surface w-full max-w-md rounded-lg p-8 shadow-soft">
                                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">BlokeBot</p>
                                <h1 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">Channel setup</h1>
                                <a class="btn-primary mt-6 w-full" href="/host">Open channel setup</a>
                            </section>
                        </main>
                    </Authorized>
                    <NotAuthorized Context="anonymousUser">
                        <main class="flex min-h-screen items-center justify-center bg-background px-4 text-foreground">
                            <section class="surface w-full max-w-md rounded-lg p-8 shadow-soft">
                                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">BlokeBot</p>
                                <h1 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">Sign in to BlokeBot</h1>
                                <a class="btn-primary auth-action mt-6 w-full" href="/auth/login">
                                    Continue with Twitch
                                </a>
                                <PublicLeaderboardPrompt />
                            </section>
                        </main>
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
        else
        {
            <PublicDocumentReload />
        }
    </Found>
</Router>

@code {
    [Parameter] public bool PublicDocument { get; set; }
    [Parameter] public string DocumentNonce { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (RendererInfo.IsInteractive)
        {
            PublicCircuit.Enter(PublicDocument, DocumentNonce);
        }
    }
}

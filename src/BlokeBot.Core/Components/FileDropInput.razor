@implements IAsyncDisposable
@inject IJSRuntime _js

<div class="file-drop-input @(Compact ? "file-drop-input--compact" : null)"
     data-file-drop-target
     data-disabled="@(_isDisabled ? "true" : "false")"
     aria-disabled="@(_isDisabled ? "true" : "false")"
     aria-busy="@(_handling ? "true" : "false")"
     @ref="_dropTarget">
    <span class="file-drop-input__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" focusable="false">
            <path d="M7 18H5.5a3.5 3.5 0 0 1-.5-6.96A7 7 0 0 1 18.3 9.2 4.5 4.5 0 0 1 18.5 18H17" />
            <path d="M12 12v9" />
            <path d="m8.5 15.5 3.5-3.5 3.5 3.5" />
        </svg>
    </span>
    <span class="file-drop-input__copy">
        <span class="file-drop-input__label">@Label</span>
        <strong>@Prompt</strong>
        @if (_selection is { } selection)
        {
            <span class="file-drop-input__selection" data-selected-file>
                @SelectedFileLabel
            </span>
        }
    </span>
    <button class="btn-secondary file-drop-input__browse"
            type="button"
            disabled="@_isDisabled"
            @onclick="BrowseAsync">
        Browse files
    </button>
    <InputFile class="file-drop-input__native"
               OnChange="HandleSelectionAsync"
               accept="@Accept"
               disabled="@_isDisabled" />
</div>

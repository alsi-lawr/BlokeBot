<button class="@_class"
        type="button"
        aria-label="@AccessibleName"
        data-save-state="@_state"
        disabled="@_disabled"
        @onclick="OnSave"
        @attributes="AdditionalAttributes">
    <svg class="save-changes-button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" focusable="false" aria-hidden="true">
        <path d="M5 4h12l2 2v14H5zM8 4v6h8V4M8 20v-6h8v6" />
    </svg>
    <span>@(Saving ? "Saving..." : "Save")</span>
</button>

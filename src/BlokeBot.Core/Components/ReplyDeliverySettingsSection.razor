@using BlokeBot.Core.Features.Replies

<CollapsibleSection Title="@Title" Description="@Description" InitiallyOpen="false">
    <div class="grid gap-3 p-4 md:grid-cols-2">
        @foreach (var option in Options)
        {
            <span @key="option.ReplyKey">
                <label class="@_whisperLabelClass">
                    <input class="h-4 w-4"
                           type="checkbox"
                           checked="@Delivery.IsWhisper(option.ReplyKey)"
                           disabled="@_whisperDisabled"
                           aria-describedby="@(_whisperDisabled ? "reply-delivery-whisper-recovery" : null)"
                           @onchange="args => SetWhisper(option.ReplyKey, args)" />
                    <span>@option.Label</span>
                </label>
            </span>
        }
    </div>
    @if (_whisperDisabled)
    {
        <p id="reply-delivery-whisper-recovery" class="px-4 pb-4 text-sm font-medium text-slate-600">Private replies need a connected custom bot. <a class="font-semibold text-blue-700 underline underline-offset-2" href="/host#custom-bot">Open Channel setup to connect one.</a></p>
    }
</CollapsibleSection>

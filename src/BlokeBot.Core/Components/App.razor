@inject IWebHostEnvironment Environment
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (Environment.EnvironmentName == "Simulation")
    {
        <script>
            try {
                const requestedTheme = new URLSearchParams(window.location.search).get("simulationTheme");
                const simulationTheme = requestedTheme === "dark" ? "dark" : "light";
                window.localStorage.setItem("blokebot.theme", simulationTheme);
            } catch {
            }
        </script>
        <style>
            h1:focus {
                outline: none !important;
            }
        </style>
    }
    <script>
        (() => {
            const flagKey = "blokebot.preferences.disabled";
            const preferenceKeys = [
                "blokebot.theme",
                "blokebot.sidebar.guessing.open",
                "blokebot.sidebar.points.open",
                "blokebot.sidebar.customcommands.open",
                "blokebot.sidebar.automations.open",
                "blokebot.sidebar.nativetwitch.open",
                "blokebot.shell.rail.v1",
            ];
            const enabled = () => {
                try {
                    return window.localStorage.getItem(flagKey) !== "true";
                } catch {
                    return false;
                }
            };
            const disable = () => {
                try {
                    window.localStorage.setItem(flagKey, "true");
                    for (const key of preferenceKeys)
                        window.localStorage.removeItem(key);
                } catch {
                }

                window.blokeBotTheme?.sync();
                window.blokeBotNavigation?.sync();
                return enabled();
            };
            const enable = () => {
                try {
                    window.localStorage.removeItem(flagKey);
                } catch {
                }

                return enabled();
            };

            window.blokeBotPreferences = { enabled, disable, enable };
        })();
    </script>
    <script>
        (() => {
            const storageKey = "blokebot.theme";
            const media = window.matchMedia("(prefers-color-scheme: dark)");
            const valid = value => value === "dark" || value === "light";

            const storedTheme = () => {
                try {
                    const value = window.localStorage.getItem(storageKey);
                    return valid(value) ? value : null;
                } catch {
                    return null;
                }
            };

            const systemTheme = () => media.matches ? "dark" : "light";
            const selectedTheme = () => storedTheme() ?? systemTheme();
            const applyTheme = (theme, persist) => {
                if (document.documentElement.dataset.theme !== theme)
                    document.documentElement.dataset.theme = theme;

                if (document.documentElement.style.colorScheme !== theme)
                    document.documentElement.style.colorScheme = theme;

                if (!persist || !window.blokeBotPreferences.enabled())
                    return;

                try {
                    window.localStorage.setItem(storageKey, theme);
                } catch {
                }
            };
            const syncTheme = () => applyTheme(selectedTheme(), false);

            syncTheme();

            const mediaChanged = () => {
                if (storedTheme() === null)
                    syncTheme();
            };

            if (media.addEventListener)
                media.addEventListener("change", mediaChanged);
            else if (media.addListener)
                media.addListener(mediaChanged);

            new MutationObserver(syncTheme).observe(document.documentElement, {
                attributeFilter: ["data-theme", "style"],
                attributes: true,
            });
            window.addEventListener("pageshow", syncTheme);

            window.blokeBotTheme = {
                current: () => selectedTheme(),
                sync: syncTheme,
                toggle: () => {
                    const next = window.blokeBotTheme.current() === "dark" ? "light" : "dark";
                    applyTheme(next, true);
                    return next;
                },
            };
        })();
    </script>
    <script>
        (() => {
            const states = [
                ["blokebot.sidebar.guessing.open", "navGuessingOpen"],
                ["blokebot.sidebar.points.open", "navPointsOpen"],
                ["blokebot.sidebar.customcommands.open", "navCustomCommandsOpen"],
                ["blokebot.sidebar.automations.open", "navAutomationsOpen"],
                ["blokebot.sidebar.nativetwitch.open", "navNativeTwitchOpen"],
            ];

            const readBoolean = key => {
                try {
                    const value = window.localStorage.getItem(key);
                    return value === null ? true : value === "true";
                } catch {
                    return true;
                }
            };

            const sync = () => {
                for (const [key, datasetName] of states)
                    document.documentElement.dataset[datasetName] = readBoolean(key) ? "true" : "false";
            };
            let deactivateMobileDrawer = () => {};
            const focus = id => document.getElementById(id)?.focus();
            const mobileDrawerFocusableSelector = [
                "a[href]",
                "area[href]",
                "button:not([disabled])",
                "input:not([disabled]):not([type='hidden'])",
                "select:not([disabled])",
                "textarea:not([disabled])",
                "[contenteditable='true']",
                "[tabindex]:not([tabindex='-1'])",
            ].join(",");

            const mobileDrawerFocusables = drawer =>
                [...drawer.querySelectorAll(mobileDrawerFocusableSelector)].filter(element =>
                    element.tabIndex >= 0 &&
                    !element.closest("[inert], [aria-hidden='true']") &&
                    element.getClientRects().length > 0);

            const activateMobileDrawer = (id, dotNetReference) => {
                deactivateMobileDrawer();

                const drawer = document.getElementById(id);
                if (!drawer)
                    return;

                const onKeyDown = event => {
                    if (event.key === "Escape") {
                        event.preventDefault();
                        dotNetReference.invokeMethodAsync("CloseMobileNavigationFromKeyboardAsync");
                        return;
                    }

                    if (event.key !== "Tab")
                        return;

                    const focusables = mobileDrawerFocusables(drawer);
                    if (focusables.length === 0) {
                        event.preventDefault();
                        drawer.focus();
                        return;
                    }

                    const first = focusables[0];
                    const last = focusables.at(-1);
                    if (event.shiftKey && (document.activeElement === first || !drawer.contains(document.activeElement))) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && (document.activeElement === last || !drawer.contains(document.activeElement))) {
                        event.preventDefault();
                        first.focus();
                    }
                };

                document.addEventListener("keydown", onKeyDown);
                mobileDrawerFocusables(drawer)[0]?.focus();
                deactivateMobileDrawer = () => document.removeEventListener("keydown", onKeyDown);
            };

            sync();
            window.addEventListener("pageshow", sync);
            window.blokeBotNavigation = {
                activateMobileDrawer,
                deactivateMobileDrawer: () => deactivateMobileDrawer(),
                focus,
                sync,
            };
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets[$"{Environment.ApplicationName}.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="_renderMode" />
    <link rel="icon" type="image/svg+xml" href="blokebot-mark.svg" />
</head>

<body>
    <Routes @rendermode="_renderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        (() => {
            const register = () => {
                if (!window.Blazor || !window.blokeBotTheme) {
                    window.setTimeout(register, 0);
                    return;
                }

                window.Blazor.addEventListener("enhancedload", window.blokeBotTheme.sync);
                window.Blazor.addEventListener("enhancednavigationend", window.blokeBotTheme.sync);
                window.Blazor.addEventListener("enhancedload", window.blokeBotNavigation.sync);
                window.Blazor.addEventListener("enhancednavigationend", window.blokeBotNavigation.sync);
            };

            register();
        })();
    </script>
</body>

</html>

@code {
    private IComponentRenderMode _renderMode =>
        HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true
        && HttpContextAccessor.HttpContext?.GetEndpoint()?.Metadata
            .GetMetadata<Microsoft.AspNetCore.Components.Endpoints.ComponentTypeMetadata>()?.Type
            != typeof(BlokeBot.Core.Features.ViewerPortal.ViewerPortalPage)
            ? new InteractiveServerRenderMode(prerender: false)
            : InteractiveServer;
}

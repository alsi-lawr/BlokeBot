@inherits LayoutComponentBase
@using BlokeBot.Core.Hosts
@inject IJSRuntime _js
@implements IAsyncDisposable

<div class="app-shell @(_railPresentation is NavigationPresentation.IconRail ? "app-shell--icon-rail" : "") min-h-screen bg-background text-foreground"
     data-rail-presentation="@(_railPresentation is NavigationPresentation.IconRail ? "icon" : "expanded")">
    <div class="app-shell__background" data-mobile-navigation-background @attributes="_backgroundAttributes">
        <div id="@_desktopRailId"
             class="app-shell__sidebar fixed inset-y-0 left-0 z-30 hidden border-r border-slate-200 bg-white/90 backdrop-blur-xl lg:block">
            <NavMenu Presentation="@_railPresentation" />
        </div>

        <main class="app-shell__main">
            <header class="app-shell__topbar sticky top-0 z-20 border-b border-slate-200 bg-white/75 backdrop-blur-xl">
                <div class="app-topbar__inner px-4 sm:px-6 lg:px-8">
                    <button class="mobile-nav-button lg:hidden"
                            id="@_mobileMenuButtonId"
                            type="button"
                            aria-label="Open navigation menu"
                            aria-controls="@_mobileDrawerId"
                            aria-expanded="@(_mobileNavigationOpen ? "true" : "false")"
                            @onclick="OpenMobileNavigation">
                        <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7h16" />
                            <path d="M4 12h16" />
                            <path d="M4 17h16" />
                        </svg>
                    </button>
                    <button class="rail-toggle hidden lg:inline-flex"
                            type="button"
                            aria-label="@(_railPresentation is NavigationPresentation.IconRail ? "Expand navigation" : "Use icon navigation")"
                            aria-controls="@_desktopRailId"
                            aria-expanded="@(_railPresentation is NavigationPresentation.Expanded ? "true" : "false")"
                            @onclick="ToggleRailAsync">
                        <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                            @if (_railPresentation is NavigationPresentation.IconRail)
                            {
                                <path d="m9 18 6-6-6-6" />
                            }
                            else
                            {
                                <path d="m15 18-6-6 6-6" />
                            }
                        </svg>
                    </button>
                    <div class="app-topbar__identity min-w-0">
                        <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Twitch channel tools</p>
                        <p class="truncate text-sm font-semibold text-slate-900">BlokeBot</p>
                    </div>
                    <div class="app-topbar__controls min-w-0">
                        <TopBarControls />
                    </div>
                    <div class="app-topbar__utility">
                        <ThemeToggle />
                        <PageHelpButton />
                    </div>
                </div>
            </header>

            <article class="app-shell__content px-4 py-6 sm:px-6 lg:px-8">
                @Body
            </article>
        </main>

        <ToastHost />
    </div>

    <div class="@_mobileDrawerOverlayClass"
         aria-hidden="true"
         data-mobile-navigation-overlay
         @onclick="CloseMobileNavigation"></div>

    <aside id="@_mobileDrawerId"
           class="@_mobileDrawerClass"
           aria-label="Main navigation"
           @attributes="_mobileDrawerAttributes">
        <button class="mobile-drawer__close"
                type="button"
                aria-label="Close navigation menu"
                @onclick="CloseMobileNavigation">
            <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 6l12 12" />
                <path d="M18 6 6 18" />
            </svg>
        </button>
        <NavMenu Presentation="NavigationPresentation.Expanded"
                 OnNavigate="CloseMobileNavigation" />
    </aside>
</div>

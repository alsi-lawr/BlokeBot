@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager _navigation
@inject DashboardFragmentState _fragments

@if (_currentHelp is { } help)
{
    <div class="relative z-50">
        <button class="control-surface relative z-50 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full text-sm font-black transition hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                type="button"
                title="Page help"
                aria-label="Page help"
                aria-expanded="@_isOpen"
                @onclick:stopPropagation="true"
                @onclick="Toggle">
            ?
        </button>

        @if (_isOpen)
        {
            <section class="surface absolute right-0 top-11 z-50 max-h-[calc(100vh-5rem)] w-[min(28rem,calc(100vw-2rem))] overflow-y-auto rounded-xl p-4 text-left shadow-xl shadow-slate-300/40">
                <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-3">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Help</p>
                        <h2 class="mt-1 text-base font-bold text-slate-950">@help.Title</h2>
                    </div>
                    <button class="menu-item inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-md transition"
                            type="button"
                            aria-label="Close help"
                            @onclick="Close">
                        x
                    </button>
                </div>

                <div class="mt-3 space-y-4">
                    @foreach (var section in help.Sections)
                    {
                        <section>
                            <h3 class="text-sm font-bold text-slate-900">@section.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(section.Body))
                            {
                                <p class="mt-1 text-sm leading-6 text-slate-600">@section.Body</p>
                            }
                            @if (section.Items.Count > 0)
                            {
                                <ul class="mt-2 space-y-1.5 text-sm leading-6 text-slate-600">
                                    @foreach (var item in section.Items)
                                    {
                                        <li class="flex gap-2">
                                            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                                            <span>@((MarkupString)item)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                </div>
            </section>
        }
    </div>
}

@using System.Diagnostics

<div class="@_pageClass" @attributes="AdditionalAttributes">
    @if (Actions is null && SaveFeedback is null)
    {
        <PageHeader Kicker="@Kicker"
                    Title="@Title"
                    Description="@Description" />
    }
    else
    {
        <PageHeader Kicker="@Kicker"
                    Title="@Title"
                    Description="@Description">
            @if (SaveFeedback is not null)
            {
                <p class="dashboard-page__save-feedback"
                   data-save-feedback="@SaveFeedback.Kind.ToString().ToLowerInvariant()"
                   role="@_saveFeedbackRole">
                    @SaveFeedback.Message
                </p>
            }
            @if (Actions is not null)
            {
                <div class="dashboard-page__actions" data-persistent-page-actions>
                    @Actions
                </div>
            }
        </PageHeader>
    }

    @switch (LoadState)
    {
        case PageLoadState.Ready:
            @ChildContent
            break;
        case PageLoadState.Loading loading:
            <PageState Kind="PageStateKind.Loading"
                       Title="Loading"
                       Description="@loading.Message" />
            break;
        case PageLoadState.Failure failure:
            <PageState Kind="PageStateKind.Failure"
                       Title="We couldn’t load this page"
                       Description="@failure.Message">
                <Actions>
                    <button type="button"
                            class="btn-primary"
                            @onclick="failure.RetryAsync">
                        Retry
                    </button>
                </Actions>
            </PageState>
            break;
    }
</div>

@using System.Diagnostics

<div class="@PageClass">
    <PageHeader Kicker="@Kicker"
                Title="@Title"
                Description="@Description" />

    @if (Actions is not null || SaveFeedback is not null)
    {
        <div class="dashboard-page__action-bar" data-persistent-page-actions>
            @if (SaveFeedback is not null)
            {
                <p class="dashboard-page__save-feedback"
                   data-save-feedback="@SaveFeedback.Kind.ToString().ToLowerInvariant()"
                   role="@SaveFeedbackRole">
                    @SaveFeedback.Message
                </p>
            }
            @if (Actions is not null)
            {
                <div class="dashboard-page__actions">
                    @Actions
                </div>
            }
        </div>
    }

    @switch (LoadState)
    {
        case PageLoadState.Ready:
            @ChildContent
            break;
        case PageLoadState.Loading loading:
            <PageState Kind="PageStateKind.Loading"
                       Title="Loading"
                       Description="@loading.Message" />
            break;
        case PageLoadState.Failure failure:
            <PageState Kind="PageStateKind.Failure"
                       Title="We couldn’t load this page"
                       Description="@failure.Message">
                <Actions>
                    <button type="button"
                            class="btn-primary"
                            @onclick="failure.RetryAsync">
                        Retry
                    </button>
                </Actions>
            </PageState>
            break;
    }
</div>

@code {
    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Kicker { get; set; } = string.Empty;

    [Parameter]
    public PageLoadState LoadState { get; set; } = new PageLoadState.Ready();

    [Parameter]
    public PageSaveFeedback? SaveFeedback { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public DashboardPageWidth Width { get; set; } = DashboardPageWidth.Readable;

    private string PageClass =>
        Width switch
        {
            DashboardPageWidth.Readable => "dashboard-page dashboard-page--readable app-motion-stack",
            DashboardPageWidth.Wide => "dashboard-page dashboard-page--wide app-motion-stack",
            _ => throw new UnreachableException(),
        };

    private string SaveFeedbackRole =>
        SaveFeedback?.Kind is PageSaveFeedbackKind.Validation or PageSaveFeedbackKind.Failure
            ? "alert"
            : "status";
}

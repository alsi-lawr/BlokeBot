@using System.Diagnostics

<div class="@_pageClass" data-sticky-save-scope @attributes="AdditionalAttributes">
    @if (Actions is null)
    {
        <PageHeader Kicker="@Kicker"
                    Title="@Title"
                    Description="@Description" />
    }
    else
    {
        <PageHeader Kicker="@Kicker"
                    Title="@Title"
                    Description="@Description">
            <div class="dashboard-page__actions">
                @Actions
            </div>
        </PageHeader>
    }

    @if (SaveAction is not null)
    {
        <StickySaveRegion Feedback="SaveFeedback">
            @SaveAction
        </StickySaveRegion>
    }

    @switch (LoadState)
    {
        case PageLoadState.Ready:
            @ChildContent
            break;
        case PageLoadState.Loading loading:
            <PageState Kind="PageStateKind.Loading"
                       Title="Loading"
                       Description="@loading.Message" />
            break;
        case PageLoadState.Failure failure:
            <PageState Kind="PageStateKind.Failure"
                       Title="We couldn’t load this page"
                       Description="@failure.Message">
                <Actions>
                    <button type="button"
                            class="btn-primary"
                            @onclick="failure.RetryAsync">
                        Retry
                    </button>
                </Actions>
            </PageState>
            break;
    }
</div>

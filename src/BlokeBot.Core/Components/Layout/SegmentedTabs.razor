@implements IDisposable

<nav class="segmented-motion segmented-motion--shared"
     style="@_style"
     role="tablist"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">
    <span class="segmented-motion__indicator" aria-hidden="true"></span>
    @foreach (var item in Items)
    {
        var active = IsActive(item);
        if (OwnsFragment)
        {
            <a @key="item.Key"
               id="@TabIdFor(item)"
               class="@TabClass(active)"
               href="@FragmentHref(item)"
               role="tab"
               aria-selected="@(active ? "true" : "false")"
               aria-controls="@PanelIdFor(item)"
               tabindex="@TabIndexFor(item)"
               @ref="_tabElements[item.Key]"
               @onclick="() => SelectAsync(item)"
               @onclick:preventDefault="true"
               @onkeydown="args => HandleKeyDownAsync(args, item)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    @item.Label
                }
            </a>
        }
        else if (item.Href is null)
        {
            <button @key="item.Key"
                    id="@TabIdFor(item)"
                    class="@TabClass(active)"
                    type="button"
                    role="tab"
                    aria-selected="@(active ? "true" : "false")"
                    aria-controls="@PanelIdFor(item)"
                    tabindex="@TabIndexFor(item)"
                    @ref="_tabElements[item.Key]"
                    @onclick="() => SelectAsync(item)"
                    @onkeydown="args => HandleKeyDownAsync(args, item)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    @item.Label
                }
            </button>
        }
        else
        {
            <a @key="item.Key"
               id="@TabIdFor(item)"
               class="@TabClass(active)"
               href="@item.Href"
               role="tab"
               aria-selected="@(active ? "true" : "false")"
               aria-controls="@PanelIdFor(item)"
               tabindex="@TabIndexFor(item)"
               @ref="_tabElements[item.Key]"
               @onkeydown="args => HandleKeyDownAsync(args, item)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    @item.Label
                }
            </a>
        }
    }
</nav>

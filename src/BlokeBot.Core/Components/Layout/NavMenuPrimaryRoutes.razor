                                <path d="M14 15h6v4h-6Z" />
                            </svg>
                        </span>
                        <span class="nav-menu__label min-w-0">Home</span>
                    </NavLink>
                    @Routes.RouteHelp("home", "Home")
                </div>

                @if (Visibility.ShowAlerts)

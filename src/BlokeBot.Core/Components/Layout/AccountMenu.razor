@using BlokeBot.Core.Auth.Sessions
@using BlokeBot.Core.Hosts
@inject NavigationManager _navigation

<details class="account-menu group relative min-w-0">
    <summary class="account-menu__summary control-surface cursor-pointer list-none marker:hidden">
        @if (AccountImageUrl() is { Length: > 0 } imageUrl)
        {
            <img class="h-7 w-7 rounded-full border border-slate-200 object-cover" src="@imageUrl" alt="" />
        }
        else
        {
            <span class="grid h-7 w-7 place-items-center rounded-full bg-slate-100 text-xs font-bold text-slate-500 ring-1 ring-slate-200" aria-hidden="true">
                @AccountInitial()
            </span>
        }
        <span class="truncate text-sm font-semibold text-slate-900" title="@IdentityText()">@IdentityText()</span>
        <span class="@RoleBadgeClass(_role)">@_role</span>
        <svg class="h-5 w-5 shrink-0 fill-none stroke-current text-slate-500 transition group-open:rotate-180 [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2.25]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </summary>
    <div class="surface absolute right-0 z-50 mt-2 w-52 overflow-hidden rounded-md py-1 shadow-xl shadow-slate-200/70">
        @if (_isAdminEditing)
        {
            <form method="get" action="/auth/exit-admin" data-enhance-nav="false">
                <input type="hidden" name="returnUrl" value="@_currentPath" />
                <button class="menu-item block w-full px-3 py-2 text-left text-sm font-semibold" type="submit">
                    Return to admin
                </button>
            </form>
        }
        <form method="get" action="/auth/logout" data-enhance-nav="false">
            <button class="menu-item block w-full px-3 py-2 text-left text-sm font-semibold" type="submit">
                Sign out
            </button>
        </form>
        @if (_noticeUrl is not null)
        {
            <a class="menu-item block w-full px-3 py-2 text-left text-sm font-semibold" href="@_noticeUrl" target="_blank" rel="noreferrer">
                Privacy notice
            </a>
        }
        <button class="menu-item block w-full px-3 py-2 text-left text-sm font-semibold"
                type="button"
                aria-pressed="@(_preferencesEnabled ? "true" : "false")"
                title="When off, saved view preferences are removed from this browser and no new ones are stored."
                @onclick="TogglePreferenceSavingAsync">
            @(_preferencesEnabled ? "Stop saving view preferences" : "Save view preferences")
        </button>
    </div>
</details>

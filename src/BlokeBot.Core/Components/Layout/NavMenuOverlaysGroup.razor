<div class="nav-menu__panel nav-menu__group rounded-xl p-1" data-nav-section="overlays" data-open="@Group.IsOpen.ToString().ToLowerInvariant()">
    <button class="nav-menu__summary flex min-h-11 w-full items-center gap-2.5 rounded-lg px-2.5 text-left text-sm font-bold transition" type="button" aria-label="Overlays" aria-describedby='@Routes.RouteHelpReference("overlays-group")' aria-controls="@Group.BodyId" aria-expanded="@Group.IsOpen.ToString().ToLowerInvariant()" aria-current='@(_current ? "page" : null)' data-current="@_current.ToString().ToLowerInvariant()" @onclick="Group.ToggleAsync" @onkeydown="Group.CloseOnEscape">
        <span class="nav-menu__icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-fuchsia-700" aria-hidden="true">▣</span>
        <span class="nav-menu__label min-w-0 flex-1">Overlays</span>
        <span class="nav-menu__badge" aria-label="2 destinations">2</span>
        <svg class="nav-menu__section-chevron h-4 w-4 shrink-0 fill-none stroke-current text-slate-400 transition [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    @Routes.RouteHelp("overlays-group", "Overlays")
    <div id="@Group.BodyId" class="nav-menu__section-body grid gap-1 border-t border-slate-100" hidden="@(!Group.IsOpen)">
        <p class="nav-menu__flyout-title">Overlays</p>
        <NavLink class="nav-menu__sub-link flex min-h-10 items-center rounded-lg px-3 text-sm font-semibold transition" ActiveClass="nav-menu__item-active" href="overlays#sources" aria-label="Simple overlays" aria-current='@Routes.CurrentRoute("overlays")' @onclick="Routes.NotifyNavigatedAsync">Simple</NavLink>
        <NavLink class="nav-menu__sub-link flex min-h-10 items-center rounded-lg px-3 text-sm font-semibold transition" ActiveClass="nav-menu__item-active" href="full-overlays" aria-label="Overlay editor" aria-current='@Routes.CurrentRoute("full-overlays")' @onclick="Routes.NotifyNavigatedAsync">Editor</NavLink>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required NavMenuGroupBindings Group { get; set; }
    [Parameter, EditorRequired] public required NavMenuRouteBindings Routes { get; set; }
    private bool _current => Routes.GroupIsCurrent("overlays") || Routes.GroupIsCurrent("full-overlays");
}

@inject IJSRuntime _js
@implements IAsyncDisposable

<section class="@_panelClass">
    <button type="button"
            class="disclosure-trigger"
            aria-controls="@_resolvedContentId"
            aria-expanded="@(_isOpen ? "true" : "false")"
            @onclick="ToggleAsync">
        <span class="disclosure-copy">
            <span class="disclosure-title">@Title</span>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <span class="disclosure-description">@Description</span>
            }
        </span>
        <span class="disclosure-chevron @(_isOpen ? "open" : "")" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">
                <path d="M6 8l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </span>
    </button>

    @if (_isOpen)
    {
        <div id="@_resolvedContentId" class="disclosure-content">
            @ChildContent
        </div>
    }
</section>

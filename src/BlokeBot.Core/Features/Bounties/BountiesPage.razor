@page "/bounties"
@using BlokeBot.Core.Features.Points.Balances
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject BountyService _bounties
@inject BlokeBot.Core.Features.HostedChannels.HostFeatureService _features

<PageTitle>BlokeBot | Bounties</PageTitle>

<DashboardPage Kicker="Community progression"
               Title="Bounties"
               Description="Create, fund, and settle viewer-backed channel challenges."
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_featureEnabled && Host is not null)
        {
            <a class="btn-secondary" href="@_publicBoardUrl" target="_blank" rel="noopener">Open public board</a>
        }
    </Actions>
    <ChildContent>
        @if (Host is null)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">Choose a channel to manage bounties.</div>
            </ApplicationCardCollection>
        }
        else if (!_bountiesConfigured)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Bounties are off for this channel. Turn them on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved bounties, pledges, and history are retained.
                </div>
            </ApplicationCardCollection>
        }
        else if (!_pointsEnabled)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Bounties depend on Points, which is off for this channel. Turn Points on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. No saved bounty work is changed while unavailable.
                </div>
            </ApplicationCardCollection>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="rounded-lg border p-3 text-sm font-semibold" role="@(_operationFailed ? "alert" : "status")">@_feedback</p>
            }

            <section class="card p-5" aria-labelledby="new-bounty-heading">
                <h2 id="new-bounty-heading" class="text-lg font-semibold text-slate-950">New bounty</h2>
                <div class="studio-grid mt-4">
                    <div class="studio-span-6"><Field Id="bounty-title" Label="Title" @bind-Value="_draft.Title" /></div>
                    <div class="studio-span-6"><Field Id="bounty-expiry" Label="Expiry (UTC)" @bind-Value="_draft.ExpiresAtUtc" /></div>
                    <div class="studio-span-12"><TextAreaField Id="bounty-description" Label="Description" @bind-Value="_draft.Description" /></div>
                    <div class="studio-span-4"><Field Id="bounty-target" Label="Funding target" @bind-Value="_draft.FundingTarget" /></div>
                    <div class="studio-span-4"><Field Id="bounty-reward" Label="Completion bonus pool" @bind-Value="_draft.CompletionReward" /></div>
                    <div class="studio-span-4">
                        <label class="label" for="bounty-visibility">Visibility</label>
                        <select id="bounty-visibility" class="input" @bind="_draft.Visibility">
                            <option value="@BountyVisibility.Public">Public</option>
                            <option value="@BountyVisibility.Private">Private</option>
                        </select>
                    </div>
                    <div class="studio-span-6">
                        <label class="label" for="bounty-failure">If the bounty fails</label>
                        <select id="bounty-failure" class="input" @bind="_draft.FailurePolicy">
                            <option value="@BountyFailurePledgePolicy.Refund">Refund pledges</option>
                            <option value="@BountyFailurePledgePolicy.Spend">Spend pledges</option>
                        </select>
                    </div>
                    <div class="studio-span-6">
                        <label class="label" for="bounty-reward-distribution">Completion bonus distribution</label>
                        <select id="bounty-reward-distribution" class="input" @bind="_draft.RewardDistribution">
                            <option value="@BountyRewardDistribution.Equal">Equal</option>
                            <option value="@BountyRewardDistribution.Proportional">Proportional</option>
                        </select>
                    </div>
                    <div class="studio-span-6"><TextAreaField Id="bounty-create-reason" Label="Private moderator note" @bind-Value="_draft.Reason" /></div>
                    <div class="studio-span-12"><button class="btn-primary" type="button" @onclick="CreateAsync">Create proposed bounty</button></div>
                </div>
            </section>

            <section class="application-card-collection" data-card-owner="bounty-cards" aria-label="Bounties">
                @if (_items.Count == 0)
                {
                    <div class="card p-8 text-sm text-muted-foreground">No bounties yet.</div>
                }
                @foreach (var item in _items)
                {
                    var bounty = item.Bounty;
                    <article @key="bounty.PublicId" class="card p-5" data-bounty-id="@bounty.PublicId">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <h2 class="text-lg font-semibold text-slate-950">@bounty.Title</h2>
                                    <span class="status-pill bg-[var(--app-surface-muted)] text-[var(--app-text-muted)] ring-1 ring-[var(--app-border)]"><span class="status-pill__label">@bounty.Status</span></span>
                                    <span class="text-xs font-semibold text-muted-foreground">@bounty.Visibility</span>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">@bounty.Description</p>
                            </div>
                            <span class="font-mono text-xs text-muted-foreground">@ShortId(bounty.PublicId)</span>
                        </div>
                        <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
                            <div><dt class="font-semibold">Funding</dt><dd>@bounty.PledgedAmount.ToDisplayString() / @bounty.FundingTarget.ToDisplayString()</dd></div>
                            <div><dt class="font-semibold">Contributors</dt><dd>@bounty.ContributorCount</dd></div>
                            <div><dt class="font-semibold">Expires</dt><dd>@bounty.ExpiresAtUtc.ToString("u")</dd></div>
                            <div><dt class="font-semibold">Completion bonus</dt><dd>@bounty.CompletionReward.ToDisplayString() · @bounty.RewardDistribution</dd></div>
                        </dl>
                        @if (bounty.Contributors.Count > 0)
                        {
                            <p class="mt-3 text-sm"><span class="font-semibold">Recorded pledges:</span> @string.Join(", ", bounty.Contributors.Select(value => $"@{value.Login} {value.PledgedAmount.ToDisplayString()}"))</p>
                        }
                        <div class="mt-4 grid gap-3 md:grid-cols-[minmax(0,1fr)_auto]">
                            <TextAreaField Id="@($"bounty-reason-{bounty.PublicId:N}")" Label="Private audit reason" Value="@ReasonFor(bounty.PublicId)" ValueChanged="value => SetReason(bounty.PublicId, value)" />
                            <div class="flex flex-wrap content-end items-end gap-2">
                                @foreach (var action in AvailableActions(bounty.Status))
                                {
                                    <button class="btn-secondary" type="button" @onclick="() => TransitionAsync(bounty, action)">@ActionLabel(action)</button>
                                }
                            </div>
                        </div>
                        @if (CanExtend(bounty.Status))
                        {
                            <div class="mt-3 flex flex-wrap items-end gap-2">
                                <div class="min-w-56 grow"><Field Id="@($"bounty-extend-{bounty.PublicId:N}")" Label="Extend expiry (UTC)" Value="@ExtensionFor(bounty.PublicId)" ValueChanged="value => SetExtension(bounty.PublicId, value)" /></div>
                                <button class="btn-secondary" type="button" @onclick="() => ExtendAsync(bounty)">Extend</button>
                            </div>
                        }
                        @if (item.Audits.Count > 0)
                        {
                            <details class="mt-4 text-sm">
                                <summary class="cursor-pointer font-semibold">Private moderation audit</summary>
                                <ul class="mt-2 space-y-2 text-muted-foreground">
                                    @foreach (var audit in item.Audits)
                                    {
                                        <li>@audit.OccurredAtUtc.ToString("u") · @audit.Action by @($"@{audit.ActorLogin}") · @audit.Reason</li>
                                    }
                                </ul>
                            </details>
                        }
                    </article>
                }
            </section>
        }
    </ChildContent>
</DashboardPage>

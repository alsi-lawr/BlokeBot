@page "/raid-collaboration"
@using BlokeBot.Core.Components.Layout
@using BlokeBot.Core.Features.TwitchOperations.Shoutouts
@using BlokeBot.Eventing
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject RaidCollaborationService _service
@inject EventBus<AppEventKind> _events

<PageTitle>BlokeBot | Raid &amp; collaboration</PageTitle>

<DashboardPage Kicker="Community"
               Title="Raid &amp; collaboration"
               Description="Welcome incoming communities and choose the next channel with live, explainable Twitch context."
               Width="DashboardPageWidth.Wide"
               data-raid-collaboration-page>
    <Actions>
        @if (_dashboard is not null)
        {
            <button class="btn-secondary" type="button" disabled="@_loading" @onclick="LoadAsync">Refresh live context</button>
        }
    </Actions>
    <ChildContent>
        @if (Host is null)
        {
            <PageState Kind="PageStateKind.Empty" Title="Choose a channel" Description="Select a channel before opening its raid and collaboration hub." />
        }
        else if (_loading)
        {
            <PageState Kind="PageStateKind.Loading" Title="Loading raid hub" Description="Checking approved channels and live Twitch context." />
        }
        else if (_disabled)
        {
            <ApplicationCardCollection Owner="raid-collaboration-disabled">
                <div class="card p-8 text-sm text-muted-foreground" data-raid-collaboration-disabled-recovery>
                    Raid &amp; collaboration is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved welcome settings, approved channels, and history are retained. Re-enable processes only fresh events; suppressed raids, welcome steps, shoutouts, provider calls, and queued work are never replayed.
                </div>
            </ApplicationCardCollection>
        }
        else if (_loadFailed)
        {
            <PageState Kind="PageStateKind.Failure" Title="Raid hub could not load" Description="Twitch live context is unavailable. Nothing was sent or changed.">
                <Actions><button class="btn-primary" type="button" @onclick="LoadAsync">Retry</button></Actions>
            </PageState>
        }
        else if (_dashboard is { } dashboard)
        {
            <div class="card mb-4 flex items-start gap-3 border-emerald-200 bg-emerald-50 p-4 text-sm" data-raid-collaboration-ready>
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-600"></span>
                <div><strong>Hub on.</strong> Incoming and outgoing raid subscriptions are reconciled. Twitch supplies only an aggregate viewer count, so BlokeBot never infers which individual viewers arrived through a raid.</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_operationFeedback))
            {
                <p class="card mb-4 p-3 text-sm font-semibold" role="@(_operationFailed ? "alert" : "status")">@_operationFeedback</p>
            }

            <div class="grid gap-4 xl:grid-cols-[minmax(0,1.45fr)_minmax(18rem,.55fr)]">
                <div class="grid gap-4">
                    <TaskPanel Title="Eligible channels" Description="Only approved channels that pass every current filter appear here. BlokeBot does not score safety or reputation.">
                        @if (dashboard.EligibleChannels.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground">No approved channel currently passes every live filter. Review the explicit exclusions below or save another approved channel.</p>
                        }
                        else
                        {
                            <div class="grid gap-3" data-raid-shortlist>
                                @foreach (var candidate in dashboard.EligibleChannels)
                                {
                                    <article class="surface-muted rounded-xl p-4" @key="candidate.Login">
                                        <div class="flex flex-wrap items-start justify-between gap-3">
                                            <div class="min-w-0">
                                                <h2 class="font-bold text-[var(--app-text-strong)]">@candidate.DisplayName <span class="text-sm font-medium text-muted-foreground">@@@candidate.Login</span></h2>
                                                <p class="text-sm text-muted-foreground">@candidate.Category · @candidate.Language · @candidate.ViewerCount viewers</p>
                                                <p class="mt-1 truncate text-xs text-muted-foreground">@candidate.Title</p>
                                                <div class="mt-2 flex flex-wrap gap-1.5">
                                                    @foreach (var reason in candidate.EligibilityReasons)
                                                    {
                                                        <span class="status-pill status-pill--emerald"><span class="status-pill__label">@reason</span></span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="flex flex-wrap gap-2">
                                                <button class="btn-secondary" type="button" @onclick="() => SendShoutoutAsync(candidate.Login)">Shoutout</button>
                                                <button class="btn-primary" type="button" @onclick="() => PrepareRaid(candidate.Login)">Prepare raid</button>
                                            </div>
                                        </div>
                                        @if (candidate.ApprovedClip is { } clip)
                                        {
                                            <a class="surface-solid mt-3 flex items-center justify-between gap-3 rounded-lg p-3 text-sm" href="@clip.Url" target="_blank" rel="noopener">
                                                <span><strong class="text-violet-700">Approved recent clip</strong> · @clip.Title</span>
                                                <span class="text-xs text-muted-foreground">@Math.Round(clip.DurationSeconds)s</span>
                                            </a>
                                        }
                                        @if (_preparedRaidLogin == candidate.Login)
                                        {
                                            <div class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm" data-raid-confirmation>
                                                <strong>Confirm outgoing raid to @@candidate.Login?</strong>
                                                <p class="mt-1 text-xs text-muted-foreground">This starts Twitch’s native raid. It is never triggered automatically from the shortlist.</p>
                                                <div class="mt-3 flex flex-wrap gap-2">
                                                    <button class="btn-primary" type="button" @onclick="() => ConfirmRaidAsync(candidate.Login)">Confirm and start raid</button>
                                                    <button class="btn-secondary" type="button" @onclick="CancelPreparedRaid">Cancel</button>
                                                </div>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                        @if (dashboard.ExcludedChannels.Count > 0)
                        {
                            <details class="mt-4 rounded-xl border border-[var(--app-border)] p-3" data-raid-exclusions>
                                <summary class="cursor-pointer font-semibold">Why @dashboard.ExcludedChannels.Count approved channel(s) are hidden</summary>
                                <div class="mt-3 grid gap-2">
                                    @foreach (var exclusion in dashboard.ExcludedChannels)
                                    {
                                        <div class="surface-muted rounded-lg p-3 text-sm"><strong>@@@exclusion.Login</strong><ul class="mt-1 list-disc pl-5 text-muted-foreground">@foreach (var reason in exclusion.Reasons){<li>@reason</li>}</ul></div>
                                    }
                                </div>
                            </details>
                        }
                    </TaskPanel>

                    <TaskPanel Title="Relationship history" Description="Deduplicated incoming and outgoing Twitch raids with native shoutout and welcome context.">
                        @if (dashboard.History.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground">No raid history has been recorded yet.</p>
                        }
                        else
                        {
                            <div class="responsive-data-list" data-raid-history>
                                @foreach (var item in dashboard.History)
                                {
                                    <div class="responsive-data-row" @key="item">
                                        <div><span class="text-xs font-extrabold uppercase tracking-wide text-violet-700">@item.Direction</span></div>
                                        <div><strong>@@@item.Login</strong><p class="text-xs text-muted-foreground">@(item.Category ?? "Category unavailable") · stream @(item.StreamId ?? "identity unavailable")</p></div>
                                        <div><strong>@item.ViewerCount viewers</strong><p class="text-xs text-muted-foreground">@item.OccurredAt.ToLocalTime().ToString("MMM d, HH:mm")</p></div>
                                        <div class="text-xs text-muted-foreground">Welcome: @item.WelcomeOutcome<br />Shoutout: @item.ShoutoutOutcome</div>
                                    </div>
                                }
                            </div>
                        }
                    </TaskPanel>
                </div>

                <div class="grid content-start gap-4">
                    <TaskPanel Title="Latest arrival" Description="Aggregate EventSub evidence only; no individual viewer attribution.">
                        @if (dashboard.LatestArrival is { } arrival)
                        {
                            <div class="grid grid-cols-2 gap-2">
                                <div class="surface-muted rounded-lg p-3"><strong class="text-xl">@arrival.ViewerCount</strong><p class="text-xs text-muted-foreground">aggregate viewers</p></div>
                                <div class="surface-muted rounded-lg p-3"><strong>@@@arrival.Login</strong><p class="text-xs text-muted-foreground">@(arrival.Category ?? "Category unavailable")</p></div>
                            </div>
                            <p class="mt-3 text-xs text-muted-foreground">Welcome: @arrival.WelcomeOutcome · native shoutout: @arrival.ShoutoutOutcome · @arrival.OccurredAt.ToLocalTime().ToString("g")</p>
                        }
                        else
                        {
                            <p class="text-sm text-muted-foreground">No incoming raid has been recorded yet.</p>
                        }
                    </TaskPanel>
                    <TaskPanel Title="Native shoutout" Description="Live and cooldown checks run again at send time through the existing Twitch shoutout boundary.">
                        <p class="text-sm font-semibold">@ShoutoutReadiness(dashboard.ShoutoutContext)</p>
                    </TaskPanel>
                    @if (!dashboard.RaidManagementAuthorized)
                    {
                        <div class="card p-4 text-sm"><strong>Raid confirmation needs Twitch permission.</strong><p class="mt-1 text-xs text-muted-foreground">The channel owner can reconnect with raid management access. Other native Twitch tools keep their existing permission boundary.</p><a class="btn-secondary mt-3 inline-flex" href="/oauth/broadcaster/start?raid=true">Reconnect Twitch integration</a></div>
                    }
                </div>
            </div>

            <section class="card mt-4 p-5" data-sticky-save-scope data-raid-settings>
                <div class="mb-4 flex flex-wrap items-start justify-between gap-3"><div><h2 class="text-lg font-bold text-[var(--app-text-strong)]">Welcome &amp; shortlist settings</h2><p class="text-sm text-muted-foreground">Saved for this channel. Turning the feature off retains everything without replay.</p></div><span class="status-pill status-pill--slate"><span class="status-pill__label">Opt-in</span></span></div>
                <div class="studio-grid">
                    <div class="studio-span-4"><label class="flex items-center gap-2 font-semibold"><input type="checkbox" @bind="_draft.WelcomeEnabled" /> Welcome message step</label></div>
                    <div class="studio-span-4"><label class="label" for="raid-dedupe">Deduplication window (minutes)</label><input id="raid-dedupe" class="input" type="number" min="1" max="1440" @bind="_draft.DeduplicationWindowMinutes" /></div>
                    <div class="studio-span-4"><label class="label" for="raid-gap">Outgoing relationship gap (hours)</label><input id="raid-gap" class="input" type="number" min="0" max="8760" @bind="_draft.RelationshipCooldownHours" /></div>
                    <div class="studio-span-8"><TextAreaField Id="raid-welcome-message" Label="Welcome message" @bind-Value="_draft.WelcomeMessage" /><p class="mt-1 text-xs text-muted-foreground">Tokens: {display_name}, {twitch_handle}, {viewer_count}</p></div>
                    <div class="studio-span-4"><label class="flex items-center gap-2 font-semibold"><input type="checkbox" @bind="_draft.NativeShoutoutEnabled" /> Native shoutout step</label></div>
                    <div class="studio-span-4"><Field Id="raid-language" Label="Language code (blank allows any)" @bind-Value="_draft.Language" /></div>
                    <div class="studio-span-8"><TextAreaField Id="raid-categories" Label="Eligible categories (one per line; blank allows any)" @bind-Value="_draft.Categories" /></div>
                    <div class="studio-span-12"><h3 class="font-semibold text-[var(--app-text-strong)]">Approved channels</h3><p class="text-xs text-muted-foreground">Approval is your explicit allowlist, not a Twitch safety judgement. An optional clip ID is shown only when Twitch confirms it belongs to that channel and is at most 30 days old.</p></div>
                    @for (var index = 0; index < _draft.ApprovedChannels.Count; index++)
                    {
                        var channel = _draft.ApprovedChannels[index];
                        <div class="studio-span-12 grid gap-2 rounded-xl border border-[var(--app-border)] p-3 md:grid-cols-[1fr_1fr_1fr_auto]" @key="channel">
                            <Field Id="@($"raid-channel-login-{index}")" Label="Twitch login" @bind-Value="channel.Login" />
                            <Field Id="@($"raid-channel-name-{index}")" Label="Display name" @bind-Value="channel.DisplayName" />
                            <Field Id="@($"raid-channel-clip-{index}")" Label="Approved clip ID (optional)" @bind-Value="channel.ApprovedClipId" />
                            <button class="btn-secondary self-end" type="button" @onclick="() => RemoveApprovedChannel(channel)">Remove</button>
                        </div>
                    }
                    <div class="studio-span-12"><button class="btn-secondary" type="button" @onclick="AddApprovedChannel">+ Add approved channel</button></div>
                </div>
                <StickySaveRegion Scope="StickySaveScope.Editor" Feedback="_saveFeedback" class="mt-4">
                    <button class="btn-primary" type="button" disabled="@_saving" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save settings")</button>
                </StickySaveRegion>
            </section>
        }
    </ChildContent>
</DashboardPage>

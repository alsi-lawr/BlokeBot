@page "/raid-collaboration"
@using BlokeBot.Core.Components.Layout
@using BlokeBot.Core.Components.Studio
@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Core.Features.TwitchOperations.Shoutouts
@using BlokeBot.Eventing
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject RaidCollaborationService _service
@inject EventBus<AppEventKind> _events

<PageTitle>BlokeBot | Raid &amp; collaboration</PageTitle>

<DashboardPage Kicker="Community"
               Title="Raid &amp; collaboration"
               Description="@DescriptionFor(_workspaceKey)"
               Width="DashboardPageWidth.Wide"
               data-raid-collaboration-page>
    <Actions>
        @if (_dashboard is not null && _workspaceKey == _hubKey)
        {
            <button class="btn-secondary" type="button" disabled="@_loading" @onclick="RefreshAsync">Refresh live channels</button>
        }
    </Actions>
    <ChildContent>
        @if (Host is null)
        {
            <PageState Kind="PageStateKind.Empty" Title="Choose a channel" Description="Select a channel before opening its raid and collaboration hub." />
        }
        else if (_loading)
        {
            <PageState Kind="PageStateKind.Loading" Title="Loading raid hub" Description="Checking approved channels and live Twitch context." />
        }
        else if (_disabled)
        {
            <ApplicationCardCollection Owner="raid-collaboration-disabled">
                <div class="card p-8 text-sm text-muted-foreground" data-raid-collaboration-disabled-recovery>
                    Raid &amp; collaboration is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved welcome settings, approved channels, and history are retained. Re-enable processes only fresh events; missed raids, welcome steps, shoutouts, Twitch actions, and queued work are never repeated.
                </div>
            </ApplicationCardCollection>
        }
        else if (_loadFailed)
        {
            <PageState Kind="PageStateKind.Failure" Title="Raid hub could not load" Description="Twitch live context is unavailable. Nothing was sent or changed.">
                <Actions><button class="btn-primary" type="button" @onclick="RefreshAsync">Retry</button></Actions>
            </PageState>
        }
        else if (_dashboard is { } dashboard)
        {
            <SegmentedTabs Id="@_workspaceTabsId"
                           OwnsFragment
                           AriaLabel="Raid workspace"
                           Items="_workspaceTabs"
                           ActiveKey="@_workspaceKey"
                           ActiveKeyChanged="@(key => _workspaceKey = key)" />

            <div class="raid-workspace"
                 id="@SegmentedTabs.PanelId(_workspaceTabsId, _workspaceKey)"
                 role="tabpanel"
                 aria-labelledby="@SegmentedTabs.TabId(_workspaceTabsId, _workspaceKey)"
                 tabindex="0">
                @if (_workspaceKey == _hubKey)
                {
                    <div class="card flex items-start gap-3 border-emerald-200 bg-emerald-50 p-4 text-sm" data-raid-collaboration-ready>
                        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-600"></span>
                        <div><strong>Hub on.</strong> Incoming and outgoing raid subscriptions are reconciled. Twitch supplies only an aggregate viewer count, so BlokeBot never infers which individual viewers arrived through a raid.</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_operationFeedback))
                    {
                        <p class="card p-3 text-sm font-semibold" role="@(_operationFailed ? "alert" : "status")">@_operationFeedback</p>
                    }

                    <div class="raid-hub">
                        <div class="raid-hub__column">
                            <TaskPanel Title="Eligible channels" Description="Approved channels that match your current filters.">
                                @if (dashboard.EligibleChannels.Count == 0)
                                {
                                    <p class="text-sm text-muted-foreground">No approved channel currently passes every live filter. Review the explicit exclusions below or save another approved channel.</p>
                                }
                                else
                                {
                                    <div class="grid gap-3" data-raid-shortlist>
                                        @foreach (var candidate in dashboard.EligibleChannels)
                                        {
                                            <article class="surface-muted rounded-xl p-4" @key="candidate.Login">
                                                <div class="flex flex-wrap items-start justify-between gap-3">
                                                    <div class="min-w-0">
                                                        <h3 class="font-bold text-[var(--app-text-strong)]">@candidate.DisplayName <span class="text-sm font-medium text-muted-foreground">@@@candidate.Login</span></h3>
                                                        <p class="text-sm text-muted-foreground">@candidate.Category · @candidate.Language · @candidate.ViewerCount viewers</p>
                                                        <p class="mt-1 truncate text-xs text-muted-foreground">@candidate.Title</p>
                                                        <div class="mt-2 flex flex-wrap gap-1.5">
                                                            @foreach (var reason in candidate.EligibilityReasons)
                                                            {
                                                                <span class="status-pill status-pill--emerald"><span class="status-pill__label">@reason</span></span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="flex flex-wrap gap-2">
                                                        <button class="btn-secondary" type="button" @onclick="() => SendShortlistShoutoutAsync(candidate.Login)">Shoutout</button>
                                                        <button class="btn-primary" type="button" @onclick="() => PrepareRaid(candidate.Login)">Prepare raid</button>
                                                    </div>
                                                </div>
                                                @if (candidate.ApprovedClip is { } clip)
                                                {
                                                    <a class="surface-solid mt-3 flex items-center justify-between gap-3 rounded-lg p-3 text-sm" href="@clip.Url" target="_blank" rel="noopener">
                                                        <span><strong class="text-violet-700">Approved recent clip</strong> · @clip.Title</span>
                                                        <span class="text-xs text-muted-foreground">@Math.Round(clip.DurationSeconds)s</span>
                                                    </a>
                                                }
                                                @if (_preparedRaidLogin == candidate.Login)
                                                {
                                                    <div class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm" data-raid-confirmation>
                                                        <strong>Confirm outgoing raid to @@candidate.Login?</strong>
                                                        <p class="mt-1 text-xs text-muted-foreground">This starts Twitch’s native raid. It is never triggered automatically from the shortlist.</p>
                                                        <div class="mt-3 flex flex-wrap gap-2">
                                                            <button class="btn-primary" type="button" @onclick="() => ConfirmRaidAsync(candidate.Login)">Confirm and start raid</button>
                                                            <button class="btn-secondary" type="button" @onclick="CancelPreparedRaid">Cancel</button>
                                                        </div>
                                                    </div>
                                                }
                                            </article>
                                        }
                                    </div>
                                }
                                @if (dashboard.ExcludedChannels.Count > 0)
                                {
                                    <details class="mt-4 rounded-xl border border-[var(--app-border)] p-3" data-raid-exclusions>
                                        <summary class="cursor-pointer font-semibold">Why @dashboard.ExcludedChannels.Count approved channel(s) are hidden</summary>
                                        <div class="mt-3 grid gap-2">
                                            @foreach (var exclusion in dashboard.ExcludedChannels)
                                            {
                                                <div class="surface-muted rounded-lg p-3 text-sm"><strong>@@@exclusion.Login</strong><ul class="mt-1 list-disc pl-5 text-muted-foreground">@foreach (var reason in exclusion.Reasons){<li>@reason</li>}</ul></div>
                                            }
                                        </div>
                                    </details>
                                }
                            </TaskPanel>
                        </div>

                        <div class="raid-hub__column">
                            <TaskPanel Title="Latest arrival" Description="Aggregate EventSub evidence only; no individual viewer attribution.">
                                @if (dashboard.LatestArrival is { } arrival)
                                {
                                    <div class="grid grid-cols-2 gap-2">
                                        <div class="surface-muted rounded-lg p-3"><strong class="text-xl">@arrival.ViewerCount</strong><p class="text-xs text-muted-foreground">aggregate viewers</p></div>
                                        <div class="surface-muted rounded-lg p-3"><strong>@@@arrival.Login</strong><p class="text-xs text-muted-foreground">@(arrival.Category ?? "Category unavailable")</p></div>
                                    </div>
                                    <p class="mt-3 text-xs text-muted-foreground">Welcome: @arrival.WelcomeOutcome · native shoutout: @arrival.ShoutoutOutcome · @arrival.OccurredAt.ToLocalTime().ToString("g")</p>
                                }
                                else
                                {
                                    <p class="text-sm text-muted-foreground">No incoming raid has been recorded yet.</p>
                                }
                            </TaskPanel>
                            <TaskPanel Title="Send a shoutout" Description="Enter the Twitch name of another channel that is live with viewers.">
                                <div class="studio-grid" data-shoutout-send>
                                    <div class="studio-span-8">
                                        <Field Id="shoutout-target" Label="Target channel" @bind-Value="_shoutoutTarget" Placeholder="channel login" />
                                    </div>
                                    <div class="studio-span-4 content-end">
                                        <button class="btn-primary w-full" type="button" @onclick="SendShoutoutAsync">Send shoutout</button>
                                    </div>
                                    <div class="studio-span-12"><p class="form-help">@CooldownText(dashboard.ShoutoutContext, _shoutoutTarget)</p></div>
                                </div>
                            </TaskPanel>
                            @if (!dashboard.RaidManagementAuthorized)
                            {
                                <div class="card p-4 text-sm"><strong>Raid confirmation needs Twitch permission.</strong><p class="mt-1 text-xs text-muted-foreground">The channel owner can reconnect with raid management access. Other native Twitch tools keep their existing permission boundary.</p><a class="btn-secondary mt-3 inline-flex" href="/oauth/broadcaster/start?raid=true">Reconnect Twitch integration</a></div>
                            }
                        </div>
                    </div>

                    <TaskPanel Title="Relationship history" Description="Recent incoming and outgoing raids, deduplicated, with welcome and native shoutout context.">
                        @if (dashboard.History.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground">No raid history has been recorded yet.</p>
                        }
                        else
                        {
                            <div class="raid-history" data-raid-history>
                                @foreach (var item in dashboard.History)
                                {
                                    <article class="raid-history__card" @key="item">
                                        <span class="raid-history__direction">@item.Direction</span>
                                        <h3 class="raid-history__channel">@@@item.Login</h3>
                                        <p class="raid-history__meta">@(item.Category ?? "Category unavailable") · @item.ViewerCount viewers</p>
                                        <strong class="raid-history__outcome">Welcome: @item.WelcomeOutcome</strong>
                                        <p class="raid-history__meta">Shoutout: @item.ShoutoutOutcome · @item.OccurredAt.ToLocalTime().ToString("MMM d, HH:mm")</p>
                                        <p class="raid-history__meta">Stream @(item.StreamId ?? "identity unavailable")</p>
                                        @if (!IsApproved(item.Login))
                                        {
                                            <button class="btn-secondary raid-history__approve"
                                                    type="button"
                                                    disabled="@(_approvingLogin == item.Login)"
                                                    @onclick="() => ApproveAsync(item)">Approve channel</button>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </TaskPanel>

                    <TaskPanel Title="Automatic shoutout outcomes" Description="What happened to the automatic shoutout for each recent incoming raid.">
                        <AutomaticShoutoutOutcomeList Outcomes="dashboard.AutomaticShoutoutOutcomes" />
                    </TaskPanel>

                    <TaskPanel Title="Recent shoutouts" Description="Shoutouts this channel sent and received on Twitch.">
                        @if (dashboard.ShoutoutContext.History.Count == 0)
                        {
                            <p class="text-sm text-muted-foreground">No shoutouts recorded yet.</p>
                        }
                        else
                        {
                            <div class="grid gap-2" data-shoutout-history>
                                @foreach (var item in dashboard.ShoutoutContext.History)
                                {
                                    <NativeOperationRow @key="item"
                                                        Title="@($"{item.Direction} · @{item.TargetLogin}")"
                                                        When="@item.OccurredAtUtc.ToLocalTime().ToString("MMM d, HH:mm")">
                                        @item.ViewerCount viewers
                                    </NativeOperationRow>
                                }
                            </div>
                        }
                    </TaskPanel>
                }
                else
                {
                    <div class="raid-settings" data-sticky-save-scope data-raid-settings>
                        <section class="card raid-section">
                            <header class="raid-section__header">
                                <span class="raid-section__step" aria-hidden="true">1</span>
                                <div class="min-w-0">
                                    <h2 class="raid-section__heading">Welcome flow</h2>
                                    <p class="raid-section__description">Choose what happens when another channel raids you.</p>
                                </div>
                            </header>
                            <div class="raid-section__body">
                                <div class="raid-split">
                                    <div class="raid-toggle">
                                        <div class="min-w-0">
                                            <strong id="raid-welcome-enabled-label" class="raid-toggle__title">Send a welcome</strong>
                                            <span id="raid-welcome-enabled-hint" class="raid-toggle__hint">Posts one chat message for a new arrival.</span>
                                        </div>
                                        <button id="raid-welcome-enabled"
                                                class="studio-toggle"
                                                type="button"
                                                role="switch"
                                                aria-checked="@(_draft.WelcomeEnabled ? "true" : "false")"
                                                aria-labelledby="raid-welcome-enabled-label"
                                                aria-describedby="raid-welcome-enabled-hint"
                                                @onclick="() => _draft.WelcomeEnabled = !_draft.WelcomeEnabled"></button>
                                    </div>
                                </div>
                                <div class="raid-split">
                                    <div class="raid-field raid-field--wide">
                                        <div class="field">
                                            <label class="field__label" for="raid-welcome-message">Welcome message</label>
                                            <textarea id="raid-welcome-message"
                                                      class="field__input min-h-24 resize-y"
                                                      aria-describedby="raid-welcome-message-hint"
                                                      @bind="_draft.WelcomeMessage"
                                                      @bind:event="oninput"></textarea>
                                        </div>
                                        <p id="raid-welcome-message-hint" class="form-help">Tokens: {display_name}, {twitch_handle}, {viewer_count}</p>
                                    </div>
                                    <div class="raid-field-pair raid-field--wide">
                                        <div class="field">
                                            <label class="field__label" for="raid-dedupe">Repeat window (minutes)</label>
                                            <input id="raid-dedupe" class="field__input" type="number" min="1" max="1440" @bind="_draft.DeduplicationWindowMinutes" />
                                        </div>
                                        <div class="field">
                                            <label class="field__label" for="raid-gap">Outgoing raid gap (hours)</label>
                                            <input id="raid-gap" class="field__input" type="number" min="0" max="8760" @bind="_draft.RelationshipCooldownHours" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="card raid-section">
                            <header class="raid-section__header">
                                <span class="raid-section__step" aria-hidden="true">2</span>
                                <div class="min-w-0">
                                    <h2 class="raid-section__heading">Automatic raid shoutouts</h2>
                                    <p class="raid-section__description">Decide how a qualifying incoming raid is shouted out.</p>
                                </div>
                            </header>
                            <div class="raid-section__body">
                                <AutomaticShoutoutSection Value="_draft.AutomaticShoutout"
                                                          ValueChanged="@(value => _draft.AutomaticShoutout = value)"
                                                          Errors="_shoutoutErrors"
                                                          ErrorCleared="ClearShoutoutError" />
                            </div>
                        </section>

                        <section class="card raid-section">
                            <header class="raid-section__header">
                                <span class="raid-section__step" aria-hidden="true">3</span>
                                <div class="min-w-0">
                                    <h2 class="raid-section__heading">Shortlist rules</h2>
                                    <p class="raid-section__description">Keep the next-channel list focused.</p>
                                </div>
                            </header>
                            <div class="raid-section__body">
                                <div class="raid-split">
                                    <div class="raid-field raid-field--wide">
                                        <div class="field">
                                            <label class="field__label" for="raid-language">Stream language</label>
                                            <input id="raid-language"
                                                   class="field__input"
                                                   aria-describedby="raid-language-hint"
                                                   @bind="_draft.Language"
                                                   @bind:event="oninput" />
                                        </div>
                                        <p id="raid-language-hint" class="form-help">One language code. Leave blank for any language.</p>
                                    </div>
                                    <div class="raid-field">
                                        <span class="label" id="raid-categories-label">Eligible categories</span>
                                        <div class="raid-chips" role="group" aria-labelledby="raid-categories-label">
                                            @for (var index = 0; index < _draft.Categories.Count; index++)
                                            {
                                                var categoryIndex = index;
                                                <StudioChip @key="categoryIndex"
                                                            Label="@_draft.Categories[categoryIndex]"
                                                            RemoveLabel="@($"Remove category {_draft.Categories[categoryIndex]}")"
                                                            RemoveAction="remove-raid-category"
                                                            Remove="@(() => RemoveCategory(categoryIndex))" />
                                            }
                                            <input id="raid-categories"
                                                   class="studio-chip-input w-32 min-w-32 rounded-full border border-dashed border-[var(--app-control-border)] px-3 py-[0.28rem] text-[0.82rem] font-semibold text-[var(--app-text-strong)] outline-none placeholder:text-[var(--app-text-muted)] focus:border-solid focus:border-[var(--app-focus-border)] focus:shadow-[var(--app-focus-shadow)]"
                                                   placeholder="+ category"
                                                   aria-label="Add an eligible category"
                                                   aria-describedby="raid-categories-hint"
                                                   value="@_categoryDraft"
                                                   @oninput="args => _categoryDraft = args.Value?.ToString() ?? string.Empty"
                                                   @onkeydown="AddCategoryOnEnter"
                                                   @onblur="AddCategory" />
                                        </div>
                                        <p id="raid-categories-hint" class="form-help">Leave empty to allow any category.</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="card raid-section">
                            <header class="raid-section__header">
                                <span class="raid-section__step" aria-hidden="true">4</span>
                                <div class="min-w-0">
                                    <h2 class="raid-section__heading">Approved channels</h2>
                                    <p class="raid-section__description">Only approved channels can appear in your shortlist. Approval is an allowlist you control, and Twitch supplies no safety or reputation signal for it. An optional clip ID is shown only when Twitch confirms it belongs to that channel and is at most 30 days old.</p>
                                </div>
                                <button class="btn-secondary raid-section__action" type="button" @onclick="AddApprovedChannel">Add channel</button>
                            </header>
                            <div class="raid-section__body">
                                @if (_draft.ApprovedChannels.Count == 0)
                                {
                                    <p class="text-sm text-muted-foreground">No channel is approved yet. Add one to build your shortlist.</p>
                                }
                                else
                                {
                                    <div class="raid-channels">
                                        @for (var index = 0; index < _draft.ApprovedChannels.Count; index++)
                                        {
                                            var channel = _draft.ApprovedChannels[index];
                                            var position = index;
                                            <div class="raid-channel" @key="channel">
                                                <div class="raid-field">
                                                    <div class="field">
                                                        <label class="field__label" for="@($"raid-channel-login-{position}")">Twitch login</label>
                                                        <input id="@($"raid-channel-login-{position}")"
                                                               class="field__input"
                                                               @bind="channel.Login"
                                                               @bind:event="oninput" />
                                                    </div>
                                                </div>
                                                <div class="raid-field">
                                                    <div class="field">
                                                        <label class="field__label" for="@($"raid-channel-name-{position}")">Display name</label>
                                                        <input id="@($"raid-channel-name-{position}")"
                                                               class="field__input"
                                                               @bind="channel.DisplayName"
                                                               @bind:event="oninput" />
                                                    </div>
                                                </div>
                                                <div class="raid-field">
                                                    <div class="field">
                                                        <label class="field__label" for="@($"raid-channel-clip-{position}")">Approved clip ID (optional)</label>
                                                        <input id="@($"raid-channel-clip-{position}")"
                                                               class="field__input"
                                                               @bind="channel.ApprovedClipId"
                                                               @bind:event="oninput" />
                                                    </div>
                                                </div>
                                                <button class="btn-secondary raid-channel__remove" type="button" @onclick="() => RemoveApprovedChannel(channel)">Remove</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </section>

                        <StickySaveRegion Scope="StickySaveScope.Editor" Feedback="_saveFeedback">
                            <button class="btn-primary" type="button" disabled="@_saving" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save settings")</button>
                        </StickySaveRegion>
                    </div>
                }
            </div>
        }
    </ChildContent>
</DashboardPage>

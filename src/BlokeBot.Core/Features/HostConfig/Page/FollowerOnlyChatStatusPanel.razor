@using System.Diagnostics
@inherits BackgroundLoadComponent<FollowerOnlyChatReadiness, FollowerOnlyChatStatusPanelLoadFailure, FollowerOnlyChatStatusPanelLoadIdentity>
@inject FollowerOnlyChatReadinessService _followerOnlyChat

<div class="surface-muted rounded-lg px-3 py-2.5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Follower-only chat</p>
        <span class="@_badgeClass">
            <span class="@_dotClass"></span>
            <span class="status-pill__label">@_badgeText</span>
        </span>
    </div>
    <div class="mt-2 text-xs font-medium leading-5 text-slate-500">
        @if (IsBackgroundLoading)
        {
            <p>Checking follower-only chat.</p>
        }
        else if (BackgroundError is not null || _presentation is null)
        {
            <p>Status unavailable.</p>
            <button class="control-surface mt-2 inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="RecheckAsync">Recheck</button>
        }
        else
        {
            @switch (_presentation.State)
            {
                case FollowerOnlyChatSetupState.NotRequired:
                    <p>Follower-only chat is off.</p>
                    break;
                case FollowerOnlyChatSetupState.Exempt:
                    <p>@BotAccountName is exempt.</p>
                    break;
                case FollowerOnlyChatSetupState.Eligible:
                    <p>@BotAccountName can chat.</p>
                    break;
                case FollowerOnlyChatSetupState.Waiting:
                    <p>@BotAccountName can chat after @_presentation.EligibleAtUtc!.Value.ToLocalTime().ToString("g").</p>
                    @ManualFollowActions
                    break;
                case FollowerOnlyChatSetupState.NotFollowing:
                    <p>@BotAccountName is not following.</p>
                    @ManualFollowActions
                    break;
                case FollowerOnlyChatSetupState.ReconnectRequired:
                    <p>Reconnect @BotAccountName to check this status.</p>
                    <AuthPopupButton Class="auth-action mt-2 inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                     Url="@ReconnectUrl"
                                     PopupName="blokebot-follower-only-oauth"
                                     OpeningText="Opening..."
                                     OnClosed="RecheckAsync">
                        Reconnect bot
                    </AuthPopupButton>
                    break;
                case FollowerOnlyChatSetupState.UnableToVerify:
                    <p>Status unavailable.</p>
                    <button class="control-surface mt-2 inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="RecheckAsync">Recheck</button>
                    break;
                default:
                    throw new UnreachableException();
            }
        }
    </div>
</div>

@code {
    private RenderFragment ManualFollowActions => @<div class="mt-2 flex flex-wrap items-center gap-2">
        <a class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition"
           href="@_channelUrl"
           target="_blank"
           rel="noreferrer">Open Twitch channel</a>
        <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="RecheckAsync">Recheck</button>
        <span class="basis-full">Sign in to Twitch as @BotAccountName and follow this channel.</span>
    </div>;
}

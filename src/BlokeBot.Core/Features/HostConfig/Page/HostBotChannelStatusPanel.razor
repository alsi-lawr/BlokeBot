@inherits BackgroundLoadComponent<HostBotChannelStatus, HostBotChannelStatusLoadFailure, HostBotChannelStatusPanelLoadIdentity>
@inject HostBotStatusService _hostBotStatus

<div class="surface-muted rounded-lg px-3 py-2.5">
    <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Ready to use</p>
    </div>
    <div class="mt-3 space-y-3">
        <div>
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-semibold text-slate-600">Moderator access</p>
                <span class="@_moderatorStatusBadgeClass">
                    <span class="@_moderatorStatusDotClass"></span>
                    @_moderatorStatusText
                </span>
            </div>
            <p class="mt-1 text-xs font-medium text-slate-500">@_moderatorStatusMessage</p>
        </div>
        <div>
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-semibold text-slate-600">Follower giveaways</p>
                <span class="@_followerReadStatusBadgeClass">
                    <span class="@_followerReadStatusDotClass"></span>
                    @_followerReadStatusText
                </span>
            </div>
            <p class="mt-1 text-xs font-medium text-slate-500">@_followerReadStatusMessage</p>
        </div>
    </div>
</div>

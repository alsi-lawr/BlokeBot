@inject IJSRuntime _js
@implements IAsyncDisposable

<span id="@_rootId" hidden aria-hidden="true"></span>

@code {
    private readonly string _rootId = $"host-config-fragment-observer-{Guid.NewGuid():N}";
    private DotNetObjectReference<HostConfigFragmentObserver>? _reference;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public EventCallback<string> FragmentChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await _js.InvokeAsync<IJSObjectReference>(
                "import",
                "./Features/HostConfig/Page/HostConfigFragmentObserver.razor.js"
            );
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observe", _rootId, _reference);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }

    [JSInvokable]
    public Task NotifyFragmentChangedAsync(string location)
    {
        return FragmentChanged.InvokeAsync(location);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _rootId);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (TaskCanceledException) { }

            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }

        _reference?.Dispose();
    }
}

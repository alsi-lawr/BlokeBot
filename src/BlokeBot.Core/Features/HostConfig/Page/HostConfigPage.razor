@page "/host"
@using BlokeBot.Core.Auth.Sessions
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.AccessLists
@using BlokeBot.Core.Features.Admin.Authorization
@using BlokeBot.Core.Features.Admin.SiteAccess
@using BlokeBot.Core.Features.HostConfig.Access
@using BlokeBot.Core.Features.HostConfig.StartupMessage
@using BlokeBot.Core.Features.Commands
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Features.HostedChannels.Authorization
@using BlokeBot.Core.Features.HostedChannels.Runtime
@using BlokeBot.Core.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AuthenticatedPageComponent
@inject HostConfigService _hostConfig
@inject StartupMessageConfigurationService _startupMessages
@inject CommandsConfigurationService _commandsConfiguration
@inject ViewerCommandCatalogService _commandCatalogService
@inject HostFeatureService _features
@inject HostModAccessService _modAccess
@inject AccessListProfileResolver _accessListProfiles
@inject HostedChannelRuntimeControlService _runtime
@inject ChannelBotAuthorizationService _channelBotAuthorization
@inject HostBroadcasterAuthorizationService _hostBroadcasterAuthorization
@inject HostBotAccountAuthorizationService _hostBotAccounts
@inject EventBus<AppEventKind> _events
@inject NavigationManager _navigation
@inject TimeProvider _timeProvider
@inject ToastService _toasts
@inject BotSettings _botSettings

<PageTitle>BlokeBot | Channel Setup</PageTitle>
<HostConfigFragmentObserver FragmentChanged="OnNativeFragmentChangedAsync" />

<div class="mx-auto max-w-5xl space-y-6">
    <PageHeader Kicker="Channel setup"
                Title="Channel setup"
                Description="Connect the bot, choose who can help, and turn chat tools on or off." />

    @if (_blockedByMode)
    {
        <ApplicationCardCollection Owner="channel-setup-cards">
            <div class="card p-8 text-sm text-muted-foreground">Switch back to your own channel to change these settings.</div>
        </ApplicationCardCollection>
    }
    else if (_state is null)
    {
        <ApplicationCardCollection Owner="channel-setup-cards">
            <div class="card p-8 text-sm text-muted-foreground">Loading channel setup...</div>
        </ApplicationCardCollection>
    }
    else if (!_state.IsHostCreated)
    {
        <ApplicationCardCollection Owner="channel-setup-cards">
        <section class="card p-6">
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrWhiteSpace(_state.ProfileImageUrl))
                {
                    <img class="h-14 w-14 rounded-full border border-slate-200 object-cover" src="@_state.ProfileImageUrl" alt="" />
                }
                <div>
                    <h2 class="text-lg font-semibold text-slate-950">#@_state.DisplayName</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Create your channel setup before turning on bot tools.</p>
                </div>
            </div>
            @if (_state.CanCreateHost)
            {
                <a class="btn-primary mt-5" href="/host/create?returnUrl=/host" data-enhance-nav="false">Create channel setup</a>
            }
            else
            {
                <p class="mt-5 text-sm font-semibold text-slate-700">This Twitch account cannot create a BlokeBot channel setup yet.</p>
            }
        </section>
        </ApplicationCardCollection>
    }
    else if (_state.HostId is { } hostId)
    {
        <div class="settings-disclosure-stack">
        <div id="bot-status"
             class="host-config-fragment-target scroll-mt-24"
             role="region"
             aria-label="Bot status"
             tabindex="-1">
        <StudioStage Key="bot-status"
                     Number="1"
                     Title="@($"#{_state.DisplayName}")"
                     Summary="@_botStatusStageSummary"
                     Open="@_openStages.IsOpen(HostConfigStage.BotStatus)"
                     OpenChanged="open => _openStages.Set(HostConfigStage.BotStatus, open)"
                     FocusElementId="bot-status"
                     FocusRequest="@_botStatusFragmentRequest">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Chat access</p>
                        <span class="@_authorizationBadgeClass">
                            <span class="@_authorizationDotClass"></span>
                            <span class="status-pill__label">@_authorizationText</span>
                        </span>
                    </div>
                    @if (_state.IsChannelBotAuthorized && _state.RuntimeStatus?.ChannelBotAuthorizationScopesCurrent == true)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">The channel has approved BlokeBot for chat.</p>
                        @if (PageContext.Session.CanAuthorizeSelectedHost)
                        {
                            <div class="mt-2 flex flex-wrap gap-2">
                                <AuthPopupButton Class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                                 Url="/oauth/channel-bot/start"
                                                 PopupName="blokebot-channel-oauth"
                                                 OpeningText="Opening..."
                                                 OnClosed="LoadAsync">
                                    Reconnect bot
                                </AuthPopupButton>
                                <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="() => ClearChannelAuthorizationAsync(hostId)">Disconnect</button>
                            </div>
                        }
                    }
                    else if (_state.IsChannelBotAuthorized)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">The bot needs a fresh Twitch connection for this channel.</p>
                        @if (PageContext.Session.CanAuthorizeSelectedHost)
                        {
                            <div class="mt-2 flex flex-wrap gap-2">
                                <AuthPopupButton Class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                                 Url="/oauth/channel-bot/start"
                                                 PopupName="blokebot-channel-oauth"
                                                 OpeningText="Opening..."
                                                 OnClosed="LoadAsync">
                                    Reconnect bot
                                </AuthPopupButton>
                                <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="() => ClearChannelAuthorizationAsync(hostId)">Disconnect</button>
                            </div>
                        }
                        else
                        {
                            <p class="mt-2 text-xs font-medium text-slate-500">The channel owner must reconnect this Twitch account.</p>
                        }
                    }
                    else
                    {
                        @if (PageContext.Session.CanAuthorizeSelectedHost)
                        {
                            <AuthPopupButton Class="auth-action mt-2 inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                             Url="/oauth/channel-bot/start"
                                             PopupName="blokebot-channel-oauth"
                                             OpeningText="Opening..."
                                             OnClosed="LoadAsync">
                                Connect channel
                            </AuthPopupButton>
                        }
                        else
                        {
                            <p class="mt-2 text-xs font-medium text-slate-500">The channel owner must connect this Twitch account.</p>
                        }
                    }
                </div>
                <div class="surface-muted rounded-lg px-3 py-2.5" data-twitch-integration>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Twitch integration</p>
                        <span class="@_operationsAuthorizationBadgeClass">
                            <span class="@_operationsAuthorizationDotClass"></span>
                            <span class="status-pill__label">@_operationsAuthorizationText</span>
                        </span>
                    </div>
                    @if (_state.TwitchOperationsAuthorization is TwitchOperationsAuthorizationState.Ready)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">Connected for this channel.</p>
                        @if (PageContext.Session.CanAuthorizeSelectedHost)
                        {
                            <div class="mt-2 flex flex-wrap gap-2">
                                <AuthPopupButton Class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                                 Url="/oauth/broadcaster/start"
                                                 PopupName="blokebot-broadcaster-oauth"
                                                 OpeningText="Opening..."
                                                 OnClosed="LoadAsync">
                                    Reconnect
                                </AuthPopupButton>
                                <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition"
                                        type="button"
                                        data-twitch-integration-disconnect
                                        @onclick="() => DisconnectTwitchIntegrationAsync(hostId)">Disconnect</button>
                            </div>
                        }
                        else
                        {
                            <p class="mt-2 text-xs font-medium text-slate-500">Only the channel owner can change this connection.</p>
                        }
                    }
                    else if (_state.TwitchOperationsAuthorization is TwitchOperationsAuthorizationState.Stale)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">The channel owner must reconnect this integration.</p>
                        @if (PageContext.Session.CanAuthorizeSelectedHost)
                        {
                            <div class="mt-2 flex flex-wrap gap-2">
                                <AuthPopupButton Class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                                 Url="/oauth/broadcaster/start"
                                                 PopupName="blokebot-broadcaster-oauth"
                                                 OpeningText="Opening..."
                                                 OnClosed="LoadAsync">
                                    Reconnect
                                </AuthPopupButton>
                                <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition"
                                        type="button"
                                        data-twitch-integration-disconnect
                                        @onclick="() => DisconnectTwitchIntegrationAsync(hostId)">Disconnect</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">The channel owner must connect this integration.</p>
                        @if (PageContext.Session.CanAuthorizeSelectedHost)
                        {
                            <AuthPopupButton Class="auth-action mt-2 inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                             Url="/oauth/broadcaster/start"
                                             PopupName="blokebot-broadcaster-oauth"
                                             OpeningText="Opening..."
                                             OnClosed="LoadAsync">
                                Connect
                            </AuthPopupButton>
                        }
                    }
                </div>
                <HostBotChannelStatusPanel HostLogin="@_state.Login" ReloadKey="@_botAccountStatusReloadKey" />
                <FollowerOnlyChatStatusPanel HostLogin="@_state.Login"
                                             BotAccountName="@_activeBotAccountName"
                                             ReconnectUrl="@_activeBotReconnectUrl"
                                             ReloadKey="@_botAccountStatusReloadKey" />
            </div>
            <div class="runtime-control-card surface-muted mt-3 rounded-lg px-3 py-2.5">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bot status</p>
                    <span class="@_runtimeBadgeClass">
                        <span class="@_runtimeDotClass"></span>
                        <span class="status-pill__label">@_runtimeText</span>
                    </span>
                </div>
                <div class="runtime-control-actions mt-3">
                    <span class="block min-w-0" title="@_startRuntimeTooltip">
                        <button class="primary-control grid w-full grid-cols-[2.25rem_minmax(0,1fr)] items-center gap-3 rounded-lg p-3 text-left transition disabled:cursor-not-allowed disabled:opacity-50"
                                type="button"
                                disabled="@(!_canStart)"
                                aria-label="Start bot"
                                @onclick="() => StartAsync(hostId)">
                            <span class="inline-flex h-9 w-9 items-center justify-center">
                                <svg class="h-6 w-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M8 5.5v13l10-6.5Z" />
                                </svg>
                            </span>
                            <span class="min-w-0">
                                <span class="block text-sm font-bold">Start bot</span>
                                <span class="mt-1 block text-xs font-medium opacity-75">Let the bot join chat</span>
                            </span>
                        </button>
                    </span>
                    <span class="block min-w-0" title="@_stopRuntimeTooltip">
                        <button class="control-surface grid w-full grid-cols-[2.25rem_minmax(0,1fr)] items-center gap-3 rounded-lg p-3 text-left transition disabled:cursor-not-allowed disabled:opacity-50"
                                type="button"
                                disabled="@(!_canStop)"
                                aria-label="Stop bot"
                                @onclick="() => StopAsync(hostId)">
                            <span class="inline-flex h-9 w-9 items-center justify-center text-red-700">
                                <svg class="h-6 w-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="7" y="7" width="10" height="10" rx="1.5" />
                                </svg>
                            </span>
                            <span class="min-w-0">
                                <span class="block text-sm font-bold text-red-700">Stop bot</span>
                                <span class="mt-1 block text-xs font-medium text-slate-500">Take the bot out of chat</span>
                            </span>
                        </button>
                    </span>
                </div>
            </div>
        </StudioStage>
        </div>

        <StudioStage Key="startup-message"
                     Number="2"
                     Title="Startup chat message"
                     Summary="@_startupMessageStageSummary"
                     Open="@_openStages.IsOpen(HostConfigStage.StartupMessage)"
                     OpenChanged="open => _openStages.Set(HostConfigStage.StartupMessage, open)">
            <div class="studio-grid">
                <div class="studio-span-12 flex flex-wrap items-center gap-3">
                    <button type="button"
                            id="startup-message-enabled"
                            class="studio-toggle"
                            role="switch"
                            aria-checked="@(_startupMessageEnabled ? "true" : "false")"
                            aria-label="Send a startup message"
                            @onclick="ToggleStartupMessageEnabled"></button>
                    <span class="text-sm font-semibold text-[var(--app-text-strong)]">Send a message when the bot joins or reconnects</span>
                </div>
                <div class="studio-span-12">
                    <div class="field">
                        <label class="field__label" for="startup-chat-message">Message</label>
                        <textarea id="startup-chat-message"
                                  class="field__input mt-2 min-h-24 w-full"
                                  maxlength="@(_botSettings.MaxChatMessageLength > 0 ? _botSettings.MaxChatMessageLength : null)"
                                  disabled="@(!_startupMessageEnabled)"
                                  value="@_startupMessageText"
                                  @oninput="SetStartupMessageText"></textarea>
                    </div>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        This applies on the next fresh join or Twitch reconnect. Saving does not restart the bot.
                    </p>
                </div>
                <div class="studio-span-12">
                    <SaveChangesButton AccessibleName="Save startup message"
                                       Saving="@_startupMessageSaving"
                                       OnSave="() => SaveStartupMessageAsync(hostId)" />
                </div>
            </div>
        </StudioStage>

        <StudioStage Key="commands"
                     Number="3"
                     Title="Commands"
                     Summary="@_commandsStageSummary"
                     Open="@_openStages.IsOpen(HostConfigStage.Commands)"
                     OpenChanged="open => _openStages.Set(HostConfigStage.Commands, open)">
            <div class="studio-grid" data-simulation-command-settings>
                <div class="studio-span-8">
                    <div class="field">
                        <label class="field__label" for="commands-aliases">Command words</label>
                        <input id="commands-aliases"
                               class="field__input mt-2 w-full"
                               value="@_commandsAliases"
                               @oninput="args => { _commandsAliases = args.Value?.ToString() ?? string.Empty; MarkCommandsDirty(); }"
                               placeholder="commands"
                               autocomplete="off" />
                    </div>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        Separate extra command words with commas. Leave this blank to disable the catalog.
                    </p>
                </div>
                <div class="studio-span-4 content-end">
                    <SaveChangesButton AccessibleName="Save commands"
                                       Class="w-full"
                                       Saving="@_commandsSaving"
                                       OnSave="() => SaveCommandsAsync(hostId)" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_state.Commands.ConflictAlias))
                {
                    <div class="studio-span-12 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm font-medium text-amber-700"
                         role="alert"
                         data-command-conflict>
                        !@_state.Commands.ConflictAlias is already in use, so the default Commands command is disabled. Choose another word and save.
                    </div>
                }
                <div class="studio-span-12">
                    <StudioFold Key="command-inventory"
                                Label="Viewer command inventory"
                                Open="@_commandInventoryOpen"
                                OpenChanged="SetCommandInventoryOpenAsync">
                        <div class="space-y-3" aria-live="polite" data-command-catalog>
                            @if (_commandCatalogLoading)
                            {
                                <p class="text-sm text-muted-foreground">Loading command inventory...</p>
                            }
                            else if (_commandCatalog is null)
                            {
                                <p class="text-sm text-muted-foreground">Open this list to check configured commands and current availability.</p>
                            }
                            else
                            {
                                @if (_commandCatalog.Conflicts.Count > 0)
                                {
                                    <div class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-700"
                                         role="alert"
                                         data-command-catalog-conflicts>
                                        @foreach (var conflict in _commandCatalog.Conflicts)
                                        {
                                            <p>@conflict</p>
                                        }
                                    </div>
                                }
                                @if (_commandCatalog.UnavailableFeatures.Count > 0)
                                {
                                    <div class="rounded-lg border border-slate-300 bg-slate-50 p-3 text-sm text-slate-700"
                                         data-command-catalog-unavailable>
                                        @foreach (var unavailable in _commandCatalog.UnavailableFeatures)
                                        {
                                            <p>@unavailable</p>
                                        }
                                    </div>
                                }
                                @if (_commandCatalog.Entries.Count == 0)
                                {
                                    <p class="text-sm text-muted-foreground" data-command-catalog-empty>
                                        No viewer commands are configured or currently available.
                                    </p>
                                }
                                else
                                {
                                    <ul class="flex flex-wrap gap-2" aria-label="Viewer command inventory">
                                        @foreach (var entry in _commandCatalog.Entries)
                                        {
                                            <li class="control-surface rounded-lg px-3 py-2 text-sm font-semibold"
                                                data-command-source="@entry.Source.ToString().ToLowerInvariant()">
                                                <span class="block">@entry.Name</span>
                                                @if (entry.AccessSummary is not null)
                                                {
                                                    <span class="block text-xs font-medium text-muted-foreground"
                                                          data-command-access-summary>@entry.AccessSummary</span>
                                                }
                                                @if (CommandAvailabilitySummary(entry.Availability) is { } availability)
                                                {
                                                    <span class="block text-xs font-bold text-amber-700"
                                                          data-command-availability>@availability</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    </StudioFold>
                </div>
            </div>
        </StudioStage>

        <div id="custom-bot" class="scroll-mt-24">
        <StudioStage Key="custom-bot"
                     Number="4"
                     Title="Your own bot account"
                     Summary="@_botAccountStageSummary"
                     Open="@_openStages.IsOpen(HostConfigStage.BotAccount)"
                     OpenChanged="open => _openStages.Set(HostConfigStage.BotAccount, open)">
            <div class="studio-grid">
                <div class="studio-span-12 flex flex-wrap items-center gap-3">
                    <button type="button"
                            id="custom-bot-enabled"
                            class="studio-toggle"
                            role="switch"
                            aria-checked="@(_state.BotOverride.Enabled ? "true" : "false")"
                            aria-label="Use custom bot"
                            @onclick="() => SetBotOverrideEnabledAsync(hostId, !_state.BotOverride.Enabled)"></button>
                    <span class="text-sm font-semibold text-[var(--app-text-strong)]">Use a Twitch account you control as the bot for this channel</span>
                </div>
                <div class="studio-span-12">
                    <BotAccountAuthorizationSection Status="@_state.BotOverride.Status"
                                                    AuthorizeButtonText="Connect custom bot"
                                                    AuthorizationStartUrl="/oauth/host-bot/start"
                                                    Disabled="@(!_state.BotOverride.Enabled)"
                                                    DisabledMessage="Turn this on before connecting your own bot account."
                                                    ConfiguredAccountFallbackText="custom bot account"
                                                    Clear="() => ClearBotOverrideAuthorizationAsync(hostId)"
                                                    Refresh="LoadAsync" />
                </div>
                <div class="studio-span-12">
                    <div class="surface-muted rounded-lg px-3 py-2.5">
                        <div class="@(!_state.BotOverride.Enabled ? "opacity-60" : null)">
                            <div class="flex flex-wrap items-center gap-3">
                                <button type="button"
                                        id="whisper-responses-enabled"
                                        class="studio-toggle"
                                        role="switch"
                                        aria-checked="@(_state.BotOverride.WhisperResponsesEnabled ? "true" : "false")"
                                        aria-label="Reply with whispers from the custom bot"
                                        disabled="@(!_state.BotOverride.Enabled)"
                                        @onclick="() => SetWhisperResponsesEnabledAsync(hostId, !_state.BotOverride.WhisperResponsesEnabled)"></button>
                                <span class="text-sm font-semibold text-[var(--app-text-strong)]">Reply with whispers from the custom bot</span>
                            </div>
                            <p class="mt-2 text-xs font-medium text-slate-500">
                                @(_state.BotOverride.Enabled
                                    ? "Reconnect the custom bot if Twitch asks for more access."
                                    : "Turn on custom bot before enabling whisper responses.")
                            </p>
                        </div>
                        <div class="mt-4 border-t border-slate-200 pt-4">
                            <div class="flex items-center justify-between gap-3">
                                <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">New people whispered today</p>
                                <span class="@_whisperQuotaBadgeClass whitespace-nowrap">
                                    <span class="@_whisperQuotaDotClass"></span>
                                    @_whisperQuotaText
                                </span>
                            </div>
                            <p class="mt-2 text-xs font-medium text-slate-500">
                                @(_state.BotOverride.WhisperQuota.Exhausted
                                    ? "Twitch has paused whispers to new people for today."
                                    : $"The bot can whisper {_state.BotOverride.WhisperQuota.Remaining} more new people today.")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </StudioStage>
        </div>

        <div id="moderator-help"
             class="host-config-fragment-target scroll-mt-24"
             role="region"
             aria-label="Moderator help"
             tabindex="-1">
        <StudioStage Key="moderator-help"
                     Number="5"
                     Title="Moderator help"
                     Summary="@_moderatorHelpStageSummary"
                     Open="@_openStages.IsOpen(HostConfigStage.ModeratorHelp)"
                     OpenChanged="open => _openStages.Set(HostConfigStage.ModeratorHelp, open)"
                     FocusElementId="moderator-help"
                     FocusRequest="@_moderatorHelpFragmentRequest">
            <div class="studio-grid">
                <div class="studio-span-12 flex flex-wrap items-center gap-3">
                    <button type="button"
                            id="moderator-help-enabled"
                            class="studio-toggle"
                            role="switch"
                            aria-checked="@(_state.ModAccess.ModsEnabled ? "true" : "false")"
                            aria-label="Let moderators help"
                            @onclick="() => SetModsEnabledAsync(hostId, !_state.ModAccess.ModsEnabled)"></button>
                    <span class="text-sm font-semibold text-[var(--app-text-strong)]">Let moderators help with this channel</span>
                    <span class="text-xs text-muted-foreground">When this is off, your saved allow and block lists stay here, but mods cannot use them.</span>
                </div>
                <div class="studio-span-12">
                    <StudioSegmentedPill TValue="bool"
                                         AriaLabel="Who can help with this channel"
                                         Options="@_accessModeOptions"
                                         Value="@_state.ModAccess.AllowModsByDefault"
                                         ValueChanged="value => SetAllowModsByDefaultAsync(hostId, value)" />
                    <p class="mt-2 text-xs text-muted-foreground">
                        @(_state.ModAccess.AllowModsByDefault ? "All channel mods can help unless they are blocked." : "Only mods on the allowed list can help.")
                    </p>
                </div>
                <div class="studio-span-6">
                    <AccessList Title="Allowed mods"
                                Entries="_whitelistEntries"
                                Placeholder="mod username"
                                EmptyText="No mods added."
                                DisabledText="@(_state.ModAccess.ModsEnabled ? "Not used while “All mods” is selected. Kept for when you switch." : "Not used while moderator help is off. Kept for when you switch.")"
                                NewLogin="@_newWhitelistLogin"
                                NewLoginChanged="value => _newWhitelistLogin = value"
                                Add="() => AddAccessAsync(hostId, AccessListEntryKind.Whitelist)"
                                Remove="login => RemoveAccessAsync(hostId, AccessListEntryKind.Whitelist, login)"
                                Disabled="@(!_state.ModAccess.ModsEnabled || _state.ModAccess.AllowModsByDefault)" />
                </div>
                <div class="studio-span-6">
                    <AccessList Title="Blocked mods"
                                Entries="_blacklistEntries"
                                Placeholder="mod username"
                                EmptyText="No mods added."
                                DisabledText="@(_state.ModAccess.ModsEnabled ? "Not used while “Allowed list only” is selected. Kept for when you switch." : "Not used while moderator help is off. Kept for when you switch.")"
                                NewLogin="@_newBlacklistLogin"
                                NewLoginChanged="value => _newBlacklistLogin = value"
                                Add="() => AddAccessAsync(hostId, AccessListEntryKind.Blacklist)"
                                Remove="login => RemoveAccessAsync(hostId, AccessListEntryKind.Blacklist, login)"
                                Disabled="@(!_state.ModAccess.ModsEnabled || !_state.ModAccess.AllowModsByDefault)" />
                </div>
            </div>
        </StudioStage>
        </div>

        <div id="chat-tools"
             class="host-config-fragment-target scroll-mt-24"
             role="region"
             aria-label="Chat tools"
             tabindex="-1">
        <StudioStage Key="chat-tools"
                     Number="6"
                     Title="Chat tools"
                     Summary="@_chatToolsStageSummary"
                     Open="@_openStages.IsOpen(HostConfigStage.ChatTools)"
                     OpenChanged="open => _openStages.Set(HostConfigStage.ChatTools, open)"
                     FocusElementId="chat-tools"
                     FocusRequest="@_chatToolsFragmentRequest">
            <div class="application-card-collection sm:grid-cols-2 xl:grid-cols-3" data-card-owner="channel-setup-feature-cards">
                @foreach (var feature in _state.Features)
                {
                    <button class="@FeatureCardClass(feature)"
                            type="button"
                            aria-pressed="@feature.Enabled"
                            @onclick="() => SetFeatureEnabledAsync(hostId, feature.Feature, !feature.Enabled)">
                        <span class="flex items-center gap-2.5">
                            <span class="@FeatureIconClass(feature)">
                                @FeatureIcon(feature.Feature)
                            </span>
                            <span class="min-w-0 flex-1 truncate text-sm font-bold text-[var(--app-text-strong)]">@feature.Name</span>
                            <span class="@FeatureBadgeClass(feature)">
                                <span class="@FeatureDotClass(feature)"></span>
                                @(feature.Enabled ? "on" : "off")
                            </span>
                        </span>
                        <span class="mt-1.5 block text-xs leading-5 text-muted-foreground">@feature.Description</span>
                    </button>
                }
            </div>
        </StudioStage>
        </div>
        </div>
    }
</div>

@page "/host"
@using BlokeBot.Core.Auth.Sessions
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.AccessLists
@using BlokeBot.Core.Features.Admin.Authorization
@using BlokeBot.Core.Features.Admin.SiteAccess
@using BlokeBot.Core.Features.HostConfig.Access
@using BlokeBot.Core.Features.HostConfig.StartupMessage
@using BlokeBot.Core.Features.Commands
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Features.HostedChannels.Authorization
@using BlokeBot.Core.Features.HostedChannels.Runtime
@using BlokeBot.Core.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AuthenticatedPageComponent
@inject HostConfigService _hostConfig
@inject StartupMessageConfigurationService _startupMessages
@inject CommandsConfigurationService _commandsConfiguration
@inject ViewerCommandCatalogService _commandCatalogService
@inject HostFeatureService _features
@inject HostModAccessService _modAccess
@inject AccessListProfileResolver _accessListProfiles
@inject HostedChannelRuntimeControlService _runtime
@inject ChannelBotAuthorizationService _channelBotAuthorization
@inject HostBroadcasterAuthorizationService _hostBroadcasterAuthorization
@inject HostBotAccountAuthorizationService _hostBotAccounts
@inject EventBus<AppEventKind> _events
@inject NavigationManager _navigation
@inject TimeProvider _timeProvider
@inject ToastService _toasts
@inject BotSettings _botSettings

<PageTitle>BlokeBot | Channel Setup</PageTitle>
<HostConfigFragmentObserver FragmentChanged="OnNativeFragmentChangedAsync" />

<div class="mx-auto max-w-5xl space-y-6">
    <PageHeader Kicker="Channel setup"
                Title="Channel setup"
                Description="Connect the bot, choose who can help, and turn chat tools on or off.">
        <a class="btn-secondary" href="/configuration-transfer?mode=export&amp;section=channelToolEnablement">Import or export</a>
    </PageHeader>

    @if (_blockedByMode)
    {
        <ApplicationCardCollection Owner="channel-setup-cards">
            <div class="card p-8 text-sm text-muted-foreground">Switch back to your own channel to change these settings.</div>
        </ApplicationCardCollection>
    }
    else if (_state is null)
    {
        <ApplicationCardCollection Owner="channel-setup-cards">
            <div class="card p-8 text-sm text-muted-foreground">Loading channel setup...</div>
        </ApplicationCardCollection>
    }
    else if (!_state.IsHostCreated)
    {
        <ApplicationCardCollection Owner="channel-setup-cards">
        <section class="card p-6">
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrWhiteSpace(_state.ProfileImageUrl))
                {
                    <img class="h-14 w-14 rounded-full border border-slate-200 object-cover" src="@_state.ProfileImageUrl" alt="" />
                }
                <div>
                    <h2 class="text-lg font-semibold text-slate-950">#@_state.DisplayName</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Create your channel setup before turning on bot tools.</p>
                </div>
            </div>
            @if (_state.CanCreateHost)
            {
                <a class="btn-primary mt-5" href="/host/create?returnUrl=/host" data-enhance-nav="false">Create channel setup</a>
            }
            else
            {
                <p class="mt-5 text-sm font-semibold text-slate-700">This Twitch account cannot create a BlokeBot channel setup yet.</p>
            }
        </section>
        </ApplicationCardCollection>
    }
    else if (_state.HostId is { } hostId)
    {
        <div class="settings-disclosure-stack">
        <HostConfigBotStatusStage State="_state"
                                  CanAuthorizeSelectedHost="@PageContext.Session.CanAuthorizeSelectedHost"
                                  Summary="@_botStatusStageSummary"
                                  Open="@_openStages.IsOpen(HostConfigStage.BotStatus)"
                                  OpenChanged="open => _openStages.Set(HostConfigStage.BotStatus, open)"
                                  FocusRequest="@_botStatusFragmentRequest"
                                  AuthorizationBadgeClass="@_authorizationBadgeClass"
                                  AuthorizationDotClass="@_authorizationDotClass"
                                  AuthorizationText="@_authorizationText"
                                  OperationsAuthorizationBadgeClass="@_operationsAuthorizationBadgeClass"
                                  OperationsAuthorizationDotClass="@_operationsAuthorizationDotClass"
                                  OperationsAuthorizationText="@_operationsAuthorizationText"
                                  BotAccountStatusReloadKey="@_botAccountStatusReloadKey"
                                  ActiveBotAccountName="@_activeBotAccountName"
                                  ActiveBotReconnectUrl="@_activeBotReconnectUrl"
                                  RuntimeBadgeClass="@_runtimeBadgeClass"
                                  RuntimeDotClass="@_runtimeDotClass"
                                  RuntimeText="@_runtimeText"
                                  StartRuntimeTooltip="@_startRuntimeTooltip"
                                  StopRuntimeTooltip="@_stopRuntimeTooltip"
                                  CanStart="@_canStart"
                                  CanStop="@_canStop"
                                  Reload="LoadAsync"
                                  ClearChannelAuthorization="() => ClearChannelAuthorizationAsync(hostId)"
                                  DisconnectTwitchIntegration="() => DisconnectTwitchIntegrationAsync(hostId)"
                                  Start="() => StartAsync(hostId)"
                                  Stop="() => StopAsync(hostId)" />

        <HostConfigMessagesAndCommandsStages State="_state"
                                                    StartupMessageSummary="@_startupMessageStageSummary"
                                                    StartupMessageOpen="@_openStages.IsOpen(HostConfigStage.StartupMessage)"
                                                    StartupMessageOpenChanged="open => _openStages.Set(HostConfigStage.StartupMessage, open)"
                                                    StartupMessageEnabled="@_startupMessageEnabled"
                                                    ToggleStartupMessageEnabled="ToggleStartupMessageEnabled"
                                                    MaxChatMessageLength="@_botSettings.MaxChatMessageLength"
                                                    StartupMessageText="@_startupMessageText"
                                                    StartupMessageTextChanged="SetStartupMessageText"
                                                    StartupMessageSaving="@_startupMessageSaving"
                                                    SaveStartupMessage="() => SaveStartupMessageAsync(hostId)"
                                                    CommandsSummary="@_commandsStageSummary"
                                                    CommandsOpen="@_openStages.IsOpen(HostConfigStage.Commands)"
                                                    CommandsOpenChanged="open => _openStages.Set(HostConfigStage.Commands, open)"
                                                    CommandsAliases="@_commandsAliases"
                                                    CommandsAliasesChanged="@(value => { _commandsAliases = value; MarkCommandsDirty(); })"
                                                    CommandsSaving="@_commandsSaving"
                                                    SaveCommands="() => SaveCommandsAsync(hostId)"
                                                    CommandInventoryOpen="@_commandInventoryOpen"
                                                    CommandInventoryOpenChanged="SetCommandInventoryOpenAsync"
                                                    CommandCatalogLoading="@_commandCatalogLoading"
                                                    CommandCatalog="_commandCatalog"
                                                    AvailabilitySummary="entry => CommandAvailabilitySummary(entry.Availability)" />

        <HostConfigAccessStages State="_state"
                                BotAccountSummary="@_botAccountStageSummary"
                                BotAccountOpen="@_openStages.IsOpen(HostConfigStage.BotAccount)"
                                BotAccountOpenChanged="open => _openStages.Set(HostConfigStage.BotAccount, open)"
                                ToggleBotOverride="() => SetBotOverrideEnabledAsync(hostId, !_state.BotOverride.Enabled)"
                                ClearBotOverrideAuthorization="() => ClearBotOverrideAuthorizationAsync(hostId)"
                                Reload="LoadAsync"
                                ToggleWhisperResponses="() => SetWhisperResponsesEnabledAsync(hostId, !_state.BotOverride.WhisperResponsesEnabled)"
                                WhisperQuotaBadgeClass="@_whisperQuotaBadgeClass"
                                WhisperQuotaDotClass="@_whisperQuotaDotClass"
                                WhisperQuotaText="@_whisperQuotaText"
                                ModeratorHelpSummary="@_moderatorHelpStageSummary"
                                ModeratorHelpOpen="@_openStages.IsOpen(HostConfigStage.ModeratorHelp)"
                                ModeratorHelpOpenChanged="open => _openStages.Set(HostConfigStage.ModeratorHelp, open)"
                                ModeratorHelpFocusRequest="@_moderatorHelpFragmentRequest"
                                ToggleModeratorHelp="() => SetModsEnabledAsync(hostId, !_state.ModAccess.ModsEnabled)"
                                AccessModeOptions="_accessModeOptions"
                                SetAllowModsByDefault="value => SetAllowModsByDefaultAsync(hostId, value)"
                                WhitelistEntries="_whitelistEntries"
                                BlacklistEntries="_blacklistEntries"
                                NewWhitelistLogin="@_newWhitelistLogin"
                                NewWhitelistLoginChanged="value => _newWhitelistLogin = value"
                                NewBlacklistLogin="@_newBlacklistLogin"
                                NewBlacklistLoginChanged="value => _newBlacklistLogin = value"
                                AddAccess="kind => AddAccessAsync(hostId, kind)"
                                RemoveAccess="request => RemoveAccessAsync(hostId, request.Kind, request.Login)" />

        <HostConfigChatToolsStage Features="_state.Features"
                                  Summary="@_chatToolsStageSummary"
                                  Open="@_openStages.IsOpen(HostConfigStage.ChatTools)"
                                  OpenChanged="open => _openStages.Set(HostConfigStage.ChatTools, open)"
                                  FocusRequest="@_chatToolsFragmentRequest"
                                  CardClass="FeatureCardClass"
                                  IconClass="FeatureIconClass"
                                  Icon="FeatureIcon"
                                  BadgeClass="FeatureBadgeClass"
                                  DotClass="FeatureDotClass"
                                  SetFeatureEnabled="request => SetFeatureEnabledAsync(hostId, request.Feature, request.Enabled)" />
        </div>
    }
</div>

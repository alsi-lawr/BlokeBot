<section class="automation-call-target" aria-label="Subflow target">
    <h3>Subflow</h3>
    @if (Loading)
    {
        <p role="status">Loading subflow…</p>
    }
    else if (Name is not null)
    {
        <div class="automation-call-target-heading"><strong>@Name</strong><button class="btn-secondary" type="button" @onclick="Change">Change</button></div>
    }
    else
    {
        <p>@(HasTarget ? "Subflow unavailable" : "Not selected")</p>
    }
    @if (InterfaceChanged)
    {
        <p class="automation-field-error" role="alert">Update this call's interface and inputs.</p>

    }
    @foreach (var change in Changes) { <div class="subflow-delta" tabindex="-1" data-automation-call-port="@($"{change.Direction}:{change.Id.Value}")">
    <h4>@change.Direction · @((change.Current ?? change.Previous!).Name) <code>@change.Id.Value</code></h4>
    <div class="subflow-delta-values"><div><small>This call</small>
        @if (change.Previous is { } previous) { <span>@previous.ValueType · @(previous.Nullability == AutomationPortNullability.Nullable ? "nullable" : "required") · @previous.Sensitivity</span>@if (change.MetadataChanged) { <span>@previous.Name</span><small>@previous.Description</small> } } else { <span>Not present</span> }
    </div><span aria-hidden="true">→</span><div><small>Published</small>
        @if (change.Current is { } current) { @if (change.Previous is null) { <span class="subflow-added">Added</span> }<span>@current.ValueType · @(current.Nullability == AutomationPortNullability.Nullable ? "nullable" : "required") · @current.Sensitivity</span>@if (change.MetadataChanged) { <span>@current.Name</span><small>@current.Description</small> } } else { <span class="subflow-removed">Removed</span> }
    </div></div><small>@(change.Compatible ? "Compatible metadata change" : "Interface change · callers may need repair")</small>
</div> }
    @if (InterfaceChanged) { <button class="btn-secondary" type="button" data-automation-update-call-interface @onclick="UpdateInterface">Update inputs and outputs</button> }
    @if (Message is not null)
    {
        <p class="automation-field-error" role="alert">@Message</p>
    }
    @if (Choosing)
    {
        <AutomationSubflowList Page="Page" Search="@Search" Offset="Offset" Loading="PageLoading" SearchLabel="Search subflow targets" ResultsLabel="Subflow targets" SearchChanged="SearchChanged" PageChanged="PageChanged" Selected="Selected" />
    }
</section>

@code {
    [Parameter] public System.Collections.Immutable.ImmutableArray<AutomationSubflowPortChange> Changes { get; set; } = [];
    [Parameter] public string? Name { get; set; }
    [Parameter] public bool HasTarget { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Choosing { get; set; }
    [Parameter] public bool InterfaceChanged { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter, EditorRequired] public required AutomationSubflowLibraryPage Page { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public int Offset { get; set; }
    [Parameter] public bool PageLoading { get; set; }
    [Parameter] public EventCallback Change { get; set; }
    [Parameter] public EventCallback UpdateInterface { get; set; }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<AutomationSubflowId> Selected { get; set; }
}

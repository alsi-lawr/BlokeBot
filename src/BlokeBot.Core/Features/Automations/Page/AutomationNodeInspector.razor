@using Microsoft.AspNetCore.Components.Web

@if (Node is null)
{
    <aside class="automation-inspector automation-inspector--empty" aria-label="Node inspector">
        <p class="automation-inspector-eyebrow">Inspector</p>
        <h2>Select a node</h2>
    </aside>
}
else
{
    <aside class="@(MobileOpen ? "automation-inspector automation-inspector--mobile-open" : "automation-inspector")"
           aria-label="Node inspector: @Node.EffectiveName"
           tabindex="-1"
           data-automation-inspector="@Node.Id.Value">
        <header class="automation-inspector-header">
            <div class="automation-inspector-identity">
                <AutomationNodeIcon DefinitionId="Node.Definition.Id" />
                <div>
                    <p class="automation-inspector-eyebrow">Selected @KindLabel(Node.Definition.Kind)</p>
                    <input id="automation-node-display-alias"
                           class="automation-inspector-title"
                           type="text"
                           aria-label="Node name"
                           maxlength="@AutomationFlowSchema.NodeDisplayAliasMaximumLength"
                           value="@Node.DisplayAlias"
                           placeholder="@Node.Definition.Display.Name"
                           title="Edit node name"
                           @oninput="args => SetDisplayAliasAsync(args.Value)" />
                    <span>@Node.Definition.Display.Name</span>
                    @if (Node.Definition.Id.Value != AutomationSubflowDefinitions.Invoke && !_isSubflowBoundary) { <small class="automation-inspector-purpose">@Node.Definition.Display.Description</small> }
                </div>
            </div>
            <button class="automation-icon-button" type="button" aria-label="Close Inspector" title="Close Inspector" @onclick="ClearSelection"><EditorIcon Name="close" /></button>
        </header>

        @if (Node.Definition.Id.Value == AutomationSubflowDefinitions.Invoke)
        {
            @CallSubflowSelector
        }
        else if (_isSubflowBoundary)
        {
            @BoundaryDeclarations
        }
        else
        {
            <section class="automation-inspector-port-summary" aria-labelledby="automation-node-ports-heading">
            <h3 id="automation-node-ports-heading">Ports</h3>
            @foreach (var input in Node.Definition.Inputs)
            {
                <span><b>@input.Name</b><em>Input · @AutomationConnections.TypeLabel(input)</em></span>
            }
            @foreach (var output in Node.Definition.Outputs)
            {
                <span><b>@output.Name</b><em>Output · @AutomationConnections.TypeLabel(output)</em></span>
            }
        </section>
        }

        @if (Node.IsCelTransform)
        {
            <div class="automation-inspector-cel-help">
                <div><a href="https://www.blokebot.com/automations#write-cel-expressions">BlokeBot guide to CEL expressions</a><a href="https://github.com/cel-expr/cel-spec/blob/master/doc/intro.md">Official introduction to CEL</a></div>
                <p>Choose a Data source to create an input, or declare one manually. Flow schedules nodes; it does not import values. A Data connection supplies a value when requested.</p>
                <p>Outputs compute from declared inputs only, not other outputs. Connect an output to a consumer. A Boolean output is data, not a Flow branch.</p>
            </div>
            <section class="automation-inspector-section automation-transform-schema" aria-labelledby="automation-transform-inputs-heading">
                <div class="automation-inspector-section-heading"><h3 id="automation-transform-inputs-heading">Inputs</h3><div class="automation-authoring-actions"><button class="automation-icon-button" type="button" aria-label="Declare input manually" title="Declare input manually" @onclick="AddTransformInputAsync"><EditorIcon Name="variables" /></button><button class="automation-icon-button" type="button" aria-label="Add input from source" title="Add input from source" aria-haspopup="dialog" @ref="_addInputOpener" @onclick="OpenTransformInputSourcePicker"><EditorIcon Name="add" /></button></div></div>
                @foreach (var input in Node.TransformInputs)
                {
                    <div class="automation-transform-declaration" @key="input.PortId">
                        <div class="field"><label class="field__label" for="@DeclarationFieldId(input.PortId, "name")">Input name</label><input class="field__input" id="@DeclarationFieldId(input.PortId, "name")" type="text" value="@input.DisplayName" @oninput="args => UpdateTransformInputAsync(input, displayName: args.Value?.ToString())" /></div>
                        <div class="field"><label class="field__label" for="@DeclarationFieldId(input.PortId, "type")">Type</label><select class="field__input" id="@DeclarationFieldId(input.PortId, "type")" value="@input.ValueType" @onchange="args => UpdateTransformInputAsync(input, valueType: args.Value?.ToString())">@foreach (var type in _inputTypes){<option value="@type">@type</option>}</select></div>
                        <div class="field"><label class="field__label" for="@DeclarationFieldId(input.PortId, "required")">Required?</label><select class="field__input" id="@DeclarationFieldId(input.PortId, "required")" value="@input.Nullability" @onchange="args => UpdateTransformInputAsync(input, nullability: args.Value?.ToString())"><option value="@AutomationPortNullability.NonNullable">Required</option><option value="@AutomationPortNullability.Nullable">Optional</option></select></div>
                        <div class="field automation-declaration-cel-name"><label class="field__label" for="@DeclarationFieldId(input.PortId, "cel-name")">CEL name</label><input class="field__input" @key="(input.PortId, _renameAttempt)" id="@DeclarationFieldId(input.PortId, "cel-name")" type="text" value="@input.Identifier.Value" aria-invalid="@(RenameDiagnostic(input.PortId) is null ? null : "true")" @onchange="args => RenameTransformInputAsync(input, args.Value?.ToString())" />@if (RenameDiagnostic(input.PortId) is { } renameDiagnostic){<span class="automation-field-error" role="alert">@renameDiagnostic</span>}</div>
                        <button class="automation-icon-button automation-declaration-remove" type="button" aria-label="Remove input @input.DisplayName" title="Remove input @input.DisplayName" @onclick="() => RemoveTransformInputAsync(input.PortId)"><EditorIcon Name="delete" /></button>
                    </div>
                }
            </section>
        }

        @if (Node.Definition.Id.Value is "start-countdown" or "reset-countdown" or "cancel-countdown")
        {
            var ownerField = new AutomationConfigurationFieldId("owner");
            <label class="automation-field"><span>Timer owner</span><select value="@Node.Value(ownerField)" @onchange="args => SetValueAsync(ownerField, args.Value)"><option value="Channel">Channel</option><option value="Viewer">Viewer</option></select><span>Viewer uses the person who triggered the automation.</span></label>
        }

        @if (_isSubflowExit && Node.Definition.Inputs.Any(IsDataPort))
        {
            <h3 class="automation-return-values-heading">Return values</h3>
        }
        @foreach (var input in Node.Definition.Inputs.Where(IsDataPort))
        {
            var fieldId = input.BindingFieldId!.Value;
            var binding = Node.Binding(fieldId);
            var edge = IncomingDataEdge(input.Id);
            var issue = edge is null ? null : AutomationConnections.Issue(edge, Nodes);
            var fieldErrors = FieldErrors(fieldId);
            <section class="automation-input-editor" data-automation-field="@fieldId.Value" @key="input.Id" aria-label="@($"{input.Name} {(_isSubflowExit ? "return value" : "input")}")">
                <div class="automation-input-heading"><h3>@(_isSubflowExit ? input.Name : $"Input · {input.Name}")</h3><span>@AutomationConnections.TypeLabel(input) · @(input.Nullability == AutomationPortNullability.Nullable ? "can be null" : "required")</span></div>
                <div class="automation-binding-mode-tabs" role="group" aria-label="@($"{input.Name} {(_isSubflowExit ? "return value" : "input")} choice")">
                    @foreach (var mode in BindingModes(input))
                    {
                        <span class="automation-binding-mode-option">
                            <button type="button" aria-pressed="@(binding.Mode == mode ? "true" : "false")" aria-describedby="@BindingModeHelpId(input.Id, mode)" @onclick="() => SetBindingModeAsync(fieldId, mode)">@mode</button>
                            <span id="@BindingModeHelpId(input.Id, mode)" role="tooltip" class="automation-binding-mode-tooltip">@BindingModeHelp(mode)</span>
                        </span>
                    }
                </div>
                @if (binding.Mode == AutomationInputBindingMode.Fixed)
                {
                    @if (IsSendChatMessage(input))
                    {
                        var field = Node.Definition.Configuration.Single(field => field.Id == fieldId);
                        <div class="@(fieldErrors.Count > 0 ? "automation-field automation-field--invalid" : "automation-field")">
                            <label for="@FieldId(Node.Id, fieldId)">@field.Name</label>
                            <textarea id="@FieldId(Node.Id, fieldId)" value="@Node.Value(fieldId)" maxlength="@MaximumLength(field)" required="@field.Required" aria-invalid="@(fieldErrors.Count > 0 ? "true" : null)" aria-describedby="@(fieldErrors.Count > 0 ? FieldId(Node.Id, fieldId) + "-errors" : null)" @oninput="args => SetValueAsync(fieldId, args.Value)"></textarea>
                            <p>@field.Description</p>
                        </div>
                    }
                    else if (Node.Subflow is not null)
                    {
                        <AutomationSubflowFixedInput @key="(Node.Id, input.Id)" Node="Node" Port="input" Changed="Changed" />
                    }
                    else if (AutomationEditorNode.IsComplexFixedValue(input.ValueType))
                    {
                        <label class="automation-field"><span>Enter a JSON value</span><textarea @key="(input.Id, _fixedValueAttempt)" aria-invalid="@(ComplexFixedValueDiagnostic(input.Id) is null ? null : "true")" value="@Node.Value(fieldId)" @onchange="args => SetComplexFixedValueAsync(input.Id, args.Value)"></textarea></label>
                        @if (ComplexFixedValueDiagnostic(input.Id) is { } fixedValueDiagnostic)
                        {
                            <span class="automation-field-error" role="alert">@fixedValueDiagnostic</span>
                        }
                    }
                    else
                    {
                        <label class="automation-field"><span>@(IsDelayDuration(input) ? "Enter whole milliseconds" : "Enter a value")</span><input type="@FixedInputType(input)" min="@(IsDelayDuration(input) ? "1" : null)" step="@(IsDelayDuration(input) ? "1" : null)" aria-invalid="@(fieldErrors.Count > 0 ? "true" : null)" aria-describedby="@(fieldErrors.Count > 0 ? FieldId(Node.Id, fieldId) + "-errors" : null)" value="@Node.Value(fieldId)" @oninput="args => SetValueAsync(fieldId, args.Value)" /></label>
                    }
                }
                else if (binding.Mode == AutomationInputBindingMode.Expression && !IsSendChatMessage(input))
                {
                    <label class="automation-field"><span>Calculate a value</span><textarea aria-label="@input.Name input expression" aria-invalid="@(fieldErrors.Count > 0 ? "true" : null)" aria-describedby="@(fieldErrors.Count > 0 ? FieldId(Node.Id, fieldId) + "-errors" : null)" value="@binding.Expression?.Source" @oninput="args => SetExpressionAsync(fieldId, args.Value)"></textarea></label>
                    <div class="automation-cel-completions" aria-label="Available names for @input.Name">
                        <strong>@(Node.IsCelTransform ? "Safe trigger names" : "Common public names")</strong>
                        @foreach (var completion in AutomationCelCompletions.ForInput(Node))
                        {
                            <span><code>@completion.Name</code><em>@completion.TypeLabel</em></span>
                        }
                        <span>@(Node.IsCelTransform ? "Only trigger names here; declared inputs are for outputs." : "Other names depend on the run. Save checks compilation; runtime checks availability and result type.")</span>
                        <strong>Examples · @AutomationConnections.TypeLabel(input) · @(input.Nullability == AutomationPortNullability.Nullable ? "can be null" : "required")</strong>
                        @foreach (var example in AutomationCelCompletions.InputExamples(Node, input))
                        {
                            <span><code>@example</code></span>
                        }
                        @if (IsDelayDuration(input))
                        {
                            <span>This example converts the first argument from seconds to milliseconds. Check argument count, numeric text and a positive whole-millisecond duration in the flow before effects. A later out-of-range due time can still fail.</span>
                        }
                        @if (!Node.IsCelTransform)
                        {
                            <strong>Selected functions · non-null inputs</strong>
                            @foreach (var signature in AutomationCelCompletions.OrdinaryFunctions)
                            {
                                <span><code>@signature</code></span>
                            }
                            <span>Check argument count before indexing and finite numeric Text before conversion. Use a dot for fractions. Join requires four arguments: end is exclusive, indices clamp to 0..count, and the separator is kept exactly.</span>
                        }
                    </div>
                }
                else if (binding.Mode == AutomationInputBindingMode.Connected)
                {
                    @if (edge is null)
                    {
                        <div class="automation-binding-card"><strong>No source</strong><span>@(_isSubflowExit ? "Choose a return value source." : "Use another node for this input.")</span></div>
                    }
                    else
                    {
                        <div class="@(issue is null ? "automation-binding-card" : "automation-binding-card automation-binding-card--invalid")">
                            <strong>@ConnectedSourceLabel(edge)</strong>
                            @if (issue is null)
                            {
                                <span>Connected · @ConnectedSourceType(edge)</span>
                            }
                            else
                            {
                                <span class="automation-connection-diagnostic" role="alert">@issue</span>
                            }
                        </div>
                    }
                }
                @if (binding.Mode is AutomationInputBindingMode.Connected or AutomationInputBindingMode.Expression)
                {
                    <div class="automation-repair-actions">
                        <button type="button" data-automation-source-picker-open aria-haspopup="dialog" aria-expanded="@(_pickerInputId == input.Id ? "true" : "false")" @ref="_sourceOpeners[input.Id]" @onclick="() => OpenSourcePicker(input, edge?.Id)">@(edge is null ? "Choose source" : issue is null ? "Change source" : "Repair source")</button>
                        @if (edge is not null)
                        {
                            <button class="automation-danger-button" type="button" @onclick="() => DeleteEdge.InvokeAsync(edge.Id)">Disconnect</button>
                        }
                    </div>
                }
                @if (fieldErrors.Count > 0) { <div id="@(FieldId(Node.Id, fieldId) + "-errors")">@foreach (var error in fieldErrors){<span class="automation-field-error" role="alert">@(error.Diagnostic is { } diagnostic ? $"{diagnostic.Summary}. {diagnostic.Correction}" : error.Message)</span>}</div> }
            </section>
        }

        @if (Node.UnmatchedSubflowInputs.Any())
        {
            <section class="automation-inspector-section" aria-label="@(_isSubflowExit ? "Unmatched return values" : "Unmatched inputs")">
                <h3>@(_isSubflowExit ? "Unmatched return values" : "Unmatched inputs")</h3>
                @foreach (var field in Node.UnmatchedSubflowInputs.ToArray())
                {
                    <div class="automation-unmatched-input" @key="field">
                        <strong>@field.Value</strong>
                        @if (Node.SubflowFixedValue(new(field.Value)) is { } value)
                        {
                            <span>@AutomationPureHandlerRegistry.ValueType(value)</span><code>@AutomationEditorNode.DisplayFixedValue(value)</code>
                        }
                        @if (Node.SubflowInputBinding(field) is { } binding)
                        {
                            <span>@binding.Mode</span>@if (binding.Expression is { } expression) { <code>@expression.Source</code> }
                        }
                        <button class="automation-danger-button" type="button" @onclick="() => RemoveSubflowInputAsync(field)">@(_isSubflowExit ? "Remove return value" : "Remove input")</button>
                    </div>
                }
            </section>
        }

        @foreach (var field in Node.Definition.Configuration.Where(ShowConfigurationField))
        {
            var choices = ChoicesFor(field);
            var fieldErrors = FieldErrors(field.Id);
            <div class="@(fieldErrors.Count > 0 ? "automation-field automation-field--invalid" : "automation-field")" @key="field.Id">
                <label for="@FieldId(Node.Id, field.Id)">@ConfigurationLabel(field)</label>
                @if (field.FieldType is AutomationConfigurationFieldType.Text { Multiline: true })
                {
                    <textarea id="@FieldId(Node.Id, field.Id)" value="@Node.Value(field.Id)" maxlength="@MaximumLength(field)" required="@field.Required" aria-invalid="@(fieldErrors.Count > 0 ? "true" : null)" @oninput="args => SetValueAsync(field.Id, args.Value)"></textarea>
                }
                else if (choices.Count > 0)
                {
                    <select id="@FieldId(Node.Id, field.Id)" value="@Node.Value(field.Id)" required="@field.Required" aria-invalid="@(fieldErrors.Count > 0 ? "true" : null)" @onchange="args => SetValueAsync(field.Id, args.Value)">@if (!field.Required){<option value="">Any</option>}@foreach (var choice in choices){<option value="@choice.Value">@choice.Label</option>}</select>
                }
                else
                {
                    <input id="@FieldId(Node.Id, field.Id)" type="@GenericInputType(field)" step="@(Node.Definition.Id == AutomationDefinitionIds.ScheduledTimeSource && field.Id.Value == "local-time" ? "1" : null)" value="@ConfigurationValue(field)" required="@field.Required" aria-invalid="@(fieldErrors.Count > 0 ? "true" : null)" @oninput="args => SetValueAsync(field.Id, args.Value)" />
                }
                <p>@ConfigurationDescription(field)</p>
                @if (fieldErrors.Count > 0) { <div id="@(FieldId(Node.Id, field.Id) + "-errors")">@foreach (var error in fieldErrors){<span class="automation-field-error" role="alert">@(error.Diagnostic is { } diagnostic ? $"{diagnostic.Summary}. {diagnostic.Correction}" : error.Message)</span>}</div> }
            </div>
        }

        @if (_scheduleTimeWarning is { } timeWarning)
        {
            <p class="automation-field-error" role="status" data-automation-schedule-skipped-time>@timeWarning</p>
        }

        @if (Node.Definition.Id == AutomationDefinitionIds.ScheduledTimeSource)
        {
            @ScheduleHistory
        }

        @if (Node.IsCelTransform)
        {
            <section class="automation-inspector-section automation-transform-schema" aria-labelledby="automation-transform-outputs-heading">
                <div class="automation-inspector-section-heading"><h3 id="automation-transform-outputs-heading">Outputs</h3><button class="automation-icon-button" type="button" aria-label="Add output" title="Add output" @onclick="AddTransformOutputAsync"><EditorIcon Name="add" /></button></div>
                @foreach (var output in Node.TransformOutputs)
                {
                    <div class="automation-transform-declaration" data-automation-output="@output.PortId.Value" @key="output.PortId">
                        <div class="field"><label class="field__label" for="@DeclarationFieldId(output.PortId, "name")">Output name</label><input class="field__input" id="@DeclarationFieldId(output.PortId, "name")" type="text" value="@output.DisplayName" @oninput="args => UpdateTransformOutputAsync(output, displayName: args.Value?.ToString())" /></div>
                        <div class="field"><label class="field__label" for="@DeclarationFieldId(output.PortId, "type")">Type</label><select class="field__input" id="@DeclarationFieldId(output.PortId, "type")" value="@output.ValueType" @onchange="args => UpdateTransformOutputAsync(output, valueType: args.Value?.ToString())">@foreach (var type in _outputTypes){<option value="@type">@type</option>}</select></div>
                        <div class="field"><label class="field__label" for="@DeclarationFieldId(output.PortId, "required")">Required?</label><select class="field__input" id="@DeclarationFieldId(output.PortId, "required")" value="@output.Nullability" @onchange="args => UpdateTransformOutputAsync(output, nullability: args.Value?.ToString())"><option value="@AutomationPortNullability.NonNullable">Required</option><option value="@AutomationPortNullability.Nullable">Optional</option></select></div>
                        <div class="field automation-transform-cel"><label class="field__label" for="@DeclarationFieldId(output.PortId, "expression")">CEL expression</label><textarea class="field__input" id="@DeclarationFieldId(output.PortId, "expression")" aria-invalid="@(Errors.Any(error => error.NodeId == Node.Id && error.PortId == output.PortId) ? "true" : null)" aria-describedby="@(Errors.Any(error => error.NodeId == Node.Id && error.PortId == output.PortId) ? DeclarationFieldId(output.PortId, "errors") : null)" value="@output.Source" @oninput="args => UpdateTransformOutputAsync(output, source: args.Value?.ToString())"></textarea></div>
                        <div id="@DeclarationFieldId(output.PortId, "errors")">@foreach (var error in Errors.Where(error => error.NodeId == Node.Id && error.PortId == output.PortId)) { <span class="automation-field-error" role="alert">@(error.Diagnostic is { } diagnostic ? $"{diagnostic.Summary}. {diagnostic.Correction}" : error.Message)</span> }</div>
                        @if (AutomationCelCompletions.OutputExamples(Node, output) is { IsEmpty: false } examples)
                        {
                            <div class="automation-cel-completions automation-transform-cel" aria-label="Example expressions for @output.DisplayName">
                                <strong>Examples · @output.ValueType · @(output.Nullability == AutomationPortNullability.Nullable ? "can be null" : "required")</strong>
                                @foreach (var example in examples)
                                {
                                    <span><code>@example</code></span>
                                }
                            </div>
                        }
                        <button class="automation-icon-button automation-declaration-remove" type="button" aria-label="Remove output @output.DisplayName" title="Remove output @output.DisplayName" @onclick="() => RemoveTransformOutputAsync(output.PortId)"><EditorIcon Name="delete" /></button>
                    </div>
                }
                <div class="automation-cel-completions" aria-label="Available output CEL names">
                    <strong>Declared input names</strong>
                    @foreach (var completion in AutomationCelCompletions.ForOutput(Node))
                    {
                        <span><code>@completion.Name</code><em>@completion.TypeLabel</em></span>
                    }
                    @if (Node.TransformInputs.Count == 0)
                    {
                        <span>No input is declared. Add and bind an input to use a source value.</span>
                    }
                    <strong>Selected functions · non-null inputs</strong>
                    @foreach (var signature in AutomationCelCompletions.TransformFunctions)
                    {
                        <span><code>@signature</code></span>
                    }
                    <span>Check argument count before indexing. Numeric Text must contain a finite invariant number, using a dot for fractions. Join requires all four arguments; end is exclusive, indices clamp to 0..count, and the separator is kept exactly.</span>
                </div>
            </section>
        }

        @if (_genericErrors.Count > 0)
        {
            <div class="automation-node-errors" role="alert">@foreach (var error in _genericErrors){<span>@(error.Diagnostic is { } diagnostic ? $"{diagnostic.Summary}. {diagnostic.Correction}" : error.Message)</span>}</div>
        }

        @if (Node.Definition.Outputs.Any(IsFlowPort))
        {
            <section class="automation-inspector-section" aria-labelledby="automation-connections-heading">
                <h3 id="automation-connections-heading">Flow connections</h3>
                @foreach (var output in Node.Definition.Outputs.Where(IsFlowPort))
                {
                    <div class="automation-connection-editor" @key="output.Id"><label for="@ConnectionId(Node.Id, output.Id)">@output.Name goes to</label><select id="@ConnectionId(Node.Id, output.Id)" value="" @onchange="args => ConnectAsync(output, args.Value)"><option value="">Choose a compatible node</option>@foreach (var target in CompatibleTargets(output)){<option value="@target.Id.Value">@target.EffectiveName</option>}</select></div>
                }
            </section>
        }

        @if (Node.Definition.Kind is not AutomationNodeKind.Source and not AutomationNodeKind.Value and not AutomationNodeKind.Transform)
        {
            <div class="automation-field"><label for="automation-failure-policy">If this node fails</label><select id="automation-failure-policy" @bind="Node.FailurePolicy" @bind:after="ChangedAsync"><option value="@AutomationNodeFailurePolicy.Stop">Stop this run</option><option value="@AutomationNodeFailurePolicy.Continue">Continue this branch</option></select></div>
        }

        <footer class="automation-inspector-footer"><button class="automation-danger-button" type="button" @onclick="() => DeleteNode.InvokeAsync(Node.Id)"><EditorIcon Name="delete" />Delete node</button><button class="btn-primary" type="button" @onclick="ChangedAsync"><EditorIcon Name="apply" />Apply</button></footer>

    </aside>

    @if (_pickerNodeId == Node.Id)
    {
        <div class="automation-source-picker-backdrop" @onclick="CancelSourcePickerAsync">
            <section class="automation-source-picker" role="dialog" aria-modal="true" aria-labelledby="automation-source-picker-title" tabindex="-1" @ref="_pickerDialog" @onkeydown="HandlePickerKeyAsync" @onclick:stopPropagation="true">
                <header><div><span class="automation-inspector-eyebrow">Use another node</span><h3 id="automation-source-picker-title">@(_addingTransformInput ? "Add input from source" : "Choose a source and port")</h3></div><button class="automation-icon-button" type="button" aria-label="Cancel source choice" @onclick="CancelSourcePickerAsync"><EditorIcon Name="close" /></button></header>
                @if (_pickerEdgeId is { } currentEdgeId && Edges.FirstOrDefault(edge => edge.Id == currentEdgeId) is { } currentEdge && _selectedSource is null)
                {
                    <div class="automation-binding-card automation-binding-card--invalid"><strong>@ConnectedSourceLabel(currentEdge)</strong><span class="automation-connection-diagnostic">Current output is unavailable. Choose a replacement.</span></div>
                }
                <div class="automation-source-picker-options" role="radiogroup" aria-label="Available source ports">
                    @foreach (var choice in SourceChoices())
                    {
                        <button type="button" role="radio" class="@(choice == _selectedSource ? "automation-source-picker-option automation-source-picker-option--selected" : "automation-source-picker-option")" aria-checked="@(choice == _selectedSource ? "true" : "false")" tabindex="@(choice == _selectedSource || (_selectedSource is null && choice == SourceChoices().FirstOrDefault()) ? 0 : -1)" @ref="_sourceReferences[choice]" @onclick="() => SelectSource(choice)" @onkeydown="args => HandleSourceChoiceKeyAsync(choice, args)"><span><strong>@choice.Node.EffectiveName · @choice.Port.Name</strong><small>@choice.Node.Definition.Display.Name · @AutomationConnections.TypeLabel(choice.Port)</small></span><em>@(choice.Compatibility.IsCompatible && _addingTransformInput ? (choice.Port.Nullability == AutomationPortNullability.Nullable ? "Optional" : "Required") : choice.Compatibility.Reason)</em></button>
                    }
                </div>
                @if (_addingTransformInput)
                {
                    <div class="space-y-3">
                        <div class="field"><label class="field__label" for="automation-new-input-name">Input name</label><input class="field__input" id="automation-new-input-name" value="@_newInputName" @oninput="SetNewInputName" /></div>
                        <div class="field"><label class="field__label" for="automation-new-input-identifier">CEL name</label><input class="field__input" id="automation-new-input-identifier" value="@_newInputIdentifier" aria-invalid="@(_newInputDiagnostic is null ? null : "true")" aria-describedby="automation-new-input-error" @oninput="SetNewInputIdentifier" /></div>
                        @if (_newInputDiagnostic is { } nameError) { <span id="automation-new-input-error" class="automation-field-error" role="alert">@nameError</span> }
                    </div>
                }
                @if (_sourcePickerError is { } pickerError) { <span class="automation-field-error" role="alert">@pickerError</span> }
                <footer><button type="button" @onclick="CancelSourcePickerAsync">Cancel</button><button class="btn-primary" type="button" data-automation-source-picker-complete disabled="@(_selectedSource?.Compatibility.IsCompatible != true || _newInputDiagnostic is not null)" @onclick="ConnectSelectedSourceAsync">@(_addingTransformInput ? "Add input" : "Connect")</button></footer>
            </section>
        </div>
    }
}

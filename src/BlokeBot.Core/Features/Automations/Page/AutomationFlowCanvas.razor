@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime _js

<div class="automation-canvas-wrap"
     data-automation-canvas-shell
     data-viewport-key="@ViewportKey"
     data-orientation="@OrientationToken(Settings.Orientation)"
     data-edge-style="@EdgeStyleToken(Settings.EdgeStyle)">
    <div class="automation-canvas-tools" role="toolbar" aria-label="Canvas controls">
        <div class="automation-canvas-tool-group" role="group" aria-label="Move selected nodes">
            <button type="button" disabled="@_noNodeSelection" aria-label="Move selected nodes left" @onclick="() => NudgeSelectedAsync(-24, 0)">←</button>
            <button type="button" disabled="@_noNodeSelection" aria-label="Move selected nodes up" @onclick="() => NudgeSelectedAsync(0, -24)">↑</button>
            <button type="button" disabled="@_noNodeSelection" aria-label="Move selected nodes down" @onclick="() => NudgeSelectedAsync(0, 24)">↓</button>
            <button type="button" disabled="@_noNodeSelection" aria-label="Move selected nodes right" @onclick="() => NudgeSelectedAsync(24, 0)">→</button>
        </div>
        <label>
            <span>Flow direction</span>
            <select value="@Settings.Orientation" @onchange="ChangeOrientationAsync">
                <option value="@AutomationFlowOrientation.Horizontal">Horizontal</option>
                <option value="@AutomationFlowOrientation.Vertical">Vertical</option>
            </select>
        </label>
        <label>
            <span>Connection style</span>
            <select value="@Settings.EdgeStyle" @onchange="ChangeEdgeStyleAsync">
                <option value="@AutomationEdgeStyle.Angular">Angular</option>
                <option value="@AutomationEdgeStyle.Smooth">Smooth</option>
            </select>
        </label>
        <button type="button" data-canvas-zoom-reset>100%</button>
    </div>

    <div class="automation-canvas-viewport"
         style="@_canvasViewportStyle"
         tabindex="0"
         role="region"
         aria-label="Automation flow canvas"
         @ref="_root"
         data-automation-canvas>
        <div class="automation-canvas-stage-size" style="@_canvasStageStyle">
        <div class="automation-canvas-stage">
            <svg class="automation-edges" viewBox="0 0 @_canvasWidth @_canvasHeight" aria-label="Flow connections">
                @foreach (var edge in Edges)
                {
                    <g @key="edge.Id"
                       class="@EdgeGroupClass(edge)"
                       data-automation-edge="@edge.Id"
                       data-source-node="@edge.SourceNodeId.Value"
                       data-source-port="@edge.SourcePortId.Value"
                       data-target-node="@edge.TargetNodeId.Value"
                       data-target-port="@edge.TargetPortId.Value"
                       @onclick:stopPropagation="true"
                       @onclick="() => SelectEdgeAsync(edge.Id)">
                        <path class="automation-edge-hit" d="" />
                        <path class="automation-edge" d="" />
                        @if (BranchLabel(edge) is { } label)
                        {
                            <svg:g class="automation-edge-label" data-edge-label style="display:none">
                                <svg:rect x="-19" y="-11" width="38" height="22" rx="11" />
                                <svg:text text-anchor="middle" dominant-baseline="central"><tspan>@label</tspan></svg:text>
                            </svg:g>
                        }
                    </g>
                }
                <path class="automation-edge automation-edge--preview" data-connection-preview d="" />
            </svg>

            <div class="automation-marquee" data-automation-marquee hidden></div>

            @foreach (var node in Nodes)
            {
                var errors = ErrorsFor(node.Id);
                var outcome = OutcomeFor(node.Id);
                <article @key="node.Id"
                         class="@NodeClass(node, errors.Count > 0, outcome)"
                         style="@NodeStyle(node)"
                         data-automation-node="@node.Id.Value"
                         data-node-x="@node.Position.X.Value"
                         data-node-y="@node.Position.Y.Value">
                    <button type="button"
                            class="automation-node-select"
                            data-automation-node-select
                            aria-label="Select @node.EffectiveName"
                            aria-pressed="@(SelectedNodeIds.Contains(node.Id) ? "true" : "false")"
                            @onclick="args => SelectNodeAsync(node.Id, args.ShiftKey)"
                            @onkeydown="args => HandleNodeKeyAsync(node, args)">
                        <span class="automation-node-kind automation-node-kind--@KindToken(node.Definition.Kind)">@KindLabel(node.Definition.Kind)</span>
                        <strong title="@node.EffectiveName">@node.EffectiveName</strong>
                        <span class="automation-node-description">@NodeSummary(node)</span>
                        @if (outcome is not null)
                        {
                            <span class="automation-node-outcome">@OutcomeLabel(outcome)</span>
                        }
                    </button>
                    @foreach (var input in node.Definition.Inputs.Where(IsFlowPort).Select((port, index) => new { Port = port, Index = index }))
                    {
                        <button type="button"
                                class="automation-port automation-port--input"
                                style="@PortStyle(input.Index, node.Definition.Inputs.Count(IsFlowPort))"
                                title="@input.Port.Name"
                                aria-label="@($"{node.EffectiveName}: {input.Port.Name} input")"
                                data-automation-port
                                data-port-direction="input"
                                data-node-id="@node.Id.Value"
                                data-port-id="@input.Port.Id.Value"
                                data-port-type="@input.Port.ValueType"
                                data-port-sensitivity="@input.Port.Sensitivity"
                                @onclick:stopPropagation="true"></button>
                    }
                    @foreach (var output in node.Definition.Outputs.Where(IsFlowPort).Select((port, index) => new { Port = port, Index = index }))
                    {
                        <button type="button"
                                class="automation-port automation-port--output automation-port--branch-@BranchToken(output.Port.Id)"
                                style="@PortStyle(output.Index, node.Definition.Outputs.Count(IsFlowPort))"
                                title="@output.Port.Name"
                                aria-label="@($"{node.EffectiveName}: {output.Port.Name} output")"
                                data-automation-port
                                data-port-direction="output"
                                data-node-id="@node.Id.Value"
                                data-port-id="@output.Port.Id.Value"
                                data-port-type="@output.Port.ValueType"
                                data-port-sensitivity="@output.Port.Sensitivity"
                                @onclick:stopPropagation="true"></button>
                    }
                </article>
            }
        </div>
        </div>
    </div>
</div>

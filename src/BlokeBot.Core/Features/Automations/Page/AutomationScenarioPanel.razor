@using System.Collections.Immutable
@using System.Globalization
@using BlokeBot.Core.Features.CustomCommands
@using BlokeBot.Persistence.Models

@if (Editor is not null)
{
    <div class="automation-authoring-body" data-automation-scenario-editor>
        <label class="field">
        <span class="field__label">Trigger</span>
        <select class="field__input" value="@Editor.Fixture.SourceNodeId.Value" @onchange="args => SourceChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty)">@foreach (var node in Nodes.Where(node => node.Definition.Kind == AutomationNodeKind.Source)) { <option value="@node.Id.Value">@node.EffectiveName</option> }</select>
        </label>
        @if (CommandId > 0)
        {
            <label class="field"><span class="field__label">Input format</span>
                <select class="field__input" value="@Editor.CommandInputFormat" @onchange="args => { if (Enum.TryParse<AutomationScenarioCommandInputFormat>(args.Value?.ToString(), out var format)) Editor.CommandInputFormat = format; }">
                    <option value="Raw">Raw chat message</option><option value="Structured">Structured inputs</option>
                </select>
            </label>
            @if (Editor.CommandInputFormat == AutomationScenarioCommandInputFormat.Raw)
            {
                <label class="field"><span class="field__label">Chat message</span>
                    <textarea class="field__input" maxlength="1000" value="@Editor.RawCommand" @oninput="args => Editor.SetRawCommand(args.Value?.ToString() ?? string.Empty)"></textarea>
                </label>
                <p class="text-sm">Uses the selected command's current alias and argument schema. Quotes are literal, just as in chat.</p>
            }
            else if (CommandSchema is not null)
            {
                <label class="field"><span class="field__label">Arguments after the command</span>
                    <textarea class="field__input" value="@Editor.Fixture.CommandArgumentTail" @oninput="args => Editor.SetCommandArgumentTail(args.Value?.ToString() ?? string.Empty)"></textarea>
                </label>
            }
            @if (CommandSchema is { } schema)
            {
                @(CustomCommandArguments.Parse(CommandId, "command", schema, Editor.Fixture.CommandArgumentTail ?? string.Empty).Match<RenderFragment>(
                    prepared => @<div>
                        @foreach (var field in schema.Fields)
                        {
                            <p class="text-sm"><strong>@field.Name</strong> (@(field.Kind == CustomCommandArgumentKind.Number ? "Number" : "Text")): <output class="whitespace-pre-wrap">@DisplayArgument(prepared.Arguments.Values[field.Name])</output></p>
                        }
                    </div>,
                    rejected => @<p role="status">@rejected.Message</p>))
            }
        }
        <details open="@(CommandId == 0)">
        <summary>Other source fields</summary>
        <div class="automation-authoring-section">
            @foreach (var field in Fields.Where(field => (CommandSchema is null || (field.Id.Value != "arguments" && !field.Id.Value.StartsWith("argument.", StringComparison.Ordinal))) && !(CommandId > 0 && Editor.CommandInputFormat == AutomationScenarioCommandInputFormat.Raw && field.Id.Value == "arguments")))
            {
                <AutomationFixtureValueInput @key="(Editor, field.Id)" Label="@field.Name" Value="@Editor.SourceValue(field)" ValueType="field.ValueType" Nullable="@(field.Nullability == AutomationPortNullability.Nullable)" Changed="value => Editor.SetSourceValue(field, value)" ValidityChanged="valid => InputValidity.InvokeAsync(new(field.Id.Value, valid))" />
            }
        </div>
        </details>
        <details>
        <summary>Clock and seed</summary>
        <div class="automation-authoring-section">
            <label class="field">
            <span class="field__label">Clock (UTC)</span>
            <input class="field__input" type="datetime-local" value="@Editor.Fixture.ClockUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture)" @onchange="ClockChanged" />
            </label>
            <label class="field">
            <span class="field__label">Seed</span>
            <input class="field__input" inputmode="numeric" value="@Editor.Fixture.Seed.ToString(CultureInfo.InvariantCulture)" @onchange="SeedChanged" />
            </label>
        </div>
        </details>
        <details>
        <summary>Hypothetical action outcomes</summary>
        <div class="automation-authoring-section">
        <p>Actions are not sent to Twitch. Known missing permissions fail; current Twitch approval, eligibility and live state are not checked.</p>
            @foreach (var node in Nodes.Where(node => node.Definition.Kind == AutomationNodeKind.Action))
            {
                <label class="automation-effect-choice">
                <span>@node.EffectiveName</span>
                @{ var start = node.Definition.Id == AutomationDefinitionIds.StartCountdownAction;
                   var effect = Editor.Fixture.Effects.FirstOrDefault(effect => effect.NodeId == node.Id)?.Result ?? AutomationScenarioEffectResult.Succeeded;
                   var selectedEffect = start && effect == AutomationScenarioEffectResult.Succeeded ? AutomationScenarioEffectResult.Started : effect; }
                <select aria-label="@($"{node.EffectiveName} result")" data-scenario-effect-node="@node.Id.Value" value="@selectedEffect" @onchange="args => SetEffect(node.Id, args)">
                @if (start)
                {
                    <option value="Started">Would start</option>
                    <option value="AlreadyRunning">Would already be running</option>
                }
                else
                {
                    <option value="Succeeded">Would succeed</option>
                }
                <option value="Failed">Failure</option>
                </select>
                </label>
            }
        </div>
        </details>
        <details>
        <summary>Connected input overrides</summary>
        <div class="automation-authoring-section">
            <label class="field">
            <span class="field__label">Node</span>
            <select class="field__input" value="@_inputNode?.Value" @onchange="args => _inputNode = Guid.TryParse(args.Value?.ToString(), out var id) ? new(id) : null">
            <option value="">Choose node</option>@foreach (var node in Nodes.Where(node => node.Definition.Inputs.Any(port => port.BindingFieldId is { } field && node.Binding(field).Mode == AutomationInputBindingMode.Connected))) { <option value="@node.Id.Value">@node.EffectiveName</option> }</select>
            </label>
            @if (Nodes.FirstOrDefault(node => node.Id == _inputNode) is { } inputNode)
            {
                @foreach (var port in inputNode.Definition.Inputs.Where(port => port.BindingFieldId is { } field && inputNode.Binding(field).Mode == AutomationInputBindingMode.Connected))
                {
                    var overridden = Editor.Fixture.ConnectedInputs.FirstOrDefault(input => input.NodeId == inputNode.Id && input.PortId == port.Id);
                    <label class="automation-port-option">
                    <input type="checkbox" checked="@(overridden is not null)" @onchange="args => ToggleOverride(inputNode.Id, port, args.Value is true)" /> @port.Name</label>
                    @if (overridden is not null)
                    {
                        <AutomationFixtureValueInput @key="(Editor, inputNode.Id, port.Id)" Label="@port.Name" Value="overridden.Value.Value" ValueType="port.ValueType" Nullable="@(port.Nullability == AutomationPortNullability.Nullable)" Changed="value => Editor.SetConnected(inputNode.Id, port, value)" ValidityChanged="valid => ConnectedValidity(inputNode.Id, port.Id, valid)" />
                    }
                }
            }
        </div>
        </details>
        <details><summary>Saved sample inputs</summary>
        <div class="automation-authoring-heading">
        <h3>Saved inputs</h3>
        <button class="btn-secondary" type="button" @onclick="New">New</button>
        </div>
        <label class="field">
        <span class="field__label">Scenario</span>
        <select class="field__input" value="@Editor.Id?.Value.ToString()" @onchange="args => Select.InvokeAsync(args.Value?.ToString() ?? string.Empty)">
        <option value="">New scenario</option>@foreach (var item in Saved) { <option value="@item.Id.Value">@item.Name</option> }</select>
        </label>
        <label class="field">
        <span class="field__label">Name</span>
        <input class="field__input" maxlength="200" @bind="Editor.Name" />
        </label>
        <button class="btn-secondary" type="button" @onclick="Generate">Generate sample inputs</button>
        @if (Editor.Id is not null)
        {
            <details>
            <summary>Scenario actions</summary>
            <div class="automation-authoring-actions">
            <button class="btn-secondary" type="button" @onclick="Duplicate">Duplicate</button>
            <button class="btn-secondary" type="button" @onclick="Delete">Delete</button>
            </div>
            </details>
        }
        </details>
        <p class="text-sm">Saving keeps inputs, not results. Current test values clear when you leave or edit. Only generated portable samples can be exported.</p>
    </div>
    <footer class="automation-authoring-footer">
    <button class="btn-primary" type="button" disabled="@(Busy || InvalidInputs || CommandArgumentsInvalid)" data-automation-run-scenario @onclick="Run">Run</button>
    <button class="btn-secondary" type="button" disabled="@(Busy || !CanSave || InvalidInputs)" data-automation-save-scenario @onclick="Save">Save sample</button>@if (Busy) { <button class="btn-secondary" type="button" @onclick="Cancel">Cancel</button> }</footer>
}
else
{
    <div class="automation-authoring-body">
    <h2>Test scenarios</h2>
    <p>Add a trigger to test this draft.</p>
    </div>
}

@code {
    [Parameter] public IReadOnlyDictionary<int, CustomCommandArgumentSchema> CommandSchemas { get; set; } = ImmutableDictionary<int, CustomCommandArgumentSchema>.Empty;
    private int CommandId => Nodes.FirstOrDefault(node => node.Id == Editor?.Fixture.SourceNodeId) is { } node
        && node.Definition.Id == AutomationDefinitionIds.CustomCommandSource
        && int.TryParse(node.Value(new("custom-command-id")), out var id) ? id : 0;
    private bool CommandArgumentsInvalid => Editor?.CommandInputFormat != AutomationScenarioCommandInputFormat.Raw && CommandSchema is { } schema && Editor is not null && CustomCommandArguments.Parse(CommandId, "command", schema, Editor.Fixture.CommandArgumentTail ?? string.Empty).Match(_ => false, _ => true);
    private CustomCommandArgumentSchema? CommandSchema => CommandSchemas.GetValueOrDefault(CommandId);
    private static string DisplayArgument(AutomationValue value) => value switch { AutomationValue.Number number => number.Value.ToString(CultureInfo.InvariantCulture), AutomationValue.Text text => text.Value, _ => string.Empty };

    [Parameter] public AutomationScenarioEditor? Editor { get; set; }
    [Parameter] public ImmutableArray<AutomationScenarioSnapshot> Saved { get; set; } = [];
    [Parameter] public IReadOnlyList<AutomationEditorNode> Nodes { get; set; } = [];
    [Parameter] public ImmutableArray<AutomationPortMetadata> Fields { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanSave { get; set; }
    [Parameter] public bool InvalidInputs { get; set; }
    [Parameter] public EventCallback<AutomationFixtureInputValidity> InputValidity { get; set; }
    [Parameter] public EventCallback<string> Select { get; set; }
    [Parameter] public EventCallback<string> SourceChanged { get; set; }
    [Parameter] public EventCallback New { get; set; }
    [Parameter] public EventCallback Generate { get; set; }
    [Parameter] public EventCallback Run { get; set; }
    [Parameter] public EventCallback Save { get; set; }
    [Parameter] public EventCallback Duplicate { get; set; }
    [Parameter] public EventCallback Delete { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private AutomationNodeId? _inputNode;

    private Task ConnectedValidity(AutomationNodeId node, AutomationPortId port, bool valid) => InputValidity.InvokeAsync(new($"{node.Value}/{port.Value}", valid));

    private void SetEffect(AutomationNodeId node, ChangeEventArgs args)
    {
        if (Enum.TryParse<AutomationScenarioEffectResult>(args.Value?.ToString(), out var result)) Editor?.SetEffect(node, result);
    }
    private async Task ToggleOverride(AutomationNodeId node, AutomationPortMetadata port, bool enabled)
    {
        if (enabled) Editor?.SetConnected(node, port, AutomationEditorNode.DefaultFixtureValue(port.ValueType));
        else Editor?.RemoveConnected(node, port.Id);
        await ConnectedValidity(node, port.Id, true);
    }
    private async Task ClockChanged(ChangeEventArgs args)
    {
        var valid = DateTimeOffset.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var clock);
        await InputValidity.InvokeAsync(new("clock", valid));
        if (valid) Editor?.SetClock(clock);
    }
    private async Task SeedChanged(ChangeEventArgs args)
    {
        var valid = ulong.TryParse(args.Value?.ToString(), NumberStyles.None, CultureInfo.InvariantCulture, out var seed);
        await InputValidity.InvokeAsync(new("seed", valid));
        if (valid) Editor?.SetSeed(seed);
    }
}

<div class="automation-workspace-toolbar" role="toolbar" aria-label="Automation editor tools" @onclick:stopPropagation="true">
    <button class="automation-toolbox-button"
            type="button"
            aria-expanded="@ToolboxOpen"
            data-automation-toolbox-toggle
            @ref="_toolboxButton"
            @onclick="ToggleToolbox"><AutomationIcon Name="add" />Toolbox</button>
    <label><span class="sr-only">Flow direction</span><select value="@Settings.Orientation" @onchange="OrientationChanged"><option value="@AutomationFlowOrientation.Horizontal">Horizontal</option><option value="@AutomationFlowOrientation.Vertical">Vertical</option></select></label>
    <label><span class="sr-only">Connection style</span><select value="@Settings.EdgeStyle" @onchange="EdgeStyleChanged"><option value="@AutomationEdgeStyle.Angular">Angular</option><option value="@AutomationEdgeStyle.Smooth">Smooth</option></select></label>
    <span class="automation-connection-legend automation-connection-legend--flow">Flow schedules</span>
    <span class="automation-connection-legend automation-connection-legend--data">Data supplies values</span>
</div>
@if (SelectedNode is not null)
{
    <div class="automation-mobile-selection-summary" aria-label="Selected node summary">
        <div>
            <strong>@SelectedNode.EffectiveName</strong><span> · @SelectedNode.Definition.Display.Name</span>
            <small>Inputs: @string.Join(", ", SelectedNode.Definition.Inputs.Select(static port => port.Name))</small>
            <small>Outputs: @string.Join(", ", SelectedNode.Definition.Outputs.Select(static port => port.Name))</small>
        </div>
        <button type="button" @onclick="FocusInspector"><AutomationIcon Name="node" />Inspector</button>
    </div>
}

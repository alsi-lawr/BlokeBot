<svg class="automation-node-icon"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     data-automation-node-icon="@DefinitionId.Value">
    @switch (DefinitionId.Value)
    {
        case "random-number":
            <rect x="3" y="3" width="18" height="18" rx="4" /><circle cx="8" cy="8" r="1" /><circle cx="16" cy="8" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="8" cy="16" r="1" /><circle cx="16" cy="16" r="1" />
            break;
        case "cel-transform":
            <path d="M4 7h11m0 0-3-3m3 3-3 3M20 17H9m0 0 3-3m-3 3 3 3M4 12h16" />
            break;
        case "custom-command":
            <rect x="3" y="4" width="18" height="16" rx="3" /><path d="m7 9 3 3-3 3M13 15h4" />
            break;
        case "send-chat":
            <path d="M4 5h16v11H9l-5 4zM8 9h8M8 12h5" /><path d="m16 18 4 2-2-4" />
            break;
        case "play-overlay-cue":
            <rect x="3" y="4" width="18" height="15" rx="2" /><path d="m10 8 6 3.5-6 3.5zM8 22h8" />
            break;
        case "competition-lifecycle":
            <path d="M8 4h8v3a4 4 0 0 1-8 0zM8 6H4v2a3 3 0 0 0 4 3M16 6h4v2a3 3 0 0 1-4 3M12 11v5M8 21h8M9 16h6" /><path d="M3 16a4 4 0 0 1 4-4M3 16l-1-3M3 16l3-1M21 16a4 4 0 0 0-4-4M21 16l1-3M21 16l-3-1" />
            break;
        case "condition":
            <path d="m12 3 7 7-7 7-7-7zM12 17v4M5 10H2M19 10h3" /><path d="m9.5 10 1.5 1.5 3-3" />
            break;
        case "merge-branches":
            <circle cx="6" cy="5" r="2.5" /><circle cx="18" cy="5" r="2.5" /><circle cx="12" cy="19" r="2.5" /><path d="M6 7.5v2.25A4.25 4.25 0 0 0 10.25 14H12v2.5M18 7.5v2.25A4.25 4.25 0 0 1 13.75 14H12" />
            break;
        case "delay":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2M9 2h6" />
            break;
        case "stream-online":
            <rect x="6" y="5" width="12" height="14" rx="2" /><path d="m10 9 5 3-5 3zM3 8a7 7 0 0 0 0 8M21 8a7 7 0 0 1 0 8" />
            break;
        case "stream-offline":
            <rect x="6" y="5" width="12" height="14" rx="2" /><path d="M3 3l18 18M3 8a7 7 0 0 0 0 8M21 8a7 7 0 0 1 0 8" />
            break;
        case "follow":
            <path d="M12 20S4 15 4 9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6-6 11-6 11zM18 3v6M15 6h6" />
            break;
        case "subscription":
            <path d="m12 3 2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.9z" /><circle cx="12" cy="12" r="2" />
            break;
        case "subscription-gift":
            <rect x="3" y="9" width="18" height="12" rx="2" /><path d="M12 9v12M3 13h18M7 9c-3 0-3-5 0-5 2 0 5 5 5 5M17 9c3 0 3-5 0-5-2 0-5 5-5 5" />
            break;
        case "cheer":
            <path d="m12 2 7 6-3 10-4 4-4-4L5 8zM12 2v20M5 8h14" /><path d="m14 7-4 6h3l-2 4" />
            break;
        case "incoming-raid":
            <circle cx="8" cy="8" r="3" /><circle cx="17" cy="7" r="2" /><path d="M2 20c0-4 2-7 6-7s6 3 6 7M14 13c3 0 5 2 5 5M22 11h-6M18 8l-3 3 3 3" />
            break;
        case "hype-train-begin":
            <path d="M4 15V7h11l4 5v3zM7 15v3M16 15v3M3 18h17" /><path d="M8 3v6M5 6h6" />
            break;
        case "hype-train-progress":
            <path d="M3 16V8h11l4 4v4zM6 16v3M15 16v3M2 19h18M6 12h2M11 12h2" /><path d="M20 17V7M17 10l3-3 3 3" />
            break;
        case "hype-train-end":
            <path d="M3 16V8h11l4 4v4zM6 16v3M15 16v3M2 19h18" /><path d="M20 4v9M20 4h-5l2 2-2 2h5" />
            break;
        case "chat-notification":
            <path d="M6 8a6 6 0 0 1 12 0v5l2 3H4l2-3zM9 19h6" /><path d="M9 8h6M9 11h4" />
            break;
        case "reward-redemption":
            <path d="M4 7h16v4a2 2 0 0 0 0 4v4H4v-4a2 2 0 0 0 0-4z" /><path d="m12 9 1 2 2 .3-1.5 1.5.4 2.2-1.9-1-1.9 1 .4-2.2L9 11.3l2-.3z" />
            break;
        case "fulfil-redemption":
            <path d="M4 7h16v4a2 2 0 0 0 0 4v4H4v-4a2 2 0 0 0 0-4z" /><path d="m9 13 2 2 4-5" />
            break;
        case "cancel-redemption":
            <path d="M4 7h16v4a2 2 0 0 0 0 4v4H4v-4a2 2 0 0 0 0-4z" /><path d="m9 10 6 6M15 10l-6 6" />
            break;
        case "shoutout-sent":
            <path d="m4 10 11-5v14L4 14zM15 9h3l3 3-3 3h-3M6 14l2 6h4l-2-5" />
            break;
        case "shoutout-received":
            <path d="m20 10-11-5v14l11-5zM9 9H6l-3 3 3 3h3M18 14l-2 6h-4l2-5" />
            break;
        case "poll-started":
            <path d="M4 20V10h3v10M10 20V6h3v14M16 20V3h3v17M3 20h18" /><path d="M3 5h5M5.5 2.5v5" />
            break;
        case "poll-progressed":
            <path d="M4 20v-7h3v7M10 20V9h3v11M16 20V5h3v15M3 20h18" /><path d="m3 8 5-3 5 2 7-4" />
            break;
        case "poll-ended":
            <path d="M4 20v-7h3v7M10 20V9h3v11M16 20V5h3v15M3 20h18" /><path d="m4 5 2 2 4-4" />
            break;
        case "prediction-started":
            <path d="M12 20V9M12 9 6 4M12 9l6-5M5 20h14" /><circle cx="6" cy="4" r="2" /><circle cx="18" cy="4" r="2" /><path d="M3 12h6M6 9v6" />
            break;
        case "prediction-progressed":
            <path d="M12 21V10M12 10 6 5M12 10l6-5M5 21h14" /><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><path d="m15 16 2-2 2 2 3-4" />
            break;
        case "prediction-locked":
            <path d="M11 21V11M11 11 6 6M11 11l5-5M4 21h14" /><circle cx="6" cy="6" r="2" /><circle cx="16" cy="6" r="2" /><rect x="16" y="13" width="6" height="6" rx="1" /><path d="M17.5 13v-2a1.5 1.5 0 0 1 3 0v2" />
            break;
        case "prediction-ended":
            <path d="M12 21V10M12 10 6 5M12 10l6-5M5 21h14" /><circle cx="6" cy="5" r="2" /><circle cx="18" cy="5" r="2" /><path d="m15 16 2 2 4-5" />
            break;
        case "send-shoutout":
            <path d="m3 10 11-5v14L3 14zM5 14l2 6h4l-2-5M16 9h5M18 6l3 3-3 3" />
            break;
        case "start-poll":
            <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4V2h6v2M9 10h6M12 7v6M9 16h6" />
            break;
        case "end-poll":
            <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4V2h6v2M9 11l2 2 4-5M9 17h6" />
            break;
        case "create-clip":
            <circle cx="6" cy="7" r="3" /><circle cx="6" cy="17" r="3" /><path d="m8.5 8.5 10 7M8.5 15.5 18 9M15 5l6 4-6 4z" />
            break;
        case "create-marker":
            <path d="M6 21V4M6 5h10l-2 4 2 4H6" /><path d="M18 15v6M15 18h6" />
            break;
        case "start-prediction":
            <path d="M8 4h8v3a4 4 0 0 1-8 0zM8 6H4v2a3 3 0 0 0 4 3M16 6h4v2a3 3 0 0 1-4 3M12 11v5M8 21h8M9 16h6" /><path d="M3 16h5M5.5 13.5v5" />
            break;
        case "lock-prediction":
            <path d="M7 3h8v3a4 4 0 0 1-8 0zM7 5H3v2a3 3 0 0 0 4 3M15 5h4v2a3 3 0 0 1-4 3M11 10v4M7 19h7" /><rect x="14" y="14" width="8" height="7" rx="1" /><path d="M16 14v-2a2 2 0 0 1 4 0v2" />
            break;
        case "cancel-prediction":
            <path d="M8 3h8v3a4 4 0 0 1-8 0zM8 5H4v2a3 3 0 0 0 4 3M16 5h4v2a3 3 0 0 1-4 3M12 10v5M8 20h8M9 15h6" /><path d="m17 14 5 5M22 14l-5 5" />
            break;
        case "resolve-prediction":
            <path d="M8 3h8v3a4 4 0 0 1-8 0zM8 5H4v2a3 3 0 0 0 4 3M16 5h4v2a3 3 0 0 1-4 3M12 10v5M8 20h8M9 15h6" /><path d="m16 16 2 2 4-5" />
            break;
        default:
            <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9zM8 12h8M12 8v8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public AutomationDefinitionId DefinitionId { get; set; }
}

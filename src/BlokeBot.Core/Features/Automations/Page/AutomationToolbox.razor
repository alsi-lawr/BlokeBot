<EditorToolbox @ref="_presentation" Id="automation-toolbox" Class="automation-toolbox" Purpose="Add a node"
               Search="@_search" SearchChanged="SearchChanged" SearchPlaceholder="Search all categories" SearchShortcut="/"
               SearchAttributes="_searchAttributes" ResultsTitle="@_resultsTitle" Count="_items.Length"
               ResultsRole="tabpanel" ResultsLabelledBy="@_activeTabId" EmptyMessage="No nodes match this search."
               Close="Close" data-automation-toolbox>
    <Tabs>
    <div class="automation-toolbox-tabs" role="tablist" aria-label="Toolbox categories">
        <button type="button" role="tab" id="automation-toolbox-tab-triggers" aria-controls="automation-toolbox-panel" aria-selected="@Selected(AutomationToolboxCategory.Triggers)" tabindex="@TabIndex(AutomationToolboxCategory.Triggers)" @ref="_triggerTab" @onclick="() => SelectCategory(AutomationToolboxCategory.Triggers)" @onkeydown="args => HandleTabKeyAsync(AutomationToolboxCategory.Triggers, args)">Triggers</button>
        <button type="button" role="tab" id="automation-toolbox-tab-values" aria-controls="automation-toolbox-panel" aria-selected="@Selected(AutomationToolboxCategory.Values)" tabindex="@TabIndex(AutomationToolboxCategory.Values)" @ref="_valueTab" @onclick="() => SelectCategory(AutomationToolboxCategory.Values)" @onkeydown="args => HandleTabKeyAsync(AutomationToolboxCategory.Values, args)">Values</button>
        <button type="button" role="tab" id="automation-toolbox-tab-transforms" aria-controls="automation-toolbox-panel" aria-selected="@Selected(AutomationToolboxCategory.Transforms)" tabindex="@TabIndex(AutomationToolboxCategory.Transforms)" @ref="_transformTab" @onclick="() => SelectCategory(AutomationToolboxCategory.Transforms)" @onkeydown="args => HandleTabKeyAsync(AutomationToolboxCategory.Transforms, args)">Transforms</button>
        <button type="button" role="tab" id="automation-toolbox-tab-control" aria-controls="automation-toolbox-panel" aria-selected="@Selected(AutomationToolboxCategory.Control)" tabindex="@TabIndex(AutomationToolboxCategory.Control)" @ref="_controlTab" @onclick="() => SelectCategory(AutomationToolboxCategory.Control)" @onkeydown="args => HandleTabKeyAsync(AutomationToolboxCategory.Control, args)">Control</button>
        <button type="button" role="tab" id="automation-toolbox-tab-actions" aria-controls="automation-toolbox-panel" aria-selected="@Selected(AutomationToolboxCategory.Actions)" tabindex="@TabIndex(AutomationToolboxCategory.Actions)" @ref="_actionTab" @onclick="() => SelectCategory(AutomationToolboxCategory.Actions)" @onkeydown="args => HandleTabKeyAsync(AutomationToolboxCategory.Actions, args)">Actions</button>
    </div>

    </Tabs>
    <ChildContent>
        @foreach (var item in _items)
        {
            <EditorToolboxRow @key="item.Definition.Id" Class="automation-toolbox-row" Name="@item.Definition.Display.Name"
                              Purpose="@item.Definition.Display.Description" AccessibleLabel="@AccessibleLabel(item)"
                              Badge="@(_searching ? AutomationToolboxCatalog.CategoryLabel(item.Category) : null)"
                              Available="item.IsAvailable" Status="@(!item.IsAvailable ? ShortUnavailableReason(item) : null)"
                              StatusWarning="@(!item.IsAvailable)" Activate="() => AddAsync(item)">
                <Icon><AutomationNodeIcon DefinitionId="item.Definition.Id" /></Icon>
            </EditorToolboxRow>
        }
    </ChildContent>
</EditorToolbox>

@using System.Collections.Immutable

@foreach (var inputs in new[] { true, false })
{
    var ports = inputs ? Contract.Inputs : Contract.Outputs;
    <section class="automation-authoring-section">
    <h3>@(inputs ? "Inputs" : "Outputs")</h3>
        @for (var i = 0; i < ports.Length; i++)
        {
            var index = i;
            var port = ports[index];
            <div class="automation-interface-port">
                <div class="automation-interface-fields">
                <label class="field">
                <span class="field__label">Port name</span>
                <input class="field__input" value="@port.Id.Value" @onchange="args => Update(inputs, index, port with { Id = new(args.Value?.ToString() ?? string.Empty), Name = args.Value?.ToString() ?? string.Empty, Description = args.Value?.ToString() ?? string.Empty })" />
                </label>
                <label class="field">
                <span class="field__label">Type</span>
                <select class="field__input" value="@port.ValueType" @onchange="args => ChangeType(inputs, index, port, args)">@foreach (var type in _types) { <option value="@type">@type</option> }</select>
                </label>
                </div>
                <div class="automation-port-options">
                <label>
                <input type="checkbox" checked="@(port.Nullability == AutomationPortNullability.Nullable)" @onchange="args => Update(inputs, index, port with { Nullability = args.Value is true ? AutomationPortNullability.Nullable : AutomationPortNullability.NonNullable })" /> Nullable</label>
                <label>
                <input type="checkbox" checked="@(port.Sensitivity == AutomationDataSensitivity.Sensitive)" @onchange="args => Update(inputs, index, port with { Sensitivity = args.Value is true ? AutomationDataSensitivity.Sensitive : AutomationDataSensitivity.Safe })" /> Sensitive</label>
                <button class="btn-secondary" type="button" aria-label="@($"Remove {port.Name}")" @onclick="() => Remove(inputs, index)">Remove</button>
                </div>
            </div>
        }
        <button class="btn-secondary" type="button" disabled="@(ports.Length >= 32)" @onclick="() => Add(inputs)">Add @(inputs ? "input" : "output")</button>
    </section>
}

@code {
    [Parameter, EditorRequired] public required AutomationSubflowInterface Contract { get; set; }
    [Parameter] public EventCallback<AutomationSubflowInterface> Changed { get; set; }
    private static readonly AutomationPortValueType[] _types = Enum.GetValues<AutomationPortValueType>().Where(type => type != AutomationPortValueType.Flow).ToArray();
    private Task Update(bool inputs, int index, AutomationPortMetadata port) => Changed.InvokeAsync(inputs ? Contract with { Inputs = Contract.Inputs.SetItem(index, port) } : Contract with { Outputs = Contract.Outputs.SetItem(index, port) });
    private Task Remove(bool inputs, int index) => Changed.InvokeAsync(inputs ? Contract with { Inputs = Contract.Inputs.RemoveAt(index) } : Contract with { Outputs = Contract.Outputs.RemoveAt(index) });
    private Task ChangeType(bool inputs, int index, AutomationPortMetadata port, ChangeEventArgs args) => Enum.TryParse<AutomationPortValueType>(args.Value?.ToString(), out var type) ? Update(inputs, index, port with { ValueType = type }) : Task.CompletedTask;
    private Task Add(bool inputs)
    {
        var ports = inputs ? Contract.Inputs : Contract.Outputs;
        var prefix = inputs ? "input" : "output";
        var sequence = 1;
        while (ports.Any(port => port.Id.Value == $"{prefix}-{sequence}")) sequence++;
        var name = $"{prefix}-{sequence}";
        var added = ports.Add(new(new(name), name, name, AutomationPortValueType.Text));
        return Changed.InvokeAsync(inputs ? Contract with { Inputs = added } : Contract with { Outputs = added });
    }
}

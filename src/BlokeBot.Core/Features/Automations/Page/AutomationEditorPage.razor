@page "/automations"
@using BlokeBot.Core.Features.Overlays
@using BlokeBot.Eventing
@using BlokeBot.Persistence
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Routing
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@implements IAsyncDisposable
@inject AutomationCatalogService _catalogService
@inject AutomationFlowService _flowsService
@inject AutomationRunQueryService _runsService
@inject IDbContextFactory<BlokeBotDbContext> _dbFactory
@inject IOverlayCueAdmissionService _overlayCues
@inject EventBus<AppEventKind> _events
@inject IJSRuntime _js
@inject NavigationManager _navigation

<PageTitle>BlokeBot | Visual automations</PageTitle>
<NavigationLock ConfirmExternalNavigation="@_hasChanges"
                OnBeforeInternalNavigation="HandleInternalNavigation" />

<DashboardPage Kicker="Automation"
               Title="Visual automations"
               Description="Connect triggers to conditions and actions. Validate the flow before you enable it."
               Width="DashboardPageWidth.Wide"
               data-automation-editor-page>
    @if (_loadFailed)
    {
        <PageState Kind="PageStateKind.Failure"
                   Title="BlokeBot cannot load automations"
                   Description="Your saved flows and run history did not change.">
            <Actions><button class="btn-primary" type="button" @onclick="LoadAsync">Retry</button></Actions>
        </PageState>
    }
    else if (_loading)
    {
        <PageState Kind="PageStateKind.Loading"
                   Title="Loading visual automations"
                   Description="BlokeBot loads the flows and the node library." />
    }
    else if (Host is null)
    {
        <PageState Kind="PageStateKind.Empty"
                   Title="Choose a channel"
                   Description="Choose a channel. Then, build or inspect its automation flows." />
    }
    else if (!_featureEnabled)
    {
        <PageState Kind="PageStateKind.Unavailable"
                   Title="Automations are off"
                   Description="Saved flows and run history remain. Turn on Automations to edit, validate, test, or enable a flow.">
            <Actions><a class="btn-primary" href="/host#chat-tools">Open Channel setup</a></Actions>
        </PageState>
    }
    else
    {
        <div class="automation-page-actions">
            <button class="btn-primary" type="button" @onclick="RequestNewFlowAsync">+ New flow</button>
        </div>

        @if (_flowRecoveryMessage is not null)
        {
            <PageState Kind="PageStateKind.Unavailable"
                       Title="This flow needs a node provider"
                       Description="@_flowRecoveryMessage">
                <Actions><a class="btn-primary" href="/host#chat-tools">Open Channel setup</a></Actions>
            </PageState>
        }
        else if (_editor is null)
        {
            <section class="automation-empty card">
                <span class="automation-empty-icon" aria-hidden="true">⌘</span>
                <h2>Create your first visual automation</h2>
                <p>Add a trigger. Then, connect an action and validate the flow.</p>
                <button class="btn-primary" type="button" @onclick="RequestNewFlowAsync">Create flow</button>
            </section>
        }
        else
        {
            <section class="@_editorClass" aria-label="Visual automation editor" data-editor-mode="@ModeToken(_mode)">
                @if (!_focusMode || !_editorToolsCollapsed)
                {
                <header class="automation-editor-bar">
                    <div class="automation-flow-name">
                        <label for="automation-flow-name">Flow name</label>
                        <input id="automation-flow-name"
                               maxlength="200"
                               value="@_editor.Name"
                               @oninput="RenameFlow" />
                        <span>@_flowSubtitle</span>
                    </div>
                    <div class="automation-editor-actions">
                        <div class="automation-mode-switch" role="group" aria-label="Editor view">
                            <button type="button" data-automation-mode="grid" aria-pressed="@(_mode == AutomationEditorMode.Grid)" @onclick="() => SetMode(AutomationEditorMode.Grid)">Grid</button>
                            <button type="button" data-automation-mode="list" aria-pressed="@(_mode == AutomationEditorMode.List)" @onclick="() => SetMode(AutomationEditorMode.List)">List</button>
                        </div>
                        <span class="@_validationClass" role="status">@_validationLabel</span>
                        <button class="automation-node-library-button" type="button" aria-expanded="@_nodeLibraryOpen" @onclick="ToggleNodeLibrary">+ Node</button>
                        <button class="btn-secondary" type="button" disabled="@_busy" @onclick="ValidateAsync">Validate</button>
                        <button class="btn-secondary" type="button" disabled="@(_busy || _editor.Nodes.Count == 0)" data-automation-test-flow @onclick="RunSampleAsync">Test flow</button>
                        <button class="btn-secondary" type="button" disabled="@_busy" @onclick="SaveAsync">Save</button>
                        @if (_focusMode)
                        {
                            <button class="automation-focus-action" type="button" @onclick="ToggleEditorTools">Hide tools</button>
                        }
                        <button class="@(_editor.IsEnabled ? "btn-secondary" : "btn-primary")"
                                type="button"
                                disabled="@(_busy || _editor.Id is null || _hasChanges)"
                                title="@(_hasChanges ? "Save the flow before you change its state." : null)"
                                @onclick="ToggleEnabledAsync">@(_editor.IsEnabled ? "Disable" : _enableConfirmation ? "Enable anyway" : "Enable")</button>
                    </div>
                </header>
                }

                <div class="automation-focus-controls" role="group" aria-label="Editor focus controls" data-automation-focus-controls>
                    <button type="button"
                            aria-label="@(_focusMode ? "Exit Focus" : "Focus")"
                            aria-pressed="@(_focusMode ? "true" : "false")"
                            title="@(_focusMode ? "Exit Focus" : "Focus")"
                            @onclick="ToggleFocusMode">
                        <AutomationIcon Name="focus" />
                    </button>
                    <button type="button"
                            aria-label="@(_browserFullscreen ? "Exit Full screen" : "Full screen")"
                            aria-pressed="@(_browserFullscreen ? "true" : "false")"
                            title="@(_browserFullscreen ? "Exit Full screen" : "Full screen")"
                            @onclick="ToggleBrowserFullscreenAsync">
                        <AutomationIcon Name="fullscreen" />
                    </button>
                </div>

                <div class="automation-editor-notices">
                    @if (_feedback is not null)
                    {
                        <div class="@($"automation-feedback{(_operationFailed ? " automation-feedback--error" : string.Empty)}{(_feedbackFading ? " automation-feedback--fading" : string.Empty)}")"
                             role="@(_operationFailed ? "alert" : "status")">@_feedback</div>
                    }
                    @if (_unavailableDefinitionIds.Count > 0)
                    {
                        <div class="automation-capability-recovery" role="alert">
                            <span>One or more nodes need a channel tool that is off.</span>
                            <a href="/host#chat-tools">Open Channel setup</a>
                        </div>
                    }
                    @if (_enableConfirmation)
                    {
                        <div class="automation-enable-warning" role="alert">
                            <div>
                                <strong>This flow can affect your live channel</strong>
                                <span>@_impactWarning</span>
                            </div>
                            <button type="button" @onclick="CancelEnable">Cancel</button>
                        </div>
                    }
                </div>

                <div class="@_editorBodyClass">
                    @if (!_focusMode || !_flowRailCollapsed)
                    {
                    <aside class="automation-flow-rail" aria-label="Flow library">
                        <div class="automation-flow-rail-heading">
                            <strong>Flows</strong>
                            <span>
                                @if (_focusMode)
                                {
                                    <button type="button" aria-label="Hide flow list" @onclick="ToggleFlowRail">‹</button>
                                }
                                <button type="button" aria-label="New flow" @onclick="RequestNewFlowAsync">+</button>
                            </span>
                        </div>
                        @foreach (var flow in _flowSnapshots)
                        {
                            <button @key="flow.Draft.Id"
                                    type="button"
                                    class="@(flow.Draft.Id == _editor.Id ? "automation-flow-item automation-flow-item--active" : "automation-flow-item")"
                                    @onclick="() => RequestSelectFlowAsync(flow)">
                                <strong>@FlowDisplayName(flow)</strong>
                                <span><span><i class="@FlowStatusDotClass(flow)"></i>@FlowStatusLabel(flow)</span><span>@flow.Draft.Nodes.Length nodes</span></span>
                            </button>
                        }
                        @if (_editor.Id is null)
                        {
                            <div class="automation-flow-item automation-flow-item--active">
                                <strong>@_editor.Name</strong>
                                <span><span><i class="automation-status-dot automation-status-dot--draft"></i>Not saved</span><span>@_editor.Nodes.Count nodes</span></span>
                            </div>
                        }
                        @if (_editor.Id is not null)
                        {
                            <div class="automation-flow-rail-actions">
                                <button type="button" @onclick="RequestDuplicateAsync">Duplicate</button>
                                <button type="button" @onclick="RequestDelete">@(_deleteConfirmation ? "Confirm delete" : "Delete")</button>
                            </div>
                        }
                        <p>Flows use the selected channel. Duplicating copies the graph, not run history.</p>
                    </aside>
                    }

                    <div class="automation-workspace" role="region" aria-label="Flow workspace">
                        @if (_mode == AutomationEditorMode.Grid)
                        {
                            <AutomationFlowCanvas @ref="_canvas"
                                                  Nodes="_editor.Nodes"
                                                  Edges="_editor.Edges"
                                                  SelectedNodeIds="_selectedNodeIds"
                                                  SelectedEdgeId="_selectedEdgeId"
                                                  Errors="_validationErrors"
                                                  SampleOutcomes="_sampleOutcomes"
                                                  Settings="_editor.Canvas"
                                                  ViewportKey="_canvasViewportKey"
                                                  SelectionChanged="ChangeCanvasSelection"
                                                  MoveNodes="MoveNodes"
                                                  DeleteNodes="DeleteNodes"
                                                  DeleteEdge="DeleteEdge"
                                                  Connect="ConnectNodes"
                                                  ConnectionRejected="RejectConnection"
                                                  SettingsChanged="ChangeCanvasSettings" />
                        }
                        else
                        {
                            <AutomationFlowList @ref="_list"
                                                Nodes="_editor.Nodes"
                                                Edges="_editor.Edges"
                                                SelectedNodeId="_selectedNodeId"
                                                Errors="_validationErrors"
                                                SampleOutcomes="_sampleOutcomes"
                                                SelectNode="SelectNode"
                                                DeleteNode="DeleteNode" />
                        }
                    </div>

                    @if (_selectedNode is not null)
                    {
                        <AutomationNodeInspector Node="_selectedNode"
                                                 Nodes="_editor.Nodes"
                                                 Edges="_editor.Edges"
                                                 Errors="_validationErrors"
                                                 ReferenceChoices="_referenceChoices"
                                                 Changed="EditorChanged"
                                                 ClearSelection="CloseInspector"
                                                 Connect="ConnectNodes"
                                                 DeleteEdge="DeleteEdge"
                                                 DeleteNode="DeleteNode" />
                    }
                </div>

                @if (!_focusMode || !_runDrawerCollapsed)
                {
                <footer class="automation-run-drawer" data-automation-run-kind="@(_sampleOutcomes.IsEmpty ? "history" : "sample")">
                    <div class="automation-run-summary">
                        <span class="@_runIconClass" aria-hidden="true">@_runIcon</span>
                        <div><strong>@_runTitle</strong><span>@_runDescription</span></div>
                    </div>
                    <div class="automation-run-actions">
                        @if (_focusMode)
                        {
                            <button class="btn-secondary" type="button" @onclick="ToggleRunDrawer">Hide runs</button>
                        }
                        <button class="btn-secondary" type="button" disabled="@(_recentRuns.Length == 0)" @onclick="ShowRunDetails">Run details</button>
                        <button class="btn-secondary" type="button" disabled="@(_busy || _editor.Nodes.Count == 0)" @onclick="RunSampleAsync">Test again</button>
                    </div>
                </footer>
                }

                @if (_focusMode)
                {
                    @if (_flowRailCollapsed)
                    {
                        <button class="automation-restore-tab automation-restore-tab--flows" type="button" @onclick="ToggleFlowRail">Flows</button>
                    }
                    @if (_editorToolsCollapsed)
                    {
                        <button class="automation-restore-tab automation-restore-tab--tools" type="button" @onclick="ToggleEditorTools">Tools</button>
                    }
                    @if (_runDrawerCollapsed)
                    {
                        <button class="automation-restore-tab automation-restore-tab--runs" type="button" @onclick="ToggleRunDrawer">Runs</button>
                    }
                }
            </section>
        }

        @if (_nodeLibraryOpen && _editor is not null)
        {
            <div class="automation-node-library-backdrop" @onclick="CloseNodeLibrary">
                <section class="automation-node-library-panel"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="automation-node-library-title"
                         @onclick:stopPropagation="true">
                    <header>
                        <div>
                            <strong id="automation-node-library-title">Node library</strong>
                            <span>@(_editor.Nodes.Count == 0 ? "Select a trigger." : "Select a node.")</span>
                        </div>
                        <button type="button" aria-label="Close the node library" @onclick="CloseNodeLibrary">×</button>
                    </header>
                    <label class="automation-node-search">
                        <span>Search nodes</span>
                        <input type="search" placeholder="Search by name or category" @bind="_nodeSearch" @bind:event="oninput" />
                    </label>
                    @foreach (var group in _filteredDefinitions.GroupBy(definition => definition.Display.Category).OrderBy(static group => group.Key))
                    {
                        <section>
                            <h3>@group.Key</h3>
                            @foreach (var definition in group)
                            {
                                <button type="button"
                                        disabled="@(!DefinitionIsAvailable(definition))"
                                        title="@DefinitionUnavailableReason(definition)"
                                        @onclick="() => AddNode(definition)">
                                    <span class="automation-node-kind automation-node-kind--@KindToken(definition.Kind)">@KindLabel(definition.Kind)</span>
                                    <strong>@definition.Display.Name</strong>
                                    <small>@DefinitionLibraryHelp(definition)</small>
                                </button>
                            }
                        </section>
                    }
                    @if (!_filteredDefinitions.Any())
                    {
                        <p class="automation-node-search-empty">No nodes match this search.</p>
                    }
                </section>
            </div>
        }
    }
</DashboardPage>

@if (_dirtyDialogOpen)
{
    <div class="automation-dirty-dialog-backdrop" @onclick="CancelDirtyTransition">
        <section class="automation-dirty-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="automation-dirty-dialog-title"
                 @onclick:stopPropagation="true">
            <h2 id="automation-dirty-dialog-title">Are you sure?</h2>
            <p>This flow has unsaved changes. Save the flow, discard the changes, or stay on this flow.</p>
            <div class="automation-dirty-dialog-actions">
                <button class="btn-secondary" type="button" disabled="@_busy" @onclick="CancelDirtyTransition">Cancel</button>
                <button class="automation-danger-button" type="button" disabled="@_busy" @onclick="DiscardDirtyTransitionAsync">Discard</button>
                <button class="btn-primary" type="button" disabled="@_busy" autofocus @onclick="SaveDirtyTransitionAsync">Save</button>
            </div>
        </section>
    </div>
}

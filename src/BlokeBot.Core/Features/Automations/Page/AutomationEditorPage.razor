@using System.Collections.Immutable
@page "/automations"
@using BlokeBot.Core.Features.Overlays
@using BlokeBot.Eventing
@using BlokeBot.Persistence
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Routing
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@implements IAsyncDisposable
@inject AutomationCatalogService _catalogService
@inject AutomationFlowService _flowsService
@inject AutomationManualRunService _manualRuns
@inject AutomationScenarioService _scenariosService
@inject AutomationTraceStore _tracesService
@inject AutomationSubflowService _subflowsService
@inject AutomationRunQueryService _runsService
@inject IDbContextFactory<BlokeBotDbContext> _dbFactory
@inject IOverlayCueAdmissionService _overlayCues
@inject EventBus<AppEventKind> _events
@inject IJSRuntime _js
@inject NavigationManager _navigation

<PageTitle>BlokeBot | Visual automations</PageTitle>
<NavigationLock ConfirmExternalNavigation="@_hasChanges"
                OnBeforeInternalNavigation="HandleInternalNavigation" />

<DashboardPage Kicker="Automation"
               Title="Visual automations"
               Width="DashboardPageWidth.Wide"
               data-automation-editor-page>
    @if (_loadFailed)
    {
        <PageState Kind="PageStateKind.Failure"
                   Title="BlokeBot cannot load automations">
            <Actions><button class="btn-primary" type="button" @onclick="LoadAsync"><EditorIcon Name="history" />Retry</button></Actions>
        </PageState>
    }
    else if (_loading)
    {
        <PageState Kind="PageStateKind.Loading"
                   Title="Loading visual automations" />
    }
    else if (Host is null)
    {
        <PageState Kind="PageStateKind.Empty"
                   Title="Choose a channel"
                   Description="Choose a channel. Then, build or inspect its automation flows." />
    }
    else if (!_featureEnabled)
    {
        <PageState Kind="PageStateKind.Unavailable"
                   Title="Automations are off">
            <Actions><a class="btn-primary" href="/host#chat-tools">Open Channel setup</a></Actions>
        </PageState>
        @if (!_recentRuns.IsEmpty)
        {
            <AutomationRunDrawer Visible="true"
                                 FocusMode="false"
                                 HasRecentRuns="true"
                                 CanRunSample="false"
                                 Kind="history"
                                 IconClass="@_runIconClass"
                                 Icon="@_runIcon"
                                 Title="@_runTitle"
                                 Description="@_runDescription"
                                 ShowDetails="ShowRunDetails" />
            @if (_feedback is not null)
            {
                <div class="automation-feedback" role="status">@_feedback</div>
            }
        }
    }
    else
    {
        @if (!_focusMode || _editor is null || _flowRecoveryMessage is not null)
        {
            @CreationActions
        }

        @if (_sourceFlowId is not null)
        {
            <EditorWorkspace @ref="_workspace" Class="automation-editor automation-editor--repair automation-editor--source"
                             FocusChanged="WorkspaceFocusChanged" InteropFailure="WorkspaceInteropFailure" aria-label="Flow JSON repair">
                <header class="automation-editor-bar"><div class="automation-flow-name"><h2>@_sourceName</h2><span>JSON repair · @(_sourceEnabled ? "Enabled" : "Disabled") · @(_hasChanges ? "Unsaved changes" : "Original stored values")</span><span>Flow @_sourceFlowId.Value.Value · @_sourceProviderStatus</span></div></header>
                <div class="automation-editor-body">
                    @RepairRail
                    <AutomationFlowSource Text="@_sourceText" TextChanged="ChangeSourceAsync" Status="@_sourceStatus" Errors="_sourceErrors"
                                          Busy="_busy" Enabled="_sourceEnabled" Validated="_sourceValidated" FocusRequest="_sourceFocusRequest"
                                          Parse="ParseSource" Validate="ValidateSourceAsync" Save="SaveAsync" />
                </div>
            </EditorWorkspace>
        }
        else if (_editor is null)
        {
            <section class="automation-empty card">
                <span class="automation-empty-icon" aria-hidden="true">⌘</span>
                <h2>Create your first visual automation</h2>
                <button class="btn-primary" type="button" @onclick="RequestNewFlowAsync"><EditorIcon Name="add" />Create flow</button>
            </section>
        }
        else
        {
            <EditorWorkspace @ref="_workspace" Class="@($"{_editorClass}{(_authoringEntries.IsEmpty ? "" : " automation-editor--repair")}")" FocusChanged="WorkspaceFocusChanged" InteropFailure="WorkspaceInteropFailure"
                     aria-label="Visual automation editor"
                     data-editor-mode="@ModeToken(_mode)"
                     data-editor-menu-context="@_menuContext"
                     data-automation-editor-history>
                @if (_focusMode)
                {
                    @CreationActions
                }
                <AutomationEditorHeader Visible="@(!_focusMode || !_editorToolsCollapsed)"
                                        Name="@_editor.Name"
                                        Subtitle="@_flowSubtitle"
                                        GridSelected="@(_mode == AutomationEditorMode.Grid)"
                                        ListSelected="@(_mode == AutomationEditorMode.List)"
                                        ValidationClass="@_validationClass"
                                        ValidationLabel="@_validationLabel"
                                        Busy="_busy"
                                        HasNodes="@(_editor.Nodes.Count > 0)"
                                        FocusMode="_focusMode"
                                        Enabled="_editor.IsEnabled"
                                        Saved="@(_editor.Id is not null)"
                                        HasChanges="_hasChanges"
                                        EnableConfirmation="_enableConfirmation"
                                        NameChanged="RenameFlow"
                                        SelectGrid="@(() => SetMode(AutomationEditorMode.Grid))"
                                        SelectList="@(() => SetMode(AutomationEditorMode.List))"
                                        Validate="ValidateAsync"
                                        Test="OpenScenariosAsync"
                                        CanRun="@_editor.Nodes.Any(n=>n.Definition.Id==AutomationDefinitionIds.ManualSource)"
                                        Run="RunSavedFlowAsync"
                                        Subflow="@(_editor.Subflow is not null)"
                                        Save="SaveAsync"
                                        Hide="ToggleEditorTools"
                                        ToggleEnabled="ToggleEnabledAsync" />

                <div class="automation-editor-notices">
                    @if (_feedback is not null)
                    {
                        <div class="@($"automation-feedback{(_operationFailed ? " automation-feedback--error" : string.Empty)}{(_feedbackFading ? " automation-feedback--fading" : string.Empty)}")"
                             role="@(_operationFailed ? "alert" : "status")">@_feedback</div>
                    }
                    @if (_unavailableDefinitionIds.Count > 0)
                    {
                        <div class="automation-capability-recovery" role="alert">
                            <span>One or more nodes need a channel tool that is off.</span>
                            <a href="/host#chat-tools">Open Channel setup</a>
                        </div>
                    }
                    @if (_enableConfirmation)
                    {
                        <div class="automation-enable-warning" role="alert">
                            <div>
                                <strong>This flow can affect your live channel</strong>
                                <span>@_impactWarning</span>
                            </div>
                            <button type="button" @onclick="CancelEnable"><EditorIcon Name="cancel" />Cancel</button>
                        </div>
                    }
                </div>

                @if (_nodeLibraryOpen)
                {
                    <div class="automation-toolbox-backdrop" @onclick="CloseNodeLibraryAsync" aria-hidden="true"></div>
                }

                <div class="@_editorBodyClass">
                    <AutomationFlowRail Visible="@(!_focusMode || !_flowRailCollapsed)"
                                        FocusMode="_focusMode"
                                        Flows="_flowSnapshots"
                                        RepairItems="RepairItems"
                                        CurrentFlowId="_editor.Id"
                                        CurrentName="@_editor.Name"
                                        CurrentNodeCount="_editor.Nodes.Count"
                                        Validated="_validated"
                                        ValidationErrorsEmpty="_validationErrors.IsEmpty"
                                        DeleteConfirmation="_deleteConfirmation"
                                        Toggle="ToggleFlowRail"
                                        Library="_libraryKind"
                                        LibraryChanged="ChangeLibraryAsync"
                                        EditingSubflow="@(_editor.Subflow is not null)"
                                        CurrentSubflowId="_editor.Subflow?.Id"
                                        Subflows="_subflowPage"
                                        SubflowSearch="@_subflowSearch"
                                        SubflowOffset="_subflowOffset"
                                        SubflowsLoading="_subflowLoading"
                                        SearchSubflows="SearchSubflowsAsync"
                                        PageSubflows="LoadSubflowPageAsync"
                                        SelectSubflow="SelectLibrarySubflowAsync"
                                        Select="RequestSelectFlowAsync"
                                        Duplicate="RequestDuplicateAsync"
                                        Delete="RequestDelete" />

                    @if (_nodeLibraryOpen)
                    {
                        <AutomationToolbox @ref="_toolbox"
                                           Definitions="_definitions"
                                           Nodes="_editor.Nodes"
                                           Add="AddNode"
                                           Close="CloseNodeLibraryAsync" />
                    }

                    <div class="automation-workspace" role="region" aria-label="Flow workspace" @onclick="CloseNodeLibraryFromOutsideAsync">
                        <div class="automation-authoring-openers"><button class="btn-secondary" type="button" disabled="@(_selectedNodeIds.Count == 0 || _busy)" data-automation-extract-selection @onclick="OpenExtractionAsync">Extract selection</button><button class="btn-secondary" type="button" @onclick="OpenRecentTraceAsync">Traces</button></div>
                        <AutomationWorkspaceToolbar @ref="_workspaceToolbar"
                                                    ToolboxOpen="_nodeLibraryOpen"
                                                    Settings="_editor.Canvas"
                                                    SelectedNode="_selectedNode"
                                                    ToggleToolbox="ToggleNodeLibraryAsync"
                                                    FocusInspector="FocusInspectorAsync"
                                                    OrientationChanged="ChangeOrientation"
                                                    EdgeStyleChanged="ChangeEdgeStyle" />
                        @if (_mode == AutomationEditorMode.Grid)
                        {
                            <AutomationFlowCanvas @ref="_canvas"
                                                  Nodes="_editor.Nodes"
                                                  Edges="_editor.Edges"
                                                  SelectedNodeIds="_selectedNodeIds"
                                                  DisclosedNodeId="_disclosedNodeId"
                                                  DisclosureGeneration="_disclosureGeneration"
                                                  SelectedEdgeId="_selectedEdgeId"
                                                  Errors="_validationPresentation.VisibleErrors"
                                                  Validated="_validated"
                                                  SampleOutcomes="_displayedOutcomes"
                                                  Settings="_editor.Canvas"
                                                  ViewportKey="@_canvasViewportKey"
                                                  SelectionChanged="ChangeCanvasSelection"
                                                  PointerSelectionChanged="ChangeCanvasPointerSelection"
                                                  DisclosureChanged="SetCanvasNodeDisclosure"
                                                  MoveNodes="MoveNodes"
                                                  DeleteNodes="DeleteNodes"
                                                  DeleteEdge="DeleteEdge"
                                                  Connect="ConnectNodes"
                                                  ConnectionRejected="RejectConnection"
                                                  SettingsChanged="ChangeCanvasSettings" />
                        }
                        else
                        {
                            <AutomationFlowList @ref="_list"
                                                Nodes="_editor.Nodes"
                                                Edges="_editor.Edges"
                                                SelectedNodeId="_selectedNodeId"
                                                Errors="_validationPresentation.VisibleErrors"
                                                Validated="_validated"
                                                SampleOutcomes="_displayedOutcomes"
                                                UnavailableDefinitionIds="_unavailableDefinitionIds"
                                                SelectNode="SelectNode"
                                                DeleteNode="DeleteNode" />
                        }
                        @if (_traceOpen)
                        {
                            <AutomationTracePanel Title="@_traceTitle" Message="@_traceMessage" Snapshot="_trace" Presentation="_tracePresentation" Selected="_selectedTrace" Headers="_traceHeaders" Nodes="_editor.Nodes" Offset="_traceOffset" Select="SelectTraceAsync" Page="offset => _traceOffset = offset" SelectRun="SelectTraceRunAsync" EditScenario="OpenScenariosAsync" SourceAvailable="@(_diagnosticSource is not null)" ShowSource="ShowDiagnosticSourceAsync" Close="CloseTrace" />
                        }
                    </div>

                    @if (_authoringTask != AutomationAuthoringTask.None)
                    {
                        <aside class="automation-authoring-panel" data-automation-authoring tabindex="-1" @onkeydown="Handle_authoringKeyAsync">
                            <header class="automation-authoring-tabs"><h2>@_authoringTitle</h2><button class="btn-secondary" type="button" aria-label="Close authoring panel" @onclick="CloseAuthoringAsync">×</button></header>
                            <div class="automation-authoring-content">
                                @if (_authoringTask == AutomationAuthoringTask.Scenarios)
                                {
                                    <AutomationScenarioPanel Editor="_scenario" Saved="_savedScenarios" Nodes="_editor.Nodes" Fields="_scenarioFields" CommandSchemas="_commandSchemas" Busy="_busy" CanSave="@(_editor.Id is not null)" InvalidInputs="@(_invalidFixtureInputs.Count > 0)" InputValidity="SetFixtureValidity" Select="SelectScenario" SourceChanged="SelectScenarioSource" New="NewScenario" Generate="GenerateScenarioFixture" Run="RunScenarioAsync" Save="SaveScenarioAsync" Duplicate="DuplicateScenarioAsync" Delete="DeleteScenarioAsync" Cancel="() => _scenarioCancellation?.Cancel()" />
                                }
                                else if (_authoringTask == AutomationAuthoringTask.Extraction)
                                {
                                    <div class="automation-authoring-body" data-automation-extraction><h2>Extract selection</h2>@if (_extraction?.Reviewed is { } extractionReview) { <section class="automation-authoring-section"><h3>Effects</h3><span>@(extractionReview.Effects.Summary?.Description ?? "Effects unavailable.")</span></section> }<button class="btn-secondary" type="button" @onclick="PreviewExtractionAsync">Refresh preview</button><label class="field"><span class="field__label">Subflow name</span><input class="field__input" value="@_extractionName" @onchange="async args => { _extractionName = args.Value?.ToString() ?? string.Empty; await PreviewExtractionAsync(); }" /></label>
                                        @if (_extraction is { } extraction)
                                        {
                                            @foreach (var error in extraction.Errors) { <p class="automation-authoring-error" role="alert">@error.Message</p> }
                                            <section class="automation-authoring-section"><h3>Generated inputs</h3>@if (extraction.Inputs.IsEmpty) { <span>None</span> }@foreach (var input in extraction.Inputs) { <div class="automation-interface-summary"><strong>@input.Port.Id.Value</strong><span>@input.Port.ValueType · @(input.Port.Nullability == AutomationPortNullability.Nullable ? "Nullable" : "Required")</span></div> }</section>
                                            <section class="automation-authoring-section"><h3>Generated outputs</h3>@if (extraction.Outputs.IsEmpty) { <span>None</span> }@foreach (var output in extraction.Outputs) { <div class="automation-interface-summary"><strong>@output.Port.Id.Value</strong><span>@output.Port.ValueType · @(output.Port.Nullability == AutomationPortNullability.Nullable ? "Nullable" : "Required")</span></div> }</section>
                                            <section class="automation-authoring-section"><h3>Caller replacement</h3><strong>@_extractionName · Invoke</strong><p>@string.Join(", ", _editor.Nodes.Where(node => extraction.Selection.Contains(node.Id)).Select(node => node.EffectiveName))</p><p>@extraction.Incoming.Count(edge => edge.Kind == AutomationEdgeKind.Flow) incoming flow edges · @extraction.Outgoing.Count(edge => edge.Kind == AutomationEdgeKind.Flow) outgoing</p><p>@extraction.Incoming.Count(edge => edge.Kind == AutomationEdgeKind.Data) incoming data edges · @extraction.Outgoing.Count(edge => edge.Kind == AutomationEdgeKind.Data) outgoing</p></section>
                                        }
                                    </div><footer class="automation-authoring-footer"><button class="btn-primary" type="button" disabled="@(_busy || _extraction?.IsValid is not true || _extraction.Reviewed is null || !_selectedNodeIds.SetEquals(_extraction.Selection))" data-automation-apply-extraction @onclick="ApplyExtractionAsync">Create subflow and replace</button><button class="btn-secondary" type="button" @onclick="CloseAuthoringAsync">Cancel</button></footer>
                                }
                                else if (_editor.Subflow is { } subflow)
                                {
                                    <div class="automation-authoring-body" data-automation-subflow-review>
                                        <label class="field"><span class="field__label">Description</span><input class="field__input" maxlength="2000" value="@subflow.Description" @onchange="ChangeSubflowDescription" /></label>
                                        @if (_subflowPreview is { } review)
                                        {
                                            <section class="automation-authoring-section">
                                                <h3>@(_subflowPublished ? "Published effects" : "Proposed effects")</h3>
                                                <span>@(review.Reviewed.Effects.Summary?.Description ?? "Effects unavailable. Repair the dependencies before enabling.")</span>
                                            </section>
                                            var effectParents = _subflowPublished ? _disabledEffectParents : review.Reviewed.EffectParents.Where(parent => parent.WillDisable).ToImmutableArray();
                                            @if (!effectParents.IsEmpty)
                                            {
                                                <section class="automation-authoring-section">
                                                    <h3>@effectParents.Length automations @(_subflowPublished ? "disabled" : "will be disabled")</h3>
                                                    <small>Review their effects before enabling. Runs already started continue.</small>
                                                    <ul class="subflow-callers">@foreach (var parent in effectParents)
                                                    {
                                                        <li><strong>@parent.Name</strong><small>@(parent.After.Summary?.Description ?? "Effects unavailable. Repair the dependencies before enabling.")</small>
                                                        @if (_subflowPublished) { <button type="button" data-automation-effect-parent="@parent.FlowId.Value" @onclick="() => OpenEffectParentAsync(parent)">Open automation</button> }</li>
                                                    }</ul>
                                                </section>
                                            }
                                            <section class="automation-authoring-section" data-automation-publication-preview>
                                                <h3>@(_subflowPublished ? "Published interface changes" : "Proposed interface changes")</h3>
                                                <small>Published baseline: @(review.Candidate.Revision == 1 ? "new subflow" : $"version {review.Candidate.Revision - 1}") · @(_subflowPublished ? "Published" : "Proposed") version @review.Candidate.Revision</small>
                                                @foreach (var dependency in review.Reviewed.Dependencies.Values.OrderBy(child => child.SubflowId.Value)) { <small>@dependency.Graph.Name · version @dependency.Revision</small> }
                                                @foreach (var change in AutomationSubflowDefinitions.Changes(review.PreviousInterface, review.Candidate.Interface)) { <div class="subflow-delta" >
    <h4>@change.Direction · @((change.Current ?? change.Previous!).Name) <code>@change.Id.Value</code></h4>
    <div class="subflow-delta-values"><div><small>@(_subflowPublished ? "Previous" : "Published")</small>
        @if (change.Previous is { } previous) { <span>@previous.ValueType · @(previous.Nullability == AutomationPortNullability.Nullable ? "nullable" : "required") · @previous.Sensitivity</span>@if (change.MetadataChanged) { <span>@previous.Name</span><small>@previous.Description</small> } } else { <span>Not present</span> }
    </div><span aria-hidden="true">→</span><div><small>@(_subflowPublished ? "Published" : "Proposed")</small>
        @if (change.Current is { } current) { @if (change.Previous is null) { <span class="subflow-added">Added</span> }<span>@current.ValueType · @(current.Nullability == AutomationPortNullability.Nullable ? "nullable" : "required") · @current.Sensitivity</span>@if (change.MetadataChanged) { <span>@current.Name</span><small>@current.Description</small> } } else { <span class="subflow-removed">Removed</span> }
    </div></div><small>@(change.Compatible ? "Compatible metadata change" : "Interface change · callers may need repair")</small>
</div> }
                                                @if (AutomationSubflowDefinitions.Changes(review.PreviousInterface, review.Candidate.Interface).IsEmpty) { <span>No interface changes.</span> }
                                            </section>
                                            <section class="automation-authoring-section"><h3>@review.IncompatibleCallers.Length callers @(_subflowPublished ? "need repair" : "would need repair")</h3>
                                                <ul class="subflow-callers">
                                                @foreach (var caller in review.IncompatibleCallers.Skip(_callerOffset).Take(20))
                                                {
                                                    var detail = _callerDetails.GetValueOrDefault(caller);
                                                    var authored = review.Reviewed.Callers.FirstOrDefault(impact => impact.Caller == caller)?.Interface;
                                                    var available = detail?.Invocation?.SubflowId == review.Candidate.SubflowId && authored is not null;
                                                    <li>
                                                        @if (_subflowPublished && available) { <button type="button" data-automation-caller-node="@caller.NodeId.Value" @onclick="() => OpenAffectedCallerAsync(caller)">@CallerDescription(caller)</button> }
                                                        else { <strong>@CallerDescription(caller)</strong> }
                                                        @if (available)
                                                        {
                                                            @if (caller.SubflowId is not null) { <small>Subflow caller</small> }
                                                            @foreach (var change in AutomationSubflowDefinitions.Changes(authored!, review.Candidate.Interface).Where(change => !change.Compatible))
                                                            {
                                                                @if (_subflowPublished) { <button type="button" data-automation-caller-port="@($"{change.Direction}:{change.Id.Value}")" data-automation-caller="@caller.NodeId.Value" @onclick="() => OpenAffectedCallerAsync(caller, change)">@change.Direction · @change.Id.Value</button> }
                                                                else { <small>@change.Direction · @change.Id.Value: @(change.Previous is { } oldPort ? $"{oldPort.ValueType} · {oldPort.Nullability} · {oldPort.Sensitivity}" : "Not present") → @(change.Current is { } newPort ? $"{newPort.ValueType} · {newPort.Nullability} · {newPort.Sensitivity}" : "Removed")</small> }
                                                            }
                                                        }
                                                        else { <small>This call changed or is unavailable.</small> }
                                                    </li>
                                                }
                                                </ul>
                                                @if (review.IncompatibleCallers.Length > 20) { <div class="automation-authoring-actions"><button class="btn-secondary" type="button" disabled="@(_callerOffset == 0)" @onclick="() => LoadCallerPageAsync(Math.Max(0, _callerOffset - 20))">Previous callers</button><button class="btn-secondary" type="button" disabled="@(_callerOffset + 20 >= review.IncompatibleCallers.Length)" @onclick="() => LoadCallerPageAsync(_callerOffset + 20)">Next callers</button></div> }
                                            </section>
                                        }
                                    </div>
                                    <footer class="automation-authoring-footer">
                                        @if (_subflowPreview is not null && !_subflowPublished && !_subflowReviewRequired) { <button class="btn-primary" type="button" disabled="@_busy" data-automation-publish-subflow @onclick="PublishSubflowAsync">Publish subflow</button> }
                                        else if (!_subflowPublished || _subflowPreview is null) { <button class="btn-primary" type="button" disabled="@_busy" data-automation-review-subflow @onclick="ReviewSubflowAsync">Review subflow</button> }
                                        <button class="btn-secondary" type="button" @onclick="CloseAuthoringAsync">@(_subflowPublished ? "Close" : "Cancel")</button>
                                    </footer>
                                }
                            </div>
                        </aside>
                    }

                    @if (_selectedNode is not null && !_nodeLibraryOpen && _authoringTask == AutomationAuthoringTask.None && _inspectorFocusMode == _mode)
                    {
                        <AutomationNodeInspector Node="_selectedNode"
                                                 MobileOpen="_mobileInspectorOpen"
                                                 Nodes="_editor.Nodes"
                                                 Edges="_editor.Edges"
                                                 Errors="_validationPresentation.VisibleErrors"
                                                 ReferenceChoices="_referenceChoices"
                                                 Changed="EditorChanged"
                                                 ClearSelection="CloseInspector"
                                                 AddInputFromSource="AddTransformInputFromSource"
                                                 Connect="ConnectNodes"
                                                 Repair="RepairConnection"
                                                 DeleteEdge="DeleteEdge"
                                                 DeleteNode="DeleteNode">
                            <BoundaryDeclarations>
                                @if (_editor.Subflow is not null && _selectedNode.Subflow is AutomationSubflowBoundaryConfiguration)
                                {
                                    <AutomationBoundaryPorts @key="_selectedNode" Node="_selectedNode" Changed="ChangeBoundaryPorts" />
                                }
                            </BoundaryDeclarations>
                            <CallSubflowSelector>
                                <AutomationCallTarget Changes="_callChanges" Name="@(_callTarget?.Graph.Name)" HasTarget="@(_selectedNode.Subflow is AutomationSubflowInvocationConfiguration)" Loading="_callLoading" Choosing="_callChoosing" InterfaceChanged="_callInterfaceChanged" Message="@_callMessage" Page="_callPage" Search="@_callSearch" Offset="_callOffset" PageLoading="_callPageLoading" Change="ChooseCallTargetAsync" UpdateInterface="UpdateCallInterfaceAsync" SearchChanged="SearchCallTargetsAsync" PageChanged="LoadCallPageAsync" Selected="SelectCallTargetAsync" />
                            </CallSubflowSelector>
                        </AutomationNodeInspector>
                    }
                </div>

                <AutomationRunDrawer Visible="@(!_traceOpen && _editor.Subflow is null && (!_focusMode || !_runDrawerCollapsed))"
                                     FocusMode="_focusMode"
                                     HasRecentRuns="@(_recentRuns.Length > 0)"
                                     CanRunSample="@(!_busy && _editor.Nodes.Count > 0)"
                                     Kind="@(_viewingCurrentScenario ? "sample" : "history")"
                                     IconClass="@_runIconClass"
                                     Icon="@_runIcon"
                                     Title="@_runTitle"
                                     Description="@_runDescription"
                                     Toggle="ToggleRunDrawer"
                                     ShowDetails="ShowRunDetails"
                                     RunSample="RunSampleAsync" />

                @if (_focusMode)
                {
                    @if (_flowRailCollapsed)
                    {
                        <button class="automation-restore-tab automation-restore-tab--flows" type="button" @onclick="ToggleFlowRail"><EditorIcon Name="flow-list" />Flows</button>
                    }
                    @if (_editorToolsCollapsed)
                    {
                        <button class="automation-restore-tab automation-restore-tab--tools" type="button" @onclick="ToggleEditorTools"><EditorIcon Name="tools" />Tools</button>
                    }
                    @if (_runDrawerCollapsed)
                    {
                        <button class="automation-restore-tab automation-restore-tab--runs" type="button" @onclick="ToggleRunDrawer"><EditorIcon Name="history" />Runs</button>
                    }
                }
            </EditorWorkspace>
        }

    }
</DashboardPage>

<AutomationDirtyDialog Open="_dirtyDialogOpen"
                       Busy="_busy"
                       Cancel="CancelDirtyTransition"
                       Discard="DiscardDirtyTransitionAsync"
                       Subflow="@(_editor?.Subflow is not null)"
                       Save="SaveDirtyTransitionAsync" />

@code {
    private RenderFragment RepairItems => @<text>
        @foreach (var entry in _authoringEntries)
        {
            <button @key="entry.Id" type="button" class="@($"automation-flow-item automation-flow-item--repair{(entry.Id == (_sourceFlowId ?? _editor?.Id) ? " automation-flow-item--active" : "")}")"
                    title="@entry.Reason" @onclick="() => RequestRepairFlowAsync(entry.Id)">
                <strong>@(string.IsNullOrWhiteSpace(entry.Name) ? "Untitled flow" : entry.Name)</strong>
                <span>Needs repair · @(entry.RequiresJson ? "JSON" : "Visual editor")</span>
            </button>
        }
    </text>;

    private RenderFragment RepairRail => @<AutomationFlowRail Visible="true" FocusMode="_focusMode" Flows="_flowSnapshots" RepairItems="RepairItems"
        CurrentFlowId="_sourceFlowId" CurrentName="@_sourceName" CurrentNodeCount="0" ShowDraft="false" ShowActions="false"
        Library="_libraryKind" LibraryChanged="ChangeLibraryAsync" Subflows="_subflowPage" CurrentSubflowId="_editor?.Subflow?.Id"
        SubflowSearch="@_subflowSearch" SubflowOffset="_subflowOffset" SubflowsLoading="_subflowLoading"
        SearchSubflows="SearchSubflowsAsync" PageSubflows="LoadSubflowPageAsync" SelectSubflow="SelectLibrarySubflowAsync"
        Select="RequestSelectFlowAsync" Toggle="ToggleFlowRail" />;

    private RenderFragment CreationActions => @<div class="automation-page-actions">
        <button class="btn-primary" type="button" @onclick="RequestNewFlowAsync"><EditorIcon Name="new-flow" />New flow</button>
        <button class="btn-primary" type="button" data-automation-new-subflow @onclick="NewSubflowAsync"><EditorIcon Name="new-subflow" />New subflow</button>
    </div>;
}

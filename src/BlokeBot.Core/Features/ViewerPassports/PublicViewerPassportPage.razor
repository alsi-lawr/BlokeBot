@layout PublicPortalLayout
@page "/passport/{Channel}/{Viewer}"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject ViewerPassportService _passports
@inject BlokeBotPageContextAccessor _pageContexts

<ChannelReturnLink Channel="@Channel" />
<PageTitle>BlokeBot | Viewer passport</PageTitle>

<div class="mx-auto grid max-w-4xl gap-5 px-4 py-8 sm:px-6">
    <PageHeader Kicker="Channel community"
                Title="Viewer passport"
                Description="A viewer-selected snapshot of channel participation." />
    @if (!_loaded)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading viewer passport...</div>
    }
    else if (_featureDisabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Viewer passports is off for this channel.</div>
    }
    else if (_passport is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">This viewer passport is not available.</div>
    }
    else
    {
        <article class="card overflow-hidden">
            <div class="h-20 bg-gradient-to-r from-indigo-600 via-violet-600 to-fuchsia-400"></div>
            <div class="p-5 sm:p-6">
                <div class="-mt-12 flex flex-wrap items-end gap-3">
                    <div class="grid h-16 w-16 place-items-center rounded-full border-4 border-[var(--app-surface-solid)] bg-violet-600 text-xl font-black text-white">@Initials(_passport.DisplayName)</div>
                    <div class="min-w-0 pb-1">
                        @if (_passport.SelectedTitle is { } title)
                        {
                            <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-800">✦ @title.Name</span>
                        }
                        <h2 class="truncate text-2xl font-bold text-[var(--app-text-strong)]">@_passport.DisplayName</h2>
                        <p class="text-xs text-muted-foreground">@($"@{_passport.Login}") · @_passport.HostDisplayName</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_passport.ProfileLine))
                {
                    <p class="my-5 text-base text-[var(--app-text-strong)]">@_passport.ProfileLine</p>
                }
                <div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
                    @Stat(_passport.Statistics.Points, _passport.Statistics.PointsRank is { } rank ? $"points · rank #{rank}" : "points")
                    @Stat($"{_passport.Statistics.GuessAccuracyPercent}%", "guess accuracy")
                    @if (!_passport.HideAttendance)
                    {
                        @Stat($"{_passport.Statistics.AttendanceStreakSessions} streams", "attendance streak")
                    }
                    @Stat(_passport.Statistics.Achievements.ToString(), "achievements")
                </div>
                <section class="mt-5 border-t border-[var(--app-border)] pt-5">
                    <h2 class="mb-3 text-lg font-semibold text-[var(--app-text-strong)]">Channel contributions</h2>
                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                        @Stat($"{_passport.Statistics.GamesWon} games · {_passport.Statistics.GiveawaysWon} giveaways", "won")
                        @Stat($"{_passport.Statistics.BountiesSupported} bounties · {_passport.Statistics.ApprovedMoments} moments", "supported and approved")
                    </div>
                </section>
                @if (_passport.SelectedBadge is { } badge)
                {
                    <section class="mt-5 border-t border-[var(--app-border)] pt-5">
                        <h2 class="mb-3 text-lg font-semibold text-[var(--app-text-strong)]">Selected achievement</h2>
                        <span class="inline-flex rounded-full border border-[var(--app-control-border)] px-3 py-1 text-sm font-bold text-[var(--app-text-strong)]">@badge.PresentationToken @badge.Name</span>
                    </section>
                }
                <p class="mt-5 text-xs text-muted-foreground">@_passport.DisplayName controls this passport. Attendance counts consecutive recorded streams with a chat message. It does not measure watch time or every broadcast.</p>
            </div>
        </article>
    }
</div>

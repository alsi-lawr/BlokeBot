@page "/passports"
@page "/passports/{Channel}/me"
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AuthenticatedPageComponent
@inject ViewerPassportService _passports

<PageTitle>BlokeBot | Viewer passport</PageTitle>

<DashboardPage Kicker="Community identity"
               Title="Your viewer passport"
               Description="@_description"
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_passport is { Visibility: not ViewerPassportVisibility.Private } passport)
        {
            <a class="btn-secondary" href="@PublicUrl(passport)" target="_blank" rel="noopener">Open public profile ↗</a>
        }
    </Actions>
    <ChildContent>
        @if (!_loaded)
        {
            <ApplicationCardCollection Owner="viewer-passport-cards">
                <div class="card p-8 text-sm text-muted-foreground">Loading your viewer passport...</div>
            </ApplicationCardCollection>
        }
        else if (_featureDisabled)
        {
            <ApplicationCardCollection Owner="viewer-passport-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Viewer passports is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved profiles, visibility choices, and chat-presence days are retained; re-enabling does not repeat missed activity.
                </div>
            </ApplicationCardCollection>
        }
        else if (_passport is null)
        {
            <ApplicationCardCollection Owner="viewer-passport-cards">
                <div class="card p-8 text-sm text-muted-foreground">Channel not found.</div>
            </ApplicationCardCollection>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="rounded-lg border p-3 text-sm font-semibold" role="@(_failed ? "alert" : "status")">@_feedback</p>
            }

            <div class="passport-editor">
                <div class="card passport-editor__form" data-sticky-save-scope>
                    <details class="passport-editor__section" open>
                        <summary>
                            <span class="passport-editor__section-title">Profile</span>
                            <span class="passport-editor__section-summary">Profile line, display title, and featured badge</span>
                            <span class="passport-editor__chevron" aria-hidden="true">›</span>
                        </summary>
                        <div class="passport-editor__section-body">
                            <p class="mb-4 text-sm text-muted-foreground">Your Twitch user ID keeps this passport together if your login changes.</p>
                            <div class="passport-editor__fields">
                                <div class="passport-editor__field--wide" data-field>
                                    <label class="label" for="passport-profile-line">Profile line</label>
                                    <textarea id="passport-profile-line"
                                              class="input passport-editor__profile-line mt-2"
                                              maxlength="@ViewerPassportLimits.ProfileLineMaximumLength"
                                              @bind="_profileLine"
                                              @bind:event="oninput"></textarea>
                                    <p class="passport-editor__hint">
                                        <span>Channel moderation rules apply. Displayed as plain text.</span>
                                        <span>@_profileLine.Length / @ViewerPassportLimits.ProfileLineMaximumLength</span>
                                    </p>
                                </div>
                                <div>
                                    <label class="label" for="passport-title">Display title</label>
                                    <select id="passport-title" class="input mt-2" @bind="_selectedTitle">
                                        <option value="">No title</option>
                                        @foreach (var reward in _passport.EarnedTitles)
                                        {
                                            <option value="@reward.Id">@reward.Name</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="label" for="passport-badge">Featured badge</label>
                                    <select id="passport-badge" class="input mt-2" @bind="_selectedBadge">
                                        <option value="">No badge</option>
                                        @foreach (var reward in _passport.EarnedBadges)
                                        {
                                            <option value="@reward.Id">@reward.Name · @reward.PresentationToken</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </details>

                    <details class="passport-editor__section" open>
                        <summary>
                            <span class="passport-editor__section-title">Who can see it</span>
                            <span class="passport-editor__section-summary">Visibility and attendance choices</span>
                            <span class="passport-editor__chevron" aria-hidden="true">›</span>
                        </summary>
                        <div class="passport-editor__section-body">
                            <p class="mb-4 text-sm text-muted-foreground">Public presentation is opt-in. Saved activity stays private until you choose otherwise.</p>
                            <fieldset class="passport-visibility">
                                <legend class="passport-visibility__legend">Who can open this passport</legend>
                                <div class="passport-visibility-options">
                                    @foreach (var option in _visibilityOptions)
                                    {
                                        <label class="@VisibilityClass(option)">
                                            <input type="radio"
                                                   name="passport-visibility"
                                                   value="@option.Value"
                                                   @onchange="() => _visibility = option.Value"
                                                   checked="@(_visibility == option.Value)" />
                                            <span class="passport-visibility-option__icon" aria-hidden="true">
                                                @switch (option.Value)
                                                {
                                                    case ViewerPassportVisibility.Public:
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" focusable="false">
                                                            <circle cx="12" cy="12" r="9" />
                                                            <path d="M3 12h18" />
                                                            <path d="M12 3c3 3.2 3 14.8 0 18" />
                                                            <path d="M12 3c-3 3.2-3 14.8 0 18" />
                                                        </svg>
                                                        break;
                                                    case ViewerPassportVisibility.ChannelMembers:
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" focusable="false">
                                                            <circle cx="9" cy="8" r="3" />
                                                            <circle cx="17" cy="10" r="2.5" />
                                                            <path d="M3 20c.4-4 2.5-6 6-6s5.6 2 6 6" />
                                                            <path d="M14 15c4-.7 6.3 1 7 5" />
                                                        </svg>
                                                        break;
                                                    case ViewerPassportVisibility.Private:
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" focusable="false">
                                                            <rect x="5" y="10" width="14" height="11" rx="2" />
                                                            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                                        </svg>
                                                        break;
                                                }
                                            </span>
                                            <span class="passport-visibility-option__text">
                                                <span class="passport-visibility-option__label">@option.Label</span>
                                                <span class="passport-visibility-option__copy">@option.Description</span>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </fieldset>
                            <div class="passport-attendance">
                                <span>
                                    <span class="passport-attendance__label" id="passport-attendance-label">Show attendance streak</span>
                                    <span class="passport-attendance__copy">Counts consecutive days you chatted.</span>
                                </span>
                                <button type="button"
                                        class="studio-toggle"
                                        role="switch"
                                        aria-checked="@(!_hideAttendance ? "true" : "false")"
                                        aria-labelledby="passport-attendance-label"
                                        @onclick="ToggleAttendance"></button>
                            </div>
                        </div>
                    </details>

                    <details class="passport-editor__section">
                        <summary>
                            <span class="passport-editor__section-title">Privacy and data</span>
                            <span class="passport-editor__section-summary">Export or reset your passport data</span>
                            <span class="passport-editor__chevron" aria-hidden="true">›</span>
                        </summary>
                        <div class="passport-editor__section-body">
                            <p class="mb-4 text-sm text-muted-foreground">Export your channel data or remove this passport and its chat-presence days.</p>
                            <div class="passport-data-actions">
                                <a class="btn-secondary" href="@ExportUrl()">Export my channel data</a>
                                @if (!_confirmReset)
                                {
                                    <button class="btn-secondary passport-data-actions__reset" type="button" @onclick="() => _confirmReset = true">Reset passport</button>
                                }
                                else
                                {
                                    <span class="passport-reset-confirmation">
                                        Remove this profile and its chat-presence days?
                                        <button class="btn-secondary passport-data-actions__reset" type="button" @onclick="ResetAsync">Confirm reset</button>
                                        <button class="btn-secondary" type="button" @onclick="() => _confirmReset = false">Cancel</button>
                                    </span>
                                }
                            </div>
                        </div>
                    </details>

                    <div class="passport-editor__save">
                        <StickySaveRegion Scope="StickySaveScope.Editor">
                            <button class="btn-primary" type="button" @onclick="SaveAsync">Save passport</button>
                        </StickySaveRegion>
                    </div>
                </div>

                <aside class="card passport-preview" aria-label="Viewer passport preview">
                    <div class="passport-preview__identity">
                        <div class="passport-preview__avatar">@Initials(_passport.DisplayName)</div>
                        <div class="passport-preview__identity-copy">
                            @if (_previewTitle is not null || _previewBadge is not null)
                            {
                                <div class="passport-preview__rewards">
                                    @if (_previewTitle is { } title)
                                    {
                                        <span class="passport-preview__reward">✦ @title.Name</span>
                                    }
                                    @if (_previewBadge is { } badge)
                                    {
                                        <span class="passport-preview__reward">@badge.PresentationToken @badge.Name</span>
                                    }
                                </div>
                            }
                            <h2 class="passport-preview__name">@_passport.DisplayName</h2>
                            <p class="passport-preview__meta">@($"@{_passport.Login}") · @_passport.HostDisplayName</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_profileLine))
                    {
                        <p class="passport-preview__line">@_profileLine</p>
                    }
                    <div class="passport-preview__stats">
                        @Stat(_passport.Statistics.Points, _passport.Statistics.PointsRank is { } rank ? $"points · rank #{rank}" : "points")
                        @Stat($"{_passport.Statistics.GuessAccuracyPercent}%", $"guess accuracy · {_passport.Statistics.GuessRounds} rounds")
                        @if (!_hideAttendance)
                        {
                            @Stat($"{_passport.Statistics.AttendanceStreakDays} days", "chat-presence streak")
                        }
                        @Stat(_passport.Statistics.Achievements.ToString(), "achievements")
                        @Stat($"{_passport.Statistics.GamesWon} / {_passport.Statistics.GiveawaysWon}", "games / giveaways won")
                        @Stat($"{_passport.Statistics.BountiesSupported} / {_passport.Statistics.ApprovedMoments}", "bounties / moments")
                    </div>
                    <p class="passport-preview__notice">Preview shows only fields allowed by your current visibility choices.</p>
                </aside>
            </div>
        }
    </ChildContent>
</DashboardPage>

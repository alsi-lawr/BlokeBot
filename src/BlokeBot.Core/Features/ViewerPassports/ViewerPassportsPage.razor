@page "/passports"
@page "/passports/{Channel}/me"
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AuthenticatedPageComponent
@inject ViewerPassportService _passports

<PageTitle>BlokeBot | Viewer passport</PageTitle>

<DashboardPage Kicker="Community identity"
               Title="Your viewer passport"
               Description="@_description"
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_passport is { Visibility: not ViewerPassportVisibility.Private } passport)
        {
            <a class="btn-secondary" href="@PublicUrl(passport)" target="_blank" rel="noopener">Open public profile</a>
        }
    </Actions>
    <ChildContent>
        @if (!_loaded)
        {
            <ApplicationCardCollection Owner="viewer-passport-cards">
                <div class="card p-8 text-sm text-muted-foreground">Loading your viewer passport...</div>
            </ApplicationCardCollection>
        }
        else if (_featureDisabled)
        {
            <ApplicationCardCollection Owner="viewer-passport-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Viewer passports is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved profiles, visibility choices, and chat-presence days are retained; re-enabling does not replay suppressed activity.
                </div>
            </ApplicationCardCollection>
        }
        else if (_passport is null)
        {
            <ApplicationCardCollection Owner="viewer-passport-cards">
                <div class="card p-8 text-sm text-muted-foreground">Channel not found.</div>
            </ApplicationCardCollection>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="rounded-lg border p-3 text-sm font-semibold" role="@(_failed ? "alert" : "status")">@_feedback</p>
            }

            <div class="grid min-w-0 gap-4 xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,.65fr)]">
                <div class="card overflow-hidden" data-sticky-save-scope>
                    <section class="grid gap-4 p-5">
                        <div>
                            <h2 class="text-lg font-semibold text-[var(--app-text-strong)]">Profile</h2>
                            <p class="mt-1 text-sm text-muted-foreground">Your Twitch user ID keeps this passport together if your login changes.</p>
                        </div>
                        <div class="field space-y-2" data-field>
                            <label class="label" for="passport-profile-line">Profile line</label>
                            <textarea id="passport-profile-line"
                                      class="input min-h-24 resize-y"
                                      maxlength="@ViewerPassportLimits.ProfileLineMaximumLength"
                                      @bind="_profileLine"
                                      @bind:event="oninput"></textarea>
                        </div>
                        <p class="-mt-2 flex justify-between text-xs text-muted-foreground">
                            <span>Channel moderation rules apply. Displayed as plain text.</span>
                            <span>@_profileLine.Length / @ViewerPassportLimits.ProfileLineMaximumLength</span>
                        </p>
                        <div class="studio-grid">
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="passport-title">Display title</label>
                                <select id="passport-title" class="input" @bind="_selectedTitle">
                                    <option value="">No title</option>
                                    @foreach (var reward in _passport.EarnedTitles)
                                    {
                                        <option value="@reward.Id">@reward.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="passport-badge">Featured badge</label>
                                <select id="passport-badge" class="input" @bind="_selectedBadge">
                                    <option value="">No badge</option>
                                    @foreach (var reward in _passport.EarnedBadges)
                                    {
                                        <option value="@reward.Id">@reward.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="grid gap-4 border-t border-[var(--app-border)] p-5">
                        <div>
                            <h2 class="text-lg font-semibold text-[var(--app-text-strong)]">Who can see it</h2>
                            <p class="mt-1 text-sm text-muted-foreground">Public presentation is opt-in. Saved activity stays private until you choose otherwise.</p>
                        </div>
                        <div class="grid gap-2">
                            @foreach (var option in _visibilityOptions)
                            {
                                <label class="@VisibilityClass(option.Value)">
                                    <input type="radio" name="passport-visibility" value="@option.Value" @onchange="() => _visibility = option.Value" checked="@(_visibility == option.Value)" />
                                    <span><b class="block text-[var(--app-text-strong)]">@option.Label</b><span class="text-xs text-muted-foreground">@option.Description</span></span>
                                </label>
                            }
                        </div>
                        <label class="flex items-center justify-between gap-4 border-t border-[var(--app-border)] pt-4">
                            <span><b class="block text-sm text-[var(--app-text-strong)]">Show attendance streak</b><span class="text-xs text-muted-foreground">Consecutive UTC days with a chat message, never watch time.</span></span>
                            <input type="checkbox" checked="@(!_hideAttendance)" @onchange="ToggleAttendance" />
                        </label>
                    </section>

                    <section class="flex flex-wrap gap-2 border-t border-[var(--app-border)] p-5">
                        <StickySaveRegion Scope="StickySaveScope.Editor">
                            <button class="btn-primary" type="button" @onclick="SaveAsync">Save passport</button>
                        </StickySaveRegion>
                        <a class="btn-secondary" href="@ExportUrl()">Export my channel data</a>
                        @if (!_confirmReset)
                        {
                            <button class="btn-secondary text-red-700" type="button" @onclick="() => _confirmReset = true">Reset passport</button>
                        }
                        else
                        {
                            <span class="inline-flex flex-wrap items-center gap-2 rounded-lg border border-red-300 p-2 text-sm">
                                Remove this profile and its chat-presence days?
                                <button class="btn-secondary text-red-700" type="button" @onclick="ResetAsync">Confirm reset</button>
                                <button class="btn-secondary" type="button" @onclick="() => _confirmReset = false">Cancel</button>
                            </span>
                        }
                    </section>
                </div>

                <aside class="card self-start p-5">
                    <div class="flex items-center gap-3">
                        <div class="grid h-12 w-12 place-items-center rounded-full bg-violet-600 text-lg font-black text-white">@Initials(_passport.DisplayName)</div>
                        <div class="min-w-0">
                            @if (_passport.SelectedTitle is { } title)
                            {
                                <span class="inline-flex rounded-full bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-800">✦ @title.Name</span>
                            }
                            <h2 class="truncate text-xl font-bold text-[var(--app-text-strong)]">@_passport.DisplayName</h2>
                            <p class="text-xs text-muted-foreground">@($"@{_passport.Login}") · @_passport.HostDisplayName</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_profileLine))
                    {
                        <p class="my-4 border-y border-[var(--app-border)] py-4 text-sm text-[var(--app-text-strong)]">@_profileLine</p>
                    }
                    <div class="grid grid-cols-2 gap-2">
                        @Stat(_passport.Statistics.Points, _passport.Statistics.PointsRank is { } rank ? $"points · rank #{rank}" : "points")
                        @Stat($"{_passport.Statistics.GuessAccuracyPercent}%", $"guess accuracy · {_passport.Statistics.GuessRounds} rounds")
                        @if (!_hideAttendance)
                        {
                            @Stat($"{_passport.Statistics.AttendanceStreakDays} days", "chat-presence streak")
                        }
                        @Stat(_passport.Statistics.Achievements.ToString(), "achievements")
                        @Stat($"{_passport.Statistics.GamesWon} / {_passport.Statistics.GiveawaysWon}", "games / giveaways won")
                        @Stat($"{_passport.Statistics.BountiesSupported} / {_passport.Statistics.ApprovedMoments}", "bounties / moments")
                    </div>
                    <p class="mt-3 rounded-lg bg-amber-50 p-3 text-xs text-amber-800">Preview shows only fields allowed by your current attendance choice. Visibility controls who receives the profile.</p>
                </aside>
            </div>
        }
    </ChildContent>
</DashboardPage>

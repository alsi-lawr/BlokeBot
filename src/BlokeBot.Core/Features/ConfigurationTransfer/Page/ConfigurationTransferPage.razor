@page "/configuration-transfer"
@using BlokeBot.Core.Auth.Sessions
@using BlokeBot.Core.Features.ConfigurationTransfer.Contracts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using static BlokeBot.Core.Features.ConfigurationTransfer.Page.ConfigurationTransferPresentation
@attribute [Authorize(Policy = "Operator")]
@inherits AuthenticatedPageComponent

<PageTitle>BlokeBot | Configuration transfer</PageTitle>

<DashboardPage Kicker="Channel settings"
               Title="Configuration transfer"
               Description="Back up settings or bring a configuration into this channel."
               LoadState="@_loadState"
               data-configuration-transfer>
    <Actions>
        <div class="destination-chip">
            <span class="destination-chip__avatar" aria-hidden="true">@_destinationInitial</span>
            <span>
                <span class="destination-chip__label">Destination channel</span>
                <span class="destination-chip__channel">#@HostLogin</span>
            </span>
        </div>
    </Actions>
    <ChildContent>
        <SegmentedTabs Id="@_modeTabsId"
                       OwnsFragment
                       AriaLabel="Configuration transfer mode"
                       Items="@_modeTabs"
                       ActiveKey="@_activeModeKey"
                       ActiveKeyChanged="SetMode">
            <ItemTemplate Context="mode">
                @if (mode.Key == _exportModeKey)
                {
                    <svg class="segmented-motion__icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true"
                         focusable="false">
                        <path d="M12 3v12" />
                        <path d="m7 10 5 5 5-5" />
                        <path d="M5 20h14" />
                    </svg>
                }
                else
                {
                    <svg class="segmented-motion__icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true"
                         focusable="false">
                        <path d="M12 16V4" />
                        <path d="m7 9 5-5 5 5" />
                        <path d="M5 20h14" />
                    </svg>
                }
                <span>@mode.Label</span>
            </ItemTemplate>
        </SegmentedTabs>

        @if (_mode == TransferMode.Export)
        {
            <div id="@SegmentedTabs.PanelId(_modeTabsId, _exportModeKey)"
                 role="tabpanel"
                 aria-labelledby="@SegmentedTabs.TabId(_modeTabsId, _exportModeKey)">
                <TaskPanel Title="Choose what to export"
                           Description="Only configuration is included. Runtime history, balances, credentials and queued work stay here.">
                    <Actions>
                        <span class="status-pill status-pill--slate">JSON · format 1</span>
                    </Actions>
                    <ChildContent>
                        @foreach (var section in _sectionOptions)
                        {
                            var selected = _exportSections.Contains(section.Id);
                            @if (section.Id == ConfigurationSectionId.Overlays)
                            {
                                <ConfigurationTransferOverlayExportOptions Selected="@selected"
                                                                           UrlLayers="@_exportOverlayUrls"
                                                                           MediaDocumentLinks="@_exportOverlayMedia"
                                                                           UrlWarningAcknowledged="@_urlWarningAcknowledged"
                                                                           SelectedChanged="enabled => ToggleExport(section.Id, enabled)"
                                                                           UrlLayersChanged="ToggleOverlayUrls"
                                                                           MediaDocumentLinksChanged="ToggleOverlayMedia"
                                                                           UrlWarningAcknowledgedChanged="ToggleUrlWarning"
                                                                           @key="section.Id" />
                            }
                            else
                            {
                                <div class="section-row">
                                    <div class="section-row__copy">
                                        <span class="section-row__title">@section.Title</span>
                                        <span class="section-row__detail">@section.Description</span>
                                    </div>
                                    <button type="button"
                                            class="studio-toggle"
                                            role="switch"
                                            aria-checked="@(selected ? "true" : "false")"
                                            aria-label="@($"Export {section.Title}")"
                                            @onclick="() => ToggleExport(section.Id, !selected)"></button>
                                </div>
                            }
                        }
                    </ChildContent>
                    <Footer>
                        <span class="task-panel__footer-note">@_exportSections.Count of @_sectionOptions.Length sections selected</span>
                        <div class="task-panel__footer-actions">
                            <a id="configuration-transfer-download"
                               class="btn-primary"
                               href="@(_canExport ? _exportUrl : null)"
                               download
                               aria-disabled="@(!_canExport)"
                               tabindex="@(_canExport ? null : "-1")"
                               data-enhance-nav="false">
                                Download configuration
                            </a>
                        </div>
                    </Footer>
                </TaskPanel>
            </div>
        }
        else if (_applied is { } applied)
        {
            <div id="@SegmentedTabs.PanelId(_modeTabsId, _importModeKey)"
                 role="tabpanel"
                 aria-labelledby="@SegmentedTabs.TabId(_modeTabsId, _importModeKey)">
                <TaskPanel Title="Import applied"
                           Description="Runtime history and disabled configuration were preserved.">
                    <Actions>
                        <ConfigurationTransferImportProgress Stage="ConfigurationImportStage.Applied" />
                    </Actions>
                    <ChildContent>
                        <PageState Kind="PageStateKind.Success"
                                   Title="@($"Configuration saved to #{HostLogin}")"
                                   Description="@($"{applied.ChangedSections.Count} {(applied.ChangedSections.Count == 1 ? "section" : "sections")} changed in one import.")" />
                        @foreach (var failure in applied.PostCommitFailures)
                        {
                            <PageState Kind="PageStateKind.Failure"
                                       Title="@($"{SectionTitle(failure.Section)} reconciliation needs attention")"
                                       Description="The configuration is saved. Runtime reconciliation failed separately and can be retried without reapplying the import." />
                        }
                        <div class="operation-row">
                            <span class="operation-row__label">Operation ID</span>
                            <code>@applied.OperationId</code>
                        </div>
                        @if (_activation is { } activation)
                        {
                            <ConfigurationActivationStatusPanel Activation="activation"
                                                                Retry="RetryActivationAsync" />
                        }
                        <div class="section-links">
                            @foreach (var section in applied.ChangedSections)
                            {
                                <a href="@SectionPath(section)" @key="section">
                                    <strong>@SectionTitle(section)</strong>
                                    <span>Open settings →</span>
                                </a>
                            }
                        </div>
                    </ChildContent>
                    <Footer>
                        <span class="task-panel__footer-note"></span>
                        <div class="task-panel__footer-actions">
                            <button class="btn-primary" type="button" @onclick="ResetImport">
                                Transfer another configuration
                            </button>
                        </div>
                    </Footer>
                </TaskPanel>
            </div>
        }
        else if (_preview is null)
        {
            <div id="@SegmentedTabs.PanelId(_modeTabsId, _importModeKey)"
                 role="tabpanel"
                 aria-labelledby="@SegmentedTabs.TabId(_modeTabsId, _importModeKey)">
                <TaskPanel Title="Add a configuration file"
                           Description="Upload a BlokeBot JSON export or paste its contents. Nothing changes until you review and confirm.">
                    <Actions>
                        <ConfigurationTransferImportProgress Stage="ConfigurationImportStage.File" />
                    </Actions>
                    <ChildContent>
                        <FileDropInput Accept=".json,application/json"
                                       Label="Accepts a BlokeBot .json export"
                                       Prompt="Drop a configuration file here"
                                       Disabled="@_busy"
                                       OnChange="ReadFileAsync" />
                        <div class="paste-divider">or paste JSON</div>
                        <div class="paste-field">
                            <label class="label" for="configuration-transfer-json">Configuration JSON</label>
                            <textarea id="configuration-transfer-json"
                                      class="input"
                                      placeholder="Paste a BlokeBot configuration document"
                                      @bind="_pastedJson"></textarea>
                        </div>
                        @if (_parseIssue is { } issue)
                        {
                            <PageState Kind="PageStateKind.Failure"
                                       Title="@issue.Location"
                                       Description="@issue.Message" />
                        }
                    </ChildContent>
                    <Footer>
                        <button id="configuration-transfer-cancel"
                                class="btn-secondary"
                                type="button"
                                @onclick="CancelImport">
                            Cancel
                        </button>
                        <div class="task-panel__footer-actions">
                            <button id="configuration-transfer-preview"
                                    class="btn-primary"
                                    type="button"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_pastedJson))"
                                    @onclick="PreviewPastedAsync">
                                Validate and review
                            </button>
                        </div>
                    </Footer>
                </TaskPanel>
            </div>
        }
        else
        {
            <div id="@SegmentedTabs.PanelId(_modeTabsId, _importModeKey)"
                 role="tabpanel"
                 aria-labelledby="@SegmentedTabs.TabId(_modeTabsId, _importModeKey)">
                <ConfigurationTransferReviewPanel Preview="@_preview"
                                                  DestinationLogin="@HostLogin"
                                                  SelectedSections="@_importSections"
                                                  Strategies="@_strategies"
                                                  Resolutions="@_resolutions"
                                                  Renames="@_renames"
                                                  GuessingProfileTargets="@_guessingProfileTargets"
                                                  EnablementSelections="@_enablementSelections"
                                                  Busy="@_busy"
                                                  AllConflictsResolved="@_allConflictsResolved"
                                                  ApplyIssue="@_applyIssue"
                                                  SectionSelectionChanged="ToggleImport"
                                                  SectionStrategyChanged="SetStrategyAsync"
                                                  ConflictResolutionChanged="SetResolutionAsync"
                                                  ConflictRenameChanged="SetRenameAsync"
                                                  GuessingProfileTargetChanged="SetGuessingProfileTargetAsync"
                                                  EnablementSelectionChanged="ToggleEnablement"
                                                  Cancel="CancelImport"
                                                  Apply="ApplyAsync" />
            </div>
        }
    </ChildContent>
</DashboardPage>

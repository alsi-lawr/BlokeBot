@page "/competitions"
@using BlokeBot.Core.Components.Layout
@using BlokeBot.Core.Features.Points.Balances
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CompetitionService _service
@inject BlokeBot.Core.Features.HostedChannels.HostFeatureService _features
@inject TimeProvider _clock

<PageTitle>BlokeBot | Tournaments &amp; leagues</PageTitle>

<DashboardPage Kicker="Community progression"
               Title="Tournaments &amp; leagues"
               Description="Run reproducible brackets, round-robin leagues, and prediction competitions without a spreadsheet."
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_featureEnabled && Host is not null)
        {
            <a class="btn-secondary" href="@_publicUrl" target="_blank" rel="noopener">Open public results</a>
            <button class="btn-primary" type="button" data-action="new-competition" disabled="@_isCreating" @onclick="NewCompetition">New competition</button>
        }
    </Actions>
    <ChildContent>
        @if (Host is null)
        {
            <ApplicationCardCollection Owner="competition-page-cards"><div class="card p-8 text-sm text-muted-foreground">Choose a channel to manage competitions.</div></ApplicationCardCollection>
        }
        else if (!_featureEnabled)
        {
            <ApplicationCardCollection Owner="competition-page-cards">
                <div class="card p-8 text-sm text-muted-foreground" data-competitions-disabled-recovery>
                    Tournaments &amp; leagues is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved formats, entrants, schedules, results, audit history, and archives are retained. Re-enable resumes current state without replaying suppressed commands, reminders, rewards, events, or provider work.
                </div>
            </ApplicationCardCollection>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="card p-3 text-sm font-semibold" role="@(_failed ? "alert" : "status")">@_feedback</p>
            }

            @if (!_isCreating && _selected is { } selectedSummary)
            {
                var summary = selectedSummary.Competition;
                <div class="live-round-summary competition-summary" aria-label="Competition summary">
                    <div class="live-round-summary__metric live-round-summary__metric--wide"><p class="live-round-summary__label">Competition</p><p class="live-round-summary__value">@summary.Name</p></div>
                    <div class="live-round-summary__metric"><p class="live-round-summary__label">Status</p><p class="live-round-summary__value"><span class="status-pill status-pill--slate"><span class="status-pill__label">@summary.Status.Label()</span></span></p></div>
                    <div class="live-round-summary__metric"><p class="live-round-summary__label">Format</p><p class="live-round-summary__value">@summary.Format.Label()</p><p class="live-round-summary__detail">@summary.EntryKind.Label() · @summary.Entrants.Count / @summary.Capacity entrants</p></div>
                    <div class="live-round-summary__metric"><p class="live-round-summary__label">Round</p><p class="live-round-summary__value">@(TotalRounds(summary) == 0 ? "Not generated" : $"{CurrentRound(summary)} of {TotalRounds(summary)}")</p><p class="live-round-summary__detail">@summary.Matches.Count(x => x.Status == CompetitionMatchStatus.Confirmed) confirmed</p></div>
                </div>
            }

            <section class="studio competition-studio" aria-label="Competition studio" data-competition-workspace>
                <div class="competition-rail">
                    <StudioRail AriaLabel="Saved competitions" SearchPlaceholder="Search" Groups="_railGroups">
                        <Footer>
                            <button class="btn-secondary w-full" type="button" data-action="rail-new-competition" disabled="@_isCreating" @onclick="NewCompetition">+ New competition</button>
                        </Footer>
                    </StudioRail>
                </div>

                <div id="competition-workspace-inspector" class="studio__inspector competition-inspector">
                    @if (_competitions.Count > 0)
                    {
                        <div class="competition-mobile-selector"><label class="label" for="competition-mobile-select">Competition</label><select id="competition-mobile-select" class="input" value="@(_isCreating ? string.Empty : _selectedCompetitionId?.Value.ToString())" @onchange="args => SelectMobileCompetition(args.Value?.ToString())"><option value="">New competition</option>@foreach (var option in _competitions){<option value="@option.Competition.Id.Value">@option.Competition.Name · @option.Competition.Status.Label()</option>}</select></div>
                    }
                    @if (_isCreating)
                    {
                        <header class="competition-inspector__header">
                            <div><h2 class="studio__title">New competition</h2><p class="studio__subtitle">Set format, eligibility, standings, reminders, and rewards.</p></div>
                        </header>
                        <div class="competition-inspector__body" data-competition-create>
                            <StudioStage Key="competition-new" Number="1" Title="Competition setup" Summary="A deliberate draft; nothing is public until registration opens.">
                                <div class="studio-grid">
                                    <div class="studio-span-8"><Field Id="competition-name" Label="Name" @bind-Value="_draft.Name" /></div>
                                    <div class="studio-span-4 space-y-2"><label class="label" for="competition-format">Format</label><select id="competition-format" class="input" @bind="_draft.Format"><option value="@CompetitionFormat.Tournament">Tournament bracket</option><option value="@CompetitionFormat.RoundRobin">Round robin</option><option value="@CompetitionFormat.PredictionLeague">Prediction league</option></select></div>
                                    <div class="studio-span-12"><TextAreaField Id="competition-description" Label="Public description" @bind-Value="_draft.Description" /></div>
                                    <div class="studio-span-4 space-y-2"><label class="label" for="competition-entry-kind">Entry</label><select id="competition-entry-kind" class="input" @bind="_draft.EntryKind"><option value="@CompetitionEntryKind.Individual">Individuals</option><option value="@CompetitionEntryKind.Team">Teams</option></select></div>
                                    <div class="studio-span-4"><label class="label" for="competition-capacity">Entrant capacity</label><input id="competition-capacity" class="input" type="number" min="2" max="128" @bind="_draft.Capacity" /></div>
                                    <div class="studio-span-4"><label class="label" for="competition-team-size">Members per team</label><input id="competition-team-size" class="input" type="number" min="1" max="32" @bind="_draft.TeamSize" /></div>
                                    <div class="studio-span-4 space-y-2"><label class="label" for="competition-seeding">Schedule order</label><select id="competition-seeding" class="input" @bind="_draft.Seeding"><option value="@CompetitionSeeding.Random">Seeded random</option><option value="@CompetitionSeeding.Seeded">Moderator ranks</option></select></div>
                                    <div class="studio-span-4"><Field Id="competition-seed" Label="Reproducible seed" @bind-Value="_draft.Seed" /></div>
                                    <div class="studio-span-4"><Field Id="competition-minimum-points" Label="Minimum points eligibility" @bind-Value="_draft.MinimumPoints" /></div>
                                    <div class="studio-span-4 space-y-2"><label class="label" for="competition-tiebreak">Tiebreak</label><select id="competition-tiebreak" class="input" @bind="_draft.Tiebreak"><option value="@CompetitionTiebreak.ScoreDifferenceThenScoreFor">Score difference, then score for</option><option value="@CompetitionTiebreak.ScoreForThenWins">Score for, then wins</option></select></div>
                                    <div class="studio-span-8 grid grid-cols-3 gap-3"><div><label class="label" for="competition-win-points">Win</label><input id="competition-win-points" class="input" type="number" min="0" @bind="_draft.WinPoints" /></div><div><label class="label" for="competition-draw-points">Draw</label><input id="competition-draw-points" class="input" type="number" min="0" @bind="_draft.DrawPoints" /></div><div><label class="label" for="competition-loss-points">Loss</label><input id="competition-loss-points" class="input" type="number" min="0" @bind="_draft.LossPoints" /></div></div>
                                    <div class="studio-span-4"><label class="label" for="competition-reminder">Reminder hours before</label><input id="competition-reminder" class="input" type="number" min="0" max="168" @bind="_draft.ReminderHoursBefore" /></div>
                                    <div class="studio-span-8"><Field Id="competition-reminder-message" Label="Reminder message" @bind-Value="_draft.ReminderMessage" /><p class="mt-1 text-xs text-muted-foreground">Tokens: {competition}, {round}, {scheduled}, {public_url}</p></div>
                                    <div class="studio-span-4"><Field Id="competition-winner-points" Label="Winner points" @bind-Value="_draft.WinnerPoints" /></div>
                                    <div class="studio-span-4"><Field Id="competition-runner-points" Label="Runner-up points" @bind-Value="_draft.RunnerUpPoints" /></div>
                                    <div class="studio-span-4"><Field Id="competition-winner-achievement" Label="Winner achievement key" @bind-Value="_draft.WinnerAchievement" /></div>
                                    <div class="studio-span-4"><Field Id="competition-runner-achievement" Label="Runner-up achievement key" @bind-Value="_draft.RunnerUpAchievement" /></div>
                                    <div class="studio-span-12 competition-milestone-editor">
                                        <div class="flex items-center justify-between gap-3"><div><h3 class="font-semibold text-[var(--app-text-strong)]">Win milestones</h3><p class="text-xs text-muted-foreground">Up to 8 confirmed-win thresholds; final corrected standings decide recipients.</p></div><button class="btn-secondary" type="button" disabled="@(_draft.MilestoneRewards.Count >= 8)" @onclick="AddMilestoneReward">+ Add milestone</button></div>
                                        @foreach (var rule in _draft.MilestoneRewards)
                                        {
                                            <div class="competition-milestone-rule" @key="rule"><div><label class="label">Confirmed wins</label><input class="input" type="number" min="1" @bind="rule.WinsRequired" /></div><div><label class="label">Points</label><input class="input" @bind="rule.Points" /></div><div><label class="label">Achievement key</label><input class="input" @bind="rule.AchievementKey" /></div><button class="btn-secondary" type="button" aria-label="Remove win milestone" @onclick="() => RemoveMilestoneReward(rule)">Remove</button></div>
                                        }
                                    </div>
                                    <div class="studio-span-12"><TextAreaField Id="competition-lobby" Label="Private contact / lobby information" @bind-Value="_draft.PrivateLobbyInformation" /><p class="mt-1 text-xs text-muted-foreground">Moderator-only; never included in public views or lifecycle payloads.</p></div>
                                    <div class="studio-span-12"><TextAreaField Id="competition-create-note" Label="Private moderator note" @bind-Value="_draft.PrivateReason" /></div>
                                    <div class="studio-span-12"><button class="btn-primary" type="button" @onclick="CreateAsync">Create draft competition</button></div>
                                </div>
                            </StudioStage>
                        </div>
                    }
                    else if (_selected is { } selected)
                    {
                        var competition = selected.Competition;
                        <header class="competition-inspector__header">
                            <div><div class="flex flex-wrap items-center gap-2"><h2 class="studio__title">@competition.Name</h2><span class="status-pill status-pill--slate"><span class="status-pill__label">@competition.Status.Label()</span></span></div><p class="studio__subtitle">@competition.Format.Label() · revision @competition.Revision</p></div>
                            <div class="competition-inspector__actions">
                                @if (competition.Status == CompetitionStatus.Draft) { <button class="btn-primary" type="button" data-action="open-registration" @onclick='() => TransitionAsync(competition, "open")'>Open registration</button> }
                                @if (competition.Status == CompetitionStatus.Registration) { <button class="btn-primary" type="button" data-action="start-competition" @onclick='() => TransitionAsync(competition, "start")'>Generate &amp; start</button> }
                                @if (competition.Status == CompetitionStatus.Running) { <button class="btn-primary" type="button" data-action="complete-competition" @onclick='() => TransitionAsync(competition, "complete")'>Complete</button> }
                                @if (competition.Status == CompetitionStatus.Completed) { <button class="btn-primary" type="button" data-action="archive-competition" @onclick='() => TransitionAsync(competition, "archive")'>Archive</button> }
                            </div>
                        </header>
                        <div class="competition-tabs"><SegmentedTabs Id="competition-tabs" AriaLabel="Competition workspace" Items="_tabs" ActiveKey="_activeTab" ActiveKeyChanged="@(key => _activeTab = key)" /></div>
                        <div id="@SegmentedTabs.PanelId("competition-tabs", _activeTab)" role="tabpanel" aria-labelledby="@SegmentedTabs.TabId("competition-tabs", _activeTab)" class="competition-inspector__body">
                            @if (_activeTab == "standings")
                            {
                                <div class="data-table-region" tabindex="0"><table class="w-full text-sm"><thead><tr class="text-left text-xs uppercase tracking-wide text-muted-foreground"><th class="p-2">#</th><th class="p-2">Entrant</th><th class="p-2">Played</th><th class="p-2">W–D–L</th><th class="p-2">Score</th><th class="p-2">Points</th></tr></thead><tbody>@foreach (var row in competition.Standings){<tr class="border-t"><td class="p-2">@row.Rank</td><td class="p-2 font-semibold text-[var(--app-text-strong)]">@row.Name</td><td class="p-2">@row.Played</td><td class="p-2">@row.Wins–@row.Draws–@row.Losses</td><td class="p-2">@row.ScoreFor–@row.ScoreAgainst</td><td class="p-2 font-semibold">@row.Points</td></tr>}</tbody></table></div>
                                @if (competition.Matches.LastOrDefault(x => x.Status == CompetitionMatchStatus.Confirmed) is { } latest)
                                {
                                    <div class="competition-latest-result"><span>Latest result · Round @latest.Round</span><strong>@latest.EntrantA @latest.ScoreA–@latest.ScoreB @latest.EntrantB</strong></div>
                                }
                            }
                            else if (_activeTab == "schedule")
                            {
                                <div class="competition-schedule">@foreach (var round in competition.Matches.GroupBy(x => x.Round).OrderBy(x => x.Key)){<section><h3>Round @round.Key</h3>@foreach (var match in round){<button class="competition-fixture @(match.Id == _selectedMatchId ? "competition-fixture--selected" : null)" type="button" disabled="@(match.EntrantAId is null || match.EntrantBId is null)" @onclick="() => SelectMatch(match.Id)"><span>@match.EntrantA <strong>@(match.ScoreA?.ToString() ?? "–")</strong></span><span>@match.EntrantB <strong>@(match.ScoreB?.ToString() ?? "–")</strong></span><small>@match.Status · @(match.ScheduledAtUtc?.ToString("u") ?? "Unscheduled")</small></button>}</section>}</div>
                            }
                            else if (_activeTab == "entrants")
                            {
                                <div class="competition-entrant-list">@foreach (var entrant in competition.Entrants){<div class="competition-entrant"><div><strong>@entrant.Name</strong><span>@string.Join(", ", entrant.Members.Select(x => x.DisplayName))</span></div><span>@(entrant.SeedRank is { } rank ? $"Seed {rank}" : "Unseeded")</span></div>}</div>
                                @if (competition.Status == CompetitionStatus.Registration)
                                {
                                    <section class="competition-registration"><h3 class="font-semibold text-[var(--app-text-strong)]">Register @(competition.EntryKind == CompetitionEntryKind.Team ? "team" : "viewer")</h3><div class="studio-grid"><div class="studio-span-6"><Field Id="entrant-name" Label="Public entrant name" @bind-Value="_registration.Name" /></div><div class="studio-span-6"><label class="label" for="entrant-rank">Seed rank (optional)</label><input id="entrant-rank" class="input" type="number" min="1" @bind="_registration.SeedRank" /></div>@for (var index = 0; index < competition.TeamSize; index++){ var member = Member(index); <div class="studio-span-12 competition-member"><strong>Member @(index + 1)</strong><div class="grid gap-3 md:grid-cols-4"><Field Id="@($"entrant-login-{index}")" Label="Login" @bind-Value="member.Login" /><Field Id="@($"entrant-display-{index}")" Label="Display name" @bind-Value="member.DisplayName" /><Field Id="@($"entrant-id-{index}")" Label="Twitch user ID" @bind-Value="member.TwitchUserId" /><Field Id="@($"entrant-contact-{index}")" Label="Private contact" @bind-Value="member.PrivateContact" /></div></div>}<div class="studio-span-12"><TextAreaField Id="entrant-note" Label="Private registration note" @bind-Value="_registration.PrivateReason" /></div><div class="studio-span-12"><button class="btn-secondary" type="button" @onclick="() => RegisterAsync(competition)">Register entrant</button></div></div></section>
                                }
                            }
                            else
                            {
                                <div class="competition-settings-grid">
                                    <section><h3>Schedule</h3><dl><dt>Seed</dt><dd class="font-mono">@competition.Seed</dd><dt>Algorithm</dt><dd>@competition.AlgorithmVersion</dd><dt>Tiebreak</dt><dd>@competition.Tiebreak.Label()</dd><dt>Scoring</dt><dd>@competition.WinPoints / @competition.DrawPoints / @competition.LossPoints</dd></dl></section>
                                    <section><h3>Rewards</h3><dl><dt>Winner / runner-up</dt><dd>@selected.WinnerPoints.ToDisplayString() / @selected.RunnerUpPoints.ToDisplayString()</dd>@foreach (var rule in selected.MilestoneRewards){<dt>@rule.WinsRequired confirmed wins</dt><dd>@rule.Points.ToDisplayString() points@(string.IsNullOrWhiteSpace(rule.AchievementKey) ? null : $" · {rule.AchievementKey}")</dd>}</dl></section>
                                    <section><h3>Private coordination</h3><p>@(string.IsNullOrWhiteSpace(selected.PrivateLobbyInformation) ? "No lobby information saved." : selected.PrivateLobbyInformation)</p><TextAreaField Id="competition-transition-note" Label="Private transition note" Value="@Note(competition.Id.Value)" ValueChanged="value => SetNote(competition.Id.Value, value)" /></section>
                                    <section><h3>Reminders</h3><p>@selected.ReminderHoursBefore hours before</p><p>@selected.ReminderMessage</p></section>
                                </div>
                                <details class="competition-audit"><summary>Audit history · @selected.Audit.Count</summary><ul>@foreach (var audit in selected.Audit){<li><strong>@audit.Action</strong> by @audit.ActorLogin · @audit.OccurredAtUtc.ToString("u") @if (!string.IsNullOrWhiteSpace(audit.PrivateReason)){<span>· @audit.PrivateReason</span>}</li>}</ul></details>
                            }
                        </div>
                    }
                </div>

                @if (!_isCreating && _selected is { } resultOwner)
                {
                    var competition = resultOwner.Competition;
                    <aside class="competition-result-panel @(_activeTab == "schedule" ? "competition-result-panel--mobile-visible" : null)" aria-label="Contextual result entry">
                        <header><div><p class="live-round-summary__label">Result entry</p><h2>@(_selectedMatch is { } chosen ? $"Round {chosen.Round}" : "No playable match")</h2></div></header>
                        <div class="competition-result-panel__body">
                            @if (competition.Status == CompetitionStatus.Running && _selectedMatch is { } match)
                            {
                                var result = Result(match);
                                <label class="label" for="competition-result-match">Match</label>
                                <select id="competition-result-match" class="input" value="@match.Id.Value" @onchange="args => SelectMatch(new(Guid.Parse(args.Value?.ToString() ?? string.Empty)))">@foreach (var option in competition.Matches.Where(x => x.EntrantAId is not null && x.EntrantBId is not null)){<option value="@option.Id.Value">@($"R{option.Round} · {option.EntrantA} vs {option.EntrantB}")</option>}</select>
                                <div class="competition-result-scores"><div><label class="label" for="result-score-a">@match.EntrantA</label><input id="result-score-a" class="input" type="number" min="0" @bind="result.ScoreA" /></div><div><label class="label" for="result-score-b">@match.EntrantB</label><input id="result-score-b" class="input" type="number" min="0" @bind="result.ScoreB" /></div></div>
                                <TextAreaField Id="result-private-note" Label="Private moderator note" @bind-Value="result.PrivateReason" />
                                <button class="btn-primary w-full" type="button" @onclick="() => ConfirmAsync(competition, match)">@(match.Status == CompetitionMatchStatus.Confirmed ? "Correct result" : "Confirm result")</button>
                                <p class="text-xs text-muted-foreground">Corrections retain previous scores, reset changed downstream fixtures, and recompute standings.</p>
                            }
                            else
                            {
                                <p class="text-sm text-muted-foreground">@(competition.Status == CompetitionStatus.Running ? "Select a playable match from Schedule." : "Result entry becomes available while the competition is running.")</p>
                            }
                            <div class="competition-result-provenance"><strong>Reproducible schedule</strong><span class="font-mono">@competition.Seed</span><span>@competition.AlgorithmVersion</span></div>
                        </div>
                    </aside>
                }
            </section>
        }
    </ChildContent>
</DashboardPage>

@using BlokeBot.Core.Features.SiteAccess

<div id="host-access">
    <StudioStage Key="site-access"
                 Number="2"
                 Title="Who can create channels"
                 Summary="@_stageSummary"
                 Open="@_stageOpen"
                 OpenChanged="open => _stageOpen = open">
        <div class="studio-grid">
            <div class="studio-span-12 flex flex-wrap items-center gap-3">
                <button type="button"
                        id="site-access-whitelist-enabled"
                        class="studio-toggle"
                        role="switch"
                        aria-checked="@(State.WhitelistEnabled ? "true" : "false")"
                        aria-label="Only allow people on the approved list"
                        @onclick="() => ToggleWhitelist(!State.WhitelistEnabled)"></button>
                <span class="text-sm font-semibold text-[var(--app-text-strong)]">Only allow people on the approved list</span>
            </div>
            <div class="studio-span-6">
                <AccessList Title="Approved people"
                            Entries="@WhitelistEntries"
                            Placeholder="twitch login"
                            EmptyText="No one added yet."
                            Add="@AddWhitelist"
                            Remove="@RemoveWhitelist"
                            NewLogin="@NewWhitelistLogin"
                            NewLoginChanged="@OnWhitelistInput"
                            Disabled="@(!State.WhitelistEnabled)" />
            </div>
            <div class="studio-span-6">
                <AccessList Title="Blocked people"
                            Entries="@BlacklistEntries"
                            Placeholder="twitch login"
                            EmptyText="No one added yet."
                            Add="@AddBlacklist"
                            Remove="@RemoveBlacklist"
                            NewLogin="@NewBlacklistLogin"
                            NewLoginChanged="@OnBlacklistInput"
                            Disabled="@State.WhitelistEnabled" />
            </div>
        </div>
    </StudioStage>
</div>

@using BlokeBot.Core.Features.SiteAccess

<div id="host-access">
    <CollapsibleSection Title="Who can create channels"
                        Description="Choose who is allowed to create a BlokeBot channel."
                        InitiallyOpen="false"
                        PreferenceKey="admin-site-access" TaskKey="site-access">
        <div class="space-y-5 p-5">
            <label class="inline-flex items-center gap-3 text-sm font-semibold text-slate-800">
                <input class="h-4 w-4" type="checkbox" checked="@State.WhitelistEnabled" @onchange="ToggleWhitelist" />
                Only allow people on the approved list
            </label>
            <p class="text-sm text-muted-foreground">
                @(State.WhitelistEnabled ? "Only approved Twitch users can create a channel." : "Any Twitch user can create a channel unless they are blocked.")
            </p>

            <div class="grid gap-5 lg:grid-cols-2">
                <AccessList Title="Approved people"
                            Entries="@WhitelistEntries"
                            Placeholder="twitch login"
                            Add="@AddWhitelist"
                            Remove="@RemoveWhitelist"
                            NewLogin="@NewWhitelistLogin"
                            NewLoginChanged="@OnWhitelistInput"
                            Disabled="@(!State.WhitelistEnabled)" />
                <AccessList Title="Blocked people"
                            Entries="@BlacklistEntries"
                            Placeholder="twitch login"
                            Add="@AddBlacklist"
                            Remove="@RemoveBlacklist"
                            NewLogin="@NewBlacklistLogin"
                            NewLoginChanged="@OnBlacklistInput"
                            Disabled="@State.WhitelistEnabled" />
            </div>
        </div>
    </CollapsibleSection>
</div>

<div class="surface-muted rounded-lg p-4" aria-disabled="@Disabled">
    <h3 class="text-sm font-semibold text-foreground">@Title</h3>
    @if (Disabled && !string.IsNullOrWhiteSpace(DisabledText))
    {
        <p class="mt-1 text-xs text-muted-foreground">@DisabledText</p>
    }
    <div class="studio-chips mt-3">
        @if (Entries.Count == 0)
        {
            <p class="text-sm text-muted-foreground">@EmptyText</p>
        }
        else
        {
            @foreach (var entry in Entries)
            {
                @if (Disabled || _pendingRemovals.Contains(entry.Login))
                {
                    <StudioChip @key="entry.Login" Label="@entry.Login" />
                }
                else
                {
                    <StudioChip @key="entry.Login"
                                Label="@entry.Login"
                                RemoveAction="remove-access-entry"
                                RemoveLabel="@($"Remove {entry.Login}")"
                                Remove="() => RemoveEntryAsync(entry.Login)" />
                }
            }
        }
    </div>
    <div class="mt-3 flex gap-2">
        <input class="input"
               placeholder="@Placeholder"
               aria-label="@($"Add to {Title}")"
               value="@NewLogin"
               disabled="@Disabled"
               @oninput="OnInput" />
        <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@Disabled" @onclick="Add">Add</button>
    </div>
</div>

@using BlokeBot.Core.Features.HostedChannels.Authorization

<div class="@_containerClass" data-bot-account-section>
    <div class="flex flex-wrap items-center gap-4">
        @if (Status?.AuthorizedProfileImageUrl is { Length: > 0 } imageUrl)
        {
            <img class="h-11 w-11 shrink-0 rounded-full border border-[var(--app-border)] object-cover shadow-sm"
                 src="@imageUrl"
                 alt="" />
        }
        else
        {
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-[var(--app-border)] bg-[var(--app-surface-muted)] text-[var(--app-text-muted)]">
                <svg class="h-6 w-6 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.5 19 6v5.4c0 4.1-2.8 7.8-7 9.1-4.2-1.3-7-5-7-9.1V6l7-2.5Z" />
                    <path d="M9.25 12h.01" />
                    <path d="M14.75 12h.01" />
                    <path d="M9.5 16c1.4.8 3.6.8 5 0" />
                </svg>
            </span>
        }
        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-bold text-[var(--app-text-strong)]">@_authorizedAccountText</span>
                <span class="@_statusBadgeClass">
                    <span class="@_statusDotClass"></span>
                    <span class="status-pill__label">@_statusText</span>
                </span>
            </div>
            <p class="mt-1 text-xs font-medium text-[var(--app-text-muted)]">Set to use @_configuredAccountText. @_connectionHelpText</p>
            @if (!string.IsNullOrWhiteSpace(Status?.Message))
            {
                <p class="mt-1 text-xs font-medium text-[var(--app-text-muted)]">@Status?.Message</p>
            }
            @if (_connectedChatterScopeMissing)
            {
                <p class="mt-1 text-xs font-bold text-amber-700">
                    Missing Twitch access: Read connected chatters (moderator:read:chatters).
                </p>
            }
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <AuthPopupButton Class="auth-action inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-70"
                             Url="@AuthorizationStartUrl"
                             PopupName="blokebot-bot-oauth"
                             Disabled="@Disabled"
                             OpeningText="Opening..."
                             OnClosed="Refresh">
                @AuthorizeButtonText
            </AuthPopupButton>
            <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-60" disabled="@Disabled" @onclick="Refresh">Refresh</button>
            <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-60" disabled="@Disabled" @onclick="Clear">Disconnect</button>
        </div>
    </div>
    @if (Disabled && !string.IsNullOrWhiteSpace(DisabledMessage))
    {
        <p class="mt-2 text-xs font-bold text-[var(--app-text-muted)]">@DisabledMessage</p>
    }
</div>

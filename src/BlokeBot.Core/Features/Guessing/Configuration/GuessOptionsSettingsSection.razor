@using BlokeBot.Core.Features.Guessing.Profiles

<CollapsibleSection Title="Accepted answers" Description="The first name is canonical; add comma-separated aliases after it. Each answer can have an optional reply." InitiallyOpen="false" TaskKey="@TaskKey" PreferenceKey="guessing-settings-answers">
    <div class="space-y-3 p-4">
        <div class="surface-muted flex flex-wrap items-center justify-between gap-3 rounded-lg p-3">
            <span class="text-sm font-semibold text-slate-900">Answer replies</span>
            <label class="@_whisperLabelClass">
                <input class="h-4 w-4"
                       type="checkbox"
                       checked="@WhisperAnswerReplies"
                       disabled="@_whisperDisabled"
                       aria-describedby="@(_whisperDisabled ? "answer-replies-whisper-recovery" : null)"
                       @onchange="SetAnswerWhispersAsync" />
                <span>Whisper</span>
            </label>
        </div>
        @if (_whisperDisabled)
        {
            <p id="answer-replies-whisper-recovery" class="text-sm font-medium text-slate-600">Private replies need a connected custom bot. <a class="font-semibold text-blue-700 underline underline-offset-2" href="/host#custom-bot">Open Channel setup to connect one.</a></p>
        }
        <div class="motion-list scroll-panel scroll-panel--valid-guesses pr-2">
            @if (Options.Count == 0)
            {
                <p class="text-sm text-muted-foreground">No answers added yet.</p>
            }
            else
            {
                @for (var i = 0; i < Options.Count; i++)
                {
                    var option = Options[i];
                    <div @key="option" class="@OptionRowClass(option)">
                        <input class="input" placeholder="answer" @bind="option.Name" />
                        <input class="input" placeholder="bot reply (you can use {name} and {login})" @bind="option.ReplyText" />
                        <button class="btn-secondary" disabled="@_pendingRemovals.Contains(option)" @onclick="() => RemoveOptionAsync(option)">Remove</button>
                    </div>
                }
            }
        </div>
        <button class="btn-secondary" @onclick="InvokeAddOptionAsync">Add answer</button>
    </div>
</CollapsibleSection>

@code {
    [Parameter]
    public string? TaskKey { get; set; }
}

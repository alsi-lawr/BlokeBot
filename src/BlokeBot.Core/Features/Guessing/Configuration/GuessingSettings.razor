@page "/guessing/settings"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject GuessingConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts

<PageTitle>BlokeBot | Guessing Settings</PageTitle>

<DashboardPage Kicker="Chat tools"
               Title="Configure guessing"
               Description="Choose round types, answers, chat commands, and the replies viewers receive." LoadFailure="@RouteLoadFailure" RetryLoadAsync="LoadAsync">
    <Actions>
        <button class="btn-primary" disabled="@(!_featureEnabled || _config is null)" @onclick="SaveAsync">Save changes</button>
    </Actions>

    <ChildContent>
    @if (Host is null)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Choose a channel" Description="Select the channel whose guessing settings you want to configure from the top bar." />
    }
    else if (!_featureEnabled)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Turn on guessing" Description="Guessing is off for this channel. Turn it on in Channel setup before changing its settings.">
            <Actions><a class="btn-primary" href="/host">Open Channel setup</a></Actions>
        </PageState>
    }
    else if (_config is null)
    {
        <PageState Kind="DashboardPageState.Loading" Title="Loading guessing settings" Description="Loading guessing settings..." />
    }
    else
    {
        <div id="profiles">
            <ProfileSettingsSection Configuration="_config"
                                    CreateProfile="CreateProfileAsync"
                                    DeleteProfile="DeleteProfileAsync"
                                    SelectProfile="SelectProfileAsync"
                                    @bind-NewProfileName="_newProfileName" />
        </div>

        <div class="grid gap-6 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <div id="aliases">
                <CommandAliasSettingsSection Aliases="_config.Aliases" />
            </div>

            <GuessOptionsSettingsSection Options="_config.Profile.Options"
                                         WhisperResponsesEnabled="_config.WhisperResponsesEnabled"
                                         @bind-WhisperAnswerReplies="_config.Profile.WhisperAnswerReplies"
                                         AddOption="AddOption"
                                         RemoveOption="RemoveOption" />
        </div>

        <div id="replies">
            <ReplySettingsSection Replies="_config.Profile.Replies" />
            <ReplyDeliverySettingsSection Delivery="_config.ReplyDelivery"
                                          WhisperResponsesEnabled="_config.WhisperResponsesEnabled"
                                          Options="_whisperReplyOptions" />
            <section class="card mt-6 space-y-4 p-6" aria-labelledby="round-start-pin-title">
                <div>
                    <h2 id="round-start-pin-title" class="text-lg font-bold">Round start pin</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Pin the confirmed round-start reply in Twitch chat.</p>
                </div>
                <label class="flex items-center gap-3 text-sm font-medium">
                    <input type="checkbox" @bind="_config.Pin.Enabled" />
                    Pin round-start replies
                </label>
                @if (_config.Pin.Enabled)
                {
                    <label class="block text-sm font-medium">
                        Duration in seconds (leave blank for until stream end)
                        <input class="input mt-2" type="number" min="30" max="1800" @bind="_config.Pin.DurationSeconds" />
                    </label>
                    <label class="flex items-center gap-3 text-sm font-medium">
                        <input type="checkbox" @bind="_config.Pin.UnpinWhenRoundStops" />
                        Remove this pin when the round stops
                    </label>
                }
            </section>
        </div>
    }
    </ChildContent>
</DashboardPage>

@if (_pendingProfileId is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/45 p-4" data-unsaved-profile-dialog>
        <section class="surface w-full max-w-lg rounded-xl p-6 shadow-xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="unsaved-profile-title"
                 aria-describedby="unsaved-profile-description">
            <h2 id="unsaved-profile-title" class="text-lg font-bold text-slate-950">Unsaved round type changes</h2>
            <p id="unsaved-profile-description" class="mt-2 text-sm leading-6 text-slate-600">Choose what to do with your changes before switching round type.</p>
            <div class="mt-5 grid gap-2 sm:grid-cols-3">
                <button class="btn-primary" @onclick="SaveAndSwitchAsync">Save and switch</button>
                <button class="btn-secondary" @onclick="DiscardAndSwitchAsync">Discard and switch</button>
                <button class="btn-secondary" @onclick="KeepEditing">Keep editing</button>
            </div>
        </section>
    </div>
}

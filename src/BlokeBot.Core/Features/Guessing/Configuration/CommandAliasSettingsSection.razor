<CollapsibleSection Title="Chat commands" Description="Separate extra command words with commas. Each command word can only be used once in this channel." InitiallyOpen="false" PreferenceKey="guessing-settings-commands">
    <div class="grid gap-4 p-4">
        <Field Id="guessing-start-aliases" Label="Start round" @bind-Value="Aliases.StartAliases" Placeholder="startguessing, start" />
        <Field Id="guessing-stop-aliases" Label="Stop guessing" @bind-Value="Aliases.StopAliases" Placeholder="stopguessing, close" />
        <Field Id="guessing-winner-aliases" Label="Declare winner" @bind-Value="Aliases.WinAliases" Placeholder="win, winner" />
        <Field Id="guessing-guess-aliases" Label="Player guess" @bind-Value="Aliases.GuessAliases" Placeholder="guess, vote" />
        <Field Id="guessing-guesses-aliases" Label="Available guesses" @bind-Value="Aliases.GuessesAliases" Placeholder="guesses, options" />
    </div>
</CollapsibleSection>

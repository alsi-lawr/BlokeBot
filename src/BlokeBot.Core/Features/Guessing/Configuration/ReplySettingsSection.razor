<CollapsibleSection Title="Bot replies" Description="Messages the bot sends for guessing commands." InitiallyOpen="false">
    <div class="grid gap-4 p-4 md:grid-cols-2">
        <TextAreaField Id="guessing-round-started-reply" Label="Round started" @bind-Value="Replies.RoundStartedReply" />
        <TextAreaField Id="guessing-round-already-open-reply" Label="Round already running" @bind-Value="Replies.RoundAlreadyOpenReply" />
        <TextAreaField Id="guessing-no-open-round-reply" Label="No round running" @bind-Value="Replies.NoOpenRoundReply" />
        <TextAreaField Id="guessing-stopped-reply" Label="Guessing stopped" @bind-Value="Replies.GuessingStoppedReply" />
        <TextAreaField Id="guessing-already-stopped-reply" Label="Guessing already stopped" @bind-Value="Replies.GuessingAlreadyStoppedReply" />
        <TextAreaField Id="guessing-closed-reply" Label="Guessing closed" @bind-Value="Replies.GuessingClosedReply" />
        <TextAreaField Id="guessing-invalid-guess-reply" Label="Invalid guess" @bind-Value="Replies.InvalidGuessReply" />
        <TextAreaField Id="guessing-usage-reply" Label="How to guess" @bind-Value="Replies.GuessUsageReply" />
        <TextAreaField Id="guessing-available-replies" Label="Available guesses" @bind-Value="Replies.AvailableGuessesReply" />
        <TextAreaField Id="guessing-winner-usage-reply" Label="How to choose a winner" @bind-Value="Replies.WinUsageReply" />
        <TextAreaField Id="guessing-moderator-only-reply" Label="Only moderators can use this" @bind-Value="Replies.ModeratorOnlyReply" />
        <TextAreaField Id="guessing-winner-reply" Label="Winner announced" @bind-Value="Replies.WinnerReply" />
        <TextAreaField Id="guessing-no-winners-reply" Label="No winners" @bind-Value="Replies.NoWinnersReply" />
    </div>
</CollapsibleSection>

<section class="card">
    <div class="border-b border-slate-200 p-5">
        <h2 class="text-lg font-semibold text-slate-950">Run a round</h2>
        <p class="mt-1 text-sm text-muted-foreground">Start a round, stop new guesses, or pick the winner from here.</p>
    </div>
    <div class="studio-grid p-5">
        <div class="studio-span-6">
            <button class="btn-primary w-full" @onclick="InvokeStartRoundAsync">Start round</button>
        </div>
        <div class="studio-span-6">
            <button class="btn-secondary w-full" @onclick="InvokeStopGuessingAsync">Stop guessing</button>
        </div>
        <div class="studio-span-12 space-y-2">
            <label class="label" for="profile">Round type</label>
            <select id="profile" class="input" value="@SelectedProfileId" @onchange="OnSelectedProfileChanged">
                @foreach (var profile in State.Profiles)
                {
                    <option value="@profile.Id">@profile.Name@(profile.IsDefault ? " (default)" : "")</option>
                }
            </select>
        </div>
        <div class="studio-span-12 space-y-2">
            <label class="label" for="winner">Winner</label>
            @if (_answerNames.Count > 0)
            {
                <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]" role="group" aria-label="Configured answers">
                    @foreach (var answer in _answerNames)
                    {
                        <StudioChip @key="answer"
                                    Label="@answer"
                                    Pressed="@(string.Equals(WinnerName, answer, StringComparison.OrdinalIgnoreCase))"
                                    PressedNote="Chosen as the winning answer"
                                    ReleasedNote=""
                                    PressedChanged="@(pressed => ChooseAnswerAsync(answer, pressed))" />
                    }
                </div>
            }
            <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                <input id="winner" class="input min-w-0 flex-1" placeholder="winning answer" value="@WinnerName" @oninput="OnWinnerNameChanged" />
                <button class="btn-primary" @onclick="InvokeDeclareWinnerAsync">Declare win</button>
            </div>
            <p class="text-xs text-muted-foreground">Tap an answer or type it. Moderators can still declare the winner from chat.</p>
        </div>
    </div>
</section>

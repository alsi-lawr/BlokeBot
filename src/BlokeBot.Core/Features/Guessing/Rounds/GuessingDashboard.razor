@page "/guessing"
@using System.Globalization
@using BlokeBot.Commands
@using BlokeBot.Twitch
@using BlokeBot.Twitch.Auth
@using BlokeBot.Twitch.Runtime
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject GuessingDashboardService _dashboard
@inject GuessingHistoryService _history
@inject GuessingRoundService _rounds
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject IPublicChatMessageSender _chat
@inject ToastService _toasts
@inject IJSRuntime _js

<PageTitle>BlokeBot | Guessing</PageTitle>

<DashboardPage Kicker="Chat tools"
               Title="Run a guessing round"
               Description="Start a live round, manage guesses, and review results for the selected channel." LoadFailure="@RouteLoadFailure" RetryLoadAsync="LoadRouteAsync">
    <Actions>
        <button class="btn-secondary" disabled="@(!_featureEnabled)" @onclick="RefreshAsync">Refresh</button>
    </Actions>

    <ChildContent>
    @if (Host is null)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Choose a channel" Description="Select the channel where you want to run guessing rounds from the top bar." />
    }
    else if (!_featureEnabled)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Turn on guessing" Description="Guessing is off for this channel. Turn it on in Channel setup before running a round.">
            <Actions><a class="btn-primary" href="/host">Open Channel setup</a></Actions>
        </PageState>
    }
    else
    {

        <div id="live"
             class="@_segmentedControlClass"
             role="tablist"
             aria-label="Guessing dashboard view"
             @ref="_tabList">
            <span class="segmented-motion__indicator" aria-hidden="true"></span>
            <button class="@TabClass(DashboardTab.Live)"
                    type="button"
                    role="tab"
                    id="guessing-tab-live"
                    aria-controls="guessing-panel-live"
                    tabindex="@(_activeTab == DashboardTab.Live ? "0" : "-1")"
                    aria-selected="@(_activeTab == DashboardTab.Live ? "true" : "false")"
                    @ref="_liveTab"
                    @onclick="() => ActivateTabAsync(DashboardTab.Live)">
                Live
            </button>
            <button class="@TabClass(DashboardTab.History)"
                    type="button"
                    role="tab"
                    id="guessing-tab-history"
                    aria-controls="guessing-panel-history"
                    tabindex="@(_activeTab == DashboardTab.History ? "0" : "-1")"
                    aria-selected="@(_activeTab == DashboardTab.History ? "true" : "false")"
                    @ref="_historyTab"
                    @onclick="() => ActivateTabAsync(DashboardTab.History)">
                History
            </button>
            <button class="@TabClass(DashboardTab.Leaderboard)"
                    type="button"
                    role="tab"
                    id="guessing-tab-leaderboard"
                    aria-controls="guessing-panel-leaderboard"
                    tabindex="@(_activeTab == DashboardTab.Leaderboard ? "0" : "-1")"
                    aria-selected="@(_activeTab == DashboardTab.Leaderboard ? "true" : "false")"
                    @ref="_leaderboardTab"
                    @onclick="() => ActivateTabAsync(DashboardTab.Leaderboard)">
                Leaderboard
            </button>
        </div>

        @if (_activeTab == DashboardTab.Live)
        {
            <section id="guessing-panel-live" role="tabpanel" aria-labelledby="guessing-tab-live">
            @if (_state is null)
            {
                <PageState Kind="DashboardPageState.Loading" Title="Loading guessing" Description="Getting the current round and viewer guesses ready." />
            }
            else
            {
                <TaskPanel Title="Run the current round" Description="Choose a round type, start it when ready, and keep an eye on viewer guesses.">
                    <LiveRoundSummary State="_state" RoundStartedText="@_roundStartedText" RoundStatusText="@_roundStatusText" />

                    <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
                    <RoundOrchestrationPanel State="_state"
                                             StartRound="StartRoundAsync"
                                             StopGuessing="StopGuessingAsync"
                                             DeclareWinner="DeclareWinnerAsync"
                                             @bind-SelectedProfileId="_selectedProfileId"
                                             @bind-WinnerName="_winnerName" />

                    <GuessVotesTable Votes="_state.Votes" />
                </div>
                </TaskPanel>
            }
            </section>
        }
        else if (_activeTab == DashboardTab.History)
        {
            <section id="guessing-panel-history" role="tabpanel" aria-labelledby="guessing-tab-history" class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Recent rounds</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Past rounds for this channel.</p>
                </div>
                @if (_recentRounds is null)
                {
                    <PageState Kind="DashboardPageState.Loading" Title="Loading recent rounds" Description="Getting completed rounds for this channel ready." />
                }
                else if (_recentRounds.Count == 0)
                {
                    <PageState Kind="DashboardPageState.Empty" Title="No completed rounds yet" Description="Finish a guessing round to see it in this history." />
                }
                else
                {
                    <div class="phone-card-list" data-phone-cards="guess-history">
                        @foreach (var round in _recentRounds)
                        {
                            <article @key="round.Id" class="phone-card"><strong>@round.ProfileName</strong><span>Winner @round.Lifecycle.WinningName</span><span>@round.GuessCount guesses</span><span>@FormatEndedAt(round)</span></article>
                        }
                    </div>
                    <div class="wide-data-region scroll-panel scroll-panel--data-table" role="region" tabindex="0" aria-label="Recent guessing rounds">
                        <table class="w-full text-left text-sm">
                            <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                                <tr>
                                    <th class="px-5 py-3 font-semibold">Round</th>
                                    <th class="px-5 py-3 font-semibold">Winner</th>
                                    <th class="px-5 py-3 font-semibold">Guesses</th>
                                    <th class="px-5 py-3 font-semibold">Correct</th>
                                    <th class="px-5 py-3 font-semibold">Started</th>
                                    <th class="px-5 py-3 font-semibold">Ended</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var round in _recentRounds)
                                {
                                    <tr @key="round.Id" class="motion-list__item">
                                        <td class="px-5 py-3 font-medium text-slate-900">@round.ProfileName</td>
                                        <td class="px-5 py-3 text-slate-700">@round.Lifecycle.WinningName</td>
                                        <td class="px-5 py-3 text-slate-700">@round.GuessCount</td>
                                        <td class="px-5 py-3 text-slate-700">@round.CorrectGuessCount</td>
                                        <td class="px-5 py-3 text-muted-foreground">@round.Lifecycle.StartedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                        <td class="px-5 py-3 text-muted-foreground">@FormatEndedAt(round)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else
        {
            <section id="guessing-panel-leaderboard" role="tabpanel" aria-labelledby="guessing-tab-leaderboard" class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Leaderboard</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Rank viewers by correct guesses across past rounds.</p>
                </div>
                <div class="surface-band grid gap-4 border-b p-5 lg:grid-cols-4">
                    <div>
                        <label class="label" for="leaderboardFrom">From</label>
                        <input id="leaderboardFrom" class="input mt-2" type="date" @bind="_leaderboardFromDate" @bind:after="ResetAndLoadLeaderboardAsync" />
                    </div>
                    <div>
                        <label class="label" for="leaderboardTo">To</label>
                        <input id="leaderboardTo" class="input mt-2" type="date" @bind="_leaderboardToDate" @bind:after="ResetAndLoadLeaderboardAsync" />
                    </div>
                    <div>
                        <label class="label" for="leaderboardProfile">Round type</label>
                        <select id="leaderboardProfile" class="input mt-2" @bind="_leaderboardProfileId" @bind:after="ResetAndLoadLeaderboardAsync">
                            <option value="0">All round types</option>
                            @foreach (var profile in _state?.Profiles ?? [])
                            {
                                <option value="@profile.Id">@profile.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="label" for="leaderboardUsername">Username</label>
                        <input id="leaderboardUsername" class="input mt-2" placeholder="any player" @bind="_leaderboardUsername" @bind:event="oninput" @bind:after="ResetAndLoadLeaderboardAsync" />
                    </div>
                </div>

                @if (_leaderboard is null)
                {
                    <PageState Kind="DashboardPageState.Loading" Title="Loading leaderboard" Description="Calculating viewer results for these filters." />
                }
                else
                {
                    <div class="grid gap-4 border-b border-slate-200 p-5 md:grid-cols-2 xl:grid-cols-4">
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Players</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.TotalPlayers</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Guesses</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.TotalGuesses</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Correct</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.CorrectGuesses</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Page</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.Page / @_leaderboard.PageCount</p>
                        </div>
                    </div>

                    <div class="wide-data-region scroll-panel scroll-panel--data-table" role="region" tabindex="0" aria-label="Guessing leaderboard">
                        @if (_leaderboard.Entries.Count == 0)
                        {
                            <PageState Kind="DashboardPageState.Empty" Title="No matching guesses" Description="Try a different date, round type, or viewer name." />
                        }
                        else
                        {
                            <table class="w-full text-left text-sm">
                                <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                                    <tr>
                                        <th class="px-5 py-3 font-semibold">Rank</th>
                                        <th class="px-5 py-3 font-semibold">Player</th>
                                        <th class="px-5 py-3 font-semibold">Correct</th>
                                        <th class="px-5 py-3 font-semibold">Rounds</th>
                                        <th class="px-5 py-3 font-semibold">Accuracy</th>
                                        <th class="px-5 py-3 font-semibold">Latest</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in _leaderboard.Entries)
                                    {
                                        <tr @key="entry" class="motion-list__item">
                                            <td class="px-5 py-3 font-semibold text-slate-900"><RankIndicator Rank="@entry.Rank" /></td>
                                            <td class="px-5 py-3 font-medium text-slate-900">@entry.Login</td>
                                            <td class="px-5 py-3 text-slate-700">@entry.CorrectGuesses</td>
                                            <td class="px-5 py-3 text-slate-700">@entry.RoundsPlayed</td>
                                            <td class="px-5 py-3 text-slate-700">@entry.HitRate.ToString("P0", CultureInfo.CurrentCulture)</td>
                                            <td class="px-5 py-3 text-muted-foreground">@entry.LastGuessAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="flex flex-col gap-3 border-t border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-3">
                            <label class="label" for="leaderboardPageSize">Rows</label>
                            <select id="leaderboardPageSize" class="control-surface h-9 rounded-md px-2 text-sm font-medium" @bind="_leaderboardPageSize" @bind:after="ResetAndLoadLeaderboardAsync">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(_leaderboard.Page <= 1)" @onclick="PreviousLeaderboardPageAsync">Previous</button>
                            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(_leaderboard.Page >= _leaderboard.PageCount)" @onclick="NextLeaderboardPageAsync">Next</button>
                        </div>
                    </div>
                }
            </section>
        }
    }
    </ChildContent>
</DashboardPage>

@page "/guessing"
@using System.Globalization
@using BlokeBot.Commands
@using BlokeBot.Twitch
@using BlokeBot.Twitch.Auth
@using BlokeBot.Twitch.Runtime
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject GuessingDashboardService _dashboard
@inject GuessingHistoryService _history
@inject GuessingRoundService _rounds
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject IPublicChatMessageSender _chat
@inject ToastService _toasts
@inject NavigationManager _navigation

<PageTitle>BlokeBot | Guessing</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Kicker="Dashboard"
                Title="Guessing game"
                Description="Run live rounds and look back at viewer results.">
        <button class="btn-primary" disabled="@(!_featureEnabled)" @onclick="RefreshAsync">Refresh</button>
    </PageHeader>

    @if (Host is null)
    {
        <ApplicationCardCollection Owner="guessing-dashboard-cards">
            <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
        </ApplicationCardCollection>
    }
    else if (!_featureEnabled)
    {
        <ApplicationCardCollection Owner="guessing-dashboard-cards">
            <div class="card p-8 text-sm text-muted-foreground">Guessing game is off for this channel. Turn it on in Channel setup.</div>
        </ApplicationCardCollection>
    }
    else
    {

        <SegmentedTabs Id="guessing"
                       OwnsFragment
                       AriaLabel="Guessing dashboard view"
                       Items="_dashboardTabs"
                       ActiveKey="@KeyForTab(_activeTab)"
                       ActiveKeyChanged="ActivateTabAsync" />

        @if (_activeTab == DashboardTab.Live)
        {
            <div id="guessing-live-panel"
                 class="space-y-6"
                 role="tabpanel"
                 aria-labelledby="guessing-live-tab"
                 tabindex="0">
            @if (_state is null)
            {
                <ApplicationCardCollection Owner="guessing-dashboard-cards">
                    <div class="card p-8 text-sm text-muted-foreground">Loading guessing game...</div>
                </ApplicationCardCollection>
            }
            else
            {
                <LiveRoundSummary State="_state" RoundStartedText="@_roundStartedText" RoundStatusText="@_roundStatusText" />

                <div class="grid gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
                     data-card-owner="guessing-dashboard-cards">
                    <RoundOrchestrationPanel State="_state"
                                             StartRound="StartRoundAsync"
                                             StopGuessing="StopGuessingAsync"
                                             DeclareWinner="DeclareWinnerAsync"
                                             @bind-SelectedProfileId="_selectedProfileId"
                                             @bind-WinnerName="_winnerName" />

                    <GuessVotesTable Votes="_state.Votes" />
                </div>
            }
            </div>
        }
        else if (_activeTab == DashboardTab.History)
        {
            <div id="guessing-history-panel"
                 role="tabpanel"
                 aria-labelledby="guessing-history-tab"
                 tabindex="0">
            <ApplicationCardCollection Owner="guessing-dashboard-cards">
            <section class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Recent rounds</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Past rounds for this channel.</p>
                </div>
                @if (_recentRounds is null)
                {
                    <div class="p-8 text-sm text-muted-foreground">Loading recent rounds...</div>
                }
                else if (_recentRounds.Count == 0)
                {
                    <div class="p-8 text-sm text-muted-foreground">No completed rounds yet.</div>
                }
                else
                {
                    <div class="responsive-data-cards scroll-panel scroll-panel--data-table overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                                <tr>
                                    <th class="px-5 py-3 font-semibold">Round</th>
                                    <th class="px-5 py-3 font-semibold">Winner</th>
                                    <th class="px-5 py-3 font-semibold">Guesses</th>
                                    <th class="px-5 py-3 font-semibold">Correct</th>
                                    <th class="px-5 py-3 font-semibold">Started</th>
                                    <th class="px-5 py-3 font-semibold">Ended</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var round in _recentRounds)
                                {
                                    <tr @key="round.Id" class="motion-list__item">
                                        <td data-label="Round" class="px-5 py-3 font-medium text-slate-900">@round.ProfileName</td>
                                        <td data-label="Winner" class="px-5 py-3 text-slate-700">@round.Lifecycle.WinningName</td>
                                        <td data-label="Guesses" class="px-5 py-3 text-slate-700">@round.GuessCount</td>
                                        <td data-label="Correct" class="px-5 py-3 text-slate-700">@round.CorrectGuessCount</td>
                                        <td data-label="Started" class="px-5 py-3 text-muted-foreground">@round.Lifecycle.StartedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                        <td data-label="Ended" class="px-5 py-3 text-muted-foreground">@FormatEndedAt(round)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
            </ApplicationCardCollection>
            </div>
        }
        else
        {
            <div id="guessing-leaderboard-panel"
                 role="tabpanel"
                 aria-labelledby="guessing-leaderboard-tab"
                 tabindex="0">
            <ApplicationCardCollection Owner="guessing-dashboard-cards">
            <section class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Leaderboard</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Rank viewers by correct guesses across past rounds.</p>
                </div>
                <div class="surface-band grid gap-4 border-b p-5 lg:grid-cols-4">
                    <div>
                        <div class="field">
                            <label class="field__label" for="leaderboardFrom">From</label>
                            <input id="leaderboardFrom" class="field__input mt-2" type="date" @bind="_leaderboardFromDate" @bind:after="ResetAndLoadLeaderboardAsync" />
                        </div>
                    </div>
                    <div>
                        <div class="field">
                            <label class="field__label" for="leaderboardTo">To</label>
                            <input id="leaderboardTo" class="field__input mt-2" type="date" @bind="_leaderboardToDate" @bind:after="ResetAndLoadLeaderboardAsync" />
                        </div>
                    </div>
                    <div>
                        <div class="field">
                            <label class="field__label" for="leaderboardProfile">Round type</label>
                            <select id="leaderboardProfile" class="field__input mt-2" @bind="_leaderboardProfileId" @bind:after="ResetAndLoadLeaderboardAsync">
                                <option value="0">All round types</option>
                                @foreach (var profile in _state?.Profiles ?? [])
                                {
                                    <option value="@profile.Id">@profile.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <div class="field">
                            <label class="field__label" for="leaderboardUsername">Username</label>
                            <input id="leaderboardUsername" class="field__input mt-2" placeholder="any player" @bind="_leaderboardUsername" @bind:event="oninput" @bind:after="ResetAndLoadLeaderboardAsync" />
                        </div>
                    </div>
                </div>

                @if (_leaderboard is null)
                {
                    <div class="p-8 text-sm text-muted-foreground">Loading leaderboard...</div>
                }
                else
                {
                    <div class="grid gap-4 border-b border-slate-200 p-5 md:grid-cols-2 xl:grid-cols-4">
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Players</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.TotalPlayers</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Guesses</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.TotalGuesses</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Correct</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.CorrectGuesses</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Page</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@_leaderboard.Page / @_leaderboard.PageCount</p>
                        </div>
                    </div>

                    <div class="responsive-data-cards scroll-panel scroll-panel--data-table overflow-x-auto">
                        @if (_leaderboard.Entries.Count == 0)
                        {
                            <div class="p-8 text-sm text-muted-foreground">No past guesses match these filters.</div>
                        }
                        else
                        {
                            <table class="w-full text-left text-sm">
                                <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                                    <tr>
                                        <th class="px-5 py-3 font-semibold">Rank</th>
                                        <th class="px-5 py-3 font-semibold">Player</th>
                                        <th class="px-5 py-3 font-semibold">Correct</th>
                                        <th class="px-5 py-3 font-semibold">Rounds</th>
                                        <th class="px-5 py-3 font-semibold">Accuracy</th>
                                        <th class="px-5 py-3 font-semibold">Latest</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in _leaderboard.Entries)
                                    {
                                        <tr @key="entry" class="motion-list__item">
                                            <td data-label="Rank" class="px-5 py-3 font-semibold text-slate-900"><RankIndicator Rank="@entry.Rank" /></td>
                                            <td data-label="Player" class="px-5 py-3 font-medium text-slate-900">@entry.Login</td>
                                            <td data-label="Correct" class="px-5 py-3 text-slate-700">@entry.CorrectGuesses</td>
                                            <td data-label="Rounds" class="px-5 py-3 text-slate-700">@entry.RoundsPlayed</td>
                                            <td data-label="Accuracy" class="px-5 py-3 text-slate-700">@entry.HitRate.ToString("P0", CultureInfo.CurrentCulture)</td>
                                            <td data-label="Latest" class="px-5 py-3 text-muted-foreground">@entry.LastGuessAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="flex flex-col gap-3 border-t border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-3">
                            <label class="label" for="leaderboardPageSize">Rows</label>
                            <select id="leaderboardPageSize" class="control-surface h-9 rounded-md px-2 text-sm font-medium" @bind="_leaderboardPageSize" @bind:after="ResetAndLoadLeaderboardAsync">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(_leaderboard.Page <= 1)" @onclick="PreviousLeaderboardPageAsync">Previous</button>
                            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(_leaderboard.Page >= _leaderboard.PageCount)" @onclick="NextLeaderboardPageAsync">Next</button>
                        </div>
                    </div>
                }
            </section>
            </ApplicationCardCollection>
            </div>
        }
    }
</div>

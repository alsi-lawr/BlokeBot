@page "/overlays"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inject NavigationManager _navigation

<PageTitle>@_pageTitle</PageTitle>

<DashboardPage Kicker="Stream presentation"
               Title="@_title"
               Description="@_description"
               Width="DashboardPageWidth.Wide">
    <ChildContent>
        <SegmentedTabs Id="overlays"
                       OwnsFragment
                       AriaLabel="Overlays sections"
                       Items="_tabs"
                       ActiveKey="@_activeKey"
                       ActiveKeyChanged="ActivateTab"
                       data-overlay-tabs />
        @foreach (var item in _tabs)
        {
            if (!_visited.Contains(item.Key))
            {
                continue;
            }

            <div @key="item.Key"
                 id="@SegmentedTabs.PanelId("overlays", item.Key)"
                 class="grid gap-6"
                 role="tabpanel"
                 aria-labelledby="@SegmentedTabs.TabId("overlays", item.Key)"
                 hidden="@(item.Key != _activeKey)"
                 tabindex="0">
                @switch (item.Key)
                {
                    case "sources":
                        <OverlaySourcesPanel />
                        break;
                    case "cues":
                        <OverlayCuesPanel />
                        break;
                    default:
                        <OverlayMediaPanel />
                        break;
                }
            </div>
        }
    </ChildContent>
</DashboardPage>

@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Features.Bounties
@using BlokeBot.Core.Features.CommunityProgression
@using BlokeBot.Core.Features.PlayWithViewers
@using BlokeBot.Persistence.Models
@inherits AuthenticatedPageComponent
@inject OverlayInstanceService _overlays
@inject HostFeatureService _features
@inject IOverlayLivePublisher _publisher
@inject IOverlayLivePresence _presence
@inject NavigationManager _navigation
@inject IJSRuntime _js
@inject PlayQueueService _queues
@inject BountyService _bounties
@inject CommunityProgressionService _progression

        @if (_isLoading)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground" role="status">Loading overlays...</div>
            </ApplicationCardCollection>
        }
        else if (Host is null)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
            </ApplicationCardCollection>
        }
        else if (!_featureEnabled)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Overlays are off for this channel.
                    <a class="font-semibold text-blue-700 underline" href="host">Turn them on in Channel setup.</a>
                </div>
            </ApplicationCardCollection>
        }
        else
        {
            var showPositionStage = _selected is not null && _selectedFeatureEnabled;
            var showDeliveryStage = _selected is not null;
            var whatItShowsNumber = showPositionStage ? 3 : 2;
            <ApplicationCardCollection Owner="dashboard-page-cards">
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <section class="@(_operationFailed ? "card border-slate-200 bg-red-50 p-4 text-sm font-semibold text-slate-950" : "card border-slate-200 bg-blue-50 p-4 text-sm font-semibold text-slate-950")"
                         role="@(_operationFailed ? "alert" : "status")"
                         data-overlay-feedback="@(_operationFailed ? "error" : "success")">
                    @_feedback
                </section>
            }

            <section class="studio grid grid-cols-[minmax(15rem,17rem)_minmax(0,1fr)] rounded-[14px] border border-[var(--app-border)] bg-[var(--app-surface-solid)] shadow-[var(--app-shadow-surface)] max-lg:grid-cols-[minmax(0,1fr)]" aria-label="Browser Source studio">
                <StudioRail AriaLabel="Saved overlays" SearchPlaceholder="Search" Groups="_railGroups">
                    <Footer>
                        <button class="btn-primary w-full"
                                type="button"
                                data-action="new-overlay"
                                disabled="@_isCreating"
                                @onclick="NewOverlay">+ New Browser Source</button>
                    </Footer>
                </StudioRail>

                <div class="studio__inspector flex min-w-0 flex-col" data-overlay-editor data-sticky-save-scope>
                    <header class="studio__header flex flex-wrap items-center gap-x-[0.9rem] gap-y-2 rounded-tr-[14px] border-b border-[var(--app-border)] bg-[var(--app-surface)] px-5 py-[0.85rem] max-lg:rounded-tr-none">
                        <span class="studio__title min-w-0 text-[1.1rem] font-extrabold text-[var(--app-text-strong)] wrap-anywhere">@(_isCreating ? "New overlay (not saved)" : _selected?.Name ?? _draftName)</span>
                        @if (!_isCreating && _selected is { } headerOverlay)
                        {
                            <span class="studio__subtitle text-[0.78rem] text-[var(--app-text-muted)]">@TypeLabel(headerOverlay.Type) · @UpdatedLabel(headerOverlay)</span>
                            @if (headerOverlay.RequiresAccessKeyRegeneration)
                            {
                                <span class="status-pill status-pill--amber">URL regeneration required</span>
                            }
                        }
                        <span class="studio__spacer flex-1"></span>
                        @if (_selected is { } toggledOverlay)
                        {
                            <span class="studio-toggle-label text-[0.82rem] font-semibold text-[var(--app-text-muted)]">Enabled</span>
                            <button type="button"
                                    class="studio-toggle"
                                    role="switch"
                                    aria-checked="@(toggledOverlay.IsEnabled ? "true" : "false")"
                                    aria-label="Enabled"
                                    disabled="@(_isBusy || !_selectedFeatureEnabled)"
                                    @onclick="ToggleAvailabilityAsync"></button>
                        }
                        <StickySaveRegion Scope="StickySaveScope.Editor" Active="@(!_isCreating)">
                            <button class="btn-primary"
                                    type="button"
                                    disabled="@(!_featureEnabled || !_selectedFeatureEnabled || _isBusy)"
                                    @onclick="SaveAsync">@(_isCreating ? "Create overlay" : "Save overlay")</button>
                        </StickySaveRegion>
                    </header>

                    <div class="studio__body grid min-w-0 gap-3 p-5 max-md:p-4">
                        <StudioStage Key="overlay-basics"
                                     Number="1"
                                     Title="Basics"
                                     Summary="@BasicsSummary()"
                                     Open="@_openStages.IsOpen(OverlaySourceStage.Basics)"
                                     OpenChanged="@(open => _openStages.Set(OverlaySourceStage.Basics, open))">
                            <div class="studio-grid">
                                <div class="studio-span-6">
                                    <Field Id="overlay-name"
                                           Label="Overlay name"
                                           @bind-Value="_draftName"
                                           Placeholder="Main stream overlay" />
                                </div>
                                <div class="studio-span-6 space-y-2">
                                    <div class="field">
                                        <label class="field__label" for="overlay-type">Overlay type</label>
                                        <select id="overlay-type"
                                                class="field__input"
                                                disabled="@(!_isCreating)"
                                                @bind="_draftType"
                                                @bind:after="DraftTypeChanged">
                                            <option value="@OverlayType.Empty">Empty</option>
                                            <option value="@OverlayType.CuePlayer">Cue player</option>
                                            <option value="@OverlayType.EventFeed">Event feed</option>
                                            @if (_playWithViewersFeatureEnabled || _draftType is OverlayType.ViewerQueue)
                                            {
                                                <option value="@OverlayType.ViewerQueue">Viewer Queue</option>
                                            }
                                            @if (_guessingFeatureEnabled || _draftType is OverlayType.Guessing)
                                            {
                                                <option value="@OverlayType.Guessing">Guessing round</option>
                                            }
                                            @if (_pointsFeatureEnabled || _draftType is OverlayType.Giveaway)
                                            {
                                                <option value="@OverlayType.Giveaway">Points giveaway</option>
                                            }
                                            @if (_communityProgressionFeatureEnabled || _draftType is OverlayType.CommunityGoal)
                                            {
                                                <option value="@OverlayType.CommunityGoal">Community goal</option>
                                            }
                                            @if (_bountiesFeatureEnabled || _draftType is OverlayType.ViewerFundedBounty)
                                            {
                                                <option value="@OverlayType.ViewerFundedBounty">Viewer-funded bounty</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </StudioStage>

                        @if (showPositionStage && _selected is { } previewOverlay)
                        {
                            <StudioStage Key="position-look"
                                         Number="2"
                                         Title="Position & look"
                                         Summary="@PositionSummary()"
                                         Open="@_openStages.IsOpen(OverlaySourceStage.PositionLook)"
                                         OpenChanged="@(open => _openStages.Set(OverlaySourceStage.PositionLook, open))">
                                <div class="flex flex-wrap items-center gap-3">
                                    <StudioSegmentedPill TValue="OverlayPreviewMode"
                                                         AriaLabel="Preview state"
                                                         Options="_previewModeOptions"
                                                         Value="_previewMode"
                                                         ValueChanged="SetPreviewMode" />
                                    @if (previewOverlay.Type is OverlayType.Guessing)
                                    {
                                        <StudioSegmentedPill TValue="GuessingOverlaySampleState?"
                                                             AriaLabel="Guessing overlay sample state"
                                                             Options="_guessingSampleOptions"
                                                             Value="@(_previewMode is OverlayPreviewMode.Representative ? _previewSample : (GuessingOverlaySampleState?)null)"
                                                             ValueChanged="@((GuessingOverlaySampleState? sample) => SetPreviewSample(sample!.Value))" />
                                    }
                                    else if (previewOverlay.Type is OverlayType.Giveaway)
                                    {
                                        <StudioSegmentedPill TValue="GiveawayOverlaySampleState?"
                                                             AriaLabel="Giveaway overlay sample state"
                                                             Options="_giveawaySampleOptions"
                                                             Value="@(_previewMode is OverlayPreviewMode.Representative ? _giveawayPreviewSample : (GiveawayOverlaySampleState?)null)"
                                                             ValueChanged="@((GiveawayOverlaySampleState? sample) => SetPreviewSample(sample!.Value))" />
                                    }
                                    else if (previewOverlay.Type is OverlayType.EventFeed)
                                    {
                                        <StudioSegmentedPill TValue="OverlayEventFeedKind?"
                                                             AriaLabel="Event feed sample event"
                                                             Options="_eventFeedSampleOptions"
                                                             Value="@(_previewMode is OverlayPreviewMode.Representative ? _eventFeedPreviewSample : (OverlayEventFeedKind?)null)"
                                                             ValueChanged="@((OverlayEventFeedKind? sample) => SetPreviewSample(sample!.Value))" />
                                    }
                                    else if (previewOverlay.Type is OverlayType.ViewerQueue)
                                    {
                                        <StudioSegmentedPill TValue="ViewerQueueOverlaySampleState?"
                                                             AriaLabel="Viewer Queue sample state"
                                                             Options="_viewerQueueSampleOptions"
                                                             Value="@(_previewMode is OverlayPreviewMode.Representative ? _viewerQueuePreviewSample : (ViewerQueueOverlaySampleState?)null)"
                                                             ValueChanged="@((ViewerQueueOverlaySampleState? sample) => SetPreviewSample(sample!.Value))" />
                                    }
                                    else if (previewOverlay.Type is OverlayType.CommunityGoal or OverlayType.ViewerFundedBounty)
                                    {
                                        <StudioSegmentedPill TValue="ProgressOverlaySampleState?"
                                                             AriaLabel="Progress overlay sample state"
                                                             Options="_progressSampleOptions"
                                                             Value="@(_previewMode is OverlayPreviewMode.Representative ? _progressPreviewSample : (ProgressOverlaySampleState?)null)"
                                                             ValueChanged="@((ProgressOverlaySampleState? sample) => SetPreviewSample(sample!.Value))" />
                                    }
                                </div>

                                @if (previewOverlay.Type is OverlayType.EventFeed && !_communityProgressionFeatureEnabled)
                                {
                                    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3"
                                         data-achievement-preview-disabled-recovery>
                                        <p class="text-sm leading-6 text-slate-700">
                                            <span class="font-semibold text-slate-950">Achievement samples are paused.</span>
                                            Community progression is off, so achievement preview and live display are unavailable. Other configured event kinds remain available to preview.
                                        </p>
                                    </div>
                                }

                                <div class="relative mt-4 aspect-video overflow-hidden rounded-xl border border-slate-300 bg-[linear-gradient(45deg,#e2e8f0_25%,transparent_25%),linear-gradient(-45deg,#e2e8f0_25%,transparent_25%),linear-gradient(45deg,transparent_75%,#e2e8f0_75%),linear-gradient(-45deg,transparent_75%,#e2e8f0_75%)] bg-[length:24px_24px]"
                                     data-appearance-canvas>
                                    <iframe @key="_previewUrl"
                                            class="@(previewOverlay.Type is OverlayType.Empty or OverlayType.CuePlayer ? "overlay-preview-frame overlay-preview-frame--ready h-full w-full" : "overlay-preview-frame h-full w-full")"
                                            data-appearance-preview
                                            data-overlay-id="@previewOverlay.Id"
                                            data-draft-type="@previewOverlay.Type.ToString().ToLowerInvariant()"
                                            data-show-guess-count="@_draftShowGuessCount.ToString().ToLowerInvariant()"
                                            data-giveaway-title="@_draftGiveawayTitle"
                                            data-show-entrant-count="@_draftShowEntrantCount.ToString().ToLowerInvariant()"
                                            data-show-countdown="@_draftShowCountdown.ToString().ToLowerInvariant()"
                                            data-show-join-command="@_draftShowJoinCommand.ToString().ToLowerInvariant()"
                                            data-current-rows="@_viewerQueueCurrentRows"
                                            data-next-rows="@_viewerQueueNextRows"
                                            data-rotation-seconds="@_progressRotationSeconds"
                                            src="@_previewUrl"
                                            title="@($"{previewOverlay.Name} overlay preview")"
                                            referrerpolicy="no-referrer"></iframe>
                                    @if (previewOverlay.Type is not (OverlayType.Empty or OverlayType.CuePlayer))
                                    {
                                        <svg class="absolute inset-0 size-full touch-none"
                                             viewBox="0 0 1920 1080"
                                             role="group"
                                             aria-label="Overlay position and size"
                                             data-appearance-editor
                                             data-x="@_appearanceX" data-y="@_appearanceY"
                                             data-width="@_appearanceWidth" data-height="@_appearanceHeight"
                                             data-rendered-css="@_appearanceCss">
                                            <style>
                                                [data-selection-line] { fill: none; stroke: #2563eb; stroke-width: 5; stroke-dasharray: 22 14; pointer-events: none; animation: overlay-selection-dashes 1s linear infinite; }
                                                [data-appearance-action] { fill: transparent; stroke: transparent; }
                                                [data-appearance-action="move"] { cursor: move; }
                                                [data-appearance-action="w"], [data-appearance-action="e"] { cursor: ew-resize; }
                                                [data-appearance-action="n"], [data-appearance-action="s"] { cursor: ns-resize; }
                                                [data-appearance-action="nw"], [data-appearance-action="se"] { cursor: nwse-resize; }
                                                [data-appearance-action="ne"], [data-appearance-action="sw"] { cursor: nesw-resize; }
                                                @@keyframes overlay-selection-dashes { to { stroke-dashoffset: -36; } }
                                                @@media (prefers-reduced-motion: reduce) { [data-selection-line] { animation: none; } }
                                            </style>
                                            <rect x="@_appearanceX" y="@_appearanceY" width="@_appearanceWidth" height="@_appearanceHeight" data-selection-line />
                                            <rect x="@_appearanceX" y="@_appearanceY" width="@_appearanceWidth" height="@_appearanceHeight" tabindex="0" role="button" aria-label="Move overlay. Use arrow keys for one pixel, or Shift plus arrow for ten pixels." data-appearance-action="move" />
                                            <rect x="@(_appearanceX - 14)" y="@(_appearanceY + 28)" width="28" height="@(_appearanceHeight - 56)" tabindex="0" role="slider" aria-label="Resize from left edge" data-appearance-action="w" />
                                            <rect x="@(_appearanceX + _appearanceWidth - 14)" y="@(_appearanceY + 28)" width="28" height="@(_appearanceHeight - 56)" tabindex="0" role="slider" aria-label="Resize from right edge" data-appearance-action="e" />
                                            <rect x="@(_appearanceX + 28)" y="@(_appearanceY - 14)" width="@(_appearanceWidth - 56)" height="28" tabindex="0" role="slider" aria-label="Resize from top edge" data-appearance-action="n" />
                                            <rect x="@(_appearanceX + 28)" y="@(_appearanceY + _appearanceHeight - 14)" width="@(_appearanceWidth - 56)" height="28" tabindex="0" role="slider" aria-label="Resize from bottom edge" data-appearance-action="s" />
                                            <rect x="@(_appearanceX - 20)" y="@(_appearanceY - 20)" width="40" height="40" tabindex="0" role="slider" aria-label="Resize from top left corner" data-appearance-action="nw" />
                                            <rect x="@(_appearanceX + _appearanceWidth - 20)" y="@(_appearanceY - 20)" width="40" height="40" tabindex="0" role="slider" aria-label="Resize from top right corner" data-appearance-action="ne" />
                                            <rect x="@(_appearanceX - 20)" y="@(_appearanceY + _appearanceHeight - 20)" width="40" height="40" tabindex="0" role="slider" aria-label="Resize from bottom left corner" data-appearance-action="sw" />
                                            <rect x="@(_appearanceX + _appearanceWidth - 20)" y="@(_appearanceY + _appearanceHeight - 20)" width="40" height="40" tabindex="0" role="slider" aria-label="Resize from bottom right corner" data-appearance-action="se" />
                                        </svg>
                                    }
                                </div>

                                @if (previewOverlay.Type is not (OverlayType.Empty or OverlayType.CuePlayer))
                                {
                                    <div class="studio-grid mt-4" data-appearance-fields>
                                        <div class="col-span-3 min-w-0 max-md:col-span-6"><div class="field"><label class="field__label" for="appearance-x">X</label><input id="appearance-x" class="field__input" type="number" min="0" max="1760" @bind="_appearanceX" @bind:event="oninput" /></div></div>
                                        <div class="col-span-3 min-w-0 max-md:col-span-6"><div class="field"><label class="field__label" for="appearance-y">Y</label><input id="appearance-y" class="field__input" type="number" min="0" max="990" @bind="_appearanceY" @bind:event="oninput" /></div></div>
                                        <div class="col-span-3 min-w-0 max-md:col-span-6"><div class="field"><label class="field__label" for="appearance-width">Width</label><input id="appearance-width" class="field__input" type="number" min="160" max="1920" @bind="_appearanceWidth" @bind:event="oninput" /></div></div>
                                        <div class="col-span-3 min-w-0 max-md:col-span-6"><div class="field"><label class="field__label" for="appearance-height">Height</label><input id="appearance-height" class="field__input" type="number" min="90" max="1080" @bind="_appearanceHeight" @bind:event="oninput" /></div></div>
                                        <div class="studio-span-12"><button class="btn-secondary" type="button" @onclick="ResetAppearance">Reset position and size</button></div>
                                    </div>
                                    <div class="mt-4">
                                        <StudioFold Key="overlay-css"
                                                    Label="Advanced styling: overlay-local CSS"
                                                    Open="@_cssFoldOpen"
                                                    OpenChanged="@(open => _cssFoldOpen = open)">
                                            <textarea id="appearance-css"
                                                      class="input min-h-32 font-mono text-xs"
                                                      aria-label="Overlay-local CSS"
                                                      maxlength="@OverlayAppearance.MaximumCssBytes"
                                                      spellcheck="false"
                                                      @bind="_appearanceCss" @bind:event="oninput" data-appearance-css></textarea>
                                        </StudioFold>
                                    </div>
                                }
                            </StudioStage>
                        }

                        <StudioStage Key="what-it-shows"
                                     Number="@whatItShowsNumber"
                                     Title="What it shows"
                                     Summary="@WhatItShowsSummary()"
                                     Open="@_openStages.IsOpen(OverlaySourceStage.WhatItShows)"
                                     OpenChanged="@(open => _openStages.Set(OverlaySourceStage.WhatItShows, open))">
                            @if (_draftType is OverlayType.Guessing)
                            {
                                @if (!_guessingFeatureEnabled)
                                {
                                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4"
                                         data-overlay-disabled-recovery>
                                        <p class="text-sm font-semibold text-slate-950">This guessing overlay is paused.</p>
                                        <p class="mt-1 text-sm leading-6 text-slate-700">
                                            Guessing game is off.
                                            <a class="font-semibold text-blue-700 underline" href="host">Turn Guessing game on in Channel setup</a>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="studio-grid">
                                        <div class="studio-span-6 self-end">
                                            <span class="studio-switch-row flex items-center justify-between gap-[0.8rem] rounded-lg border border-[var(--app-control-border)] bg-[var(--app-control-bg)] px-[0.9rem] py-[0.6rem] text-[0.9rem] font-semibold text-[var(--app-text-strong)]">
                                                <span id="overlay-guess-count-label">Show the number of guesses</span>
                                                <button type="button"
                                                        class="studio-toggle"
                                                        role="switch"
                                                        aria-checked="@(_draftShowGuessCount ? "true" : "false")"
                                                        aria-labelledby="overlay-guess-count-label"
                                                        @onclick="() => _draftShowGuessCount = !_draftShowGuessCount"></button>
                                            </span>
                                        </div>
                                        <div class="studio-span-6">
                                            <div class="field">
                                                <label class="field__label" for="overlay-result-duration">Result animation duration (seconds)</label>
                                                <input id="overlay-result-duration"
                                                       class="field__input"
                                                       type="number"
                                                       min="@OverlayConfiguration.GuessingV1.MinimumResultDurationSeconds"
                                                       max="@OverlayConfiguration.GuessingV1.MaximumResultDurationSeconds"
                                                       @bind="_draftResultDurationSeconds" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (_draftType is OverlayType.Giveaway)
                            {
                                @if (!_pointsFeatureEnabled)
                                {
                                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4"
                                         data-overlay-disabled-recovery>
                                        <p class="text-sm font-semibold text-slate-950">This giveaway overlay is paused.</p>
                                        <p class="mt-1 text-sm leading-6 text-slate-700">
                                            Points is off.
                                            <a class="font-semibold text-blue-700 underline" href="host">Turn Points on in Channel setup</a>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="studio-grid">
                                        <div class="studio-span-6">
                                            <Field Id="overlay-giveaway-title"
                                                   Label="Giveaway title"
                                                   @bind-Value="_draftGiveawayTitle"
                                                   Placeholder="Points giveaway" />
                                        </div>
                                        <div class="studio-span-6 grid content-end gap-2">
                                            <span class="studio-switch-row flex items-center justify-between gap-[0.8rem] rounded-lg border border-[var(--app-control-border)] bg-[var(--app-control-bg)] px-[0.9rem] py-[0.6rem] text-[0.9rem] font-semibold text-[var(--app-text-strong)]">
                                                <span id="overlay-entrant-count-label">Entrant count</span>
                                                <button type="button" class="studio-toggle" role="switch"
                                                        aria-checked="@(_draftShowEntrantCount ? "true" : "false")"
                                                        aria-labelledby="overlay-entrant-count-label"
                                                        @onclick="() => _draftShowEntrantCount = !_draftShowEntrantCount"></button>
                                            </span>
                                            <span class="studio-switch-row flex items-center justify-between gap-[0.8rem] rounded-lg border border-[var(--app-control-border)] bg-[var(--app-control-bg)] px-[0.9rem] py-[0.6rem] text-[0.9rem] font-semibold text-[var(--app-text-strong)]">
                                                <span id="overlay-countdown-label">Close-time countdown</span>
                                                <button type="button" class="studio-toggle" role="switch"
                                                        aria-checked="@(_draftShowCountdown ? "true" : "false")"
                                                        aria-labelledby="overlay-countdown-label"
                                                        @onclick="() => _draftShowCountdown = !_draftShowCountdown"></button>
                                            </span>
                                            <span class="studio-switch-row flex items-center justify-between gap-[0.8rem] rounded-lg border border-[var(--app-control-border)] bg-[var(--app-control-bg)] px-[0.9rem] py-[0.6rem] text-[0.9rem] font-semibold text-[var(--app-text-strong)]">
                                                <span id="overlay-join-command-label">Current join command</span>
                                                <button type="button" class="studio-toggle" role="switch"
                                                        aria-checked="@(_draftShowJoinCommand ? "true" : "false")"
                                                        aria-labelledby="overlay-join-command-label"
                                                        @onclick="() => _draftShowJoinCommand = !_draftShowJoinCommand"></button>
                                            </span>
                                        </div>
                                    </div>
                                }
                            }
                            else if (_draftType is OverlayType.CommunityGoal or OverlayType.ViewerFundedBounty)
                            {
                                var requiredFeatureEnabled = _draftType is OverlayType.CommunityGoal
                                    ? _communityProgressionFeatureEnabled
                                    : _bountiesFeatureEnabled;
                                var sourceOptions = _draftType is OverlayType.CommunityGoal
                                    ? _communityGoalOptions
                                    : _bountyOptions;
                                @if (!requiredFeatureEnabled)
                                {
                                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4"
                                         data-overlay-disabled-recovery>
                                        <p class="text-sm font-semibold text-slate-950">This @(TypeLabel(_draftType).ToLowerInvariant()) overlay is paused.</p>
                                        <p class="mt-1 text-sm leading-6 text-slate-700">
                                            @(_draftType is OverlayType.CommunityGoal ? "Community progression" : "Bounties") is off.
                                            <a class="font-semibold text-blue-700 underline" href="host">Turn @(_draftType is OverlayType.CommunityGoal ? "Community progression" : "Bounties") on in Channel setup</a>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="studio-grid" data-progress-overlay-settings>
                                        <div class="studio-span-8 space-y-2">
                                            <div class="field">
                                                <label class="field__label" for="progress-overlay-selection">Goal or bounty selection</label>
                                                <select id="progress-overlay-selection" class="field__input" @bind="_progressSelectedItemId">
                                                    <option value="">Rotate current public @(_draftType is OverlayType.CommunityGoal ? "communal goals" : "bounties")</option>
                                                    @foreach (var option in sourceOptions)
                                                    {
                                                        <option value="@option.Id">Only @option.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="studio-span-4">
                                            <div class="field">
                                                <label class="field__label" for="progress-overlay-rotation">Rotate every (seconds)</label>
                                                <input id="progress-overlay-rotation"
                                                       class="field__input"
                                                       type="number"
                                                       min="@OverlayConfiguration.ProgressOverlayV1.MinimumRotationSeconds"
                                                       max="@OverlayConfiguration.ProgressOverlayV1.MaximumRotationSeconds"
                                                       disabled="@(_progressSelectedItemId is not null)"
                                                       @bind="_progressRotationSeconds" />
                                            </div>
                                        </div>
                                        @if (_draftType is OverlayType.ViewerFundedBounty)
                                        {
                                            <div class="studio-span-4">
                                                <div class="field">
                                                    <label class="field__label" for="progress-overlay-contributors">Recent contributor callouts</label>
                                                    <select id="progress-overlay-contributors" class="field__input" @bind="_progressRecentContributorCount">
                                                        @for (var count = 0; count <= OverlayConfiguration.ProgressOverlayV1.MaximumRecentContributorCount; count++)
                                                        {
                                                            <option value="@count">@(count == 0 ? "Hidden" : $"Latest {count}")</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <p class="mt-3 text-sm leading-6 text-muted-foreground">
                                        @if (_draftType is OverlayType.CommunityGoal)
                                        {
                                            <text>Only public communal definitions are projected. Hidden seasons, viewer-scoped progress, Twitch user IDs, balances, moderator notes, and private audit data never reach the Browser Source.</text>
                                        }
                                        else
                                        {
                                            <text>Only public bounties and public pledge login/amount data are projected. Private bounties, Twitch user IDs, balances, moderation reasons, and internal accounting never reach the Browser Source.</text>
                                        }
                                    </p>
                                }
                            }
                            else if (_draftType is OverlayType.EventFeed)
                            {
                                <div class="studio-grid">
                                    <div class="studio-span-4"><div class="field"><label class="field__label" for="event-feed-capacity">Maximum waiting cards</label><input id="event-feed-capacity" class="field__input" type="number" min="1" max="25" @bind="_eventFeedCapacity" /></div></div>
                                    <div class="studio-span-8"><div class="field"><label class="field__label" for="event-feed-overflow">When full</label><select id="event-feed-overflow" class="field__input" @bind="_eventFeedOverflow"><option value="@EventFeedOverflowPolicy.DropNewest">Keep current cards</option><option value="@EventFeedOverflowPolicy.ReplaceNewestSameKind">Replace the newest matching item</option></select></div></div>
                                </div>
                                <div class="mt-4 grid gap-3 xl:grid-cols-2" data-event-feed-kind-settings>
                                    <section class="@KindCardClass(_pointEventEnabled)">
                                        <div class="flex items-center justify-between gap-3">
                                            <span id="point-event-label" class="@KindTitleClass(_pointEventEnabled)">Point awards</span>
                                            <button type="button" class="studio-toggle" role="switch"
                                                    aria-checked="@(_pointEventEnabled ? "true" : "false")"
                                                    aria-labelledby="point-event-label"
                                                    @onclick="() => _pointEventEnabled = !_pointEventEnabled"></button>
                                        </div>
                                        @if (_pointEventEnabled)
                                        {
                                            <div class="mt-3 grid gap-3" data-event-feed-details>
                                                <div><div class="field"><label class="field__label" for="point-event-template">Template</label><input id="point-event-template" class="field__input" @bind="_pointEventTemplate" /></div></div>
                                                <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]">
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{recipient}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{amount}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{pointLabel}</span>
                                                </div>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                                                    <div><div class="field"><label class="field__label" for="point-event-duration">On screen for (seconds)</label><input id="point-event-duration" class="field__input" type="number" min="1" max="30" @bind="_pointEventDuration" /></div></div>
                                                    <StudioSegmentedPill TValue="OverlayEventFeedPriority"
                                                                         AriaLabel="Point award priority"
                                                                         Options="_priorityOptions"
                                                                         @bind-Value="_pointEventPriority" />
                                                </div>
                                            </div>
                                        }
                                    </section>
                                    <section class="@KindCardClass(_achievementEventEnabled && _communityProgressionFeatureEnabled)"
                                             data-achievement-event-settings>
                                        <div class="flex items-center justify-between gap-3">
                                            <span id="achievement-event-label" class="@KindTitleClass(_achievementEventEnabled && _communityProgressionFeatureEnabled)">Achievement completions</span>
                                            @if (_communityProgressionFeatureEnabled)
                                            {
                                                <button type="button" class="studio-toggle" role="switch"
                                                        aria-checked="@(_achievementEventEnabled ? "true" : "false")"
                                                        aria-labelledby="achievement-event-label"
                                                        @onclick="() => _achievementEventEnabled = !_achievementEventEnabled"></button>
                                            }
                                            else
                                            {
                                                <span class="text-xs font-semibold text-muted-foreground">Paused</span>
                                            }
                                        </div>
                                        @if (!_communityProgressionFeatureEnabled)
                                        {
                                            <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3"
                                                 data-achievement-event-disabled-recovery>
                                                <p class="text-sm leading-6 text-slate-700">
                                                    Community progression is off.
                                                    <a class="font-semibold text-blue-700 underline" href="host">Turn Community progression on in Channel setup</a>
                                                </p>
                                            </div>
                                        }
                                        else if (_achievementEventEnabled)
                                        {
                                            <div class="mt-3 grid gap-3" data-event-feed-details>
                                                <div><div class="field"><label class="field__label" for="achievement-event-template">Template</label><input id="achievement-event-template" class="field__input" @bind="_achievementEventTemplate" /></div></div>
                                                <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]">
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{viewer}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{achievement}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{rewards}</span>
                                                </div>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                                                    <div><div class="field"><label class="field__label" for="achievement-event-duration">On screen for (seconds)</label><input id="achievement-event-duration" class="field__input" type="number" min="1" max="30" @bind="_achievementEventDuration" /></div></div>
                                                    <StudioSegmentedPill TValue="OverlayEventFeedPriority"
                                                                         AriaLabel="Achievement completion priority"
                                                                         Options="_priorityOptions"
                                                                         @bind-Value="_achievementEventPriority" />
                                                </div>
                                            </div>
                                        }
                                    </section>
                                    <section class="@KindCardClass(_guessEventEnabled)">
                                        <div class="flex items-center justify-between gap-3">
                                            <span id="guess-event-label" class="@KindTitleClass(_guessEventEnabled)">Guessing winners</span>
                                            <button type="button" class="studio-toggle" role="switch"
                                                    aria-checked="@(_guessEventEnabled ? "true" : "false")"
                                                    aria-labelledby="guess-event-label"
                                                    @onclick="() => _guessEventEnabled = !_guessEventEnabled"></button>
                                        </div>
                                        @if (_guessEventEnabled)
                                        {
                                            <div class="mt-3 grid gap-3" data-event-feed-details>
                                                <div><div class="field"><label class="field__label" for="guess-event-template">Template</label><input id="guess-event-template" class="field__input" @bind="_guessEventTemplate" /></div></div>
                                                <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]">
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{roundName}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{winningAnswer}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{winners}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{winnerCount}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{amount}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{pointLabel}</span>
                                                </div>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                                                    <div><div class="field"><label class="field__label" for="guess-event-duration">On screen for (seconds)</label><input id="guess-event-duration" class="field__input" type="number" min="1" max="30" @bind="_guessEventDuration" /></div></div>
                                                    <StudioSegmentedPill TValue="OverlayEventFeedPriority"
                                                                         AriaLabel="Guessing winner priority"
                                                                         Options="_priorityOptions"
                                                                         @bind-Value="_guessEventPriority" />
                                                </div>
                                            </div>
                                        }
                                    </section>
                                    <section class="@KindCardClass(_giveawayEventEnabled)">
                                        <div class="flex items-center justify-between gap-3">
                                            <span id="giveaway-event-label" class="@KindTitleClass(_giveawayEventEnabled)">Giveaway winners</span>
                                            <button type="button" class="studio-toggle" role="switch"
                                                    aria-checked="@(_giveawayEventEnabled ? "true" : "false")"
                                                    aria-labelledby="giveaway-event-label"
                                                    @onclick="() => _giveawayEventEnabled = !_giveawayEventEnabled"></button>
                                        </div>
                                        @if (_giveawayEventEnabled)
                                        {
                                            <div class="mt-3 grid gap-3" data-event-feed-details>
                                                <div><div class="field"><label class="field__label" for="giveaway-event-template">Template</label><input id="giveaway-event-template" class="field__input" @bind="_giveawayEventTemplate" /></div></div>
                                                <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]">
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{winners}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{winnerCount}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{prizes}</span>
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{pointLabel}</span>
                                                </div>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                                                    <div><div class="field"><label class="field__label" for="giveaway-event-duration">On screen for (seconds)</label><input id="giveaway-event-duration" class="field__input" type="number" min="1" max="30" @bind="_giveawayEventDuration" /></div></div>
                                                    <StudioSegmentedPill TValue="OverlayEventFeedPriority"
                                                                         AriaLabel="Giveaway winner priority"
                                                                         Options="_priorityOptions"
                                                                         @bind-Value="_giveawayEventPriority" />
                                                </div>
                                            </div>
                                        }
                                    </section>
                                    <section class="@KindCardClass(_bingoEventEnabled)">
                                        <div class="flex items-center justify-between gap-3">
                                            <span id="bingo-event-label" class="@KindTitleClass(_bingoEventEnabled)">Bingo events</span>
                                            <button type="button" class="studio-toggle" role="switch"
                                                    aria-checked="@(_bingoEventEnabled ? "true" : "false")"
                                                    aria-labelledby="bingo-event-label"
                                                    @onclick="() => _bingoEventEnabled = !_bingoEventEnabled"></button>
                                        </div>
                                        @if (_bingoEventEnabled)
                                        {
                                            <div class="mt-3 grid gap-3" data-event-feed-details>
                                                <div><div class="field"><label class="field__label" for="bingo-event-template">Template</label><input id="bingo-event-template" class="field__input" @bind="_bingoEventTemplate" /></div></div>
                                                <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]">
                                                    <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.82rem] font-semibold text-[var(--app-text-strong)]">{summary}</span>
                                                </div>
                                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3">
                                                    <div><div class="field"><label class="field__label" for="bingo-event-duration">On screen for (seconds)</label><input id="bingo-event-duration" class="field__input" type="number" min="1" max="30" @bind="_bingoEventDuration" /></div></div>
                                                    <StudioSegmentedPill TValue="OverlayEventFeedPriority"
                                                                         AriaLabel="Bingo event priority"
                                                                         Options="_priorityOptions"
                                                                         @bind-Value="_bingoEventPriority" />
                                                </div>
                                            </div>
                                        }
                                    </section>
                                </div>
                            }
                            else if (_draftType is OverlayType.ViewerQueue)
                            {
                                @if (!_playWithViewersFeatureEnabled)
                                {
                                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4"
                                         data-overlay-disabled-recovery>
                                        <p class="text-sm font-semibold text-slate-950">This Viewer Queue overlay is paused.</p>
                                        <p class="mt-1 text-sm leading-6 text-slate-700">
                                            Play with viewers is off.
                                            <a class="font-semibold text-blue-700 underline" href="host">Turn Play with viewers on in Channel setup</a>
                                        </p>
                                    </div>
                                }
                                else if (_queueOptions.Count == 0)
                                {
                                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                                        <p class="text-sm font-semibold text-slate-950">Create a play-with-viewers queue first.</p>
                                        <p class="mt-1 text-sm text-slate-700"><a class="font-semibold text-blue-700 underline" href="/queues">Create a queue</a></p>
                                    </div>
                                }
                                else
                                {
                                    <div class="studio-grid">
                                        <div class="studio-span-4">
                                            <div class="field">
                                                <label class="field__label" for="viewer-queue-source">Queue</label>
                                                <select id="viewer-queue-source" class="field__input" @bind="_viewerQueueId">
                                                    @foreach (var queue in _queueOptions)
                                                    {
                                                        <option value="@queue.Id">@queue.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="studio-span-4">
                                            <div class="field">
                                                <label class="field__label" for="viewer-queue-current-rows">Current party rows</label>
                                                <input id="viewer-queue-current-rows" class="field__input" type="number" min="0" max="12" @bind="_viewerQueueCurrentRows" />
                                            </div>
                                        </div>
                                        <div class="studio-span-4">
                                            <div class="field">
                                                <label class="field__label" for="viewer-queue-next-rows">Next rows</label>
                                                <input id="viewer-queue-next-rows" class="field__input" type="number" min="0" max="12" @bind="_viewerQueueNextRows" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-sm leading-6 text-muted-foreground">
                                    @(_draftType is OverlayType.CuePlayer
                                        ? "Cue players receive reusable cue layers. Compose and test them on the Cues tab."
                                        : "Empty overlays have no visual settings.")
                                </p>
                            }
                        </StudioStage>

                        @if (showDeliveryStage && _selected is { } deliveryOverlay)
                        {
                            <StudioStage Key="delivery-access"
                                         Number="@(whatItShowsNumber + 1)"
                                         Title="Delivery & access"
                                         Summary="@DeliverySummary()"
                                         Open="@_openStages.IsOpen(OverlaySourceStage.Delivery)"
                                         OpenChanged="@(open => _openStages.Set(OverlaySourceStage.Delivery, open))">
                                @if (deliveryOverlay.RequiresAccessKeyRegeneration)
                                {
                                    <section class="rounded-[14px] border border-amber-300 bg-amber-50 p-4"
                                             role="status"
                                             data-overlay-access-regeneration-required>
                                        <h3 class="text-sm font-bold text-slate-950">Generate this Browser Source URL</h3>
                                        <p class="mt-1 text-sm leading-6 text-slate-700">
                                            This imported source cannot connect yet. Select Generate private URL below, copy the URL, and replace this source's URL in OBS.
                                            If the button is unavailable, turn this source's required tool on in Channel setup first.
                                        </p>
                                    </section>
                                }
                                @if (_selectedFeatureEnabled)
                                {
                                    <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-[var(--app-control-border)] bg-[var(--app-control-bg)] px-4 py-3">
                                        <div>
                                            <p class="text-sm font-semibold text-slate-950">@_presenceLabel</p>
                                        </div>
                                        <button class="btn-primary"
                                                type="button"
                                                disabled="@(_isBusy || !deliveryOverlay.IsEnabled || deliveryOverlay.RequiresAccessKeyRegeneration)"
                                                @onclick="PublishTestAsync">Send test pulse</button>
                                    </div>
                                }

                                @if (_revealedBrowserSourceUrl is not null)
                                {
                                    <section class="mt-3 rounded-[14px] border border-[var(--app-control-border)] bg-[var(--app-surface-muted)] p-4"
                                             aria-labelledby="overlay-private-url-title"
                                             data-private-url-reveal>
                                        <h3 id="overlay-private-url-title" class="text-sm font-bold text-slate-950">
                                            Copy this private URL now
                                        </h3>
                                        <div class="mt-3 flex min-w-0 flex-col gap-2 sm:flex-row">
                                            <input class="input min-w-0 flex-1 font-mono text-xs"
                                                   aria-label="Private Browser Source URL"
                                                   readonly
                                                   value="@_revealedBrowserSourceUrl" />
                                            <button class="btn-secondary"
                                                    type="button"
                                                    @onclick="CopyBrowserSourceUrlAsync">Copy URL</button>
                                        </div>
                                    </section>
                                }

                                <div class="mt-4 flex flex-wrap gap-2">
                                    <button class="btn-secondary"
                                            type="button"
                                            disabled="@(_isBusy || !_selectedFeatureEnabled)"
                                            @onclick="RotateUrlAsync">
                                        @(deliveryOverlay.RequiresAccessKeyRegeneration ? "Generate private URL" : "Rotate private URL")
                                    </button>
                                    <button class="btn-secondary"
                                            type="button"
                                            disabled="@(_isBusy || !_selectedFeatureEnabled)"
                                            @onclick="ToggleAvailabilityAsync">
                                        @(deliveryOverlay.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                    <button class="btn-secondary"
                                            type="button"
                                            disabled="@(_isBusy || !_selectedFeatureEnabled)"
                                            @onclick="DeleteAsync">Delete</button>
                                </div>
                            </StudioStage>
                        }
                    </div>
                </div>
            </section>
            </ApplicationCardCollection>
        }

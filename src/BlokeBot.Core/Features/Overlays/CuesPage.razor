@page "/overlays/cues"
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject OverlayCueService _cues
@inject OverlayCuePlaybackService _playback
@inject HostFeatureService _features

<PageTitle>BlokeBot | Overlay cues</PageTitle>

<DashboardPage Kicker="Stream presentation" Title="Cues" Description="Build reusable scenes and try them on a Cue player Browser Source." Width="DashboardPageWidth.Wide">
    <ChildContent>
        <OverlaySectionTabs />
        <ApplicationCardCollection Owner="dashboard-page-cards">
            @if (_loading)
            {
                <div class="card p-8 text-sm text-muted-foreground" role="status">Loading cues...</div>
            }
            else if (!_enabled)
            {
                <div class="card p-8 text-sm text-muted-foreground" data-overlay-disabled-recovery>
                    Cues are paused because Overlays is off.
                    <a class="font-semibold text-blue-700 underline" href="host">Turn Overlays on in Channel setup.</a>
                    Saved cues remain and do not play when you resume.
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_feedback))
                {
                    <section class="@(_failed ? "card bg-red-50 p-4 text-sm font-semibold text-slate-950" : "card bg-blue-50 p-4 text-sm font-semibold text-slate-950")" role="@(_failed ? "alert" : "status")">@_feedback</section>
                }
                <div class="cue-workspace" data-card-owner="cue-workspace-columns">
                <section class="card cue-workspace__inventory p-5">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div><h2 class="text-lg font-semibold text-slate-950">Saved cues</h2><p class="mt-1 text-sm text-muted-foreground">Choose a cue to edit, or start a new one.</p></div>
                        <div class="flex gap-2"><a class="btn-secondary" href="overlays/media">Manage media</a><button class="btn-secondary" type="button" @onclick="NewCue">New cue</button></div>
                    </div>
                    <div class="mt-4 grid gap-2" aria-label="Saved cues">
                        @foreach (var cue in _items)
                        {
                            <button class="control-surface rounded-lg px-3 py-2 text-left" type="button" aria-current="@(_selected?.Id == cue.Id ? "true" : null)" @onclick="() => SelectCue(cue)">
                                <span class="block font-semibold">@cue.Name</span><span class="text-xs text-muted-foreground">@(cue.IsEnabled ? "On" : "Off") · @PolicyLabel(cue.QueuePolicy)</span>
                            </button>
                        }
                    </div>
                </section>
                <section class="card cue-workspace__editor p-5" data-cue-editor>
                    <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-lg font-semibold text-slate-950">@(_selected is null ? "New cue" : "Edit cue")</h2><button class="btn-primary" type="button" disabled="@_busy" @onclick="SaveAsync">@(_selected is null ? "Create cue" : "Save cue")</button></div>
                    <div class="mt-4 grid gap-4 md:grid-cols-3">
                        <Field Id="cue-name" Label="Cue name" @bind-Value="_name" />
                        <div><label class="label" for="cue-duration">Total duration (milliseconds)</label><input id="cue-duration" class="input mt-2" type="number" min="100" max="300000" @bind="_duration" /></div>
                        <div><label class="label" for="cue-policy">When another cue is playing</label><select id="cue-policy" class="input mt-2" @bind="_policy">@foreach (var policy in Enum.GetValues<OverlayCueQueuePolicy>()) { <option value="@policy">@PolicyLabel(policy)</option> }</select></div>
                    </div>
                    <div class="mt-4"><OverlayStateToggle Label="Cue enabled" @bind-Value="_cueEnabled" /></div>

                    <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
                        <div><h3 class="text-base font-semibold text-slate-950">Cue content</h3><p class="mt-1 text-sm text-muted-foreground">Content lower in the list appears in front when stacking values match.</p></div>
                        <div class="flex flex-wrap gap-2">
                            <button class="btn-secondary" type="button" disabled="@(_layers.Count >= OverlayCueConfiguration.MaximumLayerCount || _assets.Count == 0)" @onclick="() => AddLayer(CueLayerKind.UploadedMedia)">Add uploaded media</button>
                            <button class="btn-secondary" type="button" disabled="@(_layers.Count >= OverlayCueConfiguration.MaximumLayerCount)" @onclick="() => AddLayer(CueLayerKind.OnlineMedia)">Add online media</button>
                            <button class="btn-secondary" type="button" disabled="@(_layers.Count >= OverlayCueConfiguration.MaximumLayerCount)" @onclick="() => AddLayer(CueLayerKind.WebPage)">Add web page</button>
                        </div>
                    </div>

                    <div class="application-card-collection mt-4" data-cue-layers>
                        @for (var index = 0; index < _layers.Count; index++)
                        {
                            var layerIndex = index;
                            var layer = _layers[index];
                            <article class="control-surface rounded-lg p-4" @key="layer">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <h4 class="font-semibold text-slate-950">Content @(index + 1)</h4>
                                    <div class="flex gap-2">
                                        <button class="btn-secondary" type="button" aria-label="Move content up" disabled="@(index == 0)" @onclick="() => MoveLayer(layerIndex, -1)">Up</button>
                                        <button class="btn-secondary" type="button" aria-label="Move content down" disabled="@(index == _layers.Count - 1)" @onclick="() => MoveLayer(layerIndex, 1)">Down</button>
                                        <button class="btn-secondary" type="button" disabled="@(_layers.Count == 1)" @onclick="() => RemoveLayer(layerIndex)">Remove</button>
                                    </div>
                                </div>
                                <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                                    <div><label class="label">Content type</label><select class="input mt-2" @bind="layer.Kind"><option value="@CueLayerKind.UploadedMedia">Uploaded media</option><option value="@CueLayerKind.OnlineMedia">Online media</option><option value="@CueLayerKind.WebPage">Web page</option></select></div>
                                    @if (layer.Kind is CueLayerKind.UploadedMedia)
                                    {
                                        <div><label class="label">Media</label><select class="input mt-2" @bind="layer.AssetId"><option value="">Choose media</option>@foreach (var asset in _assets) { <option value="@asset.Id">@asset.Name (@OverlayMediaTypes.Label(asset.ContentType).ToLowerInvariant())</option> }</select></div>
                                    }
                                    else
                                    {
                                        <div class="md:col-span-1 xl:col-span-2"><label class="label">Secure address</label><input class="input mt-2" type="url" placeholder="https://example.com/media" @bind="layer.Address" /></div>
                                    }
                                    @if (layer.Kind is CueLayerKind.OnlineMedia)
                                    {
                                        <div><label class="label">Media type</label><select class="input mt-2" @bind="layer.MediaKind"><option value="@OverlayCueMediaKind.Video">Video</option><option value="@OverlayCueMediaKind.Audio">Audio</option></select></div>
                                    }
                                </div>
                                <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
                                    <div><label class="label">Starts after (ms)</label><input class="input mt-2" type="number" min="0" max="300000" @bind="layer.StartMilliseconds" /></div>
                                    <div><label class="label">Plays for (ms)</label><input class="input mt-2" type="number" min="100" max="300000" @bind="layer.DurationMilliseconds" /></div>
                                    <div><label class="label">Stacking order</label><input class="input mt-2" type="number" min="-100" max="100" @bind="layer.StackOrder" /></div>
                                    <div><label class="label">Left (%)</label><input class="input mt-2" type="number" min="0" max="100" step="0.1" @bind="layer.X" /></div>
                                    <div><label class="label">Top (%)</label><input class="input mt-2" type="number" min="0" max="100" step="0.1" @bind="layer.Y" /></div>
                                    <div><label class="label">Width (%)</label><input class="input mt-2" type="number" min="0.1" max="100" step="0.1" @bind="layer.Width" /></div>
                                    <div><label class="label">Height (%)</label><input class="input mt-2" type="number" min="0.1" max="100" step="0.1" @bind="layer.Height" /></div>
                                    @if (layer.Kind is not CueLayerKind.WebPage)
                                    {
                                        <div><label class="label">Volume (%)</label><input class="input mt-2" type="number" min="0" max="100" step="1" @bind="layer.VolumePercent" /></div>
                                        <div><label class="label">Fit</label><select class="input mt-2" @bind="layer.Fit"><option value="@OverlayCueFitMode.Contain">Show all</option><option value="@OverlayCueFitMode.Cover">Fill and crop</option><option value="@OverlayCueFitMode.Fill">Stretch to fill</option></select></div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                    @if (_assets.Count == 0) { <p class="mt-3 text-sm text-muted-foreground">Upload media on the <a class="font-semibold text-blue-700 underline" href="overlays/media">Media tab</a> before adding uploaded content.</p> }
                    @if (_selected is not null) { <button class="btn-secondary mt-4" type="button" @onclick="DeleteAsync">Delete cue</button> }
                </section>
                </div>
                <section class="card p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Test playback</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Choose an enabled Cue player Browser Source, then play the saved cue as it will appear in OBS.</p>
                    <div class="mt-4 flex flex-wrap items-end gap-3"><div class="min-w-64 flex-1"><label class="label" for="cue-target">Cue player</label><select id="cue-target" class="input mt-2" @bind="_target"><option value="">Choose a Cue player</option>@foreach (var target in _catalog.Targets) { <option value="@target.Id">@target.Name</option> }</select></div><a class="btn-secondary" href="overlays/sources">Manage Browser Sources</a><button class="btn-primary" type="button" disabled="@(_selected is null || _target is null || _busy)" @onclick="PlayAsync">Play test cue</button></div>
                    @if (_target is { } targetId) { <div class="mt-4 aspect-video overflow-hidden rounded-xl bg-slate-950"><iframe class="size-full" src="@($"/overlays/preview/{targetId:D}")" title="Cue player preview" referrerpolicy="no-referrer"></iframe></div> }
                </section>
            }
        </ApplicationCardCollection>
    </ChildContent>
</DashboardPage>

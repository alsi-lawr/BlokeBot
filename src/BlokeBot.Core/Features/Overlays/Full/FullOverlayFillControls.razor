<label class="field"><span class="field__label">Text colour</span><div class="full-color-control"><button type="button" class="btn-secondary full-color-swatch" data-color-open="text" aria-label="Choose text colour and opacity"><span aria-hidden="true"></span>Choose</button><input class="field__input" data-guided-color="text" aria-label="Text colour" readonly tabindex="-1" /></div></label>
<h3 class="full-fill-heading">Background</h3>
<div class="full-fill-kinds" role="group" aria-label="Background fill"><button type="button" class="btn-secondary" data-fill-kind="solid">Solid</button><button type="button" class="btn-secondary" data-fill-kind="gradient">Gradient</button></div>
<div data-fill-custom hidden><p class="form-help">Custom background in source</p><EditorAction Label="Replace custom image with solid…" Icon="tools" data-fill-replace /></div>
<div data-solid-controls><label class="field"><span class="field__label">Fill colour</span><div class="full-color-control"><button type="button" class="btn-secondary full-color-swatch" data-color-open="solid" aria-label="Choose fill colour and opacity"><span aria-hidden="true"></span>Choose</button><input class="field__input" data-guided-color="solid" aria-label="Fill colour" readonly tabindex="-1" /></div></label></div>
<div data-gradient-controls hidden>
    <div class="full-gradient-stops" data-gradient-stops role="group" aria-label="Gradient stops"></div>
    <div class="full-inspector-grid"><label class="field"><span class="field__label">Gradient</span><select class="field__input" data-gradient-kind aria-label="Gradient kind"><option value="linear">Linear</option><option value="radial">Radial</option></select></label>
        <label class="field"><span class="field__label">Stop position (%)</span><input class="field__input" type="number" step="any" data-gradient-position aria-label="Gradient stop position (%)" /></label></div>
    <label class="field"><span class="field__label">Stop colour</span><div class="full-color-control"><button type="button" class="btn-secondary full-color-swatch" data-color-open="stop" aria-label="Choose stop colour and opacity"><span aria-hidden="true"></span>Choose</button><input class="field__input" data-guided-color="stop" aria-label="Gradient stop colour" readonly tabindex="-1" /></div></label>
    <div class="full-fill-kinds"><EditorAction Label="Add stop" Icon="add" data-gradient-add /><EditorAction Label="Remove stop" Icon="minus" data-gradient-remove /></div>
    <label class="field" data-linear-controls><span class="field__label">Direction (°)</span><input class="field__input" type="number" step="any" data-gradient-angle aria-label="Gradient direction (°)" /></label>
    <label class="field" data-radial-controls hidden><span class="field__label">Centre</span><select class="field__input" data-gradient-centre aria-label="Radial centre"><option value="center">Centre</option><option value="left">Left</option><option value="right">Right</option><option value="top">Top</option><option value="bottom">Bottom</option><option value="left top">Top left</option><option value="right top">Top right</option><option value="left bottom">Bottom left</option><option value="right bottom">Bottom right</option></select></label>
</div>

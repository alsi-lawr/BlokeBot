@page "/points"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject PointsDashboardService _dashboard
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts

<PageTitle>BlokeBot | Points</PageTitle>

<DashboardPage Kicker="Chat tools"
               Title="Manage points"
               Description="Check balances, adjust viewer points, and run the current giveaway." LoadFailure="@RouteLoadFailure" RetryLoadAsync="LoadRouteAsync">
    <Actions>
        <button class="btn-secondary" disabled="@(!_featureEnabled)" @onclick="RefreshAsync">Refresh</button>
    </Actions>

    <ChildContent>
    @if (Host is null)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Choose a channel" Description="Select the channel whose viewer points you want to manage from the top bar." />
    }
    else if (!_featureEnabled)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Turn on points" Description="Points are off for this channel. Turn them on in Channel setup before managing balances or giveaways.">
            <Actions><a class="btn-primary" href="/host">Open Channel setup</a></Actions>
        </PageState>
    }
    else if (_state is null)
    {
        <PageState Kind="DashboardPageState.Loading" Title="Loading points" Description="Getting balances, the current giveaway, and recent changes ready." />
    }
    else
    {
        <TaskPanel Title="Find a viewer" Description="Look up the current balance for a viewer in this channel.">
            <div class="grid gap-4 p-5 md:grid-cols-2">
                <Field Id="points-dashboard-lookup-login" Label="Find viewer" @bind-Value="_lookupLogin" Placeholder="username" />
                <div class="flex items-end">
                    <button class="btn-primary" @onclick="LookupAsync">Search</button>
                </div>
                @if (_lookupResult is not null)
                {
                    <div class="surface-muted rounded-lg p-4 md:col-span-2">
                        <p class="text-sm font-bold text-slate-950">@_lookupResult.Login</p>
                        <p class="mt-1 text-sm text-muted-foreground">@_lookupResult.Balance.ToDisplayString() points</p>
                    </div>
                }
            </div>
        </TaskPanel>

        <CollapsibleSection Title="Viewer balances"
                            Description="Review balances or remove a balance."
                            InitiallyOpen="false"
                            PreferenceKey="points-dashboard-balances">
            <section class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Leaderboard</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Top balances for this channel.</p>
                </div>
                <div class="points-dashboard__leaderboard scroll-panel scroll-panel--data-table overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                            <tr>
                                <th class="px-5 py-3 font-semibold">Rank</th>
                                <th class="px-5 py-3 font-semibold">User</th>
                                <th class="px-5 py-3 font-semibold">Balance</th>
                                <th class="px-5 py-3 font-semibold">Manage</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @for (var i = 0; i < _state.Leaderboard.Count; i++)
                            {
                                var entry = _state.Leaderboard[i];
                                <tr @key="entry.Login" class="motion-list__item">
                                    <td data-label="Rank" class="px-5 py-3 font-semibold text-slate-900"><RankIndicator Rank="@(i + 1)" /></td>
                                    <td data-label="User" class="px-5 py-3 font-medium text-slate-900">@entry.Login</td>
                                    <td data-label="Balance" class="px-5 py-3 text-slate-700">@entry.Balance.ToDisplayString()</td>
                                    <td data-label="Manage" class="px-5 py-3">
                                        <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold text-red-700 transition"
                                                type="button"
                                                @onclick="() => RemoveLeaderboardEntryAsync(entry.Login)">
                                            Delete balance
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_state.Leaderboard.Count == 0)
                    {
                        <PageState Kind="DashboardPageState.Empty" Title="No balances yet" Description="Viewer balances will appear here after points are earned or adjusted." />
                    }
                </div>
            </section>

        </CollapsibleSection>

        <CollapsibleSection Title="Adjust viewer points"
                            Description="Move, add, or take away points with the same moderator permissions."
                            InitiallyOpen="false"
                            PreferenceKey="points-dashboard-adjustments">
            <div class="grid gap-4 p-5 lg:grid-cols-3">
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold text-slate-950">Move points</h3>
                        <Field Id="points-dashboard-give-from" Label="From viewer" @bind-Value="_giveFrom" Placeholder="from username" />
                        <Field Id="points-dashboard-give-to" Label="To viewer" @bind-Value="_giveTo" Placeholder="to username" />
                        <Field Id="points-dashboard-give-amount" Label="Amount" @bind-Value="_giveAmount" Placeholder="100, 50%, all" />
                        <button class="btn-secondary" @onclick="GiveAsync">Move points</button>
                    </div>
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold text-slate-950">Add points</h3>
                        <Field Id="points-dashboard-add-login" Label="Viewer" @bind-Value="_addLogin" Placeholder="username" />
                        <Field Id="points-dashboard-add-amount" Label="Amount" @bind-Value="_addAmount" Placeholder="100" />
                        <button class="btn-secondary" @onclick="AddAsync">Add points</button>
                    </div>
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold text-slate-950">Take away points</h3>
                        <Field Id="points-dashboard-remove-login" Label="Viewer" @bind-Value="_removeLogin" Placeholder="username" />
                        <Field Id="points-dashboard-remove-amount" Label="Amount" @bind-Value="_removeAmount" Placeholder="100, 50%, all" />
                        <button class="btn-secondary" @onclick="RemoveAsync">Take away points</button>
                    </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Giveaway administration"
                            Description="Start, end, or cancel the current giveaway."
                            InitiallyOpen="false"
                            PreferenceKey="points-dashboard-giveaway">
        <section class="card">
            <div class="flex flex-col gap-4 border-b border-slate-200 p-5 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <h2 class="text-lg font-semibold text-slate-950">Giveaway</h2>
                    <p class="mt-1 text-sm text-muted-foreground">@_giveawaySummary</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button class="btn-primary" @onclick="StartGiveawayAsync">Start</button>
                    <button class="btn-secondary" disabled="@(_state.ActiveGiveaway is null)" @onclick="EndGiveawayAsync">End</button>
                    <button class="btn-secondary" disabled="@(_state.ActiveGiveaway is null)" @onclick="CancelGiveawayAsync">Cancel</button>
                </div>
            </div>
            <div class="grid gap-5 p-5 lg:grid-cols-2">
                <div>
                    <h3 class="text-sm font-bold text-slate-950">People who joined</h3>
                    <div class="scroll-panel scroll-panel--tag-cloud mt-3 flex flex-wrap gap-2 pr-2">
                        @foreach (var entrant in _state.ActiveGiveaway?.Entrants ?? [])
                        {
                            <span @key="entrant" class="motion-list__item surface-row rounded-full px-2.5 py-1 text-xs font-semibold text-slate-700">@entrant</span>
                        }
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-950">Winners</h3>
                    <div class="scroll-panel scroll-panel--tag-cloud mt-3 flex flex-wrap gap-2 pr-2">
                        @foreach (var winner in _state.ActiveGiveaway?.Winners ?? [])
                        {
                            <span @key="winner" class="motion-list__item rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">@winner.Login: @winner.Payout.ToDisplayString()</span>
                        }
                    </div>
                </div>
            </div>
        </section>
        </CollapsibleSection>

        <CollapsibleSection Title="Recent point changes"
                            Description="Review the latest balance ledger entries."
                            InitiallyOpen="false"
                            PreferenceKey="points-dashboard-ledger">
        <section class="card">
            <div class="border-b border-slate-200 p-5">
                <h2 class="text-lg font-semibold text-slate-950">Recent changes</h2>
                <p class="mt-1 text-sm text-muted-foreground">Latest point changes for this channel.</p>
            </div>
            <div class="scroll-panel scroll-panel--data-table overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                        <tr>
                            <th class="px-5 py-3 font-semibold">Time</th>
                            <th class="px-5 py-3 font-semibold">Change</th>
                            <th class="px-5 py-3 font-semibold">User</th>
                            <th class="px-5 py-3 font-semibold">Amount</th>
                            <th class="px-5 py-3 font-semibold">Balance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var entry in _state.RecentLedger)
                        {
                            <tr @key="entry" class="motion-list__item">
                                <td class="px-5 py-3 text-muted-foreground">@entry.CreatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                <td class="px-5 py-3 font-medium text-slate-900">@LedgerChangeLabel(entry.Kind)</td>
                                <td class="px-5 py-3 text-slate-700">@entry.Login</td>
                                <td class="px-5 py-3 text-slate-700">@entry.Delta</td>
                                <td class="px-5 py-3 text-slate-700">@entry.BalanceAfter</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        </CollapsibleSection>
    }
    </ChildContent>
</DashboardPage>

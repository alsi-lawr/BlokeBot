@inherits BackgroundLoadComponent<HostBotChannelStatus, HostBotChannelStatusLoadFailure, PointsEligibilityLoadIdentity>
@using BlokeBot.Persistence.Models
@inject HostBotStatusService _hostBotStatus

<div class="space-y-2">
    <span class="label">Who can enter</span>
    <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
        <StudioSegmentedPill TValue="PointsEligibilityMode"
                             AriaLabel="Who can enter"
                             Options="_options"
                             Value="Value"
                             DisabledDescriptionId="eligibility-follower-status"
                             ValueChanged="OnEligibilityChangedAsync" />
        <span id="eligibility-follower-status" class="text-xs font-medium text-muted-foreground">@_followerEligibilityTitle</span>
    </div>
</div>

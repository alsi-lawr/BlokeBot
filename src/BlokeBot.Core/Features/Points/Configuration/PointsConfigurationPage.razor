@page "/points/settings"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject PointsConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts

<PageTitle>BlokeBot | Points Settings</PageTitle>

<div class="mx-auto max-w-7xl space-y-6" data-sticky-save-scope>
    <PageHeader Title="Points settings"
                Description="Choose point names, chat commands, chances of winning, giveaways, and what the bot says." />
    <StickySaveRegion>
        <button class="btn-primary" disabled="@(!_featureEnabled || _config is null)" @onclick="SaveAsync">Save changes</button>
    </StickySaveRegion>

    @if (Host is null)
    {
        <ApplicationCardCollection Owner="points-settings-cards">
            <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
        </ApplicationCardCollection>
    }
    else if (!_featureEnabled)
    {
        <ApplicationCardCollection Owner="points-settings-cards">
            <div class="card p-8 text-sm text-muted-foreground">Points is off for this channel. Turn it on in Channel setup.</div>
        </ApplicationCardCollection>
    }
    else if (_config is null)
    {
        <ApplicationCardCollection Owner="points-settings-cards">
            <div class="card p-8 text-sm text-muted-foreground">Loading points settings...</div>
        </ApplicationCardCollection>
    }
    else
    {
        <div class="settings-disclosure-stack">
            <StudioStage Key="point-name"
                         Number="1"
                         Title="What points are called"
                         Summary="@LabelSummary()"
                         Open="@_openStages.IsOpen(PointsStage.Label)"
                         OpenChanged="@(open => _openStages.Set(PointsStage.Label, open))">
                <div class="studio-grid">
                    <div class="studio-span-6">
                        <Field Id="points-label" Label="Point label" @bind-Value="_config.PointLabel" Placeholder="points" />
                        <p class="mt-1 text-xs text-muted-foreground">Used in every bot message via {label}. Blank falls back to "points".</p>
                    </div>
                    <div class="studio-span-12">
                        <StudioChatPreview Lines="BalancePreviewLines()" />
                    </div>
                </div>
            </StudioStage>

            <StudioStage Key="gambling"
                         Number="2"
                         Title="Gambling"
                         Summary="@GamblingSummary()"
                         Open="@_openStages.IsOpen(PointsStage.Gambling)"
                         FocusElementId="@_validationFocusId"
                         FocusRequest="@_gamblingFocusRequest"
                         OpenChanged="@(open => _openStages.Set(PointsStage.Gambling, open))">
                <div class="studio-grid">
                    <div class="studio-span-6 space-y-2">
                        <label class="label" for="winRate">Chance of winning</label>
                        <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                            <StudioStepper Id="winRate"
                                           AriaLabel="Chance of winning"
                                           Unit="%"
                                           Step="5"
                                           Minimum="0"
                                           Maximum="100"
                                           Value="@Whole(_config.GamblingWinRatePercent)"
                                           ValueChanged="@(value => SetWinRate(value))" />
                        </div>
                        <p class="text-xs text-muted-foreground">0–100%. A win pays out the wagered amount; a loss takes it.</p>
                    </div>
                    <div class="studio-span-6 space-y-2">
                        <label class="label" for="gamblingCooldown">Wait between gambles</label>
                        <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                            <StudioStepper Id="gamblingCooldown"
                                           AriaLabel="Wait between gambles in seconds"
                                           Unit="seconds"
                                           Step="15"
                                           Minimum="0"
                                           Invalid="@(_gamblingCooldownError is not null)"
                                           InvalidDescriptionId="gamblingCooldown-error"
                                           Value="@Whole(_config.GamblingCooldownSeconds)"
                                           ValueChanged="@(value => SetGamblingCooldown(value))" />
                            <span class="text-xs text-muted-foreground">@GamblingCooldownHint()</span>
                        </div>
                        @if (_gamblingCooldownError is not null)
                        {
                            <p id="gamblingCooldown-error" class="text-sm font-semibold text-red-700">@_gamblingCooldownError.Message</p>
                        }
                    </div>
                    <div class="studio-span-12">
                        <StudioChatPreview Lines="GamblePreviewLines()" />
                    </div>
                </div>
            </StudioStage>

            <StudioStage Key="giveaways"
                         Number="3"
                         Title="Giveaways"
                         Summary="@GiveawaysSummary()"
                         Open="@_openStages.IsOpen(PointsStage.Giveaways)"
                         FocusElementId="@_validationFocusId"
                         FocusRequest="@_giveawaysFocusRequest"
                         OpenChanged="@(open => _openStages.Set(PointsStage.Giveaways, open))">
                <div class="studio-grid">
                    <div class="studio-span-6 space-y-2">
                        <label class="label" for="duration">Time to enter</label>
                        <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                            <StudioStepper Id="duration"
                                           AriaLabel="Time to enter in seconds"
                                           Unit="seconds"
                                           Step="30"
                                           Minimum="1"
                                           Invalid="@(_giveawayDurationError is not null)"
                                           InvalidDescriptionId="duration-error"
                                           Value="@Whole(_config.GiveawayDurationSeconds)"
                                           ValueChanged="@(value => SetGiveawayDuration(value))" />
                            <span class="text-xs text-muted-foreground">= @DurationProse.Format(_config.GiveawayDurationSeconds)</span>
                        </div>
                        @if (_giveawayDurationError is not null)
                        {
                            <p id="duration-error" class="text-sm font-semibold text-red-700">@_giveawayDurationError.Message</p>
                        }
                    </div>
                    <div class="studio-span-6 space-y-2">
                        <label class="label" for="winnerCount">Number of winners</label>
                        <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                            <StudioStepper Id="winnerCount"
                                           AriaLabel="Number of winners"
                                           Unit="@(_config.GiveawayWinnerCount == 1 ? "winner" : "winners")"
                                           Step="1"
                                           Minimum="1"
                                           Invalid="@(_giveawayWinnerCountError is not null)"
                                           InvalidDescriptionId="winnerCount-error"
                                           Value="@Whole(_config.GiveawayWinnerCount)"
                                           ValueChanged="@(value => SetGiveawayWinnerCount(value))" />
                        </div>
                        @if (_giveawayWinnerCountError is not null)
                        {
                            <p id="winnerCount-error" class="text-sm font-semibold text-red-700">@_giveawayWinnerCountError.Message</p>
                        }
                    </div>
                    <div class="studio-span-6 space-y-2">
                        <label class="label" for="points-giveaway-minimum-payout">Prize range</label>
                        <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                            <StudioStepper Id="points-giveaway-minimum-payout"
                                           AriaLabel="Smallest prize"
                                           DecrementLabel="Smaller minimum"
                                           IncrementLabel="Larger minimum"
                                           Step="10"
                                           Minimum="0"
                                           Maximum="@Bound(_config.GiveawayMaximumPayout)"
                                           @bind-Value="_config.GiveawayMinimumPayout" />
                            <span class="text-sm font-bold text-muted-foreground" aria-hidden="true">–</span>
                            <StudioStepper Id="points-giveaway-maximum-payout"
                                           AriaLabel="Largest prize"
                                           DecrementLabel="Smaller maximum"
                                           IncrementLabel="Larger maximum"
                                           Unit="@PointLabel()"
                                           Step="10"
                                           Minimum="@Bound(_config.GiveawayMinimumPayout)"
                                           Maximum="@PointAmount.MaximumValue"
                                           @bind-Value="_config.GiveawayMaximumPayout" />
                        </div>
                        <p class="text-xs text-muted-foreground">Each winner gets a random prize in this range. Prizes step by 10; type any whole amount up to 10^100.</p>
                    </div>
                    <div class="studio-span-6 space-y-2">
                        <label class="label" for="cooldown">Wait between giveaways</label>
                        <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                            <StudioStepper Id="cooldown"
                                           AriaLabel="Wait between giveaways in seconds"
                                           Unit="seconds"
                                           Step="60"
                                           Minimum="@PointsConfigurationValidator.MinimumGiveawayCooldownSeconds"
                                           Invalid="@(_giveawayCooldownError is not null)"
                                           InvalidDescriptionId="cooldown-error"
                                           Value="@Whole(_config.GiveawayCooldownSeconds)"
                                           ValueChanged="@(value => SetGiveawayCooldown(value))" />
                            <span class="text-xs text-muted-foreground">minimum @DurationProse.Format(PointsConfigurationValidator.MinimumGiveawayCooldownSeconds)</span>
                        </div>
                        @if (_giveawayCooldownError is not null)
                        {
                            <p id="cooldown-error" class="text-sm font-semibold text-red-700">@_giveawayCooldownError.Message</p>
                        }
                    </div>
                    <div class="studio-span-12">
                        <PointsEligibilitySelector HostLogin="@Host.Login" @bind-Value="_config.GiveawayEligibility" />
                    </div>
                </div>
            </StudioStage>

            <StudioStage Key="chat-commands"
                         Number="4"
                         Title="Chat commands"
                         Summary="@CommandsSummary()"
                         Open="@_openStages.IsOpen(PointsStage.Commands)"
                         OpenChanged="@(open => _openStages.Set(PointsStage.Commands, open))">
                <div class="studio-grid">
                    @foreach (var field in _aliasFields)
                    {
                        <div class="studio-span-4 space-y-2" @key="field.Kind">
                            <label class="label" for="@field.FieldId">@field.Label</label>
                            <div class="studio-chips flex flex-wrap items-center gap-[0.45rem]">
                                @foreach (var word in AliasWords(field))
                                {
                                    <StudioChip @key="word"
                                                Label="@($"!{word}")"
                                                RemoveLabel="@($"Remove !{word} from {field.Label}")"
                                                RemoveAction="remove-command-word"
                                                Remove="@(() => RemoveAliasWord(field, word))" />
                                }
                                <input id="@field.FieldId"
                                       class="studio-chip-input w-28 min-w-28 rounded-full border border-dashed border-[var(--app-control-border)] px-3 py-[0.28rem] text-[0.82rem] font-semibold text-[var(--app-text-strong)] outline-none placeholder:text-[var(--app-text-muted)] focus:border-solid focus:border-[var(--app-focus-border)] focus:shadow-[var(--app-focus-shadow)]"
                                       placeholder="+ word"
                                       aria-label="@($"Add a {field.Label} command word")"
                                       value="@AliasDraft(field.Kind)"
                                       @oninput="args => SetAliasDraft(field.Kind, args.Value?.ToString() ?? string.Empty)"
                                       @onkeydown="args => AddAliasWordOnEnter(field, args)"
                                       @onblur="() => AddAliasWord(field)" />
                            </div>
                        </div>
                    }
                    <p class="studio-span-12 text-xs text-muted-foreground">Each command word can only be used once in this channel. Type a word and press Enter to add it.</p>
                </div>
            </StudioStage>

            <StudioStage Key="bot-replies"
                         Number="5"
                         Title="Bot replies"
                         Summary="@RepliesSummary()"
                         Open="@_openStages.IsOpen(PointsStage.Replies)"
                         OpenChanged="@(open => _openStages.Set(PointsStage.Replies, open))">
                <p class="mb-3 text-xs text-muted-foreground">Every message the bot can send, grouped by what it is about. Open a row to change its wording or, where private delivery is possible, send it as a whisper instead.</p>
                @if (!_config.WhisperResponsesEnabled)
                {
                    <p id="reply-delivery-whisper-recovery" class="mb-3 text-sm font-medium text-muted-foreground">Private replies need a connected custom bot. <a class="font-semibold text-primary underline" href="/host#custom-bot">Open Channel setup to connect one.</a></p>
                }
                @foreach (var group in _replyGroups)
                {
                    <StudioReplyList @key="group.Label" Label="@group.Label">
                        @foreach (var field in group.Fields)
                        {
                            <StudioReplyRow @key="field.Key"
                                            Key="@field.Key"
                                            Label="@field.Label"
                                            Excerpt="@field.Read(_config.Replies)"
                                            Customised="@IsCustomised(field)"
                                            Whispered="@IsWhispered(field)"
                                            Open="@_openReplies.IsOpen(field.Key)"
                                            OpenChanged="@(open => _openReplies.Set(field.Key, open))">
                                <textarea class="input min-h-16 resize-y"
                                          id="@($"points-{field.Key}-reply")"
                                          aria-label="@field.Label"
                                          value="@field.Read(_config.Replies)"
                                          @oninput="args => field.Write(_config.Replies, args.Value?.ToString() ?? string.Empty)"></textarea>
                                @if (field.ChatOnlyNote is { Length: > 0 } note)
                                {
                                    <p class="text-xs text-muted-foreground">@note</p>
                                }
                                else
                                {
                                    <div class="studio-stepline flex flex-wrap items-center gap-[0.6rem]">
                                        <span class="text-xs text-muted-foreground">Delivery</span>
                                        <StudioSegmentedPill TValue="bool"
                                                             AriaLabel="@($"{field.Label} delivery")"
                                                             Options="_deliveryOptions"
                                                             Value="@IsWhispered(field)"
                                                             Disabled="@(!_config.WhisperResponsesEnabled)"
                                                             DisabledDescriptionId="reply-delivery-whisper-recovery"
                                                             ValueChanged="@(whisper => SetReplyWhispered(field, whisper))" />
                                    </div>
                                }
                                @if (field.Key == "balance")
                                {
                                    <StudioChatPreview Lines="BalancePreviewLines()" />
                                }
                                else if (field.Key == "giveaway-started")
                                {
                                    <StudioChatPreview Lines="GiveawayStartedPreviewLines()" />
                                }
                            </StudioReplyRow>
                        }
                    </StudioReplyList>
                }
            </StudioStage>
        </div>
    }
</div>

@page "/points/settings"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject PointsConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts

<PageTitle>BlokeBot | Points Settings</PageTitle>

<DashboardPage Kicker="Chat tools"
               Title="Configure points"
               Description="Set up point names, chat commands, giveaways, and the replies viewers receive." LoadFailure="@RouteLoadFailure" RetryLoadAsync="LoadAsync">
    <Actions>
        <button class="btn-primary" disabled="@(!_featureEnabled || _config is null)" @onclick="SaveAsync">Save changes</button>
    </Actions>

    <ChildContent>
    @if (Host is null)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Choose a channel" Description="Select the channel whose points settings you want to configure from the top bar." />
    }
    else if (!_featureEnabled)
    {
        <PageState Kind="DashboardPageState.Unavailable" Title="Turn on points" Description="Points are off for this channel. Turn them on in Channel setup before changing their settings.">
            <Actions><a class="btn-primary" href="/host">Open Channel setup</a></Actions>
        </PageState>
    }
    else if (_config is null)
    {
        <PageState Kind="DashboardPageState.Loading" Title="Loading points settings" Description="Getting this channel’s point rules, commands, and replies ready." />
    }
    else
    {
        var gamblingCooldownError = _validationErrors
            .OfType<PointsConfigurationValidationError.NegativeGamblingCooldown>()
            .FirstOrDefault();
        var giveawayDurationError = _validationErrors
            .OfType<PointsConfigurationValidationError.GiveawayDurationBelowMinimum>()
            .FirstOrDefault();
        var giveawayWinnerCountError = _validationErrors
            .OfType<PointsConfigurationValidationError.GiveawayWinnerCountBelowMinimum>()
            .FirstOrDefault();
        var giveawayCooldownError = _validationErrors
            .OfType<PointsConfigurationValidationError.GiveawayCooldownBelowMinimum>()
            .FirstOrDefault();

        <CollapsibleSection Title="General" Description="What points are called and how gambling works." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-3">
                <Field Id="points-label" Label="Point label" @bind-Value="_config.PointLabel" Placeholder="points" />
                <div class="space-y-2">
                    <label class="label" for="winRate">Chance of winning (%)</label>
                    <input id="winRate" class="input" type="number" min="0" max="100" @bind="_config.GamblingWinRatePercent" />
                </div>
                <div class="space-y-2">
                    <label class="label" for="gamblingCooldown">Wait between gambles (seconds)</label>
                    <input id="gamblingCooldown"
                           class="input"
                           type="number"
                           min="0"
                           aria-invalid="@(gamblingCooldownError is null ? "false" : "true")"
                           aria-describedby="@(gamblingCooldownError is null ? null : "gamblingCooldown-error")"
                           @bind="_config.GamblingCooldownSeconds" />
                    @if (gamblingCooldownError is not null)
                    {
                        <p id="gamblingCooldown-error" class="text-sm font-semibold text-red-700">@gamblingCooldownError.Message</p>
                    }
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Chat commands" Description="Separate extra command words with commas." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-2">
                <Field Id="points-aliases" Label="Balance" @bind-Value="_config.Aliases.PointsAliases" Placeholder="points" />
                <Field Id="points-give-aliases" Label="Give" @bind-Value="_config.Aliases.GivePointsAliases" Placeholder="givepoints" />
                <Field Id="points-add-aliases" Label="Add" @bind-Value="_config.Aliases.AddPointsAliases" Placeholder="addpoints" />
                <Field Id="points-remove-aliases" Label="Remove" @bind-Value="_config.Aliases.RemovePointsAliases" Placeholder="removepoints" />
                <Field Id="points-gamble-aliases" Label="Gamble" @bind-Value="_config.Aliases.GambleAliases" Placeholder="gamble" />
                <Field Id="points-giveaway-aliases" Label="Start giveaway" @bind-Value="_config.Aliases.GiveawayAliases" Placeholder="giveaway" />
                <Field Id="points-join-giveaway-aliases" Label="Join giveaway" @bind-Value="_config.Aliases.JoinAliases" Placeholder="join" />
                <Field Id="points-end-giveaway-aliases" Label="End giveaway" @bind-Value="_config.Aliases.EndGiveawayAliases" Placeholder="endgiveaway" />
                <Field Id="points-cancel-giveaway-aliases" Label="Cancel giveaway" @bind-Value="_config.Aliases.CancelGiveawayAliases" Placeholder="cancelgiveaway" />
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Giveaways" Description="Prizes, timing, and who can enter." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-3">
                <div class="space-y-2">
                    <label class="label" for="duration">Time to enter (seconds)</label>
                    <input id="duration"
                           class="input"
                           type="number"
                           min="1"
                           aria-invalid="@(giveawayDurationError is null ? "false" : "true")"
                           aria-describedby="@(giveawayDurationError is null ? null : "duration-error")"
                           @bind="_config.GiveawayDurationSeconds" />
                    @if (giveawayDurationError is not null)
                    {
                        <p id="duration-error" class="text-sm font-semibold text-red-700">@giveawayDurationError.Message</p>
                    }
                </div>
                <Field Id="points-giveaway-minimum-payout" Label="Smallest prize" @bind-Value="_config.GiveawayMinimumPayout" Placeholder="10" />
                <Field Id="points-giveaway-maximum-payout" Label="Largest prize" @bind-Value="_config.GiveawayMaximumPayout" Placeholder="100" />
                <div class="space-y-2">
                    <label class="label" for="winnerCount">Number of winners</label>
                    <input id="winnerCount"
                           class="input"
                           type="number"
                           min="1"
                           aria-invalid="@(giveawayWinnerCountError is null ? "false" : "true")"
                           aria-describedby="@(giveawayWinnerCountError is null ? null : "winnerCount-error")"
                           @bind="_config.GiveawayWinnerCount" />
                    @if (giveawayWinnerCountError is not null)
                    {
                        <p id="winnerCount-error" class="text-sm font-semibold text-red-700">@giveawayWinnerCountError.Message</p>
                    }
                </div>
                <PointsEligibilitySelector HostLogin="@Host.Login" @bind-Value="_config.GiveawayEligibility" />
                <div class="space-y-2">
                    <label class="label" for="cooldown">Wait between giveaways (seconds)</label>
                    <input id="cooldown"
                           class="input"
                           type="number"
                           min="@PointsConfigurationValidator.MinimumGiveawayCooldownSeconds"
                           aria-invalid="@(giveawayCooldownError is null ? "false" : "true")"
                           aria-describedby="@(giveawayCooldownError is null ? null : "cooldown-error")"
                           @bind="_config.GiveawayCooldownSeconds" />
                    @if (giveawayCooldownError is not null)
                    {
                        <p id="cooldown-error" class="text-sm font-semibold text-red-700">@giveawayCooldownError.Message</p>
                    }
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Bot replies" Description="Messages the bot sends for points commands." InitiallyOpen="false">
            <div class="scroll-panel scroll-panel--settings grid gap-4 p-4 md:grid-cols-2">
                <TextAreaField Id="points-balance-reply" Label="Balance" @bind-Value="_config.Replies.BalanceReply" />
                <TextAreaField Id="points-other-balance-reply" Label="Another viewer's balance" @bind-Value="_config.Replies.OtherBalanceReply" />
                <TextAreaField Id="points-transfer-reply" Label="Points given" @bind-Value="_config.Replies.TransferReply" />
                <TextAreaField Id="points-add-reply" Label="Moderator adds points" @bind-Value="_config.Replies.AddReply" />
                <TextAreaField Id="points-remove-reply" Label="Moderator removes points" @bind-Value="_config.Replies.RemoveReply" />
                <TextAreaField Id="points-invalid-amount-reply" Label="Amount not understood" @bind-Value="_config.Replies.InvalidAmountReply" />
                <TextAreaField Id="points-insufficient-balance-reply" Label="Not enough points" @bind-Value="_config.Replies.InsufficientBalanceReply" />
                <TextAreaField Id="points-moderator-only-reply" Label="Only moderators can use this" @bind-Value="_config.Replies.ModeratorOnlyReply" />
                <TextAreaField Id="points-gambling-win-reply" Label="Gamble win" @bind-Value="_config.Replies.GamblingWinReply" />
                <TextAreaField Id="points-gambling-loss-reply" Label="Gamble loss" @bind-Value="_config.Replies.GamblingLoseReply" />
                <TextAreaField Id="points-giveaway-started-reply" Label="Giveaway started" @bind-Value="_config.Replies.GiveawayStartedReply" />
                <TextAreaField Id="points-giveaway-status-reply" Label="Giveaway status" @bind-Value="_config.Replies.GiveawayUpdateReply" />
                <TextAreaField Id="points-giveaway-joined-reply" Label="Giveaway joined" @bind-Value="_config.Replies.GiveawayJoinedReply" />
                <TextAreaField Id="points-giveaway-already-joined-reply" Label="Already joined" @bind-Value="_config.Replies.GiveawayAlreadyJoinedReply" />
                <TextAreaField Id="points-giveaway-ended-reply" Label="Giveaway ended" @bind-Value="_config.Replies.GiveawayEndedReply" />
                <TextAreaField Id="points-giveaway-no-entrants-reply" Label="No one joined" @bind-Value="_config.Replies.GiveawayNoEntrantsReply" />
                <TextAreaField Id="points-giveaway-cancelled-reply" Label="Cancelled" @bind-Value="_config.Replies.GiveawayCancelledReply" />
                <TextAreaField Id="points-giveaway-active-reply" Label="Giveaway already running" @bind-Value="_config.Replies.GiveawayAlreadyActiveReply" />
                <TextAreaField Id="points-giveaway-not-running-reply" Label="No giveaway running" @bind-Value="_config.Replies.GiveawayNotActiveReply" />
                <TextAreaField Id="points-giveaway-cooldown-reply" Label="Giveaway used too recently" @bind-Value="_config.Replies.GiveawayCooldownReply" />
                <TextAreaField Id="points-stream-offline-reply" Label="Stream is offline" @bind-Value="_config.Replies.StreamOfflineReply" />
                <TextAreaField Id="points-not-eligible-reply" Label="Viewer cannot enter" @bind-Value="_config.Replies.NotEligibleReply" />
                <TextAreaField Id="points-follower-unavailable-reply" Label="Follower check unavailable" @bind-Value="_config.Replies.FollowerEligibilityUnavailableReply" />
            </div>
        </CollapsibleSection>

        <ReplyDeliverySettingsSection Delivery="_config.ReplyDelivery"
                                      WhisperResponsesEnabled="_config.WhisperResponsesEnabled"
                                      Options="_whisperReplyOptions" />
    }
    </ChildContent>
</DashboardPage>

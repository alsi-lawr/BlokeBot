@page "/dashboards/control"
@page "/dashboards/control/{Dashboard:guid}"
@page "/dashboards/editor"
@page "/dashboards/editor/{Dashboard:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@implements IAsyncDisposable
@using BlokeBot.Core.Features.Dashboards
@inject DashboardConfigurationService _configuration
@inject NavigationManager _navigation
@inject IJSRuntime _js

<PageTitle>BlokeBot | Dashboards</PageTitle>
<NavigationLock ConfirmExternalNavigation="@_dirty" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<BlokeBot.Core.Components.Layout.DashboardPage Kicker="Channel tools" Title="@(_editing ? "Dashboard editor" : "Dashboard controls")" Width="DashboardPageWidth.Wide">
    @if (_loading) {
        <PageState Kind="PageStateKind.Loading" Title="Loading dashboards" />
    }
    else if (_error is not null) {
        <PageState Kind="PageStateKind.Failure" Title="@_error">
            <Actions>
                <button class="btn-secondary" @onclick="LoadAsync">Retry</button>
            </Actions>
        </PageState>
    }
    else if (_editing && _edit is null) {
        <div class="dashboard-picker">
            <TaskPanel Title="Choose a dashboard">
                <div class="dashboard-selector">
                    <label class="field">
                        <span class="field__label">Dashboard</span>
                        <select class="field__input" @ref="_picker" @bind="_choice">
                            <option value="">Choose a dashboard</option>
                            @foreach (var dashboard in _dashboards) {
                                <option value="@dashboard.Id.Value">@dashboard.Name</option>
                            }
                        </select>
                    </label>
                    <EditorAction Label="Open dashboard editor" Icon="edit" Disabled="@(_choice == Guid.Empty)" Click="OpenChoice" />
                </div>
                <div class="dashboard-create">
                    <h3>New dashboard</h3>
                    <div class="dashboard-selector">
                        <Field Id="dashboard-new-name" Label="Name" Value="@_newName" ValueChanged="value => _newName = value" Placeholder="Dashboard name" />
                        <EditorAction Label="Create dashboard" Icon="add" Disabled="@(string.IsNullOrWhiteSpace(_newName) || _busy)" Click="CreateAsync" />
                    </div>
                </div>
            </TaskPanel>
        </div>
    }
    else {
        <div @ref="_root" class="dashboard-composition" data-server-now="@_clock.GetUtcNow().ToString("O")" data-editing="@((_editing && !_busy).ToString().ToLowerInvariant())" data-server-dirty="@_dirty.ToString().ToLowerInvariant()" data-editor-menu-context="@_editorContext" data-settings-owner="@_settingsOwner">
            <fieldset class="dashboard-edit-boundary" disabled="@(_busy && _editing)">
                <EditorWorkspace Class="dashboard-workspace" Header="_workspaceHeader" aria-label="@(_editing ? "Dashboard editor workspace" : "Dashboard control workspace")">
                    <div class="dashboard-body">
                        <div class="dashboard-grid @(_editing && _showSlots ? "dashboard-grid--slots" : null)" data-dashboard-grid tabindex="0" aria-label="Dashboard arrangement" data-columns="@_arrangement.Columns" data-cell-height="@_arrangement.CellHeight" data-arrangement="@_arrangementKind" style="@_gridStyle">
                            @foreach (var widget in _orderedWidgets) {
                                var placement = Placement(widget.Id);
                                <div @key="widget.Id" class="dashboard-card" data-selected="@((_selected == widget.Id).ToString().ToLowerInvariant())" tabindex="@(_editing ? 0 : -1)" @onfocusin="() => SelectWidget(widget.Id)" data-widget-id="@widget.Id.Value" style="@PlacementStyle(placement)">
                                    <TaskPanel Title="@widget.Label">
                                        <Actions>
                                            @if (_editing) {
                                                <EditorAction Label='@($"Configure {widget.Label}")'  Icon="settings" data-settings-for="@widget.Id.Value" Click="() => SettingsAsync(widget.Id)" />
                                                <button class="dashboard-grip" data-grid-move aria-label="Move @widget.Label" type="button" @onkeydown="args => GridKeyAsync(widget, args)">
                                                    <EditorIcon Name="drag" />
                                                </button>
                                            }
                                        </Actions>
                                        <ChildContent>
                                            <DashboardWidgetControl View="@(new DashboardWidgetView(widget))" SelectedHostId="HostId" Session="PageContext.Session" Editing="_editing" EditorTargets="_editorTargets" Visible="_visible" RecentViewers="_recentViewers" />
                                        </ChildContent>
                                    </TaskPanel>
                                    @if (_editing) {
                                        <button class="dashboard-resize" data-grid-resize aria-label="Resize @widget.Label" type="button" @onkeydown="args => GridKeyAsync(widget, args, true)">
                                            <EditorIcon Name="fullscreen" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (_editing) {
                        var settingsOwner = _settingsOwner;
                        <dialog class="full-editor-dialog dashboard-settings-dialog" data-dashboard-settings aria-labelledby="dashboard-settings-title">
                            <header><div><h2 id="dashboard-settings-title">Widget settings</h2><p class="dashboard-status">@_selectedWidget?.Label</p></div><EditorAction Label="Close settings" Icon="close" Click="() => CloseSettingsAsync(settingsOwner)" /></header>
                            @if (_settingsOpen && _selectedWidget is { } selected) {
                                <div class="dashboard-settings-fields">
                                    <DashboardWidgetSettings @key="selected.Id" View="@(new DashboardWidgetView(selected))" Targets="_editorTargets" Placement="@(new DashboardPlacementTransport(Placement(selected.Id).Column, Placement(selected.Id).Row, Placement(selected.Id).Width, Placement(selected.Id).Height))" Changed="view => ConfigureWidget(view.Widget, settingsOwner)" PlacementChanged="placement => ChangeSettingsPlacementAsync(selected, placement, settingsOwner)" />
                                </div>
                            }
                        </dialog>
                    }
                    @if (_editing && _toolboxOpen) {
                        <EditorToolbox @ref="_toolbox" Id="dashboard-toolbox" Purpose="Dashboard widgets" Search="@_search" SearchChanged="value => _search = value" ResultsTitle="Add a widget" Count="_toolboxKinds.Count" EmptyMessage="No matching widgets" Close="CloseToolboxAsync">
                            @foreach (var kind in _toolboxKinds) {
                                <div draggable="true" data-toolbox-kind="@kind.ToString()">
                                    <EditorToolboxRow Name="@DashboardWidgetKinds.Label(kind)" Purpose="@DashboardWidgetKinds.Label(kind)" AccessibleLabel='@($"Add {DashboardWidgetKinds.Label(kind)}")'  Activate="() => AddAsync(kind)">
                                        <Icon>
                                            <EditorIcon Name="@DashboardWidgetKinds.Icon(kind)" />
                                        </Icon>
                                    </EditorToolboxRow>
                                </div>
                            }
                        </EditorToolbox>
                    }
                </EditorWorkspace>
            </fieldset>
            @if (_feedback is not null) {
                <p class="dashboard-feedback" role="status">@_feedback</p>
            }
            @if (_edit?.Conflict is not null) {
                <button class="btn-secondary" @onclick="ReloadConflictAsync">Discard local changes and reload saved dashboard</button>
            }
        </div>
    }
</BlokeBot.Core.Components.Layout.DashboardPage>

@code {
    private RenderFragment<RenderFragment> _workspaceHeader => controls => @<div class="dashboard-toolbar">
        <div class="dashboard-toolbar-selection">
            @if (_editing) {
                <EditorAction Label="Choose another dashboard" Icon="arrow-left" Click='() => _navigation.NavigateTo("/dashboards/editor")' />
                <Field Id="dashboard-name" Label="Dashboard name" Value="@(_edit?.Name ?? string.Empty)" ValueChanged="Rename" />
            }
            else {
                <label class="field">
                    <span class="field__label">Dashboard</span>
                    <select class="field__input" @ref="_picker" value="@Dashboard" @onchange="SelectControl">
                        <option value="">Choose a dashboard</option>
                        @foreach (var dashboard in _dashboards) {
                            <option value="@dashboard.Id.Value">@dashboard.Name</option>
                        }
                    </select>
                </label>
            }
            @if (_editing && _snapshot is not null) {
                <div class="dashboard-management" @onkeydown="ManagementKeyAsync">
                    <EditorAction Label="Manage dashboard" Icon="menu" data-dashboard-manage aria-expanded="@_managementOpen.ToString().ToLowerInvariant()" aria-controls="dashboard-management" Click="ToggleManagement" Disabled="_busy" />
                    @if (_managementOpen) {
                        <section id="dashboard-management" class="dashboard-management-panel" aria-label="Manage dashboard">
                            <button class="btn-secondary" type="button" @onclick="EditNameAsync"><EditorIcon Name="edit" />Rename in editor</button>
                            <button class="btn-secondary" type="button" @onclick="DeleteDashboardAsync" disabled="@_busy"><EditorIcon Name="delete" />Delete dashboard</button>
                        </section>
                    }
                </div>
            }
        </div>
        @if (_snapshot is not null) {
            <div class="dashboard-grid-controls">
                <label class="field"><span class="field__label">Arrangement</span>
                    <select class="field__input" id="dashboard-arrangement" value="@_arrangementKind" @onchange="ArrangementChangedAsync">
                        <option value="Desktop">Desktop</option><option value="Phone">Phone</option>
                    </select>
                </label>
                @if (_editing) {
                    <label class="field"><span class="field__label">Columns</span><input class="field__input" id="dashboard-columns" type="number" min="1" max="24" value="@_arrangement.Columns" @onchange="ColumnsChangedAsync" /></label>
                    <label class="field"><span class="field__label">Cell height (px)</span><input class="field__input" id="dashboard-cell-height" type="number" min="24" max="240" step="8" value="@_arrangement.CellHeight" @onchange="CellHeightChangedAsync" /></label>
                    <label class="dashboard-checkbox"><input id="dashboard-show-slots" type="checkbox" @bind="_showSlots" />Show slots</label>
                }
            </div>
        }
        <div class="dashboard-toolbar-actions">
            @if (_editing) {
                <span class="dashboard-save-state">@(_dirty ? "Unsaved" : "Saved")</span>
                <EditorAction Label="Add widget" Icon="add" data-dashboard-add aria-expanded="@_toolboxOpen.ToString().ToLowerInvariant()" aria-controls="dashboard-toolbox" Click="ToggleToolboxAsync" />
                <EditorContextMenu>
                    <AdditionalItems>
                        <button type="button" role="menuitem" tabindex="-1" data-editor-menu-action="settings"><EditorIcon Name="settings" /><span>Settings</span></button>
                        <button type="button" role="menuitem" tabindex="-1" data-editor-menu-action="position"><EditorIcon Name="grid" /><span>Position &amp; size</span></button>
                        <button type="button" role="menuitem" tabindex="-1" data-editor-menu-action="moveLeft"><EditorIcon Name="arrow-left" /><span>Move left</span></button>
                        <button type="button" role="menuitem" tabindex="-1" data-editor-menu-action="moveRight"><EditorIcon Name="arrow-right" /><span>Move right</span></button>
                        <button type="button" role="menuitem" tabindex="-1" data-editor-menu-action="narrow"><EditorIcon Name="minus" /><span>Narrow</span></button>
                        <button type="button" role="menuitem" tabindex="-1" data-editor-menu-action="widen"><EditorIcon Name="add" /><span>Widen</span></button>
                    </AdditionalItems>
                </EditorContextMenu>
                <EditorAction Label="Undo" Icon="undo" Disabled="@(_edit?.CanUndo != true)" Click="UndoAsync" />
                <EditorAction Label="Redo" Icon="redo" Disabled="@(_edit?.CanRedo != true)" Click="RedoAsync" />
                <EditorAction Label="Cancel changes" Icon="close" Click="CancelAsync" Disabled="_busy" />
                <EditorAction Label="Save dashboard" Icon="save" Click="SaveAsync" Disabled="_busy" />
            }
            @controls
        </div>
    </div>;
}

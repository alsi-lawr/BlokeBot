<div class="progression-timeline">
    <div class="progression-timeline__bar">
        <span class="progression-timeline__fill" style="@_fillStyle"></span>
        <span class="progression-timeline__today" style="@_todayStyle"></span>
    </div>
    <div class="progression-timeline__labels">
        <span>Started <b>@_startLabel</b></span>
        <span><b>@_dayLabel</b></span>
        <span>Ends <b>@_endLabel</b>@_zoneLabel</span>
    </div>
</div>

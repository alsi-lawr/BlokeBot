@page "/community"
@using BlokeBot.Core.Features.Points.Balances
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CommunityProgressionService _progression
@inject BlokeBot.Core.Features.HostedChannels.HostFeatureService _features

<PageTitle>BlokeBot | Community progression</PageTitle>

<DashboardPage Kicker="Community"
               Title="Seasons, quests &amp; achievements"
               Description="Run recurring channel progression with durable rewards and archived standings."
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_enabled && Host is not null)
        {
            <a class="btn-secondary" href="@_publicUrl" target="_blank" rel="noopener">Open public progression</a>
        }
    </Actions>
    <ChildContent>
        @if (Host is null)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">Choose a channel to manage Community progression.</div>
            </ApplicationCardCollection>
        }
        else if (!_enabled)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Community progression is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved seasons, progress, rewards, and history are retained; re-enabling does not replay suppressed events or reset periods.
                </div>
            </ApplicationCardCollection>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="rounded-lg border p-3 text-sm font-semibold" role="@(_failed ? "alert" : "status")">@_feedback</p>
            }

            <section class="card p-5" aria-labelledby="season-create-heading">
                <h2 id="season-create-heading" class="text-lg font-semibold text-slate-950">New season</h2>
                <div class="studio-grid mt-4">
                    <div class="studio-span-6"><Field Id="season-name" Label="Name" @bind-Value="_season.Name" /></div>
                    <div class="studio-span-6 grid gap-4 sm:grid-cols-2">
                        <Field Id="season-start" Label="Starts (UTC)" @bind-Value="_season.StartsAtUtc" />
                        <Field Id="season-end" Label="Ends (UTC)" @bind-Value="_season.EndsAtUtc" />
                    </div>
                    <div class="studio-span-12"><TextAreaField Id="season-description" Label="Public description" @bind-Value="_season.Description" /></div>
                    <div class="studio-span-6">
                        <label class="label" for="season-visibility">Visibility</label>
                        <select id="season-visibility" class="input" @bind="_season.Visibility">
                            <option value="@CommunityVisibility.Public">Public — participant Twitch identities and progress are visible</option>
                            <option value="@CommunityVisibility.Hidden">Hidden — no public progression data</option>
                        </select>
                    </div>
                    <div class="studio-span-6"><TextAreaField Id="season-notes" Label="Private moderator notes" @bind-Value="_season.ModeratorNotes" /></div>
                    <div class="studio-span-12"><button class="btn-primary" type="button" @onclick="CreateSeasonAsync">Create draft season</button></div>
                </div>
            </section>

            @foreach (var season in _seasons)
            {
                <article class="card p-5" @key="season.Id" data-season-id="@season.Id.Value">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <h2 class="text-lg font-semibold text-slate-950">@season.Name</h2>
                                <span class="status-pill bg-[var(--app-surface-muted)] text-[var(--app-text-muted)] ring-1 ring-[var(--app-border)]"><span class="status-pill__label">@season.Status</span></span>
                                <span class="text-xs font-semibold text-muted-foreground">@season.Visibility</span>
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">@season.Description</p>
                            <p class="mt-2 text-xs text-muted-foreground">@season.StartsAtUtc.ToString("u") — @season.EndsAtUtc.ToString("u")</p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @if (season.Status == CommunitySeasonStatus.Draft)
                            {
                                <button class="btn-primary" type="button" @onclick="() => TransitionAsync(season, CommunitySeasonTransition.Open)">Open season</button>
                            }
                            else if (season.Status == CommunitySeasonStatus.Open)
                            {
                                <button class="btn-secondary" type="button" @onclick="() => TransitionAsync(season, CommunitySeasonTransition.Close)">Close and snapshot standings</button>
                            }
                            else if (season.Status == CommunitySeasonStatus.Closed)
                            {
                                <button class="btn-secondary" type="button" @onclick="() => TransitionAsync(season, CommunitySeasonTransition.Archive)">Archive season</button>
                            }
                        </div>
                    </div>

                    @if (season.Status == CommunitySeasonStatus.Draft)
                    {
                        <div class="mt-5 grid gap-4 lg:grid-cols-2">
                            <section class="rounded-xl border p-4" aria-label="Add persistent reward">
                                <h3 class="font-semibold">Add persistent reward</h3>
                                <div class="mt-3 grid gap-3">
                                    <Field Id="@($"reward-key-{season.Id.Value:N}")" Label="Stable key" @bind-Value="_reward.Key" />
                                    <Field Id="@($"reward-name-{season.Id.Value:N}")" Label="Display name" @bind-Value="_reward.Name" />
                                    <label class="label">Type
                                        <select class="input mt-1" @bind="_reward.Kind">
                                            <option value="@CommunityRewardKind.Title">Title</option>
                                            <option value="@CommunityRewardKind.Badge">Badge icon</option>
                                            <option value="@CommunityRewardKind.CosmeticAccent">Cosmetic accent</option>
                                        </select>
                                    </label>
                                    <Field Id="@($"reward-token-{season.Id.Value:N}")" Label="Presentation token" @bind-Value="_reward.PresentationToken" />
                                    <p class="text-xs text-muted-foreground">Badge tokens: star, crown, spark, shield. Accent tokens: sky, violet, amber, emerald. Titles use bounded text, never CSS.</p>
                                    <button class="btn-secondary" type="button" @onclick="() => AddRewardAsync(season)">Add reward</button>
                                </div>
                            </section>

                            <section class="rounded-xl border p-4" aria-label="Add quest or achievement">
                                <h3 class="font-semibold">Add quest or achievement</h3>
                                <div class="mt-3 grid gap-3">
                                    <Field Id="@($"definition-key-{season.Id.Value:N}")" Label="Stable key" @bind-Value="_definition.Key" />
                                    <Field Id="@($"definition-name-{season.Id.Value:N}")" Label="Name" @bind-Value="_definition.Name" />
                                    <label class="label">Kind
                                        <select class="input mt-1" @bind="_definition.Kind"><option value="@CommunityDefinitionKind.Quest">Quest</option><option value="@CommunityDefinitionKind.Achievement">Achievement</option></select>
                                    </label>
                                    <label class="label">Progress owner
                                        <select class="input mt-1" @bind="_definition.Scope"><option value="@CommunityProgressScope.Viewer">Per viewer</option><option value="@CommunityProgressScope.Communal">Channel-wide communal</option></select>
                                    </label>
                                    <label class="label">Completion
                                        <select class="input mt-1" @bind="_definition.Completion"><option value="@CommunityCompletionMode.OneTime">One-time</option><option value="@CommunityCompletionMode.Repeatable">Repeatable</option></select>
                                    </label>
                                    <label class="label">Supported event
                                        <select class="input mt-1" @bind="_definition.EventRule">@foreach (var kind in Enum.GetValues<CommunityEventRuleKind>()) { <option value="@kind">@kind</option> }</select>
                                    </label>
                                    <label class="label">Increment
                                        <select class="input mt-1" @bind="_definition.Increment"><option value="@CommunityProgressIncrement.Occurrence">One per event</option><option value="@CommunityProgressIncrement.EventValue">Event value (bits/viewers)</option></select>
                                    </label>
                                    <Field Id="@($"definition-filter-{season.Id.Value:N}")" Label="Optional typed filter token" @bind-Value="_definition.FilterToken" />
                                    <Field Id="@($"definition-target-{season.Id.Value:N}")" Label="Target" @bind-Value="_definition.Target" />
                                    <Field Id="@($"definition-points-{season.Id.Value:N}")" Label="Points reward" @bind-Value="_definition.PointsReward" />
                                    <Field Id="@($"definition-rewards-{season.Id.Value:N}")" Label="Reward keys (comma separated)" @bind-Value="_definition.RewardKeys" />
                                    <label class="label">Reset cadence
                                        <select class="input mt-1" @bind="_definition.ResetCadence"><option value="@CommunityResetCadence.None">None</option><option value="@CommunityResetCadence.Daily">Daily</option><option value="@CommunityResetCadence.Weekly">Weekly</option></select>
                                    </label>
                                    <Field Id="@($"definition-reset-time-{season.Id.Value:N}")" Label="Local reset time (HH:mm)" @bind-Value="_definition.ResetLocalTime" />
                                    <label class="label">Weekly day
                                        <select class="input mt-1" @bind="_definition.ResetWeekday">@foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@day</option> }</select>
                                    </label>
                                    <button class="btn-secondary" type="button" @onclick="() => AddDefinitionAsync(season)">Add definition</button>
                                </div>
                            </section>
                        </div>
                    }

                    @if (season.Rewards.Count > 0)
                    {
                        <p class="mt-4 text-sm"><span class="font-semibold">Persistent rewards:</span> @string.Join(", ", season.Rewards.Select(value => $"{value.Name} ({value.Kind}, {value.Key})"))</p>
                    }
                    @foreach (var definition in season.Definitions)
                    {
                        <div class="mt-4 rounded-xl border p-4 text-sm">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div><span class="font-semibold">@definition.Name</span> · @definition.Kind · @definition.Scope · @definition.EventRule · target @definition.Target</div>
                                <span class="text-xs text-muted-foreground">@definition.Key</span>
                            </div>
                            @if (definition.Schedule.Cadence != CommunityResetCadence.None)
                            {
                                <p class="mt-2 text-muted-foreground">@definition.Schedule.Cadence at @definition.Schedule.LocalTime.ToString("HH:mm") @definition.Schedule.Weekday · @definition.TimeZoneId · next @definition.NextResetUtc?.ToString("u")</p>
                                <p class="mt-1 text-xs text-muted-foreground">DST gaps move to the first valid instant; overlaps use the first occurrence only. After downtime BlokeBot rolls directly into the current period and never replays missed periods.</p>
                            }
                            @if (season.Status == CommunitySeasonStatus.Open && definition.CompletionMode == CommunityCompletionMode.Repeatable)
                            {
                                var edit = ScheduleFor(definition);
                                <div class="mt-3 grid gap-2 md:grid-cols-4">
                                    <select class="input" @bind="edit.Cadence"><option value="@CommunityResetCadence.None">None</option><option value="@CommunityResetCadence.Daily">Daily</option><option value="@CommunityResetCadence.Weekly">Weekly</option></select>
                                    <input class="input" aria-label="New local reset time" @bind="edit.LocalTime" />
                                    <select class="input" @bind="edit.Weekday">@foreach (var day in Enum.GetValues<DayOfWeek>()) { <option value="@day">@day</option> }</select>
                                    <label class="flex items-center gap-2 text-xs font-semibold"><input type="checkbox" @bind="edit.Confirmed" /> Reset active progress now</label>
                                    <button class="btn-secondary md:col-span-4" type="button" @onclick="() => EditScheduleAsync(definition)">Save schedule and roll over immediately</button>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        }
    </ChildContent>
</DashboardPage>

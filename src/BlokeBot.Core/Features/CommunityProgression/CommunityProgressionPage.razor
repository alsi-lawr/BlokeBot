@page "/community"
@using BlokeBot.Core.Features.Points.Balances
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CommunityProgressionService _progression
@inject BlokeBot.Core.Features.HostedChannels.HostFeatureService _features

<PageTitle>BlokeBot | Community progression</PageTitle>

<DashboardPage Kicker="Community"
               Title="Seasons, quests &amp; achievements"
               Description="Run recurring channel progression with durable rewards and archived standings."
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_enabled && Host is not null)
        {
            <a class="btn-secondary" href="@_publicUrl" target="_blank" rel="noopener">Open public progression</a>
        }
    </Actions>
    <ChildContent>
        @if (Host is null)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">Choose a channel to manage Community progression.</div>
            </ApplicationCardCollection>
        }
        else if (!_enabled)
        {
            <ApplicationCardCollection Owner="dashboard-page-cards">
                <div class="card p-8 text-sm text-muted-foreground">
                    Community progression is off for this channel. Turn it on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved seasons, progress, rewards, and history are retained; re-enabling does not replay suppressed events or reset periods.
                </div>
            </ApplicationCardCollection>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_feedback))
            {
                <p class="rounded-lg border p-3 text-sm font-semibold" role="@(_failed ? "alert" : "status")">@_feedback</p>
            }

            <details class="card progression-disclosure progression-card" open>
                <summary>
                    <div class="grid min-w-0 gap-1">
                        <h2 class="text-lg font-semibold text-[var(--app-text-strong)]">New season</h2>
                        <p class="text-sm text-muted-foreground">Draft a season, then open it once its rewards and definitions are ready.</p>
                    </div>
                    <span class="progression-chevron" aria-hidden="true">›</span>
                </summary>
                <div class="progression-card__body">
                    <div class="studio-grid">
                        <div class="studio-span-6"><Field Id="season-name" Label="Name" @bind-Value="_season.Name" /></div>
                        <div class="studio-span-6 grid gap-4 sm:grid-cols-2">
                            <Field Id="season-start" Label="Starts (UTC)" @bind-Value="_season.StartsAtUtc" />
                            <Field Id="season-end" Label="Ends (UTC)" @bind-Value="_season.EndsAtUtc" />
                        </div>
                        <div class="studio-span-12"><TextAreaField Id="season-description" Label="Public description" @bind-Value="_season.Description" /></div>
                        <div class="studio-span-6">
                            <label class="label" for="season-visibility">Visibility</label>
                            <select id="season-visibility" class="input mt-1" @bind="_season.Visibility">
                                <option value="@CommunityVisibility.Public">Public, participant Twitch identities and progress are visible</option>
                                <option value="@CommunityVisibility.Hidden">Hidden, no public progression data</option>
                            </select>
                        </div>
                        <div class="studio-span-6"><TextAreaField Id="season-notes" Label="Private moderator notes" @bind-Value="_season.ModeratorNotes" /></div>
                        <div class="studio-span-12"><button class="btn-primary" type="button" @onclick="CreateSeasonAsync">Create draft season</button></div>
                    </div>
                </div>
            </details>

            @foreach (var season in _seasons)
            {
                <details class="card progression-disclosure progression-card"
                         @key="season.Id"
                         data-season-id="@season.Id.Value"
                         open="@(season.Status != CommunitySeasonStatus.Archived)">
                    <summary>
                        <div class="grid min-w-0 gap-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <h2 class="text-lg font-semibold text-[var(--app-text-strong)]">@season.Name</h2>
                                <span class="@CommunityProgressionPresentation.StatusPillClass(season.Status)">
                                    <span class="status-pill__dot"></span><span class="status-pill__label">@season.Status</span>
                                </span>
                                <span class="progression-tag">@season.Visibility</span>
                            </div>
                            <p class="text-sm text-muted-foreground">@SeasonSummary(season)</p>
                        </div>
                        <span class="progression-chevron" aria-hidden="true">›</span>
                    </summary>
                    <div class="progression-card__body">
                        @if (season.Status != CommunitySeasonStatus.Draft)
                        {
                            <CommunitySeasonTimeline StartsAtUtc="season.StartsAtUtc"
                                                     EndsAtUtc="season.EndsAtUtc"
                                                     TimeZoneId="@SeasonTimeZone(season)" />
                        }

                        @if (season.Status != CommunitySeasonStatus.Archived)
                        {
                            <div class="flex flex-wrap gap-2">
                                @if (season.Status == CommunitySeasonStatus.Draft)
                                {
                                    <button class="btn-primary" type="button" @onclick="() => TransitionAsync(season, CommunitySeasonTransition.Open)">Open season</button>
                                }
                                else if (season.Status == CommunitySeasonStatus.Open)
                                {
                                    <button class="btn-secondary" type="button" @onclick="() => TransitionAsync(season, CommunitySeasonTransition.Close)">Close and snapshot standings</button>
                                }
                                else
                                {
                                    <button class="btn-secondary" type="button" @onclick="() => TransitionAsync(season, CommunitySeasonTransition.Archive)">Archive season</button>
                                }
                            </div>
                        }

                        @if (season.Status == CommunitySeasonStatus.Draft)
                        {
                            <StudioStage Key='@StageKey(season, "details")'
                                         Number="1"
                                         Title="Season details"
                                         Summary="@SeasonSummary(season)"
                                         Open='@StageOpen(season, "details")'
                                         OpenChanged='value => SetStageOpen(season, "details", value)'>
                                <div class="studio-grid">
                                    <div class="studio-span-4">
                                        <span class="label">Name</span>
                                        <p class="text-sm">@season.Name</p>
                                    </div>
                                    <div class="studio-span-4">
                                        <span class="label">Starts</span>
                                        <p class="text-sm" title="@CommunityProgressionPresentation.ExactMoment(season.StartsAtUtc)">@CommunityProgressionPresentation.HumanMoment(season.StartsAtUtc)</p>
                                    </div>
                                    <div class="studio-span-4">
                                        <span class="label">Ends</span>
                                        <p class="text-sm" title="@CommunityProgressionPresentation.ExactMoment(season.EndsAtUtc)">@CommunityProgressionPresentation.HumanMoment(season.EndsAtUtc)</p>
                                    </div>
                                    <div class="studio-span-4">
                                        <span class="label">Visibility</span>
                                        <p class="text-sm">@season.Visibility</p>
                                    </div>
                                    <div class="studio-span-8">
                                        <span class="label">Public description</span>
                                        <p class="text-sm">@season.Description</p>
                                    </div>
                                </div>
                            </StudioStage>

                            <StudioStage Key='@StageKey(season, "rewards")'
                                         Number="2"
                                         Title="Persistent rewards"
                                         Summary="@RewardSummary(season)"
                                         Open='@StageOpen(season, "rewards")'
                                         OpenChanged='value => SetStageOpen(season, "rewards", value)'>
                                <div class="grid min-w-0 gap-5 lg:grid-cols-2">
                                    <div class="studio-grid">
                                        <div class="studio-span-6"><Field Id="@($"reward-key-{season.Id.Value:N}")" Label="Stable key" @bind-Value="_reward.Key" /></div>
                                        <div class="studio-span-6"><Field Id="@($"reward-name-{season.Id.Value:N}")" Label="Display name" @bind-Value="_reward.Name" /></div>
                                        <div class="studio-span-6">
                                            <label class="label" for="@($"reward-kind-{season.Id.Value:N}")">Type</label>
                                            <select id="@($"reward-kind-{season.Id.Value:N}")" class="input mt-1" @bind="_reward.Kind">
                                                <option value="@CommunityRewardKind.Title">Title</option>
                                                <option value="@CommunityRewardKind.Badge">Badge icon</option>
                                                <option value="@CommunityRewardKind.CosmeticAccent">Cosmetic accent</option>
                                            </select>
                                        </div>
                                        <div class="studio-span-6">
                                            @if (TokenOptions(_reward.Kind) is { Count: > 0 } tokens)
                                            {
                                                <label class="label" for="@($"reward-token-{season.Id.Value:N}")">Presentation token</label>
                                                <select id="@($"reward-token-{season.Id.Value:N}")" class="input mt-1" @bind="_reward.PresentationToken">
                                                    @foreach (var token in tokens)
                                                    {
                                                        <option value="@token">@token</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <Field Id="@($"reward-token-{season.Id.Value:N}")" Label="Presentation token" @bind-Value="_reward.PresentationToken" />
                                            }
                                        </div>
                                        <div class="studio-span-12"><button class="btn-secondary" type="button" @onclick="() => AddRewardAsync(season)">Add reward</button></div>
                                    </div>
                                    <div class="progression-preview">
                                        <span class="progression-preview__heading">Live preview</span>
                                        <div class="progression-chips">
                                            <CommunityRewardChip Kind="_reward.Kind" Name="@_reward.Name" PresentationToken="@_reward.PresentationToken" ShowKind="true" />
                                        </div>
                                        <span class="progression-preview__heading">Already defined</span>
                                        @if (season.Rewards.Count == 0)
                                        {
                                            <p class="text-sm text-muted-foreground">No rewards yet.</p>
                                        }
                                        else
                                        {
                                            <div class="progression-chips">
                                                @foreach (var reward in season.Rewards)
                                                {
                                                    <CommunityRewardChip Kind="reward.Kind" Name="@reward.Name" PresentationToken="@reward.PresentationToken" ShowKind="true" />
                                                }
                                            </div>
                                        }
                                        <p class="text-xs text-muted-foreground">Badges and accents pick a supported presentation token. Titles use bounded text, never CSS.</p>
                                    </div>
                                </div>
                            </StudioStage>

                            <StudioStage Key='@StageKey(season, "definitions")'
                                         Number="3"
                                         Title="Quests and achievements"
                                         Summary="@DefinitionSummary(season)"
                                         Open='@StageOpen(season, "definitions")'
                                         OpenChanged='value => SetStageOpen(season, "definitions", value)'>
                                <div class="studio-grid">
                                    <div class="studio-span-6"><Field Id="@($"definition-key-{season.Id.Value:N}")" Label="Stable key" @bind-Value="_definition.Key" /></div>
                                    <div class="studio-span-6"><Field Id="@($"definition-name-{season.Id.Value:N}")" Label="Name" @bind-Value="_definition.Name" /></div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-kind-{season.Id.Value:N}")">Kind</label>
                                        <select id="@($"definition-kind-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.Kind">
                                            <option value="@CommunityDefinitionKind.Quest">Quest</option>
                                            <option value="@CommunityDefinitionKind.Achievement">Achievement</option>
                                        </select>
                                    </div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-scope-{season.Id.Value:N}")">Progress owner</label>
                                        <select id="@($"definition-scope-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.Scope">
                                            <option value="@CommunityProgressScope.Viewer">Per viewer</option>
                                            <option value="@CommunityProgressScope.Communal">Channel-wide communal</option>
                                        </select>
                                    </div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-completion-{season.Id.Value:N}")">Completion</label>
                                        <select id="@($"definition-completion-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.Completion">
                                            <option value="@CommunityCompletionMode.OneTime">One-time</option>
                                            <option value="@CommunityCompletionMode.Repeatable">Repeatable</option>
                                        </select>
                                    </div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-rule-{season.Id.Value:N}")">Supported event</label>
                                        <select id="@($"definition-rule-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.EventRule">
                                            @foreach (var rule in _availableEventRules)
                                            {
                                                <option value="@rule.Kind">@rule.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-increment-{season.Id.Value:N}")">Increment</label>
                                        <select id="@($"definition-increment-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.Increment">
                                            <option value="@CommunityProgressIncrement.Occurrence">One per event</option>
                                            <option value="@CommunityProgressIncrement.EventValue">Event value (bits/viewers)</option>
                                        </select>
                                    </div>
                                    <div class="studio-span-4"><Field Id="@($"definition-filter-{season.Id.Value:N}")" Label="Optional typed filter token" @bind-Value="_definition.FilterToken" /></div>
                                    <div class="studio-span-4"><Field Id="@($"definition-target-{season.Id.Value:N}")" Label="Target" @bind-Value="_definition.Target" /></div>
                                    <div class="studio-span-4"><Field Id="@($"definition-points-{season.Id.Value:N}")" Label="Points reward" @bind-Value="_definition.PointsReward" /></div>
                                    <div class="studio-span-4"><Field Id="@($"definition-rewards-{season.Id.Value:N}")" Label="Reward keys (comma separated)" @bind-Value="_definition.RewardKeys" /></div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-cadence-{season.Id.Value:N}")">Reset cadence</label>
                                        <select id="@($"definition-cadence-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.ResetCadence">
                                            <option value="@CommunityResetCadence.None">None</option>
                                            <option value="@CommunityResetCadence.Daily">Daily</option>
                                            <option value="@CommunityResetCadence.Weekly">Weekly</option>
                                        </select>
                                    </div>
                                    <div class="studio-span-4"><Field Id="@($"definition-reset-time-{season.Id.Value:N}")" Label="Local reset time (HH:mm)" @bind-Value="_definition.ResetLocalTime" /></div>
                                    <div class="studio-span-4">
                                        <label class="label" for="@($"definition-weekday-{season.Id.Value:N}")">Weekly day</label>
                                        <select id="@($"definition-weekday-{season.Id.Value:N}")" class="input mt-1" @bind="_definition.ResetWeekday">
                                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                                            {
                                                <option value="@day">@day</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="studio-span-12"><button class="btn-secondary" type="button" @onclick="() => AddDefinitionAsync(season)">Add definition</button></div>
                                </div>
                            </StudioStage>
                        }
                        else
                        {
                            <details class="progression-disclosure progression-section" open>
                                <summary>Persistent rewards<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                <div class="progression-section__body">
                                    @if (season.Rewards.Count == 0)
                                    {
                                        <p class="text-sm text-muted-foreground">No persistent rewards were defined.</p>
                                    }
                                    else
                                    {
                                        <div class="progression-chips">
                                            @foreach (var reward in season.Rewards)
                                            {
                                                <CommunityRewardChip Kind="reward.Kind" Name="@reward.Name" PresentationToken="@reward.PresentationToken" ShowKind="true" />
                                            }
                                        </div>
                                    }
                                </div>
                            </details>
                        }

                        <details class="progression-disclosure progression-section" open>
                            <summary>Definitions<span class="progression-chevron" aria-hidden="true">›</span></summary>
                            <div class="progression-section__body">
                                @if (season.Definitions.Count == 0)
                                {
                                    <p class="text-sm text-muted-foreground">No quests or achievements yet.</p>
                                }
                                else
                                {
                                    @foreach (var definition in season.Definitions)
                                    {
                                        <div class="progression-row" @key="definition.Id">
                                            <div class="progression-row__head">
                                                <span class="progression-row__name">@definition.Name</span>
                                                <span class="@CommunityProgressionPresentation.DefinitionPillClass(definition.Kind)">
                                                    <span class="status-pill__label">@definition.Kind</span>
                                                </span>
                                                <span class="progression-tag">@DefinitionShape(definition)</span>
                                                <span class="progression-row__amount">target <b>@CommunityProgressionPresentation.Amount(definition.Target)</b> · @definition.PointsReward.ToDisplayString() pts</span>
                                            </div>
                                            @if (definition.Schedule.Cadence != CommunityResetCadence.None)
                                            {
                                                <p class="progression-row__meta">@DefinitionCadence(definition)</p>
                                                <p class="progression-row__meta">DST gaps move to the first valid instant; overlaps use the first occurrence only. After downtime BlokeBot rolls into the current period and never replays missed periods.</p>
                                            }
                                            @if (season.Status == CommunitySeasonStatus.Open && definition.CompletionMode == CommunityCompletionMode.Repeatable)
                                            {
                                                var edit = ScheduleFor(definition);
                                                <details class="progression-disclosure">
                                                    <summary class="progression-row__meta">Edit reset schedule<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                                    <div class="studio-grid mt-3">
                                                        <div class="studio-span-4">
                                                            <label class="label" for="@($"schedule-cadence-{definition.Id.Value:N}")">Cadence</label>
                                                            <select id="@($"schedule-cadence-{definition.Id.Value:N}")" class="input mt-1" @bind="edit.Cadence">
                                                                <option value="@CommunityResetCadence.None">None</option>
                                                                <option value="@CommunityResetCadence.Daily">Daily</option>
                                                                <option value="@CommunityResetCadence.Weekly">Weekly</option>
                                                            </select>
                                                        </div>
                                                        <div class="studio-span-4">
                                                            <label class="label" for="@($"schedule-time-{definition.Id.Value:N}")">New local reset time</label>
                                                            <input id="@($"schedule-time-{definition.Id.Value:N}")" class="input mt-1" @bind="edit.LocalTime" />
                                                        </div>
                                                        <div class="studio-span-4">
                                                            <label class="label" for="@($"schedule-weekday-{definition.Id.Value:N}")">Weekly day</label>
                                                            <select id="@($"schedule-weekday-{definition.Id.Value:N}")" class="input mt-1" @bind="edit.Weekday">
                                                                @foreach (var day in Enum.GetValues<DayOfWeek>())
                                                                {
                                                                    <option value="@day">@day</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="studio-span-12">
                                                            <div class="progression-warning">
                                                                <span>Saving closes the current period immediately and resets active repeatable progress. One audited rollover in @definition.TimeZoneId, and missed periods are never replayed.</span>
                                                                <label><input type="checkbox" @bind="edit.Confirmed" /> I understand, reset active progress now</label>
                                                            </div>
                                                        </div>
                                                        <div class="studio-span-12">
                                                            <button class="btn-secondary progression-gate-action"
                                                                    type="button"
                                                                    disabled="@(!edit.Confirmed)"
                                                                    @onclick="() => EditScheduleAsync(definition)">Save schedule and roll over</button>
                                                        </div>
                                                    </div>
                                                </details>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </details>

                        @if (season.Status != CommunitySeasonStatus.Draft)
                        {
                            <div class="grid min-w-0 gap-4" data-season-activity="@season.Id.Value">
                                <div class="grid min-w-0 gap-5 lg:grid-cols-2">
                                    <details class="progression-disclosure progression-section" open>
                                        <summary>@CommunityProgressionPresentation.StandingsHeading(season.Status)<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                        <div class="progression-section__body">
                                            @if (season.Standings.Count == 0)
                                            {
                                                <p class="text-sm text-muted-foreground">No participants yet.</p>
                                            }
                                            else
                                            {
                                                <CommunityStandingsTable Standings="season.Standings" />
                                            }
                                        </div>
                                    </details>
                                    <div class="grid min-w-0 gap-4">
                                        <details class="progression-disclosure progression-section" open>
                                            <summary>Channel-wide goals<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                            <div class="progression-section__body">
                                                @if (season.CommunalProgress.Count == 0)
                                                {
                                                    <p class="text-sm text-muted-foreground">No communal goals are active.</p>
                                                }
                                                else
                                                {
                                                    @foreach (var item in season.CommunalProgress)
                                                    {
                                                        <CommunityProgressMeterRow Name="@item.DefinitionName"
                                                                                   Amount="item.Amount"
                                                                                   Target="item.Target"
                                                                                   CompletionCount="item.CompletionCount" />
                                                    }
                                                }
                                            </div>
                                        </details>
                                        <details class="progression-disclosure progression-section" open>
                                            <summary>Persistent reward unlocks<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                            <div class="progression-section__body">
                                                @if (season.Unlocks.Count == 0)
                                                {
                                                    <p class="text-sm text-muted-foreground">No rewards unlocked yet.</p>
                                                }
                                                else
                                                {
                                                    <div class="progression-unlock-list">
                                                        @foreach (var item in season.Unlocks.Take(20))
                                                        {
                                                            <CommunityUnlockRow Unlock="item" />
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    </div>
                                </div>

                                <details class="progression-disclosure progression-section" open>
                                    <summary>Participant progress<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                    <div class="progression-section__body">
                                        @if (season.Progress.Count == 0)
                                        {
                                            <p class="text-sm text-muted-foreground">No viewer progress yet.</p>
                                        }
                                        else
                                        {
                                            @foreach (var item in season.Progress.Take(20))
                                            {
                                                <CommunityProgressMeterRow Name="@item.DisplayName"
                                                                           Tag="@item.DefinitionName"
                                                                           Amount="item.Amount"
                                                                           Target="item.Target"
                                                                           CompletionCount="item.CompletionCount" />
                                            }
                                        }
                                    </div>
                                </details>

                                <details class="progression-disclosure progression-section" open>
                                    <summary>Completions and history<span class="progression-chevron" aria-hidden="true">›</span></summary>
                                    <div class="progression-section__body">
                                        @if (season.Completions.Count == 0)
                                        {
                                            <p class="text-sm text-muted-foreground">No completions yet.</p>
                                        }
                                        else
                                        {
                                            <div class="progression-unlock-list">
                                                @foreach (var item in season.Completions.Take(20))
                                                {
                                                    <div class="progression-unlock" @key="item.Id">
                                                        <b>@(item.DisplayName ?? "Community")</b>
                                                        <span>completed @item.DefinitionName</span>
                                                        <span class="progression-unlock__time" title="@CommunityProgressionPresentation.ExactMoment(item.CompletedAtUtc)">@CommunityProgressionPresentation.HumanMoment(item.CompletedAtUtc)</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            </div>
                        }
                    </div>
                </details>
            }
        }
    </ChildContent>
</DashboardPage>

<div class="progression-row">
    <div class="progression-row__head">
        <span class="progression-row__name">@Name</span>
        @if (!string.IsNullOrWhiteSpace(Tag))
        {
            <span class="progression-tag">@Tag</span>
        }
        <span class="progression-row__amount"><b>@_amount</b> / @_target@_completions</span>
    </div>
    <div class="@_meterClass"
         role="progressbar"
         aria-label="@_meterLabel"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@_meterPercent">
        <span style="@_fillStyle"></span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <p class="progression-row__meta">@Note</p>
    }
</div>

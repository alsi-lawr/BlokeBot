<div class="scroll-panel scroll-panel--data-table overflow-x-auto">
    <table class="w-full text-left text-sm">
        <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
            <tr>
                <th class="px-4 py-3 font-semibold">Rank</th>
                <th class="px-4 py-3 font-semibold">Viewer</th>
                <th class="px-4 py-3 font-semibold">Completed</th>
                <th class="px-4 py-3 font-semibold">Progress</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var standing in _visible)
            {
                <tr @key="standing.TwitchUserId" class="motion-list__item">
                    <td class="px-4 py-3"><RankIndicator Rank="standing.Rank" /></td>
                    <td class="px-4 py-3">
                        <span class="block font-semibold text-[var(--app-text-strong)]">@standing.DisplayName</span>
                        <span class="block text-muted-foreground">@($"@{standing.Login}")</span>
                    </td>
                    <td class="px-4 py-3">@standing.CompletedCount</td>
                    <td class="px-4 py-3">@CommunityProgressionPresentation.Amount(standing.ProgressAmount)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

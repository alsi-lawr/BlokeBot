@page "/requests"
@using Microsoft.AspNetCore.Authorization
@using BlokeBot.Persistence.Models
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject RequestBoardService _boards
@inject BlokeBot.Core.Features.HostedChannels.HostFeatureService _features

<PageTitle>BlokeBot | Request boards</PageTitle>

<DashboardPage Kicker="Community interaction"
               Title="Request boards"
               Description="Configure viewer submissions and moderate the queue."
               Width="DashboardPageWidth.Wide">
    <Actions>
        @if (_featureEnabled && !_isCreating && Host is not null)
        {
            <a class="btn-secondary" href="@_publicBoardUrl">Open public board</a>
        }
        @if (_featureEnabled)
        {
            <button class="btn-primary" type="button" @onclick="SaveBoardAsync">Save board</button>
        }
    </Actions>

    <ChildContent>
    @if (Host is null)
    {
        <ApplicationCardCollection Owner="dashboard-page-cards">
            <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
        </ApplicationCardCollection>
    }
    else if (!_featureEnabled)
    {
        <ApplicationCardCollection Owner="dashboard-page-cards">
            <div class="card p-8 text-sm text-muted-foreground">
                Request boards are off for this channel. Turn them on in <a class="font-semibold text-blue-700" href="/host#chat-tools">Channel setup</a>. Saved boards and requests are retained.
            </div>
        </ApplicationCardCollection>
    }
    else
    {
        <div class="application-card-collection xl:grid-cols-[minmax(16rem,0.7fr)_minmax(0,1.8fr)]" data-card-owner="request-board-workspace-columns">
            <aside class="card p-4">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="text-lg font-semibold text-slate-950">Boards</h2>
                    <button class="btn-secondary"
                            type="button"
                            disabled="@_isCreating"
                            aria-describedby="@(_isCreating ? "request-board-create-guidance" : null)"
                            @onclick="NewBoard">New board</button>
                </div>
                @if (_boardList.Count == 0)
                {
                    <p class="mt-3 text-sm text-muted-foreground">No saved boards yet.</p>
                }
                <div class="mt-3 grid gap-2">
                    @foreach (var board in _boardList)
                    {
                        <button @key="board.Id"
                                type="button"
                                class="control-surface min-h-11 rounded-lg px-3 text-left text-sm font-semibold"
                                aria-current="@(!_isCreating && board.Slug == _draft.Slug ? "true" : null)"
                                @onclick="() => SelectBoardAsync(board.Slug)">
                            @board.Title
                            <span class="block text-xs font-normal text-muted-foreground">/@board.Slug · @(board.IsOpen ? "Open" : "Closed")</span>
                        </button>
                    }
                </div>
            </aside>

            <div class="application-card-collection" data-card-owner="request-board-editor-cards">
                <section class="card p-5" aria-labelledby="request-board-configuration">
                    <h2 id="request-board-configuration" class="text-lg font-semibold text-slate-950">@(_isCreating ? "New board — not saved" : "Edit board")</h2>
                    @if (_isCreating)
                    {
                        <p id="request-board-create-guidance" class="mt-2 text-sm text-muted-foreground">
                            Complete the board details, then select Save board to create it. The public board link is available after Save.
                        </p>
                    }
                    <div class="mt-4 grid gap-4 md:grid-cols-2">
                        <Field Id="request-board-slug"
                               Label="Command and URL name"
                               FocusRequest="@_primaryFocusRequest"
                               @bind-Value="_draft.Slug" />
                        <Field Id="request-board-name" Label="Title" @bind-Value="_draft.Title" />
                        <div class="md:col-span-2">
                            <TextAreaField Id="request-board-description" Label="Description" @bind-Value="_draft.Description" />
                        </div>
                        <Field Id="request-board-cost" Label="Point cost" @bind-Value="_draft.PointCost" />
                        <div>
                            <label class="mb-1 block text-sm font-semibold text-slate-950" for="request-board-refunds">Refund policy</label>
                            <select id="request-board-refunds" class="input" @bind="_draft.RefundPolicy">
                                @foreach (var policy in Enum.GetValues<RequestBoardRefundPolicy>())
                                {
                                    <option value="@policy">@policy</option>
                                }
                            </select>
                        </div>
                        <Field Id="request-board-submission-limit" Label="Active submissions per viewer" @bind-Value="_draft.SubmissionLimit" />
                        <Field Id="request-board-cooldown" Label="Submission cooldown (seconds)" @bind-Value="_draft.CooldownSeconds" />
                        <Field Id="request-board-vote-limit" Label="Votes per viewer" @bind-Value="_draft.VoteLimit" />
                        <label class="flex min-h-11 items-center gap-3 text-sm font-semibold text-slate-950">
                            <input type="checkbox" @bind="_draft.IsOpen" /> Accept submissions
                        </label>
                        <label class="flex min-h-11 items-center gap-3 text-sm font-semibold text-slate-950">
                            <input type="checkbox" @bind="_draft.VotingEnabled" /> Enable voting
                        </label>
                    </div>
                    <div class="mt-6 flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <h3 class="text-base font-semibold text-slate-950">Submission fields</h3>
                            <p id="request-field-limit" class="mt-1 text-sm text-muted-foreground">
                                @_draft.Fields.Count of @RequestBoardLimits.MaximumFields fields.
                                @if (_draft.Fields.Count >= RequestBoardLimits.MaximumFields)
                                {
                                    <span>Maximum of @RequestBoardLimits.MaximumFields fields reached.</span>
                                }
                            </p>
                        </div>
                        <button class="btn-secondary"
                                type="button"
                                disabled="@(_draft.Fields.Count >= RequestBoardLimits.MaximumFields)"
                                aria-describedby="request-field-limit"
                                @onclick="AddField">Add field</button>
                    </div>
                    <div class="management-field-workspace-container mt-3">
                        <div class="management-field-workspace">
                            <div class="management-field-inventory" aria-label="Submission fields">
                            @foreach (var field in _draft.Fields)
                            {
                                var selected = IsFieldSelected(field);
                                <div @key="field.Identity"
                                     class="management-field-inventory-row surface-row"
                                     data-current="@(selected ? "true" : "false")"
                                     aria-current="@(selected ? "true" : null)">
                                    <div class="min-w-0">
                                        <p id="@FieldInventoryLabelId(field)" class="text-sm font-semibold text-slate-900">@FieldDisplayName(field)</p>
                                        <p class="mt-1 break-words text-xs text-muted-foreground">@BoardFieldSummary(field)</p>
                                    </div>
                                    <button class="btn-secondary"
                                            type="button"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            aria-controls="@(selected ? FieldEditorRegionId(field) : null)"
                                            @onclick="() => SelectField(field)">
                                        @(selected ? "Editing" : "Edit field")
                                    </button>
                                </div>
                            }
                            </div>
                            @foreach (var field in _draft.Fields.Where(IsFieldSelected))
                            {
                                var index = _draft.Fields.IndexOf(field);
                                <section @key="field.Identity"
                                         id="@FieldEditorRegionId(field)"
                                         class="management-field-editor surface-muted"
                                         role="region"
                                         aria-labelledby="@FieldInventoryLabelId(field)"
                                         data-selected-field-editor>
                                    <div class="grid gap-3 md:grid-cols-2">
                                        <Field Id="@($"request-field-key-{index}")"
                                               Label="Key"
                                               FocusRequest="@FieldFocusRequest(field)"
                                               @bind-Value="field.Key" />
                                        <Field Id="@($"request-field-label-{index}")" Label="Label" @bind-Value="field.Label" />
                                        <div>
                                            <label class="mb-1 block text-sm font-semibold text-slate-950" for="@($"request-field-kind-{index}")">Type</label>
                                            <select id="@($"request-field-kind-{index}")" class="input" @bind="field.Kind">
                                                @foreach (var kind in Enum.GetValues<RequestBoardFieldKind>())
                                                {
                                                    <option value="@kind">@kind</option>
                                                }
                                            </select>
                                        </div>
                                        <Field Id="@($"request-field-limit-{index}")" Label="Maximum length" @bind-Value="field.MaximumLength" />
                                        @if (field.Kind == RequestBoardFieldKind.Choice)
                                        {
                                            <Field Id="@($"request-field-choices-{index}")" Label="Choices (comma-separated)" @bind-Value="field.Choices" />
                                        }
                                        @if (field.Kind == RequestBoardFieldKind.Number)
                                        {
                                            <Field Id="@($"request-field-min-{index}")" Label="Minimum (optional)" @bind-Value="field.MinimumNumber" />
                                            <Field Id="@($"request-field-max-{index}")" Label="Maximum (optional)" @bind-Value="field.MaximumNumber" />
                                        }
                                        <label class="control-surface inline-flex min-h-10 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium">
                                            <input type="checkbox" @bind="field.IsRequired" /> Required
                                        </label>
                                    </div>
                                    <div class="mt-4 flex flex-wrap items-center gap-3">
                                        <button class="btn-secondary"
                                                type="button"
                                                disabled="@(_draft.Fields.Count == 1)"
                                                aria-describedby="@(_draft.Fields.Count == 1 ? "request-field-minimum" : null)"
                                                @onclick="() => RemoveField(field)">Remove field</button>
                                        @if (_draft.Fields.Count == 1)
                                        {
                                            <p id="request-field-minimum" class="text-sm text-muted-foreground">A request board needs at least one field.</p>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_feedback))
                    {
                        <p class="mt-4 text-sm font-semibold" role="@(_operationFailed ? "alert" : "status")">@_feedback</p>
                    }
                </section>

                @if (_moderatorPage is not null)
                {
                    <section class="application-card-collection" data-card-owner="request-board-moderation-cards" aria-labelledby="request-moderation-list">
                        <div>
                            <h2 id="request-moderation-list" class="text-xl font-semibold text-slate-950">Moderation</h2>
                            <p class="mt-1 text-sm text-muted-foreground">@_moderatorPage.Board.OrderingDescription</p>
                        </div>
                        @if (_moderatorPage.Submissions.Count == 0)
                        {
                            <div class="card p-8 text-sm text-muted-foreground">No requests yet.</div>
                        }
                        @foreach (var submission in _moderatorPage.Submissions)
                        {
                            var draft = _moderationDrafts[submission.Public.Id];
                            <article @key="submission.Public.Id" class="card p-5">
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                    <div>
                                        <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">#@submission.Public.Id · @submission.Public.Status · @submission.PointReservationState</p>
                                        <h3 class="mt-1 text-lg font-semibold text-slate-950">@submission.Public.Title</h3>
                                        <p class="mt-1 text-sm text-muted-foreground">By @submission.Public.SubmitterLogin · @submission.Public.VoteCount votes</p>
                                    </div>
                                    @if (submission.PossibleDuplicateIds.Count > 0)
                                    {
                                        <p class="rounded-lg bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900">
                                            Possible duplicates: @string.Join(", ", submission.PossibleDuplicateIds.Select(id => $"#{id}"))
                                        </p>
                                    }
                                </div>
                                <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
                                    @foreach (var value in submission.Public.Values)
                                    {
                                        <div>
                                            <dt class="font-semibold text-slate-950">@value.Label</dt>
                                            <dd class="break-words text-muted-foreground">@value.Value</dd>
                                        </div>
                                    }
                                </dl>
                                <div class="mt-4 grid gap-3 md:grid-cols-2">
                                    <Field Id="@($"request-category-{submission.Public.Id}")" Label="Category" @bind-Value="draft.Category" />
                                    <Field Id="@($"request-tags-{submission.Public.Id}")" Label="Tags (comma-separated)" @bind-Value="draft.Tags" />
                                    <Field Id="@($"request-priority-{submission.Public.Id}")" Label="Priority (-1000 to 1000)" @bind-Value="draft.Priority" />
                                    <Field Id="@($"request-merge-{submission.Public.Id}")" Label="Merge into request ID" @bind-Value="draft.MergeTarget" />
                                    <div class="md:col-span-2">
                                        <TextAreaField Id="@($"request-public-note-{submission.Public.Id}")" Label="Public note" @bind-Value="draft.PublicNote" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <TextAreaField Id="@($"request-private-note-{submission.Public.Id}")" Label="Private moderator note" @bind-Value="draft.PrivateNote" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <TextAreaField Id="@($"request-rejection-{submission.Public.Id}")" Label="Private rejection reason" @bind-Value="draft.PrivateRejectionReason" />
                                    </div>
                                </div>
                                <div class="mt-4 flex flex-wrap gap-2">
                                    @foreach (var target in AvailableTransitions(submission.Public.Status))
                                    {
                                        <button class="btn-secondary" type="button" @onclick="() => TransitionAsync(submission.Public.Id, target)">@target</button>
                                    }
                                    <button class="btn-secondary" type="button" @onclick="() => MergeAsync(submission.Public.Id)">Merge</button>
                                </div>
                            </article>
                        }
                    </section>
                }
            </div>
        </div>
    }
    </ChildContent>
</DashboardPage>

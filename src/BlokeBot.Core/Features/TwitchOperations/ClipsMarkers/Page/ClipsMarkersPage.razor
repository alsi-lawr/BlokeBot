@page "/twitch-operations/clips-markers"
@using BlokeBot.Core.Features.Toasts
@using BlokeBot.Core.Features.TwitchOperations
@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Core.Features.TwitchOperations.ClipsMarkers
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits NativeOperationPage<ClipMarkerDashboardState>
@inject IClipMarkerDashboardOperations _clipsMarkers

<PageTitle>BlokeBot | Clips &amp; markers</PageTitle>

<DashboardPage Kicker="Native Twitch"
               Title="Clips &amp; markers"
               Description="Save a shareable clip or mark a moment to find in your stream recording later."
               Width="DashboardPageWidth.Wide"
               data-native-route="clips-markers">
    <NativeTwitchToolSwitcher HostId="@HostId" />

    @if (LoadFailed)
    {
        <PageState Kind="PageStateKind.Failure" Title="Clips and markers could not load" Description="Try again. Any earlier attempts are still saved.">
            <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
        </PageState>
    }
    else if (Loading)
    {
        <PageState Kind="PageStateKind.Loading" Title="Loading clips and markers" Description="Getting recent clips, markers, and unfinished attempts." />
    }
    else if (!NativeTwitchEnabled || State?.Authorization is ClipMarkerAuthorizationReadiness.Disabled)
    {
        <NativeTwitchUnavailable FeatureName="Clips &amp; markers" />
    }
    else if (State is not null)
    {
        @if (State.Authorization is ClipMarkerAuthorizationReadiness.NeedsBroadcasterAuthorization readiness)
        {
            <PageState Kind="PageStateKind.Unavailable" Title="Connect this channel again" Description="Reconnect to Twitch so BlokeBot can create clips and markers for this channel.">
                <Actions><AuthPopupButton Class="auth-action inline-flex h-10 items-center rounded-lg px-4 text-sm font-bold transition" Url="@readiness.ReauthorizationUrl" PopupName="blokebot-broadcaster-oauth" OpeningText="Opening..." OnClosed="LoadAsync">Reconnect to Twitch</AuthPopupButton></Actions>
            </PageState>
        }

        @if (State.Authorization is ClipMarkerAuthorizationReadiness.Ready)
        {
        <TaskPanel Title="Create a clip" Description="Save the current live moment as a clip you can share.">
            <div class="studio-grid">
                <div class="studio-span-8 flex flex-wrap items-center">
                    <label class="flex min-h-10 items-center gap-2 text-sm font-semibold text-[var(--app-text-strong)]" for="clip-has-delay">
                        <input id="clip-has-delay" type="checkbox" @bind="_clipHasDelay" />
                        Include the stream delay
                    </label>
                </div>
                <div class="studio-span-4 studio-align-end content-end">
                    <button class="btn-primary w-full" @onclick="CreateClipAsync">Create clip</button>
                </div>
            </div>
        </TaskPanel>

        <div class="settings-disclosure-stack">
            <StudioStage Key="stream-marker"
                         Number="1"
                         Title="Place a stream marker"
                         Summary="@_markerSummary"
                         Open="@IsStageOpen(ClipMarkerStage.Marker)"
                         OpenChanged="@(open => SetStage(ClipMarkerStage.Marker, open))">
                <div class="studio-grid">
                    <div class="studio-span-8">
                        <Field Id="marker-description" Label="Marker description" @bind-Value="_markerDescription" Placeholder="Moment description" />
                        <p class="mt-1 text-xs text-muted-foreground">A short private note only you and your editors see in the recording.</p>
                    </div>
                    <div class="studio-span-4">
                        <span class="label max-md:hidden" aria-hidden="true">&nbsp;</span>
                        <button class="btn-primary mt-2 w-full max-md:mt-0" @onclick="CreateMarkerAsync">Create marker</button>
                    </div>
                </div>
            </StudioStage>

            <StudioStage Key="clip-attempts"
                         Number="2"
                         Title="Clips and markers"
                         Summary="@_attemptsSummary"
                         Open="@IsStageOpen(ClipMarkerStage.Attempts)"
                         OpenChanged="@(open => SetStage(ClipMarkerStage.Attempts, open))">
                @if (State.PendingClips.Count == 0 && State.Results.Count == 0 && State.Markers.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No clip or marker attempts yet.</p>
                }
                else
                {
                    <div class="grid gap-2" data-native-history="clips-markers">
                        @foreach (var clip in State.PendingClips)
                        {
                            <NativeOperationRow @key="clip.Attempt" Title="Clip pending">
                                <ChildContent>Twitch is preparing this clip.</ChildContent>
                                <Actions>
                                    <button class="btn-secondary" @onclick="() => RetryClipAsync(clip.Attempt)">Check status</button>
                                </Actions>
                            </NativeOperationRow>
                        }
                        @foreach (var clip in State.Results)
                        {
                            <NativeOperationRow @key="clip.Attempt" Title="@($"Clip · {clip.Status}")">
                                <ChildContent>
                                    @if (clip.FinalUrl is { Length: > 0 } finalUrl)
                                    {
                                        <a class="font-semibold break-all text-blue-700 underline" href="@finalUrl" target="_blank" rel="noopener noreferrer">Open clip</a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(clip.FailureReason))
                                    {
                                        @clip.FailureReason
                                    }
                                </ChildContent>
                                <Actions>
                                    @if (clip.Status == "Ambiguous")
                                    {
                                        <button class="btn-secondary" @onclick="() => RetryClipAsync(clip.Attempt)">Check outcome</button>
                                    }
                                </Actions>
                            </NativeOperationRow>
                        }
                        @foreach (var marker in State.Markers)
                        {
                            <NativeOperationRow @key="marker.Attempt" Title="@marker.Description">
                                <ChildContent>Marker · @marker.Status@(marker.PositionSeconds > 0 ? $" · {marker.PositionSeconds} seconds" : string.Empty)</ChildContent>
                                <Actions>
                                    @if (marker.Status == "Ambiguous")
                                    {
                                        <button class="btn-secondary" @onclick="() => RetryMarkerAsync(marker.Attempt)">Check outcome</button>
                                    }
                                </Actions>
                            </NativeOperationRow>
                        }
                    </div>
                }
            </StudioStage>
        </div>
        }
    }
</DashboardPage>

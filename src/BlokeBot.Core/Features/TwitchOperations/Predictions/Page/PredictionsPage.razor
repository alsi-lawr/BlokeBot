@page "/twitch-operations/predictions"
@using BlokeBot.Core.Features.Toasts
@using BlokeBot.Core.Features.TwitchOperations
@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Core.Features.TwitchOperations.Predictions
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits NativeOperationPage<PredictionDashboardState>
@inject IPredictionDashboardOperations _predictions
@inject IJSRuntime _js

<PageTitle>BlokeBot | Predictions</PageTitle>

<DashboardPage Kicker="Native Twitch"
               Title="Predictions"
               Description="Let viewers back an outcome with Channel Points, then choose the winner or refund everyone."
               Width="DashboardPageWidth.Wide"
               data-native-route="predictions">
    <NativeTwitchToolSwitcher HostId="@HostId" />

    @if (LoadFailed)
    {
        <PageState Kind="PageStateKind.Failure" Title="Predictions could not load" Description="Try again. Your saved questions have not changed.">
            <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
        </PageState>
    }
    else if (Loading)
    {
        <PageState Kind="PageStateKind.Loading" Title="Loading Predictions" Description="Getting saved questions and the Prediction running now." />
    }
    else if (!NativeTwitchEnabled || State?.Authorization is PredictionAuthorizationReadiness.Disabled)
    {
        <NativeTwitchUnavailable FeatureName="Predictions" />
    }
    else if (State is not null)
    {
        @if (State.Authorization is PredictionAuthorizationReadiness.NeedsBroadcasterAuthorization authorization)
        {
            <PageState Kind="PageStateKind.Unavailable" Title="Connect this channel again" Description="Reconnect to Twitch so BlokeBot can run Predictions for this channel.">
                <Actions><AuthPopupButton Class="auth-action inline-flex h-10 items-center rounded-lg px-4 text-sm font-bold transition" Url="@authorization.ReauthorizationUrl" PopupName="blokebot-broadcaster-oauth" OpeningText="Opening..." OnClosed="LoadAsync">Reconnect to Twitch</AuthPopupButton></Actions>
            </PageState>
        }
        else if (State.Authorization is PredictionAuthorizationReadiness.Ineligible ineligible)
        {
            <PageState Kind="PageStateKind.Unavailable" Title="Predictions are unavailable" Description="@ineligible.Message" />
        }
        else if (State.Authorization is PredictionAuthorizationReadiness.Unavailable unavailable)
        {
            <PageState Kind="PageStateKind.Failure" Title="Predictions are not available right now" Description="Wait a moment, then reload this page before starting anything new.">
                <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
            </PageState>
        }
        else
        {
            <TaskPanel Title="Run a Prediction" Description="Start a saved question, close entries, choose the winner, or refund everyone.">
                @if (State.ActivePrediction is { } prediction)
                {
                    <article class="surface-row rounded-lg p-4" data-active-prediction>
                        <div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><strong>@prediction.Title</strong><p class="mt-1 text-sm text-muted-foreground">@prediction.Status@if (prediction.IsExternallyStarted) { <text> · Started in Twitch</text> }</p></div><div class="flex flex-wrap gap-2">@if (prediction.Status == "Active") { <button class="btn-secondary" @onclick="LockPredictionAsync">Lock</button> }<button class="btn-secondary" @onclick="CancelPredictionAsync">Cancel &amp; refund</button></div></div>
                        <div class="mt-4 grid gap-2">
                            @foreach (var outcome in prediction.Outcomes)
                            {
                                <div class="surface-muted flex flex-wrap items-center justify-between gap-3 rounded-md p-3" @key="outcome.Id"><div><strong>@outcome.Title</strong><p class="mt-1 text-sm text-muted-foreground">@outcome.Users viewers · @outcome.ChannelPoints Channel Points</p></div>@if (prediction.Status == "Locked") { <button class="btn-primary" @onclick="() => ResolvePredictionAsync(outcome.Id)">Resolve as winner</button> }</div>
                            }
                        </div>
                    </article>
                }
                else if (State.Templates.Count == 0)
                {
                    <PageState Kind="PageStateKind.Empty" Title="No Prediction templates yet" Description="Save a template below, then return here to start it." />
                }
                else
                {
                    <div class="phone-card-list" data-prediction-templates>
                        @foreach (var template in State.Templates)
                        {
                            <article class="surface-row rounded-lg p-4" @key="template.Id"><div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><strong>@template.Title</strong><p class="mt-1 text-sm text-muted-foreground">@string.Join(" · ", template.Outcomes) · @template.PredictionWindowSeconds seconds</p></div><button class="btn-primary" @onclick="() => StartPredictionAsync(template.Id)">Start Prediction</button></div></article>
                        }
                    </div>
                }
            </TaskPanel>

            <ApplicationCardCollection Owner="native-dashboard-disclosure-cards">
            <CollapsibleSection Title="New Prediction template" Description="Save a question and possible outcomes to reuse later." InitiallyOpen="@(State.Templates.Count == 0)">
                <div class="form-grid p-4">
                    <Field Id="prediction-title" Label="Question" @bind-Value="_title" Placeholder="Will we win?" />
                    <Field Id="prediction-outcomes" Label="Outcomes (one per line)" @bind-Value="_outcomes" Placeholder="Yes&#10;No" />
                    <Field Id="prediction-window" Label="Entry window in seconds" @bind-Value="_window" Placeholder="60" />
                    <div class="self-end"><button class="btn-primary" @onclick="SaveTemplateAsync">Save template</button></div>
                </div>
                @if (State.Templates.Count > 0)
                {
                    <div class="border-t border-slate-200 p-4"><div class="phone-card-list">@foreach (var template in State.Templates) { <article class="surface-row flex flex-wrap items-center justify-between gap-3 rounded-lg p-3" @key="template.Id"><span class="text-sm font-semibold text-slate-950">@template.Title</span><button class="btn-secondary" @onclick="() => DeleteTemplateAsync(template.Id)">Delete template</button></article> }</div></div>
                }
            </CollapsibleSection>

            <CollapsibleSection Title="Recent results" Description="Review Predictions that paid a winner or refunded viewers." InitiallyOpen="false">
                <div class="p-4">
                    @if (State.Results.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground">No Prediction results yet.</p>
                    }
                    else
                    {
                        <div class="phone-card-list" data-native-history="predictions">
                            @foreach (var result in State.Results)
                            {
                                <article class="surface-row rounded-lg p-4" @key="result.ProviderPredictionId"><div class="flex flex-wrap items-start justify-between gap-2"><strong>@result.Title</strong><span class="text-sm text-muted-foreground">@result.Status</span></div><div class="mt-3 grid gap-1 text-sm">@foreach (var outcome in result.Outcomes) { <p @key="outcome.Id"><strong>@outcome.Title</strong>: @outcome.Users viewers · @outcome.ChannelPoints Channel Points</p> }</div></article>
                            }
                        </div>
                    }
                </div>
            </CollapsibleSection>
            </ApplicationCardCollection>
        }
    }
</DashboardPage>

@page "/twitch-operations/predictions"
@using BlokeBot.Core.Features.Toasts
@using BlokeBot.Core.Features.TwitchOperations
@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Core.Features.TwitchOperations.Predictions
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits NativeOperationPage<PredictionDashboardState>
@inject IPredictionDashboardOperations _predictions
@inject IJSRuntime _js

<PageTitle>BlokeBot | Predictions</PageTitle>

<DashboardPage Kicker="Native Twitch"
               Title="Predictions"
               Description="Let viewers back an outcome with Channel Points, then choose the winner or refund everyone."
               Width="DashboardPageWidth.Wide"
               data-native-route="predictions">
    <NativeTwitchToolSwitcher HostId="@HostId" />

    @if (LoadFailed)
    {
        <PageState Kind="PageStateKind.Failure" Title="Predictions could not load" >
            <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
        </PageState>
    }
    else if (Loading)
    {
        <PageState Kind="PageStateKind.Loading" Title="Loading Predictions" Description="Getting saved questions and the Prediction running now." />
    }
    else if (!NativeTwitchEnabled || State?.Authorization is PredictionAuthorizationReadiness.Disabled)
    {
        <NativeTwitchUnavailable FeatureName="Predictions" />
    }
    else if (State is not null)
    {
        @if (State.Authorization is PredictionAuthorizationReadiness.NeedsBroadcasterAuthorization authorization)
        {
            <PageState Kind="PageStateKind.Unavailable" Title="Connect this channel again" Description="Reconnect to Twitch so BlokeBot can run Predictions for this channel.">
                <Actions><AuthPopupButton Class="auth-action inline-flex h-10 items-center rounded-lg px-4 text-sm font-bold transition" Url="@authorization.ReauthorizationUrl" PopupName="blokebot-broadcaster-oauth" OpeningText="Opening..." OnClosed="LoadAsync">Reconnect to Twitch</AuthPopupButton></Actions>
            </PageState>
        }
        else if (State.Authorization is PredictionAuthorizationReadiness.Ineligible ineligible)
        {
            <PageState Kind="PageStateKind.Unavailable" Title="Predictions are unavailable" Description="@ineligible.Message" />
        }
        else if (State.Authorization is PredictionAuthorizationReadiness.Unavailable unavailable)
        {
            <PageState Kind="PageStateKind.Failure" Title="Predictions are not available right now" Description="Wait a moment, then reload this page before starting anything new.">
                <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
            </PageState>
        }
        else
        {
            <TaskPanel Title="Run a Prediction" Description="Start a saved question, close entries, choose the winner, or refund everyone.">
                @if (State.ActivePrediction is { } prediction)
                {
                    <div data-active-prediction>
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0">
                                <strong class="text-[var(--app-text-strong)]">@prediction.Title</strong>
                                <p class="mt-1 mb-3 text-sm text-muted-foreground">@prediction.Status@(prediction.IsExternallyStarted ? " · Started in Twitch" : string.Empty)</p>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                @if (prediction.Status == "Active")
                                {
                                    <button class="btn-secondary" @onclick="LockPredictionAsync">Lock</button>
                                }
                                <button class="btn-secondary" @onclick="CancelPredictionAsync">Cancel &amp; refund</button>
                            </div>
                        </div>
                        <div class="grid gap-2">
                            @foreach (var outcome in prediction.Outcomes)
                            {
                                <NativeOperationRow @key="outcome.Id" Title="@outcome.Title">
                                    <ChildContent>@outcome.Users viewers · @outcome.ChannelPoints Channel Points</ChildContent>
                                    <Actions>
                                        @if (prediction.Status == "Locked")
                                        {
                                            <button class="btn-primary" @onclick="() => ResolvePredictionAsync(outcome.Id)">Resolve as winner</button>
                                        }
                                    </Actions>
                                </NativeOperationRow>
                            }
                        </div>
                    </div>
                }
                else if (State.Templates.Count == 0)
                {
                    <PageState Kind="PageStateKind.Empty" Title="No Prediction templates yet" Description="Save a template below, then return here to start it." />
                }
                else
                {
                    <div class="grid gap-2" data-prediction-templates>
                        @foreach (var template in State.Templates)
                        {
                            <NativeOperationRow @key="template.Id" Title="@template.Title">
                                <ChildContent>@string.Join(" · ", template.Outcomes) · @DurationProse.Format(template.PredictionWindowSeconds)</ChildContent>
                                <Actions>
                                    <button class="btn-primary" @onclick="() => StartPredictionAsync(template.Id)">Start Prediction</button>
                                </Actions>
                            </NativeOperationRow>
                        }
                    </div>
                }
            </TaskPanel>

            <div class="settings-disclosure-stack">
                <StudioStage Key="prediction-template"
                             data-sticky-save-scope
                             Number="1"
                             Title="New Prediction template"
                             Summary="@_editorSummary"
                             Open="@_openStages.IsOpen(PredictionStage.Template)"
                             OpenChanged="@(open => _openStages.Set(PredictionStage.Template, open))">
                    <div class="studio-grid">
                        <div class="studio-span-8">
                            <Field Id="prediction-title" Label="Question" @bind-Value="_title" Placeholder="Will we win?" MaxLength="45" />
                            <p class="mt-1 text-xs text-muted-foreground">Up to 45 characters. Viewers see this at the top of the Prediction.</p>
                        </div>
                        <div class="studio-span-4 space-y-2">
                            <span class="label">Entries stay open for</span>
                            <StudioSegmentedPill TValue="int"
                                                 AriaLabel="Entries stay open for"
                                                 Options="_windowOptions"
                                                 Value="_windowChoice"
                                                 ValueChanged="SetWindowChoice"
                                                 Wrap />
                            @if (_windowChoice == 0)
                            {
                                <Field Id="prediction-window" Label="Custom entry window in seconds" @bind-Value="_window" Placeholder="60" />
                            }
                            <p class="text-xs text-muted-foreground">Custom accepts 30–1800 seconds.</p>
                        </div>
                        <div class="studio-span-12 space-y-2">
                            <span class="label">Outcomes</span>
                            @for (var index = 0; index < _outcomes.Count; index++)
                            {
                                var outcomeIndex = index;
                                <div class="flex items-center gap-[0.6rem]" @key="outcomeIndex" data-prediction-outcome-row>
                                    <input class="input flex-1"
                                           maxlength="25"
                                           aria-label="@($"Outcome {outcomeIndex + 1}")"
                                           value="@_outcomes[outcomeIndex]"
                                           @oninput="args => _outcomes[outcomeIndex] = args.Value?.ToString() ?? string.Empty" />
                                    <span class="min-w-[3.2em] text-right text-[0.72rem] text-muted-foreground">@($"{_outcomes[outcomeIndex].Length}/25")</span>
                                    <button type="button"
                                            class="cursor-pointer rounded-md px-[0.4rem] py-[0.2rem] font-bold text-[var(--app-text-muted)] hover:bg-[var(--app-control-hover)] hover:text-red-700"
                                            aria-label="Remove outcome"
                                            disabled="@(_outcomes.Count <= 2)"
                                            @onclick="() => _outcomes.RemoveAt(outcomeIndex)">✕</button>
                                </div>
                            }
                            <button type="button"
                                    class="btn-secondary"
                                    disabled="@(_outcomes.Count >= 10)"
                                    @onclick="@(() => _outcomes.Add(string.Empty))">+ Add outcome</button>
                            <p class="text-xs text-muted-foreground">2–10 outcomes, up to 25 characters each. Viewers back exactly one.</p>
                        </div>
                    </div>
                    <StickySaveRegion Scope="StickySaveScope.Editor" class="mt-4">
                        <button class="btn-primary" @onclick="SaveTemplateAsync">Save template</button>
                    </StickySaveRegion>
                    @if (State.Templates.Count > 0)
                    {
                        <div class="mt-4 grid gap-2 border-t border-[var(--app-border)] pt-4">
                            @foreach (var template in State.Templates)
                            {
                                <NativeOperationRow @key="template.Id" Title="@template.Title">
                                    <Actions>
                                        <button class="btn-secondary" @onclick="() => DeleteTemplateAsync(template.Id)">Delete template</button>
                                    </Actions>
                                </NativeOperationRow>
                            }
                        </div>
                    }
                </StudioStage>

                <StudioStage Key="prediction-results"
                             Number="2"
                             Title="Recent results"
                             Summary="@_resultsSummary"
                             Open="@_openStages.IsOpen(PredictionStage.Results)"
                             OpenChanged="@(open => _openStages.Set(PredictionStage.Results, open))">
                    @if (State.Results.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground">No Prediction results yet.</p>
                    }
                    else
                    {
                        <div class="grid gap-2" data-native-history="predictions">
                            @foreach (var result in State.Results)
                            {
                                <NativeOperationRow @key="result.ProviderPredictionId" Title="@result.Title" When="@result.Status">
                                    @foreach (var outcome in result.Outcomes)
                                    {
                                        <span class="block" @key="outcome.Id"><b class="text-[var(--app-text-strong)]">@outcome.Title</b>: @outcome.Users viewers · @outcome.ChannelPoints Channel Points</span>
                                    }
                                </NativeOperationRow>
                            }
                        </div>
                    }
                </StudioStage>
            </div>
        }
    }
</DashboardPage>

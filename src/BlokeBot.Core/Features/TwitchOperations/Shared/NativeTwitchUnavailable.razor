<PageState Kind="PageStateKind.Unavailable"
           Title="@($"{FeatureName} is turned off")"
           Description="@($"Turn {FeatureName} on in Channel setup to use this page. Your saved configuration and history will still be here; suppressed work is not replayed when you turn it back on.")">
    <Actions>
        <a class="btn-primary" href="/host#chat-tools">Open Channel setup</a>
    </Actions>
</PageState>

@code {
    [Parameter, EditorRequired]
    public required string FeatureName { get; set; }
}

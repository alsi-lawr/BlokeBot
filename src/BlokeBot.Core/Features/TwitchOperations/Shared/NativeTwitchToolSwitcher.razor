<nav class="native-tool-switcher" aria-label="Native Twitch tools">
    @if (_shoutouts)
    {
    <NavLink class="native-tool-switcher__link" ActiveClass="native-tool-switcher__link--current" Match="NavLinkMatch.All" href="twitch-operations/shoutouts">Shoutouts</NavLink>
    }
    @if (_polls)
    {
    <NavLink class="native-tool-switcher__link" ActiveClass="native-tool-switcher__link--current" Match="NavLinkMatch.All" href="twitch-operations/polls">Polls</NavLink>
    }
    @if (_clips)
    {
    <NavLink class="native-tool-switcher__link" ActiveClass="native-tool-switcher__link--current" Match="NavLinkMatch.All" href="twitch-operations/clips-markers">Clips &amp; markers</NavLink>
    }
    @if (_rewards)
    {
    <NavLink class="native-tool-switcher__link" ActiveClass="native-tool-switcher__link--current" Match="NavLinkMatch.All" href="twitch-operations/channel-points">Rewards &amp; redemptions</NavLink>
    }
    @if (_predictions)
    {
    <NavLink class="native-tool-switcher__link" ActiveClass="native-tool-switcher__link--current" Match="NavLinkMatch.All" href="twitch-operations/predictions">Predictions</NavLink>
    }
</nav>

<article class="flex flex-wrap items-center gap-x-[0.8rem] gap-y-2 rounded-[10px] border border-[var(--app-control-border)] bg-[var(--app-control-bg)] px-[0.9rem] py-[0.7rem]"
         @attributes="AdditionalAttributes">
    <span class="min-w-0">
        <strong class="text-[var(--app-text-strong)]">@Title</strong>
        @if (ChildContent is not null)
        {
            <span class="mt-[0.15rem] block text-[0.8rem] text-muted-foreground">@ChildContent</span>
        }
    </span>
    @if (When is { Length: > 0 } || Actions is not null)
    {
        <span class="ml-auto flex flex-wrap items-center justify-end gap-2">
            @if (When is { Length: > 0 })
            {
                <span class="text-[0.76rem] text-muted-foreground">@When</span>
            }
            @Actions
        </span>
    }
</article>

@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Persistence.Models
@using BlokeBot.Eventing
@inject AutomaticRaidShoutoutConfigurationService _configuration
@inject EventBus<AppEventKind> _events

<StudioStage Key="automatic-raid"
             data-sticky-save-scope
             Number="1"
             Title="Automatic raid shoutouts"
             Summary="@_settingsSummary"
             Open="@_settingsOpen"
             OpenChanged="@(open => _settingsOpen = open)">
    <div data-automatic-raid-shoutouts>
        @if (_loading)
        {
            <p class="text-sm text-muted-foreground" role="status">Loading automatic raid shoutouts.</p>
        }
        else if (_loadError is not null)
        {
            <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
                <strong>Automatic raid shoutouts are unavailable.</strong>
                <p class="mt-1">@_loadError</p>
            </div>
        }
        else
        {
            <div class="studio-grid">
                <div class="studio-span-12 flex flex-wrap items-center gap-3">
                    <button type="button"
                            id="automatic-raid-enabled"
                            class="studio-toggle"
                            role="switch"
                            aria-checked="@(_draft.Enabled ? "true" : "false")"
                            aria-label="Automatic raid shoutouts"
                            @onclick="ToggleEnabled"></button>
                    <span class="text-sm font-semibold text-[var(--app-text-strong)]">Welcome qualifying incoming raids automatically</span>
                    <span class="text-xs text-muted-foreground">Off keeps every setting saved; raids just stop triggering.</span>
                </div>

                <div class="studio-span-4">
                    <label class="label" for="automatic-raid-minimum-viewers">Minimum raid size</label>
                    <input id="automatic-raid-minimum-viewers"
                           class="input mt-2"
                           type="number"
                           min="1"
                           value="@_draft.MinimumViewerCount"
                           disabled="@(!_draft.Enabled)"
                           aria-describedby="@FieldDescription(AutomaticRaidShoutoutValidationField.MinimumViewerCount)"
                           aria-invalid="@HasError(AutomaticRaidShoutoutValidationField.MinimumViewerCount)"
                           @oninput="SetMinimumViewerCount" />
                    <p class="mt-1 text-xs text-muted-foreground">Raids below this many viewers are ignored.</p>
                    @if (ErrorFor(AutomaticRaidShoutoutValidationField.MinimumViewerCount) is { } thresholdError)
                    {
                        <p id="automatic-raid-minimum-viewers-error" class="mt-1 text-sm font-semibold text-red-700" role="alert">@thresholdError</p>
                    }
                </div>

                <div class="studio-span-12 space-y-2">
                    <span class="label">How the shoutout is sent</span>
                    <StudioChoiceCards id="automatic-raid-mechanism"
                                       AriaLabel="How the shoutout is sent"
                                       Columns="StudioChoiceCardsColumns.Two">
                        <StudioChoiceCard data-mechanism="native"
                                          disabled="@(!_draft.Enabled)"
                                          Icon="📣"
                                          Title="Native Twitch shoutout"
                                          Description="Twitch's own shoutout panel. Skipped silently if Twitch's cooldown is still active, never downgraded to chat."
                                          Pressed="@(_draft.Mechanism == AutomaticRaidShoutoutMechanism.Native)"
                                          Select="@(() => SetMechanism(AutomaticRaidShoutoutMechanism.Native))" />
                        <StudioChoiceCard data-mechanism="chat"
                                          disabled="@(!_draft.Enabled)"
                                          Icon="💬"
                                          Title="Chat message"
                                          Description="BlokeBot writes a message you compose: regular, pinned, or as an announcement."
                                          Pressed="@(_draft.Mechanism == AutomaticRaidShoutoutMechanism.Chat)"
                                          Select="@(() => SetMechanism(AutomaticRaidShoutoutMechanism.Chat))" />
                    </StudioChoiceCards>
                </div>
            </div>

            @if (_draft.Mechanism == AutomaticRaidShoutoutMechanism.Chat)
            {
                <div class="studio-grid mt-4" data-automatic-raid-chat-controls>
                    <div class="studio-span-12 space-y-2">
                        <span class="label">Chat presentation</span>
                        <StudioSegmentedPill TValue="AutomaticRaidChatPresentation"
                                             AriaLabel="Chat presentation"
                                             Options="_presentationOptions"
                                             Value="_draft.ChatPresentation"
                                             ValueChanged="SetPresentation"
                                             Disabled="@(!_draft.Enabled)" />
                    </div>

                    @if (_draft.ChatPresentation == AutomaticRaidChatPresentation.Pinned)
                    {
                        <div class="studio-span-4">
                            <label class="label" for="automatic-raid-pin-duration">Pin duration in seconds</label>
                            <input id="automatic-raid-pin-duration"
                                   class="input mt-2"
                                   type="number"
                                   min="30"
                                   max="1800"
                                   value="@_pinDurationValue"
                                   disabled="@(!_draft.Enabled || _pinUntilStreamEnd)"
                                   aria-describedby="@FieldDescription(AutomaticRaidShoutoutValidationField.PinDuration)"
                                   aria-invalid="@HasError(AutomaticRaidShoutoutValidationField.PinDuration)"
                                   @oninput="SetPinDuration" />
                            <p class="mt-1 text-xs text-muted-foreground">30–1800 seconds.</p>
                            @if (ErrorFor(AutomaticRaidShoutoutValidationField.PinDuration) is { } pinError)
                            {
                                <p id="automatic-raid-pin-duration-error" class="mt-1 text-sm font-semibold text-red-700" role="alert">@pinError</p>
                            }
                        </div>
                        <div class="studio-span-8">
                            <span class="label max-md:hidden" aria-hidden="true">&nbsp;</span>
                            <div class="mt-2 flex min-h-10 flex-wrap items-center gap-3 max-md:mt-0">
                                <button type="button"
                                        id="automatic-raid-pin-until-end"
                                        class="studio-toggle"
                                        role="switch"
                                        aria-checked="@(_pinUntilStreamEnd ? "true" : "false")"
                                        aria-label="Keep pinned until stream end"
                                        disabled="@(!_draft.Enabled)"
                                        @onclick="TogglePinUntilStreamEnd"></button>
                                <span class="text-sm font-semibold text-[var(--app-text-strong)]">Keep pinned until stream end</span>
                            </div>
                        </div>
                    }
                    else if (_draft.ChatPresentation == AutomaticRaidChatPresentation.Announcement)
                    {
                        <div class="studio-span-4">
                            <label class="label" for="automatic-raid-announcement-color">Announcement color</label>
                            <select id="automatic-raid-announcement-color"
                                    class="input mt-2"
                                    value="@_draft.AnnouncementColor"
                                    disabled="@(!_draft.Enabled)"
                                    aria-describedby="@FieldDescription(AutomaticRaidShoutoutValidationField.AnnouncementColor)"
                                    aria-invalid="@HasError(AutomaticRaidShoutoutValidationField.AnnouncementColor)"
                                    @onchange="SetAnnouncementColor">
                                @foreach (var color in _announcementColors)
                                {
                                    <option value="@color">@AnnouncementColorLabel(color)</option>
                                }
                            </select>
                            <p class="mt-1 text-xs text-muted-foreground">If the announcement fails, no regular message is sent instead.</p>
                            @if (ErrorFor(AutomaticRaidShoutoutValidationField.AnnouncementColor) is { } colorError)
                            {
                                <p id="automatic-raid-announcement-color-error" class="mt-1 text-sm font-semibold text-red-700" role="alert">@colorError</p>
                            }
                        </div>
                    }

                    <div class="studio-span-12">
                        <label class="label" for="automatic-raid-message-template">Message</label>
                        <textarea id="automatic-raid-message-template"
                                  class="input mt-2 min-h-28 resize-y"
                                  value="@_draft.MessageTemplate"
                                  disabled="@(!_draft.Enabled)"
                                  aria-describedby="automatic-raid-template-guidance automatic-raid-template-budget automatic-raid-message-template-error"
                                  aria-invalid="@HasError(AutomaticRaidShoutoutValidationField.MessageTemplate)"
                                  @oninput="SetMessageTemplate"></textarea>
                        <div class="studio-chips flex flex-wrap items-center gap-[0.45rem] mt-2">
                            <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.78rem] font-semibold text-[var(--app-text-strong)]"><span>{twitch_handle}</span></span>
                            <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.78rem] font-semibold text-[var(--app-text-strong)]"><span>{display_name}</span></span>
                            <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.78rem] font-semibold text-[var(--app-text-strong)]"><span>{channel_url}</span></span>
                            <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.78rem] font-semibold text-[var(--app-text-strong)]"><span>{last_game|fallback}</span></span>
                            <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.78rem] font-semibold text-[var(--app-text-strong)]"><span>{stream_title|fallback}</span></span>
                            <span class="studio-chip inline-flex items-center gap-[0.4rem] rounded-full border border-[var(--app-control-border)] bg-[var(--app-surface-solid)] px-3 py-[0.28rem] font-mono text-[0.78rem] font-semibold text-[var(--app-text-strong)]"><span>{viewer_count}</span></span>
                        </div>
                        <p id="automatic-raid-template-guidance" class="form-help mt-2">
                            Use the tokens above anywhere in the message. Last game and stream title require a non-empty inline fallback, written as <span class="font-mono">{last_game|fallback}</span>.
                        </p>
                        <p id="automatic-raid-template-budget" class="form-help">
                            Write up to 150 characters of text and fallbacks. BlokeBot reserves 350 characters for live values, for a 500-character rendered limit. Messages are never silently shortened.
                            @if (_authoredCharacters is { } used)
                            {
                                <b class="text-[var(--app-text-strong)]">@used/@AutomaticRaidShoutoutTemplate.MaximumAuthoredCharacters used.</b>
                            }
                        </p>
                        @if (ErrorFor(AutomaticRaidShoutoutValidationField.MessageTemplate) is { } templateError)
                        {
                            <p id="automatic-raid-message-template-error" class="mt-1 text-sm font-semibold text-red-700" role="alert">@templateError</p>
                        }
                    </div>
                </div>

                <div class="mt-4" aria-live="polite" data-automatic-raid-preview>
                    @if (_previewError is not null)
                    {
                        <p class="text-sm font-semibold text-red-700" role="alert">@_previewError</p>
                    }
                    else
                    {
                        <StudioChatPreview Lines="PreviewLines()" />
                        @if (_previewUsesFallback)
                        {
                            <p class="mt-1 text-xs text-muted-foreground">Preview uses the inline fallback because Twitch may not supply the last game.</p>
                        }
                    }
                </div>
            }

            <div class="mt-4 rounded-[14px] border border-[var(--app-border)] bg-[var(--app-surface-muted)] px-[1.05rem] py-[0.85rem] text-sm" aria-live="polite" data-automatic-raid-readiness>
                <strong class="text-[var(--app-text-strong)]">Before a shoutout is sent</strong>
                <p class="mt-1 text-muted-foreground">@_readinessText</p>
            </div>

            @if (_validationErrors.Count > 0)
            {
                <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"
                     role="alert"
                     aria-labelledby="automatic-raid-validation-title"
                     data-automatic-raid-validation>
                    <strong id="automatic-raid-validation-title">Check these automatic shoutout settings</strong>
                    <ul class="mt-2 list-disc space-y-1 pl-5">
                        @foreach (var error in _validationErrors)
                        {
                            <li>@error.Message</li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-4 flex flex-wrap items-center gap-3">
                <StickySaveRegion Scope="StickySaveScope.Editor">
                    <button type="button"
                            class="btn-primary"
                            disabled="@_saving"
                            @onclick="SaveAsync">
                        @(_saving ? "Saving…" : "Save automatic shoutouts")
                    </button>
                </StickySaveRegion>
                <span class="text-sm text-muted-foreground" role="status" aria-live="polite">@_saveStatus</span>
            </div>
        }
    </div>
</StudioStage>

<StudioStage Key="automatic-raid-outcomes"
             Number="2"
             Title="Automatic shoutout outcomes"
             Summary="@_outcomesSummary"
             Open="@_outcomesOpen"
             OpenChanged="@(open => _outcomesOpen = open)">
    @if (_outcomes.Count == 0)
    {
        <p class="text-sm text-muted-foreground" data-automatic-raid-outcomes>No automatic raid shoutouts recorded yet.</p>
    }
    else
    {
        <div class="grid gap-2" data-automatic-raid-outcomes>
            @foreach (var outcome in _outcomes)
            {
                <NativeOperationRow @key="outcome.Id"
                                    Title="@($"@{outcome.SourceLogin} · {outcome.ViewerCount} viewers")"
                                    When="@outcome.MessageTimestamp.ToLocalTime().ToString("MMM d, HH:mm")">
                    <span class="@OutcomePillClass(outcome)"><span class="status-pill__label">@OutcomeTitle(outcome)</span></span>
                    <span class="mt-1 block">@OutcomeDescription(outcome)</span>
                </NativeOperationRow>
            }
        </div>
    }
</StudioStage>

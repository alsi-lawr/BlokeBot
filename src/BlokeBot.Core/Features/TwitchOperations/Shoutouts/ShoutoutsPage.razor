@page "/twitch-operations/shoutouts"
@using BlokeBot.Core.Features.Toasts
@using BlokeBot.Core.Features.TwitchOperations
@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Core.Features.TwitchOperations.Shoutouts
@using BlokeBot.Core.Features.TwitchOperations.Shoutouts.AutomaticRaids
@using BlokeBot.Eventing
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject ShoutoutService _shoutouts
@inject ToastService _toasts
@inject NativeTwitchFeatureGate _nativeTwitch
@inject EventBus<AppEventKind> _events

<PageTitle>BlokeBot | Shoutouts</PageTitle>

<div class="dashboard-page dashboard-page--readable app-motion-stack" data-native-route="shoutouts">
    <PageHeader Kicker="Native Twitch" Title="Shoutouts" Description="Send a native Twitch shoutout and see Twitch-provided cooldowns." />
    <NativeTwitchToolSwitcher />

    @if (_loadFailed)
    {
        <PageState Kind="PageStateKind.Failure" Title="Shoutouts could not load" Description="BlokeBot couldn’t load shoutouts for this channel.">
            <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
        </PageState>
    }
    else if (_loading)
    {
        <PageState Kind="PageStateKind.Loading" Title="Loading shoutouts" Description="Checking cooldowns and recent activity." />
    }
    else if (!_nativeTwitchEnabled)
    {
        <NativeTwitchUnavailable />
    }
    else if (_state is not null)
    {
        <TaskPanel Title="Send a shoutout" Description="Choose a live channel with viewers. Twitch applies global and same-channel cooldowns.">
            <div class="field-row native-primary-row">
                <Field Id="shoutout-target" Label="Target channel" @bind-Value="_targetLogin" Placeholder="channel login" />
                <button class="btn-primary" @onclick="SendAsync">Send shoutout</button>
            </div>
            <p class="form-help mt-4">@_cooldownText</p>
        </TaskPanel>

        <AutomaticRaidShoutoutSection HostId="HostId"
                                      RunHostMutationAsync="RunAutomaticRaidMutationAsync" />

        <CollapsibleSection Title="Recent shoutouts" Description="Sent and received shoutouts for this channel." InitiallyOpen="false">
            <div class="p-4">
                @if (_state.History.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No shoutouts recorded yet.</p>
                }
                else
                {
                    <div class="phone-card-list" data-native-history="shoutouts">
                        @foreach (var item in _state.History)
                        {
                            <article class="surface-row rounded-lg p-4" @key="item">
                                <div class="flex flex-wrap items-start justify-between gap-2">
                                    <strong class="text-slate-950">@item.Direction · @item.TargetLogin</strong>
                                    <span class="text-xs text-muted-foreground">@item.OccurredAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                </div>
                                <p class="mt-2 text-sm text-muted-foreground">@item.ViewerCount viewers</p>
                            </article>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>
    }
</div>

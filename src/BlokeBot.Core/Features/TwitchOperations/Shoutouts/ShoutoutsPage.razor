@page "/twitch-operations/shoutouts"
@using BlokeBot.Core.Features.Toasts
@using BlokeBot.Core.Features.TwitchOperations
@using BlokeBot.Core.Features.TwitchOperations.Shared
@using BlokeBot.Core.Features.TwitchOperations.Shoutouts
@using BlokeBot.Core.Features.TwitchOperations.Shoutouts.AutomaticRaids
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits NativeOperationPage<ShoutoutDashboardState>
@inject IShoutoutDashboardOperations _shoutouts

<PageTitle>BlokeBot | Shoutouts</PageTitle>

<DashboardPage Kicker="Native Twitch"
               Title="Shoutouts"
               Description="Recommend another live channel to your viewers, or welcome incoming raids automatically."
               Width="DashboardPageWidth.Wide"
               data-native-route="shoutouts">
    <NativeTwitchToolSwitcher HostId="@HostId" />

    @if (LoadFailed)
    {
        <PageState Kind="PageStateKind.Failure" Title="Shoutouts could not load" Description="Try again. Nothing was sent or changed.">
            <Actions><button type="button" class="btn-primary" @onclick="LoadAsync">Retry</button></Actions>
        </PageState>
    }
    else if (Loading)
    {
        <PageState Kind="PageStateKind.Loading" Title="Loading shoutouts" Description="Getting recent shoutouts and the next available send time." />
    }
    else if (!NativeTwitchEnabled)
    {
        <NativeTwitchUnavailable FeatureName="Shoutouts" />
    }
    else if (State is not null)
    {
        <TaskPanel Title="Send a shoutout" Description="Enter the Twitch name of another channel that is live with viewers.">
            <div class="studio-grid">
                <div class="studio-span-8">
                    <Field Id="shoutout-target" Label="Target channel" @bind-Value="_targetLogin" Placeholder="channel login" />
                </div>
                <div class="studio-span-4 content-end">
                    <button class="btn-primary w-full" type="button" @onclick="SendAsync">Send shoutout</button>
                </div>
                <div class="studio-span-12"><p class="form-help">@_cooldownText</p></div>
            </div>
        </TaskPanel>

        <div class="settings-disclosure-stack">
            <AutomaticRaidShoutoutSection HostId="HostId"
                                          RunHostMutationAsync="RunAutomaticRaidMutationAsync" />

            <StudioStage Key="recent-shoutouts"
                         Number="3"
                         Title="Recent shoutouts"
                         Summary="@_historySummary"
                         Open="@_historyOpen"
                         OpenChanged="@(open => _historyOpen = open)">
                @if (State.History.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No shoutouts recorded yet.</p>
                }
                else
                {
                    <div class="grid gap-2" data-native-history="shoutouts">
                        @foreach (var item in State.History)
                        {
                            <NativeOperationRow @key="item"
                                                Title="@($"{item.Direction} · @{item.TargetLogin}")"
                                                When="@item.OccurredAtUtc.ToLocalTime().ToString("MMM d, HH:mm")">
                                @item.ViewerCount viewers
                            </NativeOperationRow>
                        }
                    </div>
                }
            </StudioStage>
        </div>
    }
</DashboardPage>

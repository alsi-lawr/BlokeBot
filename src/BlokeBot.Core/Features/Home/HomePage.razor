@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>BlokeBot | Overview</PageTitle>

<DashboardPage Kicker="Overview"
               Title="Run your channel with BlokeBot"
               Description="See the selected channel’s next setup action and keep the bot ready for stream.">
    <ChildContent>
        <AuthorizeView>
            <Authorized Context="homeAuth">
                @{
                    var selectedChannel = AuthenticatedSession
                        .FromPrincipal(homeAuth.User)
                        .State.Match<string?>(
                            _ => null,
                            selected => selected.Selection.Current.Login,
                            _ => null
                        );
                }
                @if (string.IsNullOrWhiteSpace(selectedChannel))
                {
                    <PageState Kind="DashboardPageState.Unavailable"
                               Title="Choose a channel"
                               Description="Choose a channel from the top bar before setting it up." />
                }
                else
                {
                    <TaskPanel Title="@($"#{selectedChannel} readiness")"
                               Description="Channel setup shows the current connection and bot action for this channel.">
                        <a class="btn-primary" href="/host">Open Channel setup</a>
                    </TaskPanel>
                }

                <CollapsibleSection Title="Public leaderboard"
                                    Description="Open a public guessing or points leaderboard for a Twitch channel."
                                    InitiallyOpen="false"
                                    PreferenceKey="overview-public-leaderboard">
                    <PublicLeaderboardPrompt ContainerClass="p-4" InitialChannel="@selectedChannel" />
                </CollapsibleSection>
            </Authorized>
        </AuthorizeView>
    </ChildContent>
</DashboardPage>

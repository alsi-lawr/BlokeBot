@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>BlokeBot | Home</PageTitle>

<div class="home-page app-motion-stack mx-auto max-w-5xl space-y-6">
    <PageHeader Kicker="Home"
                Title="BlokeBot"
                Description="Run Twitch chat games and points from one place. Set up your channel, choose the tools you want, and let the bot handle chat during stream." />

    <ApplicationCardCollection Owner="home-card-collection">
    <AuthorizeView>
        <Authorized Context="homeAuth">
            @{
                var selectedChannel = AuthenticatedSession
                    .FromPrincipal(homeAuth.User)
                    .State.Match<string?>(
                        _ => null,
                        selected => selected.Selection.Current.Login,
                        _ => null
                    );
            }
            <PublicLeaderboardPrompt ContainerClass="home-note rounded-lg p-5" InitialChannel="@selectedChannel" />
        </Authorized>
    </AuthorizeView>

    <section class="application-card-collection md:grid-cols-2" data-card-owner="home-card-grid">
        <HomeInfoCard Title="Set up your channel" Icon="@HomeInfoCardIcon.Channel" Href="/host">
            Connect the bot to your Twitch channel and keep your stream tools separate from everyone else's.
        </HomeInfoCard>

        <HomeInfoCard Title="Choose your chat tools" Icon="@HomeInfoCardIcon.Points" Href="/host#chat-tools">
            Turn on guessing rounds, points, giveaways, or only the features that make sense for your stream.
        </HomeInfoCard>

        <HomeInfoCard Title="Let trusted mods help" Icon="@HomeInfoCardIcon.Moderators" Href="/host#moderator-help">
            Let the mods you trust help run your channel tools, then change who can help whenever you need.
        </HomeInfoCard>

        <HomeInfoCard Title="Keep the bot ready" Icon="@HomeInfoCardIcon.Bot" Href="/host#bot-status">
            Check whether the bot can chat in your stream, then start or stop it from your channel page.
        </HomeInfoCard>
    </section>

    <section class="home-note rounded-lg p-5">
        <p class="text-sm leading-6 text-muted-foreground">BlokeBot is built around your Twitch channel: connect the bot, pick the chat tools you want, and choose who can help manage them.</p>
    </section>
    </ApplicationCardCollection>
</div>

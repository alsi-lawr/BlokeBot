@page "/custom-commands/settings"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CustomCommandConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts

<PageTitle>BlokeBot | Custom Commands</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Custom commands"
                Description="Create chat commands, choose what the bot says, keep counters, and send automatic announcements.">
        <button class="btn-primary"
                aria-label="Save custom commands"
                disabled="@(!_featureEnabled || _config is null)"
                @onclick="SaveAsync">Save changes</button>
    </PageHeader>

    @if (Host is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
    }
    else if (!_featureEnabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Custom commands are off for this channel. Turn them on in Channel setup.</div>
    }
    else if (_config is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading custom commands...</div>
    }
    else
    {
        @if (_validationErrors.Count > 0)
        {
            <section class="card border-red-200 bg-red-50 p-5"
                     role="alert"
                     aria-labelledby="custom-command-validation-title"
                     data-validation-summary>
                <h2 id="custom-command-validation-title" class="text-base font-bold text-red-800">Check these settings</h2>
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm font-medium text-red-700">
                    @foreach (var error in _validationErrors)
                    {
                        <li>@error.Message</li>
                    }
                </ul>
            </section>
        }

        <CollapsibleSection Title="Replies" Description="Save one or more messages for the bot to choose from." InitiallyOpen="true">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@CountLabel(_config.MessageEntries.Count, "reply")</p>
                    <button class="btn-secondary" @onclick="AddMessageEntry">Add reply</button>
                </div>

                @if (_config.MessageEntries.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No replies yet.</p>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--settings space-y-3 pr-2">
                        @foreach (var entry in _config.MessageEntries)
                        {
                            <div @key="entry" class="surface-muted space-y-3 rounded-lg p-3">
                                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(15rem,1.2fr)_12rem_auto] xl:items-end">
                                    <Field Id="@($"message-entry-{entry.Id}-name")"
                                           Label="Reply name"
                                           @bind-Value="entry.Name"
                                           Placeholder="welcome" />
                                    <div class="space-y-2">
                                        <label class="label">How the bot chooses</label>
                                        <select class="input" @bind="entry.SelectionMode">
                                            @foreach (var mode in _messageSelectionModes)
                                            {
                                                <option value="@mode">@MessageSelectionLabel(mode)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label">Next message</label>
                                        <select class="input"
                                                disabled="@(entry.SelectionMode != CustomMessageSelectionMode.Sequential)"
                                                @bind="entry.CurrentVariantIndex">
                                            @for (var i = 0; i < entry.Variants.Count; i++)
                                            {
                                                var index = i;
                                                <option value="@index">Message @(index + 1)</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="btn-secondary" @onclick="() => RemoveMessageEntry(entry)">Delete</button>
                                </div>

                                <div class="space-y-2 border-t border-slate-200 pt-3">
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Messages</p>
                                        <button class="btn-secondary h-9 px-3 text-xs" @onclick="() => AddVariant(entry)">Add message</button>
                                    </div>
                                    @for (var i = 0; i < entry.Variants.Count; i++)
                                    {
                                        var index = i;
                                        var variant = entry.Variants[index];
                                        <div @key="variant" class="grid gap-2 lg:grid-cols-[3rem_minmax(0,1fr)_auto] lg:items-start">
                                            <span class="rank-indicator mt-7">@(index + 1)</span>
                                            <TextAreaField Label="@($"Message {index + 1}")" @bind-Value="variant.Text" />
                                            <div class="mt-7 flex flex-wrap gap-2">
                                                <button class="btn-secondary h-9 px-3 text-xs" disabled="@(index == 0)" @onclick="() => MoveVariant(entry, index, -1)">Up</button>
                                                <button class="btn-secondary h-9 px-3 text-xs" disabled="@(index == entry.Variants.Count - 1)" @onclick="() => MoveVariant(entry, index, 1)">Down</button>
                                                <button class="btn-secondary h-9 px-3 text-xs" @onclick="() => RemoveVariant(entry, variant)">Remove</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Chat commands" Description="Choose what viewers type and what the bot should do." InitiallyOpen="true">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@CountLabel(_config.Commands.Count, "command")</p>
                    <button class="btn-secondary" disabled="@(_config.MessageEntries.Count == 0)" @onclick="AddCommand">Add command</button>
                </div>

                @if (_config.Commands.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No custom commands yet.</p>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--settings space-y-3 pr-2">
                        @foreach (var command in _config.Commands)
                        {
                            <div @key="command" class="surface-muted space-y-3 rounded-lg p-3">
                                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] xl:items-end">
                                    <Field Label="Command name" @bind-Value="command.Name" Placeholder="Hello" />
                                    <Field Label="Command words (without !)" @bind-Value="command.Aliases" Placeholder="hello, hi" />
                                    <button class="btn-secondary" @onclick="() => RemoveCommand(command)">Delete</button>
                                </div>
                                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                                    <label class="control-surface inline-flex h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium">
                                        <input class="h-4 w-4" type="checkbox" @bind="command.Enabled" />
                                        Turned on
                                    </label>
                                    <label class="control-surface inline-flex h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium">
                                        <input class="h-4 w-4" type="checkbox" @bind="command.ModeratorOnly" />
                                        Only moderators can use this
                                    </label>
                                    <div class="space-y-2">
                                        <label class="label">Wait between uses (seconds)</label>
                                        <input class="input" type="number" min="0" @bind="command.CooldownSeconds" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label">Who waits?</label>
                                        <select class="input" @bind="command.CooldownScope">
                                            @foreach (var scope in _cooldownScopes)
                                            {
                                                <option value="@scope">@CooldownScopeLabel(scope)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label" for="@($"command-{command.Id}-action-kind")">What happens?</label>
                                        <select id="@($"command-{command.Id}-action-kind")"
                                                class="input"
                                                @bind="command.ActionKind">
                                            @foreach (var action in _actionKinds)
                                            {
                                                <option value="@action">@ActionKindLabel(action)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label">Reply</label>
                                        <select class="input" @bind="command.Action.MessageLibraryEntryId">
                                            @foreach (var entry in _config.MessageEntries)
                                            {
                                                <option value="@entry.Id">@entry.Name</option>
                                            }
                                        </select>
                                    </div>
                                    @if (command.Action is CounterCustomCommandActionEditor counterAction)
                                    {
                                        <div class="space-y-2 md:col-span-2">
                                            <label class="label" for="@($"command-{command.Id}-counter-id")">Counter</label>
                                            <select id="@($"command-{command.Id}-counter-id")"
                                                    class="input"
                                                    @bind="counterAction.CounterId">
                                                @if (_config.Counters.Count == 0)
                                                {
                                                    <option value="0">Create a counter first</option>
                                                }
                                                @foreach (var counter in _config.Counters)
                                                {
                                                    <option value="@counter.Id">@counter.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Counters" Description="Keep track of things such as deaths, wins, or drinks." InitiallyOpen="true">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@CountLabel(_config.Counters.Count, "counter")</p>
                    <button class="btn-secondary" @onclick="AddCounter">Add counter</button>
                </div>

                @if (_config.Counters.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No counters yet.</p>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var counter in _config.Counters)
                        {
                            <div @key="counter" class="surface-muted grid gap-3 rounded-lg p-3 md:grid-cols-[minmax(0,1fr)_12rem_auto] md:items-end">
                                <Field Label="Counter name" @bind-Value="counter.Name" Placeholder="deaths" />
                                <div class="space-y-2">
                                    <label class="label">Current number</label>
                                    <input class="input" type="number" @bind="counter.Value" />
                                </div>
                                <button class="btn-secondary" @onclick="() => RemoveCounter(counter)">Delete</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection ContentId="custom-announcement-settings"
                            Title="Announcements"
                            Description="Send a saved reply automatically on a timer or after chat activity."
                            InitiallyOpen="false">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@CountLabel(_config.Announcements.Count, "announcement")</p>
                    <button class="btn-secondary" disabled="@(_config.MessageEntries.Count == 0)" @onclick="AddAnnouncement">Add announcement</button>
                </div>

                @if (_config.Announcements.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No announcements yet.</p>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--settings space-y-3 pr-2">
                        @foreach (var announcement in _config.Announcements)
                        {
                            <div @key="announcement" class="surface-muted space-y-3 rounded-lg p-3">
                                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_12rem_auto] xl:items-end">
                                    <Field Label="Announcement name" @bind-Value="announcement.Name" Placeholder="Hydrate reminder" />
                                    <label class="control-surface mt-7 inline-flex h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium xl:mt-0">
                                        <input class="h-4 w-4" type="checkbox" @bind="announcement.Enabled" />
                                        Turned on
                                    </label>
                                    <button class="btn-secondary" @onclick="() => RemoveAnnouncement(announcement)">Delete</button>
                                </div>
                                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                                    <div class="space-y-2">
                                        <label class="label">Reply to send</label>
                                        <select class="input" @bind="announcement.MessageLibraryEntryId">
                                            @foreach (var entry in _config.MessageEntries)
                                            {
                                                <option value="@entry.Id">@entry.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label" for="@($"announcement-{announcement.Id}-schedule-kind")">When to send</label>
                                        <select id="@($"announcement-{announcement.Id}-schedule-kind")"
                                                class="input"
                                                @bind="announcement.ScheduleKind">
                                            @foreach (var type in _announcementScheduleKinds)
                                            {
                                                <option value="@type">@AnnouncementScheduleLabel(type)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label" for="@($"announcement-{announcement.Id}-retry-delay")">Wait before retrying (seconds)</label>
                                        <input id="@($"announcement-{announcement.Id}-retry-delay")"
                                               class="input"
                                               type="number"
                                               min="1"
                                               max="59"
                                               aria-describedby="@($"announcement-{announcement.Id}-delivery-timing-help")"
                                               @bind="announcement.RetryDelaySeconds" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label" for="@($"announcement-{announcement.Id}-occurrence-lifetime")">Stop retrying after (seconds)</label>
                                        <input id="@($"announcement-{announcement.Id}-occurrence-lifetime")"
                                               class="input"
                                               type="number"
                                               min="1"
                                               max="60"
                                               aria-describedby="@($"announcement-{announcement.Id}-delivery-timing-help")"
                                               @bind="announcement.OccurrenceLifetimeSeconds" />
                                    </div>
                                    <p id="@($"announcement-{announcement.Id}-delivery-timing-help")"
                                       class="text-xs font-medium text-slate-500 md:col-span-2 xl:col-span-4">These timings apply only when a scheduled send cannot happen.</p>
                                    @if (announcement.Schedule is IntervalCustomAnnouncementScheduleEditor interval)
                                    {
                                        <div class="space-y-2">
                                            <label class="label">Send every (minutes)</label>
                                            <input class="input" type="number" min="1" @bind="interval.IntervalMinutes" />
                                        </div>
                                    }
                                    else if (announcement.Schedule is IntervalAfterChatCustomAnnouncementScheduleEditor intervalAfterChat)
                                    {
                                        <div class="space-y-2">
                                            <label class="label" for="@($"announcement-{announcement.Id}-interval-minutes")">Send every (minutes)</label>
                                            <input id="@($"announcement-{announcement.Id}-interval-minutes")"
                                                   class="input"
                                                   type="number"
                                                   min="1"
                                                   @bind="intervalAfterChat.IntervalMinutes" />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="label" for="@($"announcement-{announcement.Id}-required-chat-messages")">Chat messages needed</label>
                                            <input id="@($"announcement-{announcement.Id}-required-chat-messages")"
                                                   class="input"
                                                   type="number"
                                                   min="1"
                                                   @bind="intervalAfterChat.RequiredChatMessages" />
                                        </div>
                                    }
                                    else if (announcement.Schedule is WeeklyCustomAnnouncementScheduleEditor weekly)
                                    {
                                        <div class="space-y-2">
                                            <label class="label">Day</label>
                                            <select class="input" @bind="weekly.Day">
                                                @foreach (var day in _daysOfWeek)
                                                {
                                                    <option value="@day">@day</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="space-y-2">
                                            <label class="label">Time</label>
                                            <input class="input" type="time" @bind="weekly.Time" />
                                        </div>
                                    }
                                    <div class="surface-row rounded-lg px-3 py-2">
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Last sent</p>
                                        <p class="mt-1 text-sm font-semibold text-slate-900">@FormatLastSent(announcement.LastSentAtUtc)</p>
                                    </div>
                                    <div class="surface-row rounded-lg px-3 py-2">
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Chat messages since last announcement</p>
                                        <p class="mt-1 text-sm font-semibold text-slate-900">@announcement.ChatMessagesSinceLastSent</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Time zone" Description="Weekly announcements use this local time." InitiallyOpen="false">
            <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
                <div class="space-y-2">
                    <label class="label">Time zone</label>
                    <select class="input" @bind="_config.TimeZoneId">
                        @foreach (var timeZone in _timeZones)
                        {
                            <option value="@timeZone.Id">@TimeZoneLabel(timeZone)</option>
                        }
                    </select>
                </div>
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Selected time zone</p>
                    <p class="mt-1 break-words text-sm font-semibold text-slate-900">@_selectedTimeZoneLabel</p>
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Alerts" Description="Problems that may need your attention." InitiallyOpen="false">
            <div class="space-y-3 p-4">
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Active alerts</p>
                    <p class="mt-1 text-sm font-semibold text-slate-900">@_config.AlertSummary.ActiveCount</p>
                </div>
                @if (_config.AlertSummary.ActiveAlerts.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No active alerts.</p>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var alert in _config.AlertSummary.ActiveAlerts)
                        {
                            <div @key="alert" class="surface-row rounded-lg p-3">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <p class="text-sm font-bold text-slate-950">@alert.Title</p>
                                    <span class="inline-flex h-6 items-center rounded-full bg-slate-100 px-2.5 text-xs font-bold text-slate-600 ring-1 ring-slate-200">@AlertImportanceLabel(alert.Severity)</span>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">@alert.Message</p>
                                @if (!string.IsNullOrWhiteSpace(alert.LinkPath))
                                {
                                    <a class="mt-2 inline-flex text-sm font-semibold text-blue-700" href="@alert.LinkPath">Open alert</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>
    }
</div>

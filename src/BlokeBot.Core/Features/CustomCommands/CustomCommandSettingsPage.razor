@page "/custom-commands/settings"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Features.Overlays
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CustomCommandConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts
@inject CustomCommandInvocationResetService _invocationResets
@inject CustomCommandExecutionService _execution
@inject IOverlayCueAdmissionService _overlayCues
@inject ICustomCommandViewerResolver _viewers
@inject NavigationManager _navigation
@inject DashboardFragmentState _fragmentState

<PageTitle>BlokeBot | Custom Commands</PageTitle>

<div class="custom-command-page mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Custom commands"
                Description="Create chat commands, choose what the bot says, keep counters, and schedule messages.">
        <a class="btn-secondary" href="/configuration-transfer?section=customCommands#export">Import or export</a>
    </PageHeader>

    @if (_loadFailureMessage is not null)
    {
        <section class="page-state" data-page-state="failure" role="alert">
            <div>
                <h2 class="page-state__title">Custom commands could not load</h2>
                <p class="page-state__description">@_loadFailureMessage</p>
            </div>
            <div class="page-state__actions">
                <button class="btn-primary" type="button" @onclick="LoadAsync">Retry</button>
            </div>
        </section>
    }
    else if (_isLoading)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground" role="status">Loading custom commands...</div>
        </ApplicationCardCollection>
    }
    else if (Host is null)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
        </ApplicationCardCollection>
    }
    else if (!_featureEnabled)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground">Custom commands are off for this channel. Turn them on in Channel setup.</div>
        </ApplicationCardCollection>
    }
    else if (_config is null)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground" role="status">Loading custom commands...</div>
        </ApplicationCardCollection>
    }
    else
    {
        @if (_validationErrors.Count > 0)
        {
            <ApplicationCardCollection Owner="custom-command-page-cards">
            <section class="card border-red-200 bg-red-50 p-5"
                     role="alert"
                     aria-labelledby="custom-command-validation-title"
                     data-validation-summary>
                <h2 id="custom-command-validation-title" class="text-base font-bold text-red-800">Check these settings</h2>
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm font-medium text-red-700">
                    @foreach (var error in _validationErrors)
                    {
                        <li>@error.Message</li>
                    }
                </ul>
                @if (ValidationMessage(ConfigurationTarget(CustomCommandValidationFieldKind.Identity)) is not null)
                {
                    <button id="@_reloadControlId"
                            class="btn-secondary mt-3"
                            @attributes="ValidationAttributes(_reloadControlId, ConfigurationTarget(CustomCommandValidationFieldKind.Identity))"
                            @ref="_controls[_reloadControlId]"
                            @onclick="LoadAsync">Reload settings</button>
                    @(ValidationMessageFor(_reloadControlId, ConfigurationTarget(CustomCommandValidationFieldKind.Identity)))
                }
            </section>
            </ApplicationCardCollection>
        }

        <SegmentedTabs Id="custom-command"
                       AriaLabel="Custom command settings"
                       Items="_settingsTabs"
                       ActiveKey="@KeyForTab(_activeTab)"
                       ActiveKeyChanged="HandleTabKeyChanged" />

            var studioContext = new CustomCommandStudioContext
            {
                Configuration = _config,
                ActiveTab = _activeTab,
                RailGroups = () => _railGroups,
                AddMessageEntry = EventCallback.Factory.Create(this, AddMessageEntry),
                AddCommand = AddCommand,
                SelectedCommand = () => _selectedCommand,
                SelectedCounter = () => _selectedCounter,
                SelectedAnnouncement = () => _selectedAnnouncement,
                SelectedReply = () => _selectedReply,
                HeaderName = () => _headerName,
                HeaderStats = () => _headerStats,
                EmptyInspectorMessage = () => _emptyInspectorMessage,
                HasChanges = () => _hasChanges,
                Save = EventCallback.Factory.Create(this, SaveAsync),
                Validation = new(
                    ValidationMessage,
                    FocusRequestFor,
                    EditorFocusRequestFor,
                    ValidationAttributes,
                    ValidationMessageFor,
                    _controls
                ),
                BasicsOpen = () => _openStages.IsOpen(CustomCommandStage.Basics),
                SetBasicsOpen = open => _openStages.Set(CustomCommandStage.Basics, open),
                AccessOpen = () => _openStages.IsOpen(CustomCommandStage.Access),
                SetAccessOpen = open => _openStages.Set(CustomCommandStage.Access, open),
                ActionOpen = () => _openStages.IsOpen(CustomCommandStage.Action),
                SetActionOpen = open => _openStages.Set(CustomCommandStage.Action, open),
                FineTuningOpen = () => _openStages.IsOpen(CustomCommandStage.FineTuning),
                SetFineTuningOpen = open => _openStages.Set(CustomCommandStage.FineTuning, open),
                BasicsSummary = BasicsSummary,
                CommandInvocation = CommandInvocation,
                CommandAccessSummary = CommandAccessSummary,
                ActionKindLabel = ActionKindLabel,
                CommandAdvancedSummary = CommandAdvancedSummary,
                CommandPreviewLines = CommandPreviewLines,
                AccessOptions = AccessOptions,
                SetCommandAccess = SetCommandAccess,
                ToggleModeratorAccess = ToggleModeratorAccess,
                AddAllowedUser = AddAllowedUserAsync,
                RemoveAllowedUser = RemoveAllowedUser,
                AutomationsEnabled = _automationsEnabled,
                OverlaysEnabled = _overlaysEnabled,
                CueCatalog = _cueCatalog,
                CueTestOutcome = _cueTestOutcome,
                TestCue = TestCueAsync,
                CueQueuePolicyLabel = CueQueuePolicyLabel,
                CueReplyOrderLabel = CueReplyOrderLabel,
                CooldownScopeLabel = CooldownScopeLabel,
                InvocationLimitLabel = InvocationLimitLabel,
                PendingResetAllCommandId = () => _pendingResetAllCommandId,
                ResetViewer = ResetViewerAsync,
                RequestResetAllViewers = RequestResetAllViewers,
                ResetAllViewers = ResetAllViewersAsync,
                CancelResetAllViewers = CancelResetAllViewers,
                RemoveCommand = RemoveCommand,
                RemoveCounter = RemoveCounter,
                RemoveAnnouncement = RemoveAnnouncement,
                RemoveMessageEntry = RemoveMessageEntry,
                AddVariant = AddVariant,
                MoveVariant = MoveVariant,
                RemoveVariant = RemoveVariant,
                MessageSelectionLabel = MessageSelectionLabel,
                AnnouncementDeliveryTypeLabel = AnnouncementDeliveryTypeLabel,
                TwitchAnnouncementColorLabel = TwitchAnnouncementColorLabel,
                TwitchAnnouncementCapabilityMessage = TwitchAnnouncementCapabilityMessage,
                AnnouncementScheduleLabel = AnnouncementScheduleLabel,
                NativeDeliveryUnavailable = NativeDeliveryUnavailable,
                AnnouncementAdvancedOpenRequest = AnnouncementAdvancedOpenRequest,
                AnnouncementDeliveryDetails = AnnouncementDeliveryDetails,
                FormatLastSent = FormatLastSent,
                LatestDeliveryResultLabel = LatestDeliveryResultLabel,
                TimeZones = _timeZones,
                TimeZoneSectionOpenRequest = _timeZoneSectionOpenRequest,
                SelectedTimeZoneLabel = () => _selectedTimeZoneLabel,
                ChangeTimeZone = EventCallback.Factory.Create<ChangeEventArgs>(this, ChangeTimeZone),
                AlertImportanceLabel = AlertImportanceLabel,
            };

        <CustomCommandStudio Context="studioContext" />

        <CustomCommandSettingsDetails Context="studioContext" />
    }
</div>

@code {
    private RenderFragment AnnouncementDeliveryDetails(CustomAnnouncementEditor announcement) =>
        @<text>
            <div class="studio-span-6 space-y-2">
                <div class="field">
                    <label class="field__label" for="@CustomCommandEditorIds.AnnouncementRetryDelay(announcement)">Wait before retrying (seconds)</label>
                    <input id="@CustomCommandEditorIds.AnnouncementRetryDelay(announcement)"
                           class="field__input"
                           type="number"
                           min="1"
                           max="59"
                           @attributes="ValidationAttributes(CustomCommandEditorIds.AnnouncementRetryDelay(announcement), CustomCommandEditorIds.AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.RetryDelay))"
                           @bind="announcement.RetryDelaySeconds" />
                </div>
                @(ValidationMessageFor(CustomCommandEditorIds.AnnouncementRetryDelay(announcement), CustomCommandEditorIds.AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.RetryDelay)))
            </div>
            <div class="studio-span-6 space-y-2">
                <div class="field">
                    <label class="field__label" for="@CustomCommandEditorIds.AnnouncementOccurrenceLifetime(announcement)">Stop retrying after (seconds)</label>
                    <input id="@CustomCommandEditorIds.AnnouncementOccurrenceLifetime(announcement)"
                           class="field__input"
                           type="number"
                           min="1"
                           max="60"
                           @attributes="ValidationAttributes(CustomCommandEditorIds.AnnouncementOccurrenceLifetime(announcement), CustomCommandEditorIds.AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.OccurrenceLifetime))"
                           @bind="announcement.OccurrenceLifetimeSeconds" />
                </div>
                @(ValidationMessageFor(CustomCommandEditorIds.AnnouncementOccurrenceLifetime(announcement), CustomCommandEditorIds.AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.OccurrenceLifetime)))
            </div>
        </text>;
}

@page "/custom-commands/settings"
@using BlokeBot.Eventing
@using BlokeBot.Core.Features.HostedChannels
@using BlokeBot.Core.Features.Overlays
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CustomCommandConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts
@inject CustomCommandInvocationResetService _invocationResets
@inject CustomCommandExecutionService _execution
@inject IOverlayCueAdmissionService _overlayCues
@inject ICustomCommandViewerResolver _viewers
@inject NavigationManager _navigation
@inject DashboardFragmentState _fragmentState

<PageTitle>BlokeBot | Custom Commands</PageTitle>

<div class="custom-command-page mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Custom commands"
                Description="Create chat commands, choose what the bot says, keep counters, and schedule messages." />

    @if (_loadFailureMessage is not null)
    {
        <section class="page-state" data-page-state="failure" role="alert">
            <div>
                <h2 class="page-state__title">Custom commands could not load</h2>
                <p class="page-state__description">@_loadFailureMessage</p>
            </div>
            <div class="page-state__actions">
                <button class="btn-primary" type="button" @onclick="LoadAsync">Retry</button>
            </div>
        </section>
    }
    else if (_isLoading)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground" role="status">Loading custom commands...</div>
        </ApplicationCardCollection>
    }
    else if (Host is null)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
        </ApplicationCardCollection>
    }
    else if (!_featureEnabled)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground">Custom commands are off for this channel. Turn them on in Channel setup.</div>
        </ApplicationCardCollection>
    }
    else if (_config is null)
    {
        <ApplicationCardCollection Owner="custom-command-page-cards">
            <div class="card p-8 text-sm text-muted-foreground" role="status">Loading custom commands...</div>
        </ApplicationCardCollection>
    }
    else
    {
        @if (_validationErrors.Count > 0)
        {
            <ApplicationCardCollection Owner="custom-command-page-cards">
            <section class="card border-red-200 bg-red-50 p-5"
                     role="alert"
                     aria-labelledby="custom-command-validation-title"
                     data-validation-summary>
                <h2 id="custom-command-validation-title" class="text-base font-bold text-red-800">Check these settings</h2>
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm font-medium text-red-700">
                    @foreach (var error in _validationErrors)
                    {
                        <li>@error.Message</li>
                    }
                </ul>
                @if (ValidationMessage(ConfigurationTarget(CustomCommandValidationFieldKind.Identity)) is not null)
                {
                    <button id="@_reloadControlId"
                            class="btn-secondary mt-3"
                            @attributes="ValidationAttributes(_reloadControlId, ConfigurationTarget(CustomCommandValidationFieldKind.Identity))"
                            @ref="_controls[_reloadControlId]"
                            @onclick="LoadAsync">Reload settings</button>
                    @(ValidationMessageFor(_reloadControlId, ConfigurationTarget(CustomCommandValidationFieldKind.Identity)))
                }
            </section>
            </ApplicationCardCollection>
        }

        <section class="studio" data-active-fragment="@KeyForTab(_activeTab)" aria-label="Custom command studio">
            <StudioRail AriaLabel="Commands, counters, announcements, and replies"
                        SearchPlaceholder="Search"
                        Groups="@_railGroups">
                <Footer>
                    @if (_config.MessageEntries.Count == 0)
                    {
                        <button class="btn-primary w-full"
                                data-action="create-reply"
                                @onclick="AddMessageEntry">Create a reply first</button>
                    }
                    else
                    {
                        <button class="btn-primary w-full"
                                data-action="add-command"
                                @onclick="AddCommand">+ New command</button>
                    }
                </Footer>
            </StudioRail>

            <div class="studio__inspector">
                <header class="studio__header">
                    <span class="studio__title @(_selectedCommand is not null ? "studio__title--mono" : null)">@_headerName</span>
                    @if (_headerStats is { } stats)
                    {
                        <span class="studio__subtitle">@stats</span>
                    }
                    <span class="studio__spacer"></span>
                    @if (_selectedCommand is { } toggledCommand)
                    {
                        <span class="studio-toggle-label">Turned on</span>
                        <button type="button"
                                id="@CommandEnabledToggleId(toggledCommand)"
                                class="studio-toggle"
                                role="switch"
                                aria-checked="@(toggledCommand.Enabled ? "true" : "false")"
                                aria-label="Turned on"
                                @onclick="() => toggledCommand.Enabled = !toggledCommand.Enabled"></button>
                    }
                    else if (_selectedAnnouncement is { } toggledAnnouncement)
                    {
                        <span class="studio-toggle-label">Turned on</span>
                        <button type="button"
                                id="@AnnouncementEnabledToggleId(toggledAnnouncement)"
                                class="studio-toggle"
                                role="switch"
                                aria-checked="@(toggledAnnouncement.Enabled ? "true" : "false")"
                                aria-label="Turned on"
                                disabled="@NativeDeliveryUnavailable(toggledAnnouncement)"
                                @onclick="() => toggledAnnouncement.Enabled = !toggledAnnouncement.Enabled"></button>
                    }
                    <button class="@(_hasChanges ? "btn-primary custom-command-save--dirty" : "btn-secondary")"
                            aria-label="Save custom commands"
                            data-save-state="@(_hasChanges ? "dirty" : "clean")"
                            disabled="@(!_hasChanges)"
                            @onclick="SaveAsync">Save</button>
                </header>

                <div class="studio__body">
                    @if (_selectedCommand is { } command)
                    {
                        <section @key="command"
                                 id="@EditorRegionId(CustomCommandEditorKind.Command, command.Id)"
                                 class="grid min-w-0 gap-3"
                                 role="region"
                                 aria-labelledby="@InventoryLabelId(CustomCommandEditorKind.Command, command.Id)"
                                 data-selected-editor="command">

                            <StudioStage Key="basics"
                                         Number="1"
                                         Title="Basics"
                                         Summary="@BasicsSummary(command)"
                                         Open="@IsStageOpen(CustomCommandStage.Basics)"
                                         OpenChanged="@(open => SetStage(CustomCommandStage.Basics, open))">
                                <div class="studio-grid">
                                    <div class="studio-span-4">
                                        <Field Id="@CommandNameFieldId(command)"
                                               Label="Command name"
                                               ErrorMessage="@ValidationMessage(CommandTarget(command.Id, CustomCommandValidationFieldKind.Name))"
                                               FocusRequest="@Math.Max(FocusRequestFor(CommandTarget(command.Id, CustomCommandValidationFieldKind.Name)), EditorFocusRequestFor(CommandNameFieldId(command)))"
                                               @bind-Value="command.Name"
                                               Placeholder="Hello" />
                                    </div>
                                    <div class="studio-span-8">
                                        <Field Id="@CommandAliasesFieldId(command)"
                                               Label="Command words (without !)"
                                               ErrorMessage="@ValidationMessage(CommandTarget(command.Id, CustomCommandValidationFieldKind.Aliases))"
                                               FocusRequest="@FocusRequestFor(CommandTarget(command.Id, CustomCommandValidationFieldKind.Aliases))"
                                               @bind-Value="command.Aliases"
                                               Placeholder="hello, hi" />
                                        <p class="mt-1 text-xs text-muted-foreground">Viewers type @CommandInvocation(command) in chat.</p>
                                    </div>
                                    @if (CommandPreviewLines(command) is { Count: > 0 } previewLines)
                                    {
                                        <div class="studio-span-12">
                                            <StudioChatPreview Lines="previewLines" />
                                        </div>
                                    }
                                </div>
                            </StudioStage>

                            <StudioStage Key="who-can-use-it"
                                         Number="2"
                                         Title="Who can use it"
                                         Summary="@CommandAccessSummary(command)"
                                         Open="@IsStageOpen(CustomCommandStage.Access)"
                                         OpenChanged="@(open => SetStage(CustomCommandStage.Access, open))">
                                <div class="studio-grid" data-command-access>
                                    <div class="studio-span-12">
                                        <StudioSegmentedPill TValue="bool"
                                                             AriaLabel="Command access"
                                                             Options="@AccessOptions(command)"
                                                             Value="command.AllowEveryone"
                                                             ValueChanged="@(everyone => SetCommandAccess(command, everyone))" />
                                    </div>
                                    @if (command.AllowedUserFeedback is not null)
                                    {
                                        <p class="studio-span-12 text-sm text-muted-foreground"
                                           role="status"
                                           data-allowed-user-feedback>@command.AllowedUserFeedback</p>
                                    }
                                    @if (!command.AllowEveryone)
                                    {
                                        <div class="studio-span-12 studio-chips">
                                            <StudioChip Id="@CommandModeratorAccessId(command)"
                                                        Label="Moderators"
                                                        Pressed="command.AllowModerators"
                                                        PressedChanged="@(_ => ToggleModeratorAccess(command))" />
                                            @foreach (var user in command.AllowedUsers)
                                            {
                                                <StudioChip @key="user"
                                                            Label="@user.DisplayName"
                                                            Note="@($"@{user.Login}")"
                                                            RemoveLabel="@($"Remove {user.DisplayName}")"
                                                            RemoveAction="remove-allowed-user"
                                                            Remove="@(() => RemoveAllowedUser(command, user))"
                                                            data-allowed-user-id="@user.TwitchUserId" />
                                            }
                                        </div>
                                        @if (!command.AllowModerators && command.AllowedUsers.Count == 0)
                                        {
                                            <p class="studio-span-12 text-sm text-muted-foreground" data-streamer-only>
                                                Only the streamer can use this command.
                                            </p>
                                        }
                                        <div class="studio-span-6">
                                            <Field Id="@CommandAllowedUserFieldId(command)"
                                                   Label="Twitch login"
                                                   ErrorMessage="@ValidationMessage(CommandTarget(command.Id, CustomCommandValidationFieldKind.AllowedUsers))"
                                                   FocusRequest="@FocusRequestFor(CommandTarget(command.Id, CustomCommandValidationFieldKind.AllowedUsers))"
                                                   @bind-Value="command.AllowedUserLoginDraft"
                                                   Placeholder="viewer_name" />
                                        </div>
                                        <div class="studio-span-6 studio-align-end">
                                            <button class="btn-secondary"
                                                    type="button"
                                                    data-action="add-allowed-user"
                                                    disabled="@command.AllowedUserLookupInProgress"
                                                    @onclick="() => AddAllowedUserAsync(command)">
                                                @(command.AllowedUserLookupInProgress ? "Looking up..." : "+ Add person")
                                            </button>
                                        </div>
                                    }
                                </div>
                            </StudioStage>

                            <StudioStage Key="what-happens"
                                         Number="3"
                                         Title="What happens"
                                         Summary="@ActionKindLabel(command.ActionKind)"
                                         Open="@IsStageOpen(CustomCommandStage.Action)"
                                         OpenChanged="@(open => SetStage(CustomCommandStage.Action, open))">
                                <div class="studio-grid">
                                    <div class="studio-span-12">
                                        <div id="@CommandActionFieldId(command)"
                                             class="studio-choice-cards"
                                             role="group"
                                             aria-label="What happens"
                                             tabindex="-1"
                                             @attributes="ValidationAttributes(CommandActionFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.Action))"
                                             @ref="_controls[CommandActionFieldId(command)]">
                                            @foreach (var choice in _actionChoices)
                                            {
                                                <button @key="choice.Kind"
                                                        type="button"
                                                        class="studio-choice-card"
                                                        data-action-kind="@choice.Kind"
                                                        aria-pressed="@(command.ActionKind == choice.Kind ? "true" : "false")"
                                                        @onclick="() => command.ActionKind = choice.Kind">
                                                    <span class="studio-choice-card__icon" aria-hidden="true">@choice.Icon</span>
                                                    <span class="studio-choice-card__title">@choice.Title</span>
                                                    <span class="studio-choice-card__description">@choice.Description</span>
                                                </button>
                                            }
                                        </div>
                                        @(ValidationMessageFor(CommandActionFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.Action)))
                                    </div>
                                    @if (command.Action is AutomationCustomCommandActionEditor)
                                    {
                                        <div class="studio-span-12 surface-muted space-y-2 rounded-lg p-3"
                                             data-unavailable-command-action>
                                            <p class="text-sm font-semibold text-slate-900">Saved action unavailable</p>
                                            <p class="text-sm text-muted-foreground" role="status">
                                                This action cannot be changed in this release. Saving preserves it.
                                            </p>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var route in _replyRoutes)
                                        {
                                            <div class="studio-span-4 space-y-2" @key="route.Arguments">
                                                <label class="label" for="@CommandReplyFieldId(command, route.Arguments)">@route.Label</label>
                                                <select id="@CommandReplyFieldId(command, route.Arguments)"
                                                        class="input"
                                                        @attributes="ValidationAttributes(CommandReplyFieldId(command, route.Arguments), CommandTarget(command.Id, route.Field))"
                                                        @ref="_controls[CommandReplyFieldId(command, route.Arguments)]"
                                                        value="@route.Get(command.Action.ReplyRoutes)"
                                                        @onchange="args => route.Set(command.Action.ReplyRoutes, ParseEntryId(args.Value))">
                                                    <option value="">Ignore</option>
                                                    @foreach (var entry in _config.MessageEntries)
                                                    {
                                                        <option value="@entry.Id">@entry.Name</option>
                                                    }
                                                </select>
                                                @(ValidationMessageFor(CommandReplyFieldId(command, route.Arguments), CommandTarget(command.Id, route.Field)))
                                            </div>
                                        }
                                        <p class="studio-span-12 text-xs text-muted-foreground">
                                            @if (command.Action is OverlayCueCustomCommandActionEditor)
                                            {
                                                <text>Replies are optional for overlay cues. Unmapped counts still play the cue without a response.</text>
                                            }
                                            else
                                            {
                                                <text>Choose at least one reply. Unmapped counts and commands with more than two arguments are ignored without a response.</text>
                                            }
                                        </p>
                                    }
                                    @if (command.Action is OverlayCueCustomCommandActionEditor cueAction)
                                    {
                                        @if (!_overlaysEnabled)
                                        {
                                            <p class="studio-span-12 text-sm text-muted-foreground" role="status">
                                                Overlays are off. This setup is retained, but cue playback and testing stay paused until you turn Overlays on in Channel setup.
                                            </p>
                                        }
                                        <div class="studio-span-6 space-y-2" data-overlay-cue-command>
                                            <label class="label" for="@CommandOverlayTargetFieldId(command)">Overlay player</label>
                                            <select id="@CommandOverlayTargetFieldId(command)"
                                                    class="input"
                                                    disabled="@(!_overlaysEnabled)"
                                                    @attributes="ValidationAttributes(CommandOverlayTargetFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.OverlayTarget))"
                                                    @ref="_controls[CommandOverlayTargetFieldId(command)]"
                                                    @bind="cueAction.TargetOverlayPublicId">
                                                <option value="@Guid.Empty">Choose an overlay player</option>
                                                @if (cueAction.TargetOverlayPublicId != Guid.Empty && !_cueCatalog.Targets.Any(target => target.Id == cueAction.TargetOverlayPublicId))
                                                {
                                                    <option value="@cueAction.TargetOverlayPublicId">Unavailable saved player</option>
                                                }
                                                @foreach (var target in _cueCatalog.Targets)
                                                {
                                                    <option value="@target.Id">@target.Name</option>
                                                }
                                            </select>
                                            @(ValidationMessageFor(CommandOverlayTargetFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.OverlayTarget)))
                                        </div>
                                        <div class="studio-span-6 space-y-2">
                                            <label class="label" for="@CommandOverlayCueFieldId(command)">Cue</label>
                                            <select id="@CommandOverlayCueFieldId(command)"
                                                    class="input"
                                                    disabled="@(!_overlaysEnabled)"
                                                    @attributes="ValidationAttributes(CommandOverlayCueFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.OverlayCue))"
                                                    @ref="_controls[CommandOverlayCueFieldId(command)]"
                                                    @bind="cueAction.CuePublicId">
                                                <option value="@Guid.Empty">Choose a cue</option>
                                                @if (cueAction.CuePublicId != Guid.Empty && !_cueCatalog.Cues.Any(cue => cue.Id == cueAction.CuePublicId))
                                                {
                                                    <option value="@cueAction.CuePublicId">Unavailable saved cue</option>
                                                }
                                                @foreach (var cue in _cueCatalog.Cues)
                                                {
                                                    <option value="@cue.Id">@cue.Name</option>
                                                }
                                            </select>
                                            @(ValidationMessageFor(CommandOverlayCueFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.OverlayCue)))
                                        </div>
                                        <div class="studio-span-6 space-y-2">
                                            <label class="label" for="@CommandQueuePolicyFieldId(command)">When the player is busy</label>
                                            <select id="@CommandQueuePolicyFieldId(command)"
                                                    class="input"
                                                    disabled="@(!_overlaysEnabled)"
                                                    @attributes="ValidationAttributes(CommandQueuePolicyFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.QueuePolicy))"
                                                    @ref="_controls[CommandQueuePolicyFieldId(command)]"
                                                    @bind="cueAction.QueuePolicy">
                                                @foreach (var policy in _cueQueuePolicies)
                                                {
                                                    <option value="@policy">@CueQueuePolicyLabel(policy)</option>
                                                }
                                            </select>
                                            @(ValidationMessageFor(CommandQueuePolicyFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.QueuePolicy)))
                                        </div>
                                        <div class="studio-span-6 space-y-2">
                                            <label class="label" for="@CommandReplyOrderFieldId(command)">Optional reply timing</label>
                                            <select id="@CommandReplyOrderFieldId(command)"
                                                    class="input"
                                                    disabled="@(!_overlaysEnabled)"
                                                    @attributes="ValidationAttributes(CommandReplyOrderFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.ReplyOrder))"
                                                    @ref="_controls[CommandReplyOrderFieldId(command)]"
                                                    @bind="cueAction.ReplyOrder">
                                                @foreach (var order in _cueReplyOrders)
                                                {
                                                    <option value="@order">@CueReplyOrderLabel(order)</option>
                                                }
                                            </select>
                                            @(ValidationMessageFor(CommandReplyOrderFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.ReplyOrder)))
                                        </div>
                                        <div class="studio-span-12 flex flex-wrap items-center gap-3">
                                            <button class="btn-secondary"
                                                    type="button"
                                                    disabled="@(!_overlaysEnabled || cueAction.TargetOverlayPublicId == Guid.Empty || cueAction.CuePublicId == Guid.Empty)"
                                                    data-action="test-overlay-cue-command"
                                                    @onclick="() => TestCueAsync(cueAction)">Test cue</button>
                                            @if (_cueTestOutcome is not null)
                                            {
                                                <p class="text-sm text-muted-foreground" role="status" data-cue-test-outcome>@_cueTestOutcome</p>
                                            }
                                        </div>
                                    }
                                </div>
                            </StudioStage>

                            <StudioStage Key="fine-tuning"
                                         Number="4"
                                         Title="Fine-tuning"
                                         Summary="@CommandAdvancedSummary(command)"
                                         Open="@IsStageOpen(CustomCommandStage.FineTuning)"
                                         OpenChanged="@(open => SetStage(CustomCommandStage.FineTuning, open))">
                                <div class="studio-grid">
                                    <div class="studio-span-4 space-y-2">
                                        <label class="label" for="@CommandCooldownFieldId(command)">Wait between uses (seconds)</label>
                                        <input id="@CommandCooldownFieldId(command)"
                                               class="input"
                                               type="number"
                                               min="0"
                                               @attributes="ValidationAttributes(CommandCooldownFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.Cooldown))"
                                               @ref="_controls[CommandCooldownFieldId(command)]"
                                               @bind="command.CooldownSeconds" />
                                        @(ValidationMessageFor(CommandCooldownFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.Cooldown)))
                                    </div>
                                    <div class="studio-span-4 space-y-2">
                                        <label class="label" for="@CommandCooldownScopeFieldId(command)">Who waits?</label>
                                        <select id="@CommandCooldownScopeFieldId(command)"
                                                class="input"
                                                @attributes="ValidationAttributes(CommandCooldownScopeFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.CooldownScope))"
                                                @ref="_controls[CommandCooldownScopeFieldId(command)]"
                                                @bind="command.CooldownScope">
                                            @foreach (var scope in _cooldownScopes)
                                            {
                                                <option value="@scope">@CooldownScopeLabel(scope)</option>
                                            }
                                        </select>
                                        @(ValidationMessageFor(CommandCooldownScopeFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.CooldownScope)))
                                    </div>
                                    <div class="studio-span-4 space-y-2">
                                        <label class="label" for="@CommandInvocationLimitFieldId(command)">Use limit</label>
                                        <select id="@CommandInvocationLimitFieldId(command)"
                                                class="input"
                                                @attributes="ValidationAttributes(CommandInvocationLimitFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.InvocationLimit))"
                                                @ref="_controls[CommandInvocationLimitFieldId(command)]"
                                                @bind="command.InvocationLimit">
                                            @foreach (var limit in _invocationLimits)
                                            {
                                                <option value="@limit">@InvocationLimitLabel(limit)</option>
                                            }
                                        </select>
                                        @(ValidationMessageFor(CommandInvocationLimitFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.InvocationLimit)))
                                    </div>
                                    @if (command.Action is CounterCustomCommandActionEditor counterAction)
                                    {
                                        <div class="studio-span-6 space-y-2">
                                            <label class="label" for="@CommandCounterFieldId(command)">Counter</label>
                                            <select id="@CommandCounterFieldId(command)"
                                                    class="input"
                                                    @attributes="ValidationAttributes(CommandCounterFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.Counter))"
                                                    @ref="_controls[CommandCounterFieldId(command)]"
                                                    @bind="counterAction.CounterId">
                                                @if (_config.Counters.Count == 0)
                                                {
                                                    <option value="0">Create a counter first</option>
                                                }
                                                @foreach (var counter in _config.Counters)
                                                {
                                                    <option value="@counter.Id">@counter.Name</option>
                                                }
                                            </select>
                                            @(ValidationMessageFor(CommandCounterFieldId(command), CommandTarget(command.Id, CustomCommandValidationFieldKind.Counter)))
                                        </div>
                                    }
                                    <p class="studio-span-12 text-xs text-muted-foreground">The wait is checked first. A use is only claimed after the wait passes; moderators follow the same use limit.</p>
                                    @if (command.Id > 0)
                                    {
                                        <div class="studio-span-6 custom-command-reset-boundary">
                                            <Field Id="@CommandResetViewerFieldId(command)"
                                                   Label="Reset lifetime use for viewer"
                                                   @bind-Value="command.ResetViewerLogin"
                                                   Placeholder="viewer login" />
                                        </div>
                                        <div class="studio-span-6 studio-align-end custom-command-reset-boundary flex flex-wrap gap-2">
                                            <button class="btn-secondary"
                                                    data-action="reset-viewer-use"
                                                    @onclick="() => ResetViewerAsync(command)">Reset viewer</button>
                                            <button class="btn-secondary"
                                                    data-action="reset-all-viewer-uses"
                                                    @onclick="() => RequestResetAllViewers(command)">Reset all viewers</button>
                                        </div>
                                        @if (_pendingResetAllCommandId == command.Id)
                                        {
                                            <div class="studio-span-12 flex flex-wrap items-center justify-end gap-2 text-sm" role="alert">
                                                <span>Reset every lifetime viewer use for @command.Name?</span>
                                                <button class="btn-secondary"
                                                        data-action="confirm-reset-all-viewer-uses"
                                                        @onclick="() => ResetAllViewersAsync(command)">Confirm reset all</button>
                                                <button class="btn-secondary" @onclick="CancelResetAllViewers">Cancel</button>
                                            </div>
                                        }
                                    }
                                    <div class="studio-span-12 flex justify-end">
                                        <button class="btn-secondary" @onclick="() => RemoveCommand(command)">Delete command</button>
                                    </div>
                                </div>
                            </StudioStage>
                        </section>
                    }
                    else if (_selectedCounter is { } counter)
                    {
                        <section @key="counter"
                                 id="@EditorRegionId(CustomCommandEditorKind.Counter, counter.Id)"
                                 class="studio-grid"
                                 role="region"
                                 aria-labelledby="@InventoryLabelId(CustomCommandEditorKind.Counter, counter.Id)"
                                 data-selected-editor="counter">
                            <div class="studio-span-8">
                                <Field Id="@CounterNameFieldId(counter)"
                                       Label="Counter name"
                                       ErrorMessage="@ValidationMessage(CounterTarget(counter.Id, CustomCommandValidationFieldKind.Name))"
                                       FocusRequest="@Math.Max(FocusRequestFor(CounterTarget(counter.Id, CustomCommandValidationFieldKind.Name)), EditorFocusRequestFor(CounterNameFieldId(counter)))"
                                       @bind-Value="counter.Name"
                                       Placeholder="deaths" />
                            </div>
                            <div class="studio-span-4 space-y-2">
                                <label class="label" for="@CounterValueFieldId(counter)">Current number</label>
                                <input id="@CounterValueFieldId(counter)" class="input" type="number" @bind="counter.Value" />
                            </div>
                            <div class="studio-span-12 flex justify-end">
                                <button class="btn-secondary" @onclick="() => RemoveCounter(counter)">Delete counter</button>
                            </div>
                        </section>
                    }
                    else if (_selectedAnnouncement is { } announcement)
                    {
                        <section @key="announcement"
                                 id="@EditorRegionId(CustomCommandEditorKind.ScheduledMessage, announcement.Id)"
                                 class="studio-grid"
                                 role="region"
                                 aria-labelledby="@InventoryLabelId(CustomCommandEditorKind.ScheduledMessage, announcement.Id)"
                                 data-selected-editor="scheduled-message">
                            <div class="studio-span-6">
                                <Field Id="@AnnouncementNameFieldId(announcement)"
                                       Label="Scheduled message name"
                                       ErrorMessage="@ValidationMessage(AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Name))"
                                       FocusRequest="@Math.Max(FocusRequestFor(AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Name)), EditorFocusRequestFor(AnnouncementNameFieldId(announcement)))"
                                       @bind-Value="announcement.Name"
                                       Placeholder="Hydrate reminder" />
                            </div>
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="@AnnouncementReplyFieldId(announcement)">Reply to send</label>
                                <select id="@AnnouncementReplyFieldId(announcement)"
                                        class="input"
                                        @attributes="ValidationAttributes(AnnouncementReplyFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Reply))"
                                        @ref="_controls[AnnouncementReplyFieldId(announcement)]"
                                        @bind="announcement.MessageLibraryEntryId">
                                    @foreach (var entry in _config.MessageEntries)
                                    {
                                        <option value="@entry.Id">@entry.Name</option>
                                    }
                                </select>
                                @(ValidationMessageFor(AnnouncementReplyFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Reply)))
                            </div>
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="@AnnouncementDeliveryFieldId(announcement)">Delivery type</label>
                                <select id="@AnnouncementDeliveryFieldId(announcement)"
                                        class="input"
                                        @attributes="ValidationAttributes(AnnouncementDeliveryFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Delivery))"
                                        @ref="_controls[AnnouncementDeliveryFieldId(announcement)]"
                                        @bind="announcement.DeliveryType">
                                    @foreach (var type in _announcementDeliveryTypes)
                                    {
                                        <option value="@type">@AnnouncementDeliveryTypeLabel(type)</option>
                                    }
                                </select>
                                @(ValidationMessageFor(AnnouncementDeliveryFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Delivery)))
                            </div>
                            @if (announcement.DeliveryType == CustomAnnouncementDeliveryType.TwitchAnnouncement)
                            {
                                <div class="studio-span-6 space-y-2">
                                    <label class="label" for="@AnnouncementColorFieldId(announcement)">Twitch announcement color</label>
                                    <select id="@AnnouncementColorFieldId(announcement)"
                                            class="input"
                                            @attributes="ValidationAttributes(AnnouncementColorFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Color))"
                                            @ref="_controls[AnnouncementColorFieldId(announcement)]"
                                            @bind="announcement.AnnouncementColor">
                                        @foreach (var color in _twitchAnnouncementColors)
                                        {
                                            <option value="@color">@TwitchAnnouncementColorLabel(color)</option>
                                        }
                                    </select>
                                    @(ValidationMessageFor(AnnouncementColorFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Color)))
                                </div>
                                <div class="studio-span-12 surface-row rounded-lg px-3 py-2 text-sm text-slate-700">
                                    <p>@TwitchAnnouncementCapabilityMessage(_config.TwitchAnnouncementReadiness)</p>
                                    @if (_config.TwitchAnnouncementReadiness.Availability != TwitchAnnouncementAvailability.Available)
                                    {
                                        <a class="mt-1 inline-flex font-semibold text-blue-700" href="/host">Open Channel setup</a>
                                    }
                                    <p class="mt-1 text-xs text-slate-500">Twitch announcements use the selected reply; every reply message must be no longer than 500 characters.</p>
                                </div>
                            }
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="@AnnouncementScheduleFieldId(announcement)">When to send</label>
                                <select id="@AnnouncementScheduleFieldId(announcement)"
                                        class="input"
                                        @attributes="ValidationAttributes(AnnouncementScheduleFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Schedule))"
                                        @ref="_controls[AnnouncementScheduleFieldId(announcement)]"
                                        @bind="announcement.ScheduleKind">
                                    @foreach (var type in _announcementScheduleKinds)
                                    {
                                        <option value="@type">@AnnouncementScheduleLabel(type)</option>
                                    }
                                </select>
                                @(ValidationMessageFor(AnnouncementScheduleFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Schedule)))
                            </div>
                            @if (announcement.Schedule is IntervalCustomAnnouncementScheduleEditor interval)
                            {
                                <div class="studio-span-6 space-y-2">
                                    <label class="label" for="@AnnouncementIntervalFieldId(announcement)">Send every (minutes)</label>
                                    <input id="@AnnouncementIntervalFieldId(announcement)"
                                           class="input"
                                           type="number"
                                           min="1"
                                           @attributes="ValidationAttributes(AnnouncementIntervalFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Interval))"
                                           @ref="_controls[AnnouncementIntervalFieldId(announcement)]"
                                           @bind="interval.IntervalMinutes" />
                                    @(ValidationMessageFor(AnnouncementIntervalFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Interval)))
                                </div>
                            }
                            else if (announcement.Schedule is IntervalAfterChatCustomAnnouncementScheduleEditor intervalAfterChat)
                            {
                                <div class="studio-span-6 space-y-2">
                                    <label class="label" for="@AnnouncementIntervalFieldId(announcement)">Send every (minutes)</label>
                                    <input id="@AnnouncementIntervalFieldId(announcement)"
                                           class="input"
                                           type="number"
                                           min="1"
                                           @attributes="ValidationAttributes(AnnouncementIntervalFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Interval))"
                                           @ref="_controls[AnnouncementIntervalFieldId(announcement)]"
                                           @bind="intervalAfterChat.IntervalMinutes" />
                                    @(ValidationMessageFor(AnnouncementIntervalFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Interval)))
                                </div>
                                <div class="studio-span-6 space-y-2">
                                    <label class="label" for="@AnnouncementChatMessagesFieldId(announcement)">Chat messages needed</label>
                                    <input id="@AnnouncementChatMessagesFieldId(announcement)"
                                           class="input"
                                           type="number"
                                           min="1"
                                           @attributes="ValidationAttributes(AnnouncementChatMessagesFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.ChatMessages))"
                                           @ref="_controls[AnnouncementChatMessagesFieldId(announcement)]"
                                           @bind="intervalAfterChat.RequiredChatMessages" />
                                    @(ValidationMessageFor(AnnouncementChatMessagesFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.ChatMessages)))
                                </div>
                            }
                            else if (announcement.Schedule is WeeklyCustomAnnouncementScheduleEditor weekly)
                            {
                                <div class="studio-span-6 space-y-2">
                                    <label class="label" for="@AnnouncementDayFieldId(announcement)">Day</label>
                                    <select id="@AnnouncementDayFieldId(announcement)"
                                            class="input"
                                            @attributes="ValidationAttributes(AnnouncementDayFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Day))"
                                            @ref="_controls[AnnouncementDayFieldId(announcement)]"
                                            @bind="weekly.Day">
                                        @foreach (var day in _daysOfWeek)
                                        {
                                            <option value="@day">@day</option>
                                        }
                                    </select>
                                    @(ValidationMessageFor(AnnouncementDayFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.Day)))
                                </div>
                                <div class="studio-span-6 space-y-2">
                                    <label class="label" for="@AnnouncementWeeklyTimeFieldId(announcement)">Time</label>
                                    <input id="@AnnouncementWeeklyTimeFieldId(announcement)" class="input" type="time" @bind="weekly.Time" />
                                </div>
                            }
                            <div class="studio-span-12" data-announcement-secondary="delivery-details">
                                <CollapsibleSection ContentId="custom-announcement-delivery-details"
                                                    Title="Delivery details"
                                                    Description="Retry policy and latest delivery"
                                                    InitiallyOpen="false"
                                                    OpenRequest="@AnnouncementAdvancedOpenRequest(announcement.Id)">
                                    <div class="studio-grid p-4">
                                        <div class="studio-span-6 space-y-2">
                                            <label class="label" for="@AnnouncementRetryDelayFieldId(announcement)">Wait before retrying (seconds)</label>
                                            <input id="@AnnouncementRetryDelayFieldId(announcement)"
                                                   class="input"
                                                   type="number"
                                                   min="1"
                                                   max="59"
                                                   @attributes="ValidationAttributes(AnnouncementRetryDelayFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.RetryDelay))"
                                                   @ref="_controls[AnnouncementRetryDelayFieldId(announcement)]"
                                                   @bind="announcement.RetryDelaySeconds" />
                                            @(ValidationMessageFor(AnnouncementRetryDelayFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.RetryDelay)))
                                        </div>
                                        <div class="studio-span-6 space-y-2">
                                            <label class="label" for="@AnnouncementOccurrenceLifetimeFieldId(announcement)">Stop retrying after (seconds)</label>
                                            <input id="@AnnouncementOccurrenceLifetimeFieldId(announcement)"
                                                   class="input"
                                                   type="number"
                                                   min="1"
                                                   max="60"
                                                   @attributes="ValidationAttributes(AnnouncementOccurrenceLifetimeFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.OccurrenceLifetime))"
                                                   @ref="_controls[AnnouncementOccurrenceLifetimeFieldId(announcement)]"
                                                   @bind="announcement.OccurrenceLifetimeSeconds" />
                                            @(ValidationMessageFor(AnnouncementOccurrenceLifetimeFieldId(announcement), AnnouncementTarget(announcement.Id, CustomCommandValidationFieldKind.OccurrenceLifetime)))
                                        </div>
                                    </div>
                                </CollapsibleSection>
                            </div>
                            <p id="@($"announcement-{announcement.Id}-delivery-timing-help")"
                               class="studio-span-12 text-xs font-medium text-slate-500">These timings apply only when a scheduled send cannot happen.</p>
                            <div class="studio-span-12" data-announcement-secondary="delivery-history">
                                <CollapsibleSection ContentId="custom-announcement-delivery-history"
                                                    Title="Delivery history"
                                                    Description="Last send and latest result"
                                                    InitiallyOpen="false">
                                    <div class="studio-grid p-4">
                                        <div class="studio-span-4 surface-row rounded-lg px-3 py-2">
                                            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Last sent</p>
                                            <p class="mt-1 text-sm font-semibold text-slate-900">@FormatLastSent(announcement.LastSentAtUtc)</p>
                                        </div>
                                        <div class="studio-span-4 surface-row rounded-lg px-3 py-2">
                                            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Latest delivery</p>
                                            <p class="mt-1 text-sm font-semibold text-slate-900">@LatestDeliveryResultLabel(announcement.LatestDeliveryResult)</p>
                                        </div>
                                        <div class="studio-span-4 surface-row rounded-lg px-3 py-2">
                                            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Chat messages since last announcement</p>
                                            <p class="mt-1 text-sm font-semibold text-slate-900">@announcement.ChatMessagesSinceLastSent</p>
                                        </div>
                                    </div>
                                </CollapsibleSection>
                            </div>
                            <div class="studio-span-12 flex justify-end">
                                <button class="btn-secondary" @onclick="() => RemoveAnnouncement(announcement)">Delete scheduled message</button>
                            </div>
                        </section>
                    }
                    else if (_selectedReply is { } entry)
                    {
                        <section @key="entry"
                                 id="@EditorRegionId(CustomCommandEditorKind.Reply, entry.Id)"
                                 class="studio-grid"
                                 role="region"
                                 aria-labelledby="@InventoryLabelId(CustomCommandEditorKind.Reply, entry.Id)"
                                 data-selected-editor="reply">
                            <div class="studio-span-6">
                                <Field Id="@MessageEntryNameFieldId(entry)"
                                       Label="Reply name"
                                       ErrorMessage="@ValidationMessage(ReplyTarget(entry.Id, CustomCommandValidationFieldKind.Name))"
                                       FocusRequest="@Math.Max(FocusRequestFor(ReplyTarget(entry.Id, CustomCommandValidationFieldKind.Name)), EditorFocusRequestFor(MessageEntryNameFieldId(entry)))"
                                       @bind-Value="entry.Name"
                                       Placeholder="welcome" />
                            </div>
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="@MessageSelectionFieldId(entry)">How the bot chooses</label>
                                <select id="@MessageSelectionFieldId(entry)"
                                        class="input"
                                        @attributes="ValidationAttributes(MessageSelectionFieldId(entry), ReplyTarget(entry.Id, CustomCommandValidationFieldKind.SelectionMode))"
                                        @ref="_controls[MessageSelectionFieldId(entry)]"
                                        @bind="entry.SelectionMode">
                                    @foreach (var mode in _messageSelectionModes)
                                    {
                                        <option value="@mode">@MessageSelectionLabel(mode)</option>
                                    }
                                </select>
                                @(ValidationMessageFor(MessageSelectionFieldId(entry), ReplyTarget(entry.Id, CustomCommandValidationFieldKind.SelectionMode)))
                            </div>
                            <div class="studio-span-6 space-y-2">
                                <label class="label" for="@MessageCurrentVariantFieldId(entry)">Next message</label>
                                <select id="@MessageCurrentVariantFieldId(entry)"
                                        class="input"
                                        disabled="@(entry.SelectionMode != CustomMessageSelectionMode.Sequential)"
                                        @bind="entry.CurrentVariantIndex">
                                    @for (var i = 0; i < entry.Variants.Count; i++)
                                    {
                                        var index = i;
                                        <option value="@index">Message @(index + 1)</option>
                                    }
                                </select>
                            </div>
                            <div class="studio-span-12 space-y-2">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Messages</p>
                                    <button id="@AddMessageVariantControlId(entry)"
                                            class="btn-secondary h-9 px-3 text-xs"
                                            @attributes="ValidationAttributes(AddMessageVariantControlId(entry), ReplyTarget(entry.Id, CustomCommandValidationFieldKind.VariantText))"
                                            @ref="_controls[AddMessageVariantControlId(entry)]"
                                            @onclick="() => AddVariant(entry)">Add message</button>
                                    @(ValidationMessageFor(AddMessageVariantControlId(entry), ReplyTarget(entry.Id, CustomCommandValidationFieldKind.VariantText)))
                                </div>
                                <p class="text-xs leading-5 text-muted-foreground">
                                    Pick fresh values with <code>{random_from|one|two}</code>,
                                    <code>{random_between|1|10}</code>, or <code>{random_viewer}</code>.
                                </p>
                                @for (var i = 0; i < entry.Variants.Count; i++)
                                {
                                    var index = i;
                                    var variant = entry.Variants[index];
                                    <div @key="variant" class="custom-command-variant">
                                        <span class="rank-indicator mt-7">@(index + 1)</span>
                                        <TextAreaField Id="@MessageVariantFieldId(entry, variant)"
                                                       Label="@($"Message {index + 1}")"
                                                       ErrorMessage="@ValidationMessage(VariantTarget(entry.Id, variant.Id))"
                                                       FocusRequest="@FocusRequestFor(VariantTarget(entry.Id, variant.Id))"
                                                       @bind-Value="variant.Text" />
                                        <div class="mt-7 flex flex-wrap gap-2">
                                            <button class="btn-secondary h-9 px-3 text-xs" disabled="@(index == 0)" @onclick="() => MoveVariant(entry, index, -1)">Up</button>
                                            <button class="btn-secondary h-9 px-3 text-xs" disabled="@(index == entry.Variants.Count - 1)" @onclick="() => MoveVariant(entry, index, 1)">Down</button>
                                            <button class="btn-secondary h-9 px-3 text-xs" @onclick="() => RemoveVariant(entry, variant)">Remove</button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="studio-span-12 flex justify-end">
                                <button class="btn-secondary" @onclick="() => RemoveMessageEntry(entry)">Delete reply</button>
                            </div>
                        </section>
                    }
                    else
                    {
                        <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground" data-empty-inspector>
                            @_emptyInspectorMessage
                        </p>
                    }
                </div>
            </div>
        </section>

        <div class="settings-disclosure-stack" data-card-owner="custom-command-disclosure-cards">
        <CollapsibleSection Title="Time zone"
                            Description="Weekly scheduled messages use this local time."
                            InitiallyOpen="false"
                            OpenRequest="@_timeZoneSectionOpenRequest">
            <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
                <div class="space-y-2">
                    <label class="label" for="@_timeZoneControlId">Time zone</label>
                    <select id="@_timeZoneControlId"
                            class="input"
                            @attributes="ValidationAttributes(_timeZoneControlId, ConfigurationTarget(CustomCommandValidationFieldKind.TimeZone))"
                            @ref="_controls[_timeZoneControlId]"
                            @bind="_config.TimeZoneId">
                        @foreach (var timeZone in _timeZones)
                        {
                            <option value="@timeZone.Id">@TimeZoneLabel(timeZone)</option>
                        }
                    </select>
                    @(ValidationMessageFor(_timeZoneControlId, ConfigurationTarget(CustomCommandValidationFieldKind.TimeZone)))
                </div>
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Selected time zone</p>
                    <p class="mt-1 break-words text-sm font-semibold text-slate-900">@_selectedTimeZoneLabel</p>
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Alerts" Description="Problems that may need your attention." InitiallyOpen="false">
            <div class="space-y-3 p-4">
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Active alerts</p>
                    <p class="mt-1 text-sm font-semibold text-slate-900">@_config.AlertSummary.ActiveCount</p>
                </div>
                @if (_config.AlertSummary.ActiveAlerts.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No active alerts.</p>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var alert in _config.AlertSummary.ActiveAlerts)
                        {
                            <div @key="alert" class="surface-row rounded-lg p-3">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <p class="text-sm font-bold text-slate-950">@alert.Title</p>
                                    <span class="inline-flex h-6 items-center rounded-full bg-slate-100 px-2.5 text-xs font-bold text-slate-600 ring-1 ring-slate-200">@AlertImportanceLabel(alert.Severity)</span>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">@alert.Message</p>
                                @if (!string.IsNullOrWhiteSpace(alert.LinkPath))
                                {
                                    <a class="mt-2 inline-flex text-sm font-semibold text-blue-700" href="@alert.LinkPath">Open alert</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>
        </div>
    }
</div>

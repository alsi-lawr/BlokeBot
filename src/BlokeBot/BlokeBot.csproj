<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\BlokeBot.Core\BlokeBot.Core.csproj" />
    <ProjectReference Include="..\BlokeBot.Persistence\BlokeBot.Persistence.csproj" />
    <ProjectReference Include="..\BlokeBot.Persistence.PostgreSql\BlokeBot.Persistence.PostgreSql.csproj" />
    <ProjectReference Include="..\BlokeBot.Plugins.Runtime\BlokeBot.Plugins.Runtime.csproj" />
    <ProjectReference
      Include="..\BlokeBot.PluginWorker\BlokeBot.PluginWorker.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>blokebot</AssemblyName>
    <PackageId>blokebot</PackageId>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Content
      Update="appsettings.Development.json;*.tokens.json;*.db;*.db-shm;*.db-wal"
      CopyToPublishDirectory="Never"
    />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <Target Name="PublishPluginWorker" AfterTargets="Publish">
    <PropertyGroup>
      <_PluginWorkerPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)plugin-worker'))</_PluginWorkerPublishDir>
      <_PluginWorkerRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''"
        >$(RuntimeIdentifier)</_PluginWorkerRuntimeIdentifier>
      <_PluginWorkerRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
        >$(NETCoreSdkRuntimeIdentifier)</_PluginWorkerRuntimeIdentifier>
    </PropertyGroup>
    <MSBuild
      Projects="..\BlokeBot.PluginWorker\BlokeBot.PluginWorker.csproj"
      Targets="Publish"
      BuildInParallel="false"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_PluginWorkerRuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(_PluginWorkerPublishDir);NoRestore=true"
    />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference
      Include="..\Alsi.TwitchBot\Alsi.TwitchBot.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="..\BlokeBot.Persistence\BlokeBot.Persistence.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <Target
    Name="RestoreNodePackages"
    Inputs="$(MSBuildProjectDirectory)/package-lock.json"
    Outputs="$(MSBuildProjectDirectory)/node_modules/.package-lock.json"
  >
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target
    Name="BuildTailwindCss"
    BeforeTargets="ComputeStaticWebAssets"
    DependsOnTargets="RestoreNodePackages"
  >
    <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>

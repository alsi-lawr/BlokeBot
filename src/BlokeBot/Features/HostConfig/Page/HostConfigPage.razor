@page "/host"
@using BlokeBot.Auth.Sessions
@using BlokeBot.Eventing
@using BlokeBot.Features.AccessLists
@using BlokeBot.Features.Admin.Authorization
@using BlokeBot.Features.HostConfig.Access
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Features.HostedChannels.Authorization
@using BlokeBot.Features.HostedChannels.Runtime
@using BlokeBot.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AuthenticatedPageComponent
@inject HostConfigService HostConfig
@inject HostFeatureService Features
@inject HostModAccessService ModAccess
@inject AccessListProfileResolver AccessListProfiles
@inject HostedChannelRuntimeControlService Runtime
@inject ChannelBotAuthorizationService ChannelBotAuthorization
@inject HostBotAccountAuthorizationService HostBotAccounts
@inject EventBus<AppEventKind> Events
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>BlokeBot | Channel Setup</PageTitle>

<div class="mx-auto max-w-5xl space-y-6">
    <PageHeader Kicker="Channel setup"
                Title="Channel setup"
                Description="Connect the bot, choose who can help, and turn chat tools on or off." />

    @if (blockedByMode)
    {
        <div class="card p-8 text-sm text-muted-foreground">Switch back to your own channel to change these settings.</div>
    }
    else if (state is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading channel setup...</div>
    }
    else if (!state.IsHostCreated)
    {
        <section class="card p-6">
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrWhiteSpace(state.ProfileImageUrl))
                {
                    <img class="h-14 w-14 rounded-full border border-slate-200 object-cover" src="@state.ProfileImageUrl" alt="" />
                }
                <div>
                    <h2 class="text-lg font-semibold text-slate-950">#@state.DisplayName</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Create your channel setup before turning on bot tools.</p>
                </div>
            </div>
            @if (state.CanCreateHost)
            {
                <a class="btn-primary mt-5" href="/host/create?returnUrl=/host" data-enhance-nav="false">Create channel setup</a>
            }
            else
            {
                <p class="mt-5 text-sm font-semibold text-slate-700">This Twitch account cannot create a BlokeBot channel setup yet.</p>
            }
        </section>
    }
    else if (state.HostId is { } hostId)
    {
        <CollapsibleSection Title="@($"#{state.DisplayName}")" Description="Connect the bot and start or stop it for your channel." InitiallyOpen="true">
            <div class="grid gap-3 p-4 lg:grid-cols-3">
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <div class="flex items-center justify-between gap-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Twitch chat</p>
                        <span class="@AuthorizationBadgeClass">
                            <span class="@AuthorizationDotClass"></span>
                            @AuthorizationText
                        </span>
                    </div>
                    @if (state.IsChannelBotAuthorized && state.RuntimeStatus?.ChannelBotAuthorizationScopesCurrent == true)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">The bot can chat in this channel.</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <AuthPopupButton Class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                             Url="/oauth/channel-bot/start"
                                             PopupName="blokebot-channel-oauth"
                                             OpeningText="Opening..."
                                             OnClosed="LoadAsync">
                                Reconnect channel
                            </AuthPopupButton>
                            <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="() => ClearChannelAuthorizationAsync(hostId)">Disconnect</button>
                        </div>
                    }
                    else if (state.IsChannelBotAuthorized)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">The bot needs a fresh Twitch connection for this channel.</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <AuthPopupButton Class="auth-action inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                             Url="/oauth/channel-bot/start"
                                             PopupName="blokebot-channel-oauth"
                                             OpeningText="Opening..."
                                             OnClosed="LoadAsync">
                                Reconnect channel
                            </AuthPopupButton>
                            <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="() => ClearChannelAuthorizationAsync(hostId)">Disconnect</button>
                        </div>
                    }
                    else
                    {
                        <AuthPopupButton Class="auth-action mt-2 inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition disabled:opacity-70"
                                         Url="/oauth/channel-bot/start"
                                         PopupName="blokebot-channel-oauth"
                                         OpeningText="Opening..."
                                         OnClosed="LoadAsync">
                            Connect channel
                        </AuthPopupButton>
                    }
                </div>
                <HostBotChannelStatusPanel HostLogin="@state.Login" ReloadKey="@BotAccountStatusReloadKey" />
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <div class="flex items-center justify-between gap-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bot status</p>
                        <span class="@RuntimeBadgeClass">
                            <span class="@RuntimeDotClass"></span>
                            @RuntimeText
                        </span>
                    </div>
                    <div class="mt-3 flex gap-2">
                        <button class="primary-control inline-flex h-8 items-center justify-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!CanStart)" @onclick="() => StartAsync(hostId)">Start</button>
                        <button class="control-surface inline-flex h-8 items-center justify-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!CanStop)" @onclick="() => StopAsync(hostId)">Stop</button>
                    </div>
                </div>
            </div>
        </CollapsibleSection>

        <BotAccountAuthorizationSection Status="@state.BotOverride.Status"
                                        Title="Use your own bot account"
                                        Description="Use a Twitch account you control as the bot for this channel."
                                        AuthorizeButtonText="Connect custom bot"
                                        AuthorizationStartUrl="/oauth/host-bot/start"
                                        Disabled="@(!state.BotOverride.Enabled)"
                                        DisabledMessage="Turn this on before connecting your own bot account."
                                        ConfiguredAccountFallbackText="custom bot account"
                                        ShowEnableToggle="true"
                                        EnableToggleValue="@state.BotOverride.Enabled"
                                        EnableToggleLabel="Use custom bot"
                                        EnableToggleChanged="enabled => SetBotOverrideEnabledAsync(hostId, enabled)"
                                        Clear="() => ClearBotOverrideAuthorizationAsync(hostId)"
                                        Refresh="LoadAsync"
                                        Collapsible="true"
                                        InitiallyOpen="true" />

        <CollapsibleSection Title="Moderator help" Description="Choose which mods can view and change this channel." InitiallyOpen="true">
            <div class="space-y-5 p-5">
                <div class="space-y-2">
                    <label class="flex items-center gap-3 text-sm font-semibold text-foreground">
                        <input class="h-4 w-4" type="checkbox" checked="@state.ModAccess.ModsEnabled" @onchange="args => SetModsEnabledAsync(hostId, args)" />
                        Let moderators help with this channel
                    </label>
                    <p class="text-sm text-muted-foreground">When this is off, your saved allow and block lists stay here, but mods cannot use them.</p>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm font-semibold text-foreground">Who can help?</p>
                        <p class="mt-1 text-sm text-muted-foreground">
                            @(state.ModAccess.AllowModsByDefault ? "All channel mods can help unless they are blocked." : "Only mods on the allowed list can help.")
                        </p>
                    </div>
                    <div class="@AccessModeSegmentClass" role="group" aria-label="Who can help with this channel">
                        <span class="segmented-motion__indicator" aria-hidden="true"></span>
                        <button class="@AccessModeTabClass(state.ModAccess.AllowModsByDefault)"
                                type="button"
                                aria-pressed="@state.ModAccess.AllowModsByDefault"
                                @onclick="() => SetAllowModsByDefault(hostId, true)">
                            All mods
                        </button>
                        <button class="@AccessModeTabClass(!state.ModAccess.AllowModsByDefault)"
                                type="button"
                                aria-pressed="@(!state.ModAccess.AllowModsByDefault)"
                                @onclick="() => SetAllowModsByDefault(hostId, false)">
                            Allowed list only
                        </button>
                    </div>
                </div>

                <div class="grid gap-5 lg:grid-cols-2">
                    <HostAccessList Title="Allowed mods"
                                    Entries="whitelistEntries"
                                    NewLogin="@newWhitelistLogin"
                                    NewLoginChanged="value => newWhitelistLogin = value"
                                    Add="() => AddAccessAsync(hostId, AccessListEntryKind.Whitelist)"
                                    Remove="login => RemoveAccessAsync(hostId, AccessListEntryKind.Whitelist, login)"
                                    Disabled="@(!state.ModAccess.ModsEnabled || state.ModAccess.AllowModsByDefault)" />

                    <HostAccessList Title="Blocked mods"
                                    Entries="blacklistEntries"
                                    NewLogin="@newBlacklistLogin"
                                    NewLoginChanged="value => newBlacklistLogin = value"
                                    Add="() => AddAccessAsync(hostId, AccessListEntryKind.Blacklist)"
                                    Remove="login => RemoveAccessAsync(hostId, AccessListEntryKind.Blacklist, login)"
                                    Disabled="@(!state.ModAccess.ModsEnabled || !state.ModAccess.AllowModsByDefault)" />
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Chat tools" Description="Turn on the bot tools you want in this channel." InitiallyOpen="true">
            <div class="grid gap-3 p-4 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var feature in state.Features)
                {
                    <button class="@FeatureCardClass(feature)"
                            type="button"
                            aria-pressed="@feature.Enabled"
                            @onclick="() => SetFeatureEnabledAsync(hostId, feature.Feature, !feature.Enabled)">
                        <span class="@FeatureIconClass(feature)">
                            @FeatureIcon(feature.Feature)
                        </span>
                        <span class="min-w-0">
                            <span class="flex items-center gap-2">
                                <span class="truncate text-sm font-bold text-slate-950">@feature.Name</span>
                                <span class="@FeatureBadgeClass(feature)">
                                    <span class="@FeatureDotClass(feature)"></span>
                                    @(feature.Enabled ? "on" : "off")
                                </span>
                            </span>
                            <span class="mt-1 block text-xs leading-5 text-muted-foreground">@feature.Description</span>
                        </span>
                    </button>
                }
            </div>
        </CollapsibleSection>
    }
</div>

@page "/host"
@using BlokeBot.Auth.Sessions
@using BlokeBot.Eventing
@using BlokeBot.Features.AccessLists
@using BlokeBot.Features.Admin.Authorization
@using BlokeBot.Features.HostConfig.Access
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Features.HostedChannels.Authorization
@using BlokeBot.Features.HostedChannels.Runtime
@using BlokeBot.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits AuthenticatedPageComponent
@inject HostConfigService HostConfig
@inject HostFeatureService Features
@inject HostModAccessService ModAccess
@inject AccessListProfileResolver AccessListProfiles
@inject HostedChannelRuntimeControlService Runtime
@inject ChannelBotAuthorizationService ChannelBotAuthorization
@inject HostBotAccountAuthorizationService HostBotAccounts
@inject EventBus<AppEventKind> Events
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>BlokeBot | Host config</PageTitle>

<div class="mx-auto max-w-5xl space-y-6">
    <div class="space-y-2">
        <div class="page-kicker inline-flex items-center rounded-full px-3 py-1 text-xs font-medium">
            Host config
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-950">Host config</h1>
        <p class="max-w-2xl text-sm leading-6 text-muted-foreground">Manage your channel access and bot runtime.</p>
    </div>

    @if (blockedByMode)
    {
        <div class="card p-8 text-sm text-muted-foreground">Select your own hosted channel to manage host config.</div>
    }
    else if (state is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading host config...</div>
    }
    else if (!state.IsHostCreated)
    {
        <section class="card p-6">
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrWhiteSpace(state.ProfileImageUrl))
                {
                    <img class="h-14 w-14 rounded-full border border-slate-200 object-cover" src="@state.ProfileImageUrl" alt="" />
                }
                <div>
                    <h2 class="text-lg font-semibold text-slate-950">#@state.DisplayName</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Create your hosted channel to configure bot functions.</p>
                </div>
            </div>
            @if (state.CanCreateHost)
            {
                <a class="btn-primary mt-5" href="/host/create?returnUrl=/host" data-enhance-nav="false">Create hosted channel</a>
            }
            else
            {
                <p class="mt-5 text-sm font-semibold text-slate-700">You do not currently have access to create a hosted channel.</p>
            }
        </section>
    }
    else if (state.HostId is { } hostId)
    {
        <section class="card">
            <div class="border-b border-slate-200 p-5">
                <h2 class="text-lg font-semibold text-slate-950">#@state.DisplayName</h2>
                <p class="mt-1 text-sm text-muted-foreground">Bot access and connection controls for your channel.</p>
            </div>
            <div class="grid gap-3 p-4 lg:grid-cols-3">
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <div class="flex items-center justify-between gap-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Authorization</p>
                        <span class="@AuthorizationBadgeClass">
                            <span class="@AuthorizationDotClass"></span>
                            @AuthorizationText
                        </span>
                    </div>
                    @if (state.IsChannelBotAuthorized && state.RuntimeStatus?.ChannelBotAuthorizationScopesCurrent == true)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">Channel chat authorization is current.</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <a class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold text-[#6f2bdc] transition" href="/oauth/channel-bot/start" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">Reauthorize channel</a>
                            <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="() => ClearChannelAuthorizationAsync(hostId)">Clear authorization</button>
                        </div>
                    }
                    else if (state.IsChannelBotAuthorized)
                    {
                        <p class="mt-2 text-xs font-medium text-slate-500">Channel chat authorization needs to be updated.</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                            <a class="inline-flex h-7 items-center rounded-full bg-[#9146ff] px-3 text-xs font-bold text-white shadow-sm transition hover:bg-[#7c3aed]" href="/oauth/channel-bot/start" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">Reauthorize channel</a>
                            <button class="control-surface inline-flex h-7 items-center rounded-full px-3 text-xs font-bold transition" @onclick="() => ClearChannelAuthorizationAsync(hostId)">Clear authorization</button>
                        </div>
                    }
                    else
                    {
                        <a class="mt-2 inline-flex h-7 items-center rounded-full bg-[#9146ff] px-3 text-xs font-bold text-white shadow-sm transition hover:bg-[#7c3aed]" href="/oauth/channel-bot/start" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">Authorize bot</a>
                    }
                </div>
                <HostBotChannelStatusPanel HostLogin="@state.Login" ReloadKey="@BotAccountStatusReloadKey" />
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <div class="flex items-center justify-between gap-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Runtime</p>
                        <span class="@RuntimeBadgeClass">
                            <span class="@RuntimeDotClass"></span>
                            @RuntimeText
                        </span>
                    </div>
                    <div class="mt-3 flex gap-2">
                        <button class="primary-control inline-flex h-8 items-center justify-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!CanStart)" @onclick="() => StartAsync(hostId)">Start</button>
                        <button class="control-surface inline-flex h-8 items-center justify-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!CanStop)" @onclick="() => StopAsync(hostId)">Stop</button>
                    </div>
                </div>
            </div>
        </section>

        <BotAccountAuthorizationSection Status="@state.BotOverride.Status"
                                        Title="Bot account override"
                                        Description="Use a Twitch account you control as the bot for this channel."
                                        AuthorizeButtonText="Authorize custom bot"
                                        AuthorizationStartUrl="/oauth/host-bot/start"
                                        Disabled="@(!state.BotOverride.Enabled)"
                                        DisabledMessage="Turn this on to authorize and use a channel-specific bot account."
                                        ConfiguredAccountFallbackText="custom bot account"
                                        ShowEnableToggle="true"
                                        EnableToggleValue="@state.BotOverride.Enabled"
                                        EnableToggleLabel="Use custom bot"
                                        EnableToggleChanged="enabled => SetBotOverrideEnabledAsync(hostId, enabled)"
                                        Clear="() => ClearBotOverrideAuthorizationAsync(hostId)"
                                        Refresh="LoadAsync" />

        <section class="card">
            <div class="border-b border-slate-200 p-5">
                <h2 class="text-lg font-semibold text-slate-950">Moderator access</h2>
                <p class="mt-1 text-sm text-muted-foreground">Choose which moderators can view and edit this channel.</p>
            </div>
            <div class="space-y-5 p-5">
                <div class="space-y-2">
                    <label class="flex items-center gap-3 text-sm font-semibold text-foreground">
                        <input class="h-4 w-4" type="checkbox" checked="@state.ModAccess.ModsEnabled" @onchange="args => SetModsEnabledAsync(hostId, args)" />
                        Allow moderators to view and edit this channel
                    </label>
                    <p class="text-sm text-muted-foreground">When this is off, moderator access is disabled but your saved allow and block lists are kept.</p>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm font-semibold text-foreground">Allow moderators by default</p>
                        <p class="mt-1 text-sm text-muted-foreground">
                            @(state.ModAccess.AllowModsByDefault ? "Moderators can access unless they are on the blocked list." : "Only moderators on the allowed list can access.")
                        </p>
                    </div>
                    <div class="@AccessModeSegmentClass" role="group" aria-label="Moderator access mode">
                        <span class="segmented-motion__indicator" aria-hidden="true"></span>
                        <button class="@AccessModeTabClass(state.ModAccess.AllowModsByDefault)"
                                type="button"
                                aria-pressed="@state.ModAccess.AllowModsByDefault"
                                @onclick="() => SetAllowModsByDefaultAsync(hostId, true)">
                            Allow by default
                        </button>
                        <button class="@AccessModeTabClass(!state.ModAccess.AllowModsByDefault)"
                                type="button"
                                aria-pressed="@(!state.ModAccess.AllowModsByDefault)"
                                @onclick="() => SetAllowModsByDefaultAsync(hostId, false)">
                            Require allow list
                        </button>
                    </div>
                </div>

                <div class="grid gap-5 lg:grid-cols-2">
                    <HostAccessList Title="Allowed moderators"
                                    Entries="whitelistEntries"
                                    NewLogin="@newWhitelistLogin"
                                    NewLoginChanged="value => newWhitelistLogin = value"
                                    Add="() => AddAccessAsync(hostId, AccessListEntryKind.Whitelist)"
                                    Remove="login => RemoveAccessAsync(hostId, AccessListEntryKind.Whitelist, login)"
                                    Disabled="@(!state.ModAccess.ModsEnabled || state.ModAccess.AllowModsByDefault)" />

                    <HostAccessList Title="Blocked moderators"
                                    Entries="blacklistEntries"
                                    NewLogin="@newBlacklistLogin"
                                    NewLoginChanged="value => newBlacklistLogin = value"
                                    Add="() => AddAccessAsync(hostId, AccessListEntryKind.Blacklist)"
                                    Remove="login => RemoveAccessAsync(hostId, AccessListEntryKind.Blacklist, login)"
                                    Disabled="@(!state.ModAccess.ModsEnabled || !state.ModAccess.AllowModsByDefault)" />
                </div>
            </div>
        </section>

        <section class="space-y-3">
            <div>
                <h2 class="text-lg font-semibold text-slate-950">Bot functions</h2>
                <p class="mt-1 text-sm text-muted-foreground">Turn on the chat tools you want available in this channel.</p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var feature in state.Features)
                {
                    <button class="@FeatureCardClass(feature)"
                            type="button"
                            aria-pressed="@feature.Enabled"
                            @onclick="() => SetFeatureEnabledAsync(hostId, feature.Feature, !feature.Enabled)">
                        <span class="@FeatureIconClass(feature)">
                            @FeatureIcon(feature.Feature)
                        </span>
                        <span class="min-w-0">
                            <span class="flex items-center gap-2">
                                <span class="truncate text-sm font-bold text-slate-950">@feature.Name</span>
                                <span class="@FeatureBadgeClass(feature)">
                                    <span class="@FeatureDotClass(feature)"></span>
                                    @(feature.Enabled ? "on" : "off")
                                </span>
                            </span>
                            <span class="mt-1 block text-xs leading-5 text-muted-foreground">@feature.Description</span>
                        </span>
                    </button>
                }
            </div>
        </section>
    }
</div>

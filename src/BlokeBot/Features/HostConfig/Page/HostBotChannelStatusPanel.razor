@inherits BackgroundLoadComponent<HostBotChannelStatus>
@inject HostBotStatusService HostBotStatus

<div class="surface-muted rounded-lg px-3 py-2.5">
    <div class="flex items-center justify-between gap-3">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bot checks</p>
    </div>
    <div class="mt-3 space-y-3">
        <div>
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-semibold text-slate-600">Bot is a mod</p>
                <span class="@ModeratorStatusBadgeClass">
                    <span class="@ModeratorStatusDotClass"></span>
                    @ModeratorStatusText
                </span>
            </div>
            <p class="mt-1 text-xs font-medium text-slate-500">@ModeratorStatusMessage</p>
        </div>
        <div>
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-semibold text-slate-600">Follower giveaways</p>
                <span class="@FollowerReadStatusBadgeClass">
                    <span class="@FollowerReadStatusDotClass"></span>
                    @FollowerReadStatusText
                </span>
            </div>
            <p class="mt-1 text-xs font-medium text-slate-500">@FollowerReadStatusMessage</p>
        </div>
    </div>
</div>

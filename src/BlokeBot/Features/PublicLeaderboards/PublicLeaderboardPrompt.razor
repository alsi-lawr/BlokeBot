@using BlokeBot.Twitch
@inject NavigationManager _navigation

<div class="@ContainerClass">
    <p class="text-sm font-bold text-slate-950">Public leaderboard</p>
    <div class="mt-3 grid gap-3">
        <select class="input" aria-label="Leaderboard feature" @bind="_feature">
            <option value="guessing">Guessing</option>
            <option value="points">Points</option>
        </select>
        <input class="input" placeholder="channel" aria-label="Channel" @bind="_channel" @bind:event="oninput" />
        <button class="btn-secondary h-10 w-full disabled:cursor-not-allowed disabled:opacity-50"
                type="button"
                disabled="@(!_canNavigate)"
                @onclick="OpenLeaderboard">
            View leaderboard
        </button>
    </div>
</div>

@code {
    private string _channel = string.Empty;
    private string _feature = "guessing";
    private string? _normalizedInitialChannel;

    [Parameter]
    public string ContainerClass { get; set; } = "mt-6 border-t border-slate-200 pt-5";

    [Parameter]
    public string? InitialChannel { get; set; }

    private bool _canNavigate => _normalizedChannel.Length > 0;

    private string _normalizedChannel => TwitchLogin.Normalize(_channel);

    protected override void OnParametersSet()
    {
        var normalized = TwitchLogin.Normalize(InitialChannel);
        if (normalized.Length == 0 || normalized == _normalizedInitialChannel)
        {
            return;
        }

        _normalizedInitialChannel = normalized;
        if (string.IsNullOrWhiteSpace(_channel))
        {
            _channel = normalized;
        }
    }

    private void OpenLeaderboard()
    {
        if (!_canNavigate)
        {
            return;
        }

        _navigation.NavigateTo($"/{_feature}/leaderboard/{Uri.EscapeDataString(_normalizedChannel)}");
    }
}

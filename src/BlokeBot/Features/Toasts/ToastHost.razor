@rendermode InteractiveServer
@implements IDisposable
@inject ToastService Toasts

@if (visibleToasts.Count > 0)
{
    <section class="toast-region" aria-label="Notifications" aria-live="polite" aria-atomic="false">
        @foreach (var toast in visibleToasts)
        {
            <article @key="toast.Id" class="@ToastClass(toast)" role="@ToastRole(toast)">
                <span class="toast-card__stripe" aria-hidden="true"></span>
                <div class="toast-card__body">
                    <div class="toast-card__header">
                        <span class="toast-card__dot" aria-hidden="true"></span>
                        <p class="toast-card__title">@toast.Title</p>
                        @if (toast.RequiresManualDismiss)
                        {
                            <span class="toast-card__manual">Manual</span>
                        }
                    </div>
                    <p class="toast-card__message">@toast.Message</p>
                </div>
                <button class="toast-card__close"
                        type="button"
                        aria-label="Dismiss notification"
                        @onclick="() => BeginDismissAsync(toast.Id)">
                    <span aria-hidden="true">x</span>
                </button>
            </article>
        }
    </section>
}

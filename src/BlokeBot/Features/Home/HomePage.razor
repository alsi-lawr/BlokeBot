@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>BlokeBot | Home</PageTitle>

<div class="home-page app-motion-stack mx-auto max-w-5xl space-y-6">
    <section class="space-y-3">
        <div class="page-kicker inline-flex items-center rounded-full px-3 py-1 text-xs font-medium">Home</div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-950">BlokeBot</h1>
        <p class="max-w-3xl text-sm leading-6 text-muted-foreground">Run Twitch chat games and points from one place. Set up your channel, choose the tools you want, and let the bot handle chat during stream.</p>
    </section>

    <section class="grid gap-4 md:grid-cols-2">
        <HomeInfoCard Title="Set up your channel" Icon="@HomeInfoCardIcon.Channel">
            Connect the bot to your Twitch channel and keep your stream tools separate from everyone else's.
        </HomeInfoCard>

        <HomeInfoCard Title="Choose your chat tools" Icon="@HomeInfoCardIcon.Points">
            Turn on guessing rounds, points, giveaways, or only the features that make sense for your stream.
        </HomeInfoCard>

        <HomeInfoCard Title="Let trusted mods help" Icon="@HomeInfoCardIcon.Moderators">
            Let the mods you trust help run your channel tools, then change who can help whenever you need.
        </HomeInfoCard>

        <HomeInfoCard Title="Keep the bot ready" Icon="@HomeInfoCardIcon.Bot">
            Check whether the bot can chat in your stream, then start or stop it from your channel page.
        </HomeInfoCard>
    </section>

    <section class="home-note rounded-lg p-5">
        <p class="text-sm leading-6 text-muted-foreground">BlokeBot is built around your Twitch channel: connect the bot, pick the chat tools you want, and choose who can help manage them.</p>
    </section>
</div>

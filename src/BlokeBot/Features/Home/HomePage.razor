@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>BlokeBot | Home</PageTitle>

<div class="home-page app-motion-stack mx-auto max-w-5xl space-y-6">
    <section class="space-y-3">
        <div class="page-kicker inline-flex items-center rounded-full px-3 py-1 text-xs font-medium">Home</div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-950">BlokeBot</h1>
        <p class="max-w-3xl text-sm leading-6 text-muted-foreground">Run Twitch chat games and points without handing out more access than your stream needs. Set up your channel, choose the tools you want, and let the bot handle chat during stream.</p>
    </section>

    <section class="grid gap-4 md:grid-cols-2">
        <article class="home-info-card rounded-lg p-5">
            <span class="home-info-card__icon text-blue-600">
                <svg class="h-5 w-5 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 10.5 12 4l8 6.5V20H4Z" />
                    <path d="M9 20v-6h6v6" />
                </svg>
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Set up your channel</h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">Connect the bot to your Twitch channel and keep your stream settings separate from everyone else's.</p>
        </article>

        <article class="home-info-card rounded-lg p-5">
            <span class="home-info-card__icon text-emerald-600">
                <svg class="h-5 w-5 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3v18" />
                    <path d="M17 7.5c0-1.4-1.6-2.5-5-2.5S7 6.1 7 7.5 8.6 10 12 10s5 1.1 5 2.5-1.6 2.5-5 2.5-5-1.1-5-2.5" />
                </svg>
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Choose your chat tools</h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">Turn on guessing rounds, points, giveaways, or only the features that make sense for your stream.</p>
        </article>

        <article class="home-info-card rounded-lg p-5">
            <span class="home-info-card__icon text-teal-700">
                <svg class="h-5 w-5 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 11V8a6 6 0 0 1 12 0v3" />
                    <path d="M5 11h14v9H5Z" />
                    <path d="M12 15v2" />
                </svg>
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Let trusted mods help</h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">Give moderators access to help run the channel tools, then change that access whenever you need.</p>
        </article>

        <article class="home-info-card rounded-lg p-5">
            <span class="home-info-card__icon text-slate-600">
                <svg class="h-5 w-5 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12a7 7 0 0 1 14 0" />
                    <path d="M7 12h10" />
                    <path d="M12 7v5l3 3" />
                    <path d="M6 17h12" />
                </svg>
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Keep the bot ready</h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">Check whether the bot is connected, refresh its channel access, and start or stop it from your channel page.</p>
        </article>
    </section>

    <section class="home-note rounded-lg p-5">
        <p class="text-sm leading-6 text-muted-foreground">BlokeBot is built around your Twitch channel: connect the bot, pick the chat features you want, and keep control over who can manage them.</p>
    </section>
</div>

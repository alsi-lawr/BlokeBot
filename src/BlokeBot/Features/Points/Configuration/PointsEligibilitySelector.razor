@inherits BackgroundLoadComponent<HostBotChannelStatus>
@using BlokeBot.Persistence.Models
@inject HostBotStatusService HostBotStatus

<div class="space-y-2">
    <label class="label" for="eligibility">Eligibility</label>
    <select id="eligibility" class="input" title="@FollowerEligibilityTitle" value="@Value" @onchange="OnEligibilityChangedAsync">
        <option value="@PointsEligibilityMode.Everyone">Everyone</option>
        <option value="@PointsEligibilityMode.Subscribers">Subscribers</option>
        <option value="@PointsEligibilityMode.Followers" disabled="@(!FollowerEligibilityAvailable)" title="@FollowerEligibilityTitle">Followers</option>
    </select>
    <p class="text-xs font-medium text-slate-500">@FollowerEligibilityTitle</p>
</div>

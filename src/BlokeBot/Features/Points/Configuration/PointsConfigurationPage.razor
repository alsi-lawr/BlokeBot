@page "/points/settings"
@using BlokeBot.Eventing
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Features.Points.Replies
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject PointsConfigurationService Configuration
@inject HostFeatureService Features
@inject EventBus<AppEventKind> Events
@inject ToastService Toasts

<PageTitle>BlokeBot | Points Settings</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Points settings"
                Description="Point names, chat commands, gambling odds, giveaways, and bot replies.">
        <button class="btn-primary" disabled="@(!featureEnabled || config is null)" @onclick="SaveAsync">Save changes</button>
    </PageHeader>

    @if (Host is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
    }
    else if (!featureEnabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Points is off for this channel. Turn it on in Channel setup.</div>
    }
    else if (config is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading points settings...</div>
    }
    else
    {
        <CollapsibleSection Title="General" Description="What points are called and how gambling works." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-2">
                <Field Label="Point label" @bind-Value="config.PointLabel" Placeholder="points" />
                <div class="space-y-2">
                    <label class="label" for="winRate">Gambling win rate</label>
                    <input id="winRate" class="input" type="number" min="0" max="100" @bind="config.GamblingWinRatePercent" />
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Chat commands" Description="Use commas when a command has more than one name." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-2">
                <Field Label="Balance" @bind-Value="config.Aliases.PointsAliases" Placeholder="points" />
                <Field Label="Give" @bind-Value="config.Aliases.GivePointsAliases" Placeholder="givepoints" />
                <Field Label="Add" @bind-Value="config.Aliases.AddPointsAliases" Placeholder="addpoints" />
                <Field Label="Remove" @bind-Value="config.Aliases.RemovePointsAliases" Placeholder="removepoints" />
                <Field Label="Gamble" @bind-Value="config.Aliases.GambleAliases" Placeholder="gamble" />
                <Field Label="Start giveaway" @bind-Value="config.Aliases.GiveawayAliases" Placeholder="giveaway" />
                <Field Label="Join giveaway" @bind-Value="config.Aliases.JoinAliases" Placeholder="join" />
                <Field Label="End giveaway" @bind-Value="config.Aliases.EndGiveawayAliases" Placeholder="endgiveaway" />
                <Field Label="Cancel giveaway" @bind-Value="config.Aliases.CancelGiveawayAliases" Placeholder="cancelgiveaway" />
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Giveaways" Description="Prizes, timing, and who can enter." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-3">
                <div class="space-y-2">
                    <label class="label" for="duration">Duration in seconds</label>
                    <input id="duration" class="input" type="number" min="1" @bind="config.GiveawayDurationSeconds" />
                </div>
                <Field Label="Minimum payout" @bind-Value="config.GiveawayMinimumPayout" Placeholder="10" />
                <Field Label="Maximum payout" @bind-Value="config.GiveawayMaximumPayout" Placeholder="100" />
                <div class="space-y-2">
                    <label class="label" for="winnerCount">Number of winners</label>
                    <input id="winnerCount" class="input" type="number" min="1" @bind="config.GiveawayWinnerCount" />
                </div>
                <PointsEligibilitySelector HostLogin="@Host.Login" @bind-Value="config.GiveawayEligibility" />
                <div class="space-y-2">
                    <label class="label" for="cooldown">Time between giveaways in seconds</label>
                    <input id="cooldown" class="input" type="number" min="@PointsConfigurationService.MinimumGiveawayCooldownSeconds" @bind="config.GiveawayCooldownSeconds" />
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Bot replies" Description="Messages the bot sends in chat." InitiallyOpen="false">
            <div class="scroll-panel scroll-panel--settings grid gap-4 p-4 md:grid-cols-2">
                <ReplyTextAreaField Label="Balance" ReplyKey="@PointsReplyKeys.Balance" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.BalanceReply" />
                <ReplyTextAreaField Label="Other balance" ReplyKey="@PointsReplyKeys.OtherBalance" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.OtherBalanceReply" />
                <ReplyTextAreaField Label="Transfer" ReplyKey="@PointsReplyKeys.Transfer" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.TransferReply" />
                <ReplyTextAreaField Label="Add" ReplyKey="@PointsReplyKeys.Add" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.AddReply" />
                <ReplyTextAreaField Label="Remove" ReplyKey="@PointsReplyKeys.Remove" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.RemoveReply" />
                <ReplyTextAreaField Label="Invalid amount" ReplyKey="@PointsReplyKeys.InvalidAmount" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.InvalidAmountReply" />
                <ReplyTextAreaField Label="Insufficient balance" ReplyKey="@PointsReplyKeys.InsufficientBalance" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.InsufficientBalanceReply" />
                <ReplyTextAreaField Label="Moderator only" ReplyKey="@PointsReplyKeys.ModeratorOnly" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.ModeratorOnlyReply" />
                <ReplyTextAreaField Label="Gamble win" ReplyKey="@PointsReplyKeys.GamblingWin" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GamblingWinReply" />
                <ReplyTextAreaField Label="Gamble loss" ReplyKey="@PointsReplyKeys.GamblingLose" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GamblingLoseReply" />
                <ReplyTextAreaField Label="Giveaway started" ReplyKey="@PointsReplyKeys.GiveawayStarted" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayStartedReply" />
                <TextAreaField Label="Giveaway update" @bind-Value="config.Replies.GiveawayUpdateReply" />
                <ReplyTextAreaField Label="Giveaway joined" ReplyKey="@PointsReplyKeys.GiveawayJoined" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayJoinedReply" />
                <ReplyTextAreaField Label="Already joined" ReplyKey="@PointsReplyKeys.GiveawayAlreadyJoined" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayAlreadyJoinedReply" />
                <ReplyTextAreaField Label="Giveaway ended" ReplyKey="@PointsReplyKeys.GiveawayEnded" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayEndedReply" />
                <ReplyTextAreaField Label="No entrants" ReplyKey="@PointsReplyKeys.GiveawayNoEntrants" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayNoEntrantsReply" />
                <ReplyTextAreaField Label="Cancelled" ReplyKey="@PointsReplyKeys.GiveawayCancelled" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayCancelledReply" />
                <ReplyTextAreaField Label="Already active" ReplyKey="@PointsReplyKeys.GiveawayAlreadyActive" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayAlreadyActiveReply" />
                <ReplyTextAreaField Label="Not active" ReplyKey="@PointsReplyKeys.GiveawayNotActive" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayNotActiveReply" />
                <ReplyTextAreaField Label="Cooldown" ReplyKey="@PointsReplyKeys.GiveawayCooldown" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.GiveawayCooldownReply" />
                <ReplyTextAreaField Label="Stream offline" ReplyKey="@PointsReplyKeys.StreamOffline" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.StreamOfflineReply" />
                <ReplyTextAreaField Label="Not eligible" ReplyKey="@PointsReplyKeys.NotEligible" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.NotEligibleReply" />
                <ReplyTextAreaField Label="Followers-only unavailable" ReplyKey="@PointsReplyKeys.FollowerEligibilityUnavailable" Delivery="config.ReplyDelivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="config.Replies.FollowerEligibilityUnavailableReply" />
            </div>
        </CollapsibleSection>
    }
</div>

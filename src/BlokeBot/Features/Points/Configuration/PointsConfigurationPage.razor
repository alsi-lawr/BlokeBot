@page "/points/settings"
@using BlokeBot.Eventing
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject PointsConfigurationService _configuration
@inject HostFeatureService _features
@inject EventBus<AppEventKind> _events
@inject ToastService _toasts

<PageTitle>BlokeBot | Points Settings</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Points settings"
                Description="Choose point names, chat commands, chances of winning, giveaways, and what the bot says.">
        <button class="btn-primary" disabled="@(!_featureEnabled || _config is null)" @onclick="SaveAsync">Save changes</button>
    </PageHeader>

    @if (Host is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
    }
    else if (!_featureEnabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Points is off for this channel. Turn it on in Channel setup.</div>
    }
    else if (_config is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading points settings...</div>
    }
    else
    {
        <CollapsibleSection Title="General" Description="What points are called and how gambling works." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-3">
                <Field Label="Point label" @bind-Value="_config.PointLabel" Placeholder="points" />
                <div class="space-y-2">
                    <label class="label" for="winRate">Chance of winning (%)</label>
                    <input id="winRate" class="input" type="number" min="0" max="100" @bind="_config.GamblingWinRatePercent" />
                </div>
                <div class="space-y-2">
                    <label class="label" for="gamblingCooldown">Wait between gambles (seconds)</label>
                    <input id="gamblingCooldown" class="input" type="number" min="0" @bind="_config.GamblingCooldownSeconds" />
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Chat commands" Description="Separate extra command words with commas." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-2">
                <Field Label="Balance" @bind-Value="_config.Aliases.PointsAliases" Placeholder="points" />
                <Field Label="Give" @bind-Value="_config.Aliases.GivePointsAliases" Placeholder="givepoints" />
                <Field Label="Add" @bind-Value="_config.Aliases.AddPointsAliases" Placeholder="addpoints" />
                <Field Label="Remove" @bind-Value="_config.Aliases.RemovePointsAliases" Placeholder="removepoints" />
                <Field Label="Gamble" @bind-Value="_config.Aliases.GambleAliases" Placeholder="gamble" />
                <Field Label="Start giveaway" @bind-Value="_config.Aliases.GiveawayAliases" Placeholder="giveaway" />
                <Field Label="Join giveaway" @bind-Value="_config.Aliases.JoinAliases" Placeholder="join" />
                <Field Label="End giveaway" @bind-Value="_config.Aliases.EndGiveawayAliases" Placeholder="endgiveaway" />
                <Field Label="Cancel giveaway" @bind-Value="_config.Aliases.CancelGiveawayAliases" Placeholder="cancelgiveaway" />
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Giveaways" Description="Prizes, timing, and who can enter." InitiallyOpen="true">
            <div class="grid gap-4 p-4 md:grid-cols-3">
                <div class="space-y-2">
                    <label class="label" for="duration">Time to enter (seconds)</label>
                    <input id="duration" class="input" type="number" min="1" @bind="_config.GiveawayDurationSeconds" />
                </div>
                <Field Label="Smallest prize" @bind-Value="_config.GiveawayMinimumPayout" Placeholder="10" />
                <Field Label="Largest prize" @bind-Value="_config.GiveawayMaximumPayout" Placeholder="100" />
                <div class="space-y-2">
                    <label class="label" for="winnerCount">Number of winners</label>
                    <input id="winnerCount" class="input" type="number" min="1" @bind="_config.GiveawayWinnerCount" />
                </div>
                <PointsEligibilitySelector HostLogin="@Host.Login" @bind-Value="_config.GiveawayEligibility" />
                <div class="space-y-2">
                    <label class="label" for="cooldown">Wait between giveaways (seconds)</label>
                    <input id="cooldown" class="input" type="number" min="@PointsConfigurationValidator.MinimumGiveawayCooldownSeconds" @bind="_config.GiveawayCooldownSeconds" />
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Bot replies" Description="Messages the bot sends for points commands." InitiallyOpen="false">
            <div class="scroll-panel scroll-panel--settings grid gap-4 p-4 md:grid-cols-2">
                <TextAreaField Label="Balance" @bind-Value="_config.Replies.BalanceReply" />
                <TextAreaField Label="Another viewer's balance" @bind-Value="_config.Replies.OtherBalanceReply" />
                <TextAreaField Label="Points given" @bind-Value="_config.Replies.TransferReply" />
                <TextAreaField Label="Moderator adds points" @bind-Value="_config.Replies.AddReply" />
                <TextAreaField Label="Moderator removes points" @bind-Value="_config.Replies.RemoveReply" />
                <TextAreaField Label="Amount not understood" @bind-Value="_config.Replies.InvalidAmountReply" />
                <TextAreaField Label="Not enough points" @bind-Value="_config.Replies.InsufficientBalanceReply" />
                <TextAreaField Label="Only moderators can use this" @bind-Value="_config.Replies.ModeratorOnlyReply" />
                <TextAreaField Label="Gamble win" @bind-Value="_config.Replies.GamblingWinReply" />
                <TextAreaField Label="Gamble loss" @bind-Value="_config.Replies.GamblingLoseReply" />
                <TextAreaField Label="Giveaway started" @bind-Value="_config.Replies.GiveawayStartedReply" />
                <TextAreaField Label="Giveaway status" @bind-Value="_config.Replies.GiveawayUpdateReply" />
                <TextAreaField Label="Giveaway joined" @bind-Value="_config.Replies.GiveawayJoinedReply" />
                <TextAreaField Label="Already joined" @bind-Value="_config.Replies.GiveawayAlreadyJoinedReply" />
                <TextAreaField Label="Giveaway ended" @bind-Value="_config.Replies.GiveawayEndedReply" />
                <TextAreaField Label="No one joined" @bind-Value="_config.Replies.GiveawayNoEntrantsReply" />
                <TextAreaField Label="Cancelled" @bind-Value="_config.Replies.GiveawayCancelledReply" />
                <TextAreaField Label="Giveaway already running" @bind-Value="_config.Replies.GiveawayAlreadyActiveReply" />
                <TextAreaField Label="No giveaway running" @bind-Value="_config.Replies.GiveawayNotActiveReply" />
                <TextAreaField Label="Giveaway used too recently" @bind-Value="_config.Replies.GiveawayCooldownReply" />
                <TextAreaField Label="Stream is offline" @bind-Value="_config.Replies.StreamOfflineReply" />
                <TextAreaField Label="Viewer cannot enter" @bind-Value="_config.Replies.NotEligibleReply" />
                <TextAreaField Label="Follower check unavailable" @bind-Value="_config.Replies.FollowerEligibilityUnavailableReply" />
            </div>
        </CollapsibleSection>

        <ReplyDeliverySettingsSection Delivery="_config.ReplyDelivery"
                                      WhisperResponsesEnabled="_config.WhisperResponsesEnabled"
                                      Options="_whisperReplyOptions" />
    }
</div>

@page "/admin"
@rendermode InteractiveServer
@using Alsi.TwitchBot
@using BlokeBot.Auth.Users
@using BlokeBot.AppEvents
@using BlokeBot.Features.Admin.Authorization
@using BlokeBot.Features.Admin.HostedChannels
@using BlokeBot.Features.Admin.SiteAccess
@using BlokeBot.Features.HostedChannels.Authorization
@using BlokeBot.Features.HostedChannels.Runtime
@using BlokeBot.Features.SiteAccess
@using BlokeBot.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "BotAdmin")]
@implements IDisposable
@inject SiteAccessService SiteAccess
@inject BotHostProvisioningService HostProvisioning
@inject HostedChannelRemovalService HostedChannelRemoval
@inject HostedChannelRuntimeControlService HostedChannelRuntime
@inject HostedChannelDirectoryService HostedChannels
@inject BotAccountAuthorizationService BotAccountAuthorization
@inject UserLookupService Users
@inject AppEventBus Events
@inject NavigationManager Navigation
@inject BlokeBotPageContextAccessor PageContext

<PageTitle>BlokeBot | Admin</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-2">
            <h1 class="text-3xl font-bold tracking-tight text-slate-950">Admin</h1>
            <p class="max-w-2xl text-sm leading-6 text-muted-foreground">Host access and channel management.</p>
        </div>
    </div>

    @if (state is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading admin settings...</div>
    }
    else
    {
        <BotAccountAuthorizationSection Status="@botAccountStatus"
                                        Clear="@ClearBotAccountAuthorizationAsync"
                                        Refresh="@RefreshBotAccountAuthorizationAsync" />

        <SiteAccessSection State="@state"
                           AddBlacklist="@AddBlacklistAsync"
                           AddWhitelist="@AddWhitelistAsync"
                           RemoveBlacklist="@RemoveBlacklistAsync"
                           RemoveWhitelist="@RemoveWhitelistAsync"
                           ToggleWhitelist="@ToggleWhitelistAsync"
                           @bind-NewBlacklistLogin="newBlacklistLogin"
                           @bind-NewWhitelistLogin="newWhitelistLogin" />

        <HostedChannelsSection Hosts="@hosts"
                               Status="@hostStatus"
                               CreateHost="@CreateHostAsync"
                               CanEditHosts="@(!isBotAccount)"
                               RemoveHost="@RemoveHostAsync"
                               StartBot="@StartBotAsync"
                               StopBot="@StopBotAsync"
                               @bind-NewHostLogin="newHostLogin" />
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = Task.FromResult(new AuthenticationState(new()));

    private SiteAccessAdminState? state;
    private BotAccountAuthorizationStatus? botAccountStatus;
    private IReadOnlyList<HostedChannelAdminView> hosts = [];
    private bool isBotAccount;
    private IDisposable? adminStateSubscription;
    private string? hostStatus;
    private int? pendingRuntimeHostId;
    private string newBlacklistLogin = string.Empty;
    private string newHostLogin = string.Empty;
    private string newWhitelistLogin = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        adminStateSubscription = Events.SubscribeForComponentRefresh(
            [AppEventKind.HostedChannelsChanged, AppEventKind.SiteAccessChanged],
            work => InvokeAsync(work),
            ReloadForEventAsync,
            StateHasChanged
        );
        await LoadAsync();
    }

    public void Dispose()
    {
        adminStateSubscription?.Dispose();
    }

    private async Task AddBlacklistAsync()
    {
        await SiteAccess.AddEntryAsync(AccessListEntryKind.Blacklist, newBlacklistLogin, CancellationToken.None);
        newBlacklistLogin = string.Empty;
        await LoadAsync();
    }

    private async Task AddWhitelistAsync()
    {
        await SiteAccess.AddEntryAsync(AccessListEntryKind.Whitelist, newWhitelistLogin, CancellationToken.None);
        newWhitelistLogin = string.Empty;
        await LoadAsync();
    }

    private async Task CreateHostAsync()
    {
        pendingRuntimeHostId = null;
        hostStatus = null;
        TwitchHelixUser? user;
        try
        {
            user = await Users.FindByLoginAsync(newHostLogin, CancellationToken.None);
        }
        catch (InvalidOperationException)
        {
            hostStatus = "Authorize the bot account before creating hosted channels.";
            return;
        }
        catch (HttpRequestException)
        {
            hostStatus = "Twitch user lookup failed.";
            return;
        }

        if (user is null || string.IsNullOrWhiteSpace(user.Login))
        {
            hostStatus = "Twitch user not found.";
            return;
        }

        var displayName = string.IsNullOrWhiteSpace(user.DisplayName)
            ? user.Login
            : user.DisplayName;
        await HostProvisioning.EnsureHostAsync(
            user.Login,
            user.Id,
            displayName,
            user.ProfileImageUrl,
            CancellationToken.None
        );
        hostStatus = $"Created hosted channel for {displayName}.";
        newHostLogin = string.Empty;
        await LoadAsync();
    }

    private async Task RemoveHostAsync(int hostId)
    {
        pendingRuntimeHostId = null;
        await HostedChannelRuntime.StopAsync(hostId, CancellationToken.None);
        var removed = await HostedChannelRemoval.RemoveAsync(hostId, CancellationToken.None);
        hostStatus = removed
            ? "Hosted channel removed."
            : "Hosted channel was already removed.";
        await LoadAsync();
    }

    private async Task StartBotAsync(int hostId)
    {
        pendingRuntimeHostId = hostId;
        var result = await HostedChannelRuntime.StartAsync(hostId, CancellationToken.None);
        await LoadAsync();
        var currentState = hosts.FirstOrDefault(host => host.Id == hostId)?.RuntimeState;
        hostStatus = result.Succeeded
            ? RuntimeStatusMessage(currentState)
            : result.Message;
        pendingRuntimeHostId = IsRuntimeTransitionPending(result, currentState) ? hostId : null;
    }

    private async Task StopBotAsync(int hostId)
    {
        pendingRuntimeHostId = hostId;
        var result = await HostedChannelRuntime.StopAsync(hostId, CancellationToken.None);
        await LoadAsync();
        var currentState = hosts.FirstOrDefault(host => host.Id == hostId)?.RuntimeState;
        hostStatus = result.Succeeded
            ? RuntimeStatusMessage(currentState)
            : result.Message;
        pendingRuntimeHostId = IsRuntimeTransitionPending(result, currentState) ? hostId : null;
    }

    private async Task LoadAsync()
    {
        isBotAccount = (await PageContext.FromAsync(AuthenticationState)).IsBotAccount;
        state = await SiteAccess.LoadAdminStateAsync(CancellationToken.None);
        hosts = await HostedChannels.LoadHostedChannelsAsync(CancellationToken.None);
        botAccountStatus = await BotAccountAuthorization.GetStatusAsync(CancellationToken.None);
    }

    private async Task ClearBotAccountAuthorizationAsync()
    {
        await BotAccountAuthorization.ClearAsync(CancellationToken.None);
        await LoadAsync();
    }

    private async Task RefreshBotAccountAuthorizationAsync()
    {
        await LoadAsync();
    }

    private async Task ReloadForEventAsync()
    {
        await LoadAsync();
        if (
            pendingRuntimeHostId is { } hostId
            && hosts.FirstOrDefault(host => host.Id == hostId) is { } host
        )
        {
            hostStatus = RuntimeStatusMessage(host.RuntimeState);
            if (host.RuntimeState is BotChannelRuntimeState.Started or BotChannelRuntimeState.Stopped)
                pendingRuntimeHostId = null;
        }
    }

    private static string RuntimeStatusMessage(BotChannelRuntimeState? state) =>
        state switch
        {
            BotChannelRuntimeState.Starting => "Bot starting.",
            BotChannelRuntimeState.Started => "Bot started.",
            BotChannelRuntimeState.Stopping => "Bot stopping.",
            _ => "Bot stopped.",
        };

    private static bool IsRuntimeTransitionPending(
        HostedChannelRuntimeControlResult result,
        BotChannelRuntimeState? state
    ) =>
        result.Succeeded && state is BotChannelRuntimeState.Starting or BotChannelRuntimeState.Stopping;

    private async Task RemoveBlacklistAsync(string login)
    {
        await SiteAccess.RemoveEntryAsync(AccessListEntryKind.Blacklist, login, CancellationToken.None);
        await LoadAsync();
    }

    private async Task RemoveWhitelistAsync(string login)
    {
        await SiteAccess.RemoveEntryAsync(AccessListEntryKind.Whitelist, login, CancellationToken.None);
        await LoadAsync();
    }

    private async Task ToggleWhitelistAsync(ChangeEventArgs args)
    {
        await SiteAccess.SetWhitelistEnabledAsync(args.Value is true, CancellationToken.None);
        await LoadAsync();
    }
}

@using BlokeBot.Persistence.Models

<div class="@RowClass">
    <div class="flex min-w-0 items-center gap-3">
        @if (!string.IsNullOrWhiteSpace(Host.ProfileImageUrl))
        {
            <img class="h-11 w-11 rounded-full border border-slate-200 object-cover" src="@Host.ProfileImageUrl" alt="" />
        }
        else
        {
            <div class="surface-muted flex h-11 w-11 items-center justify-center rounded-full text-sm font-bold text-slate-500">
                @Initials(Host.DisplayName)
            </div>
        }
        <div class="min-w-0">
            <p class="font-semibold text-slate-950">#@Host.DisplayName</p>
            <div class="mt-1 flex flex-wrap gap-2">
                <span class="@StatusBadgeClass(Host.IsChannelBotAuthorized)">
                    <span class="@StatusDotClass(Host.IsChannelBotAuthorized)"></span>
                    @(Host.IsChannelBotAuthorized ? "chat connected" : "chat not connected")
                </span>
                <span class="@BotStartedBadgeClass">
                    <span class="@BotStartedDotClass"></span>
                    @BotStartedText
                </span>
            </div>
        </div>
    </div>
    <div class="flex flex-wrap gap-2">
        @if (Host.RuntimeState is BotChannelRuntimeState.Stopping)
        {
            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled>Stop bot</button>
        }
        else if (Host.RuntimeState is BotChannelRuntimeState.Started or BotChannelRuntimeState.Starting)
        {
            <button class="btn-secondary" @onclick="() => StopBot(Host.Id)">Stop bot</button>
        }
        else
        {
            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!Host.IsChannelBotAuthorized)" @onclick="() => StartBot(Host.Id)">Start bot</button>
        }
        @if (CanEditHost)
        {
            <a class="btn-secondary" href="@EditHostHref" data-enhance-nav="false">Manage channel</a>
        }
        <button class="control-surface inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-semibold text-red-700 transition hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-50" disabled="@pendingRemoval" @onclick="RemoveHostAsync">Remove</button>
    </div>
</div>

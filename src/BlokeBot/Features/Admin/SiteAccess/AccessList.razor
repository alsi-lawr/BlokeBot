<div class="surface-muted rounded-lg p-4">
    <h3 class="text-sm font-semibold text-slate-950">@Title</h3>
    <div class="mt-3 flex gap-2">
        <input class="input" placeholder="@Placeholder" value="@NewLogin" @oninput="OnInput" />
        <button class="btn-secondary" @onclick="Add">Add</button>
    </div>
    <div class="motion-list scroll-panel scroll-panel--access-list mt-4 pr-2">
        @if (Entries.Count == 0)
        {
            <p class="text-sm text-muted-foreground">No entries.</p>
        }
        else
        {
            @foreach (var entry in Entries)
            {
                <div @key="entry" class="@EntryRowClass(entry)">
                    <span class="text-sm font-medium text-slate-800">@entry</span>
                    <button class="text-sm font-semibold text-red-600 transition hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-50" disabled="@pendingRemovals.Contains(entry)" @onclick="() => RemoveEntryAsync(entry)">Remove</button>
                </div>
            }
        }
    </div>
</div>

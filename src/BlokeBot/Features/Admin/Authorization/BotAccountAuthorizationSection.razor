@using BlokeBot.Features.HostedChannels.Authorization

<section class="card">
    <div class="border-b border-slate-200 p-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <h2 class="text-lg font-semibold text-slate-950">Bot account authorization</h2>
                <p class="mt-1 text-sm text-muted-foreground">Authorize the Twitch account BlokeBot uses for chat and API checks.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a class="inline-flex h-8 items-center rounded-md bg-[#9146ff] px-3 text-xs font-bold text-white shadow-sm transition hover:bg-[#7c3aed]" href="/oauth/start" target="_blank" rel="noopener noreferrer" data-enhance-nav="false">Authorize signed-in account</a>
                <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition" @onclick="Refresh">Refresh</button>
                <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition" @onclick="Clear">Clear authorization</button>
            </div>
        </div>
    </div>
    <div class="grid gap-4 p-5 lg:grid-cols-3">
        <div class="surface-muted rounded-lg px-3 py-2.5">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Configured account</p>
            <p class="mt-2 text-sm font-semibold text-slate-900">@Status?.ConfiguredBotLogin</p>
        </div>
        <div class="surface-muted rounded-lg px-3 py-2.5">
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Saved authorization</p>
                <span class="@StatusBadgeClass">
                    <span class="@StatusDotClass"></span>
                    @StatusText
                </span>
            </div>
            <p class="mt-2 text-sm font-semibold text-slate-900">@(Status?.AuthorizedLogin ?? "not authorized")</p>
            <p class="mt-1 text-xs font-medium text-slate-500">@Status?.Message</p>
        </div>
        <div class="surface-muted rounded-lg px-3 py-2.5">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Permissions</p>
            <p class="mt-2 text-xs font-medium text-slate-500">Required: @FormatScopes(Status?.RequiredScopes)</p>
            <p class="mt-1 text-xs font-medium text-slate-500">Granted: @FormatScopes(Status?.GrantedScopes)</p>
            @if (Status?.MissingScopes.Count > 0)
            {
                <p class="mt-1 text-xs font-bold text-amber-700">Missing: @FormatScopes(Status.MissingScopes)</p>
            }
        </div>
    </div>
</section>

                    <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-60" disabled="@Disabled" @onclick="Refresh">Refresh</button>
                    <button class="control-surface inline-flex h-8 items-center rounded-md px-3 text-xs font-bold transition disabled:cursor-not-allowed disabled:opacity-60" disabled="@Disabled" @onclick="Clear">Clear authorization</button>
                </div>
            </div>
        </div>
        <div class="@BodyClass">
            <div class="surface-muted rounded-lg p-4">
                <div class="flex items-center gap-4">
                    @if (Status?.AuthorizedProfileImageUrl is { Length: > 0 } imageUrl)
                    {
                        <img class="h-14 w-14 shrink-0 rounded-full border border-slate-200 object-cover shadow-sm"
                             src="@imageUrl"
                             alt="" />
                    }
                    else
                    {
                        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-500 shadow-sm ring-1 ring-slate-200">
                            <svg class="h-7 w-7 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3.5 19 6v5.4c0 4.1-2.8 7.8-7 9.1-4.2-1.3-7-5-7-9.1V6l7-2.5Z" />
                                <path d="M9.25 12h.01" />
                                <path d="M14.75 12h.01" />
                                <path d="M9.5 16c1.4.8 3.6.8 5 0" />
                            </svg>
                        </span>
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Bot account</p>
                            <span class="@StatusBadgeClass">
                                <span class="@StatusDotClass"></span>
                                @StatusText
                            </span>
                        </div>
                        <p class="mt-2 truncate text-sm font-semibold text-slate-900">@AuthorizedAccountText</p>
                        <p class="mt-1 text-xs font-medium text-slate-500">Configured as @ConfiguredAccountText</p>
                        <p class="mt-1 text-xs font-medium text-slate-500">@Status?.Message</p>
                        @if (Disabled && !string.IsNullOrWhiteSpace(DisabledMessage))
                        {
                            <p class="mt-1 text-xs font-bold text-slate-500">@DisabledMessage</p>
                        }
                    </div>
                </div>
            </div>
            <div class="surface-muted rounded-lg px-3 py-2.5">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Permissions</p>
                <p class="mt-2 text-xs font-medium text-slate-500">Required: @FormatScopes(Status?.RequiredScopes)</p>
                <p class="mt-1 text-xs font-medium text-slate-500">Granted: @FormatScopes(Status?.GrantedScopes)</p>
                @if (Status?.MissingScopes.Count > 0)
                {
                    <p class="mt-1 text-xs font-bold text-amber-700">Missing: @FormatScopes(Status.MissingScopes)</p>
                }
            </div>
        </div>
    </section>
}

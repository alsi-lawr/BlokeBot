@page "/custom-commands/settings"
@using BlokeBot.Eventing
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject CustomCommandConfigurationService Configuration
@inject HostFeatureService Features
@inject EventBus<AppEventKind> Events
@inject ToastService Toasts

<PageTitle>BlokeBot | Custom Command Settings</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Custom command settings"
                Description="Reusable chat replies, counters, scheduled announcements, and command aliases.">
        <button class="btn-primary"
                aria-label="Save custom command settings"
                disabled="@(!featureEnabled || config is null)"
                @onclick="SaveAsync">Save changes</button>
    </PageHeader>

    @if (Host is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
    }
    else if (!featureEnabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Custom commands are off for this channel. Turn them on in Channel setup.</div>
    }
    else if (config is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading custom command settings...</div>
    }
    else
    {
        <CollapsibleSection Title="Message library" Description="Saved messages and ordered variants used by commands and announcements." InitiallyOpen="true">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@config.MessageEntries.Count message entries</p>
                    <button class="btn-secondary" @onclick="AddMessageEntry">Add message</button>
                </div>

                @if (config.MessageEntries.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No message entries yet.</p>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--settings space-y-3 pr-2">
                        @foreach (var entry in config.MessageEntries)
                        {
                            <div @key="entry" class="surface-muted space-y-3 rounded-lg p-3">
                                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_12rem_9rem_auto] xl:items-end">
                                    <Field Id="@($"message-entry-{entry.Id}-name")"
                                           Label="Name"
                                           @bind-Value="entry.Name"
                                           Placeholder="welcome" />
                                    <div class="space-y-2">
                                        <label class="label">Selection</label>
                                        <select class="input" @bind="entry.SelectionMode">
                                            @foreach (var mode in MessageSelectionModes)
                                            {
                                                <option value="@mode">@mode</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label">Rotation index</label>
                                        <input class="input"
                                               type="number"
                                               min="0"
                                               disabled="@(entry.SelectionMode != CustomMessageSelectionMode.Sequential)"
                                               @bind="entry.CurrentVariantIndex" />
                                    </div>
                                    <button class="btn-secondary" @onclick="() => RemoveMessageEntry(entry)">Delete</button>
                                </div>

                                <div class="space-y-2 border-t border-slate-200 pt-3">
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Variants</p>
                                        <button class="btn-secondary h-9 px-3 text-xs" @onclick="() => AddVariant(entry)">Add variant</button>
                                    </div>
                                    @for (var i = 0; i < entry.Variants.Count; i++)
                                    {
                                        var index = i;
                                        var variant = entry.Variants[index];
                                        <div @key="variant" class="grid gap-2 lg:grid-cols-[3rem_minmax(0,1fr)_auto] lg:items-start">
                                            <span class="rank-indicator mt-7">@(index + 1)</span>
                                            <TextAreaField Label="@($"Variant {index + 1}")" @bind-Value="variant.Text" />
                                            <div class="mt-7 flex flex-wrap gap-2">
                                                <button class="btn-secondary h-9 px-3 text-xs" disabled="@(index == 0)" @onclick="() => MoveVariant(entry, index, -1)">Up</button>
                                                <button class="btn-secondary h-9 px-3 text-xs" disabled="@(index == entry.Variants.Count - 1)" @onclick="() => MoveVariant(entry, index, 1)">Down</button>
                                                <button class="btn-secondary h-9 px-3 text-xs" @onclick="() => RemoveVariant(entry, variant)">Remove</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Custom commands" Description="Chat aliases, cooldowns, access, and command actions." InitiallyOpen="true">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@config.Commands.Count custom commands</p>
                    <button class="btn-secondary" disabled="@(config.MessageEntries.Count == 0)" @onclick="AddCommand">Add command</button>
                </div>

                @if (config.Commands.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No custom commands yet.</p>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--settings space-y-3 pr-2">
                        @foreach (var command in config.Commands)
                        {
                            <div @key="command" class="surface-muted space-y-3 rounded-lg p-3">
                                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] xl:items-end">
                                    <Field Label="Name" @bind-Value="command.Name" Placeholder="Hello" />
                                    <Field Label="Aliases" @bind-Value="command.Aliases" Placeholder="hello, hi" />
                                    <button class="btn-secondary" @onclick="() => RemoveCommand(command)">Delete</button>
                                </div>
                                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                                    <label class="control-surface inline-flex h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium">
                                        <input class="h-4 w-4" type="checkbox" @bind="command.Enabled" />
                                        Enabled
                                    </label>
                                    <label class="control-surface inline-flex h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium">
                                        <input class="h-4 w-4" type="checkbox" @bind="command.ModeratorOnly" />
                                        Moderator only
                                    </label>
                                    <div class="space-y-2">
                                        <label class="label">Cooldown seconds</label>
                                        <input class="input" type="number" min="0" @bind="command.CooldownSeconds" />
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label">Cooldown scope</label>
                                        <select class="input" @bind="command.CooldownScope">
                                            @foreach (var scope in CooldownScopes)
                                            {
                                                <option value="@scope">@scope</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label" for="@($"command-{command.Id}-action-kind")">Action type</label>
                                        <select id="@($"command-{command.Id}-action-kind")"
                                                class="input"
                                                @bind="command.ActionKind">
                                            @foreach (var action in ActionKinds)
                                            {
                                                <option value="@action">@action</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label">Message entry</label>
                                        <select class="input" @bind="command.Action.MessageLibraryEntryId">
                                            @foreach (var entry in config.MessageEntries)
                                            {
                                                <option value="@entry.Id">@entry.Name</option>
                                            }
                                        </select>
                                    </div>
                                    @if (command.Action is CounterCustomCommandActionEditor counterAction)
                                    {
                                        <div class="space-y-2 md:col-span-2">
                                            <label class="label" for="@($"command-{command.Id}-counter-id")">Counter</label>
                                            <select id="@($"command-{command.Id}-counter-id")"
                                                    class="input"
                                                    @bind="counterAction.CounterId">
                                                @if (config.Counters.Count == 0)
                                                {
                                                    <option value="0">No counters available</option>
                                                }
                                                @foreach (var counter in config.Counters)
                                                {
                                                    <option value="@counter.Id">@counter.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Global counters" Description="Shared counter names and values used by counter commands." InitiallyOpen="true">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@config.Counters.Count counters</p>
                    <button class="btn-secondary" @onclick="AddCounter">Add counter</button>
                </div>

                @if (config.Counters.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No counters yet.</p>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var counter in config.Counters)
                        {
                            <div @key="counter" class="surface-muted grid gap-3 rounded-lg p-3 md:grid-cols-[minmax(0,1fr)_12rem_auto] md:items-end">
                                <Field Label="Name" @bind-Value="counter.Name" Placeholder="deaths" />
                                <div class="space-y-2">
                                    <label class="label">Value</label>
                                    <input class="input" type="number" @bind="counter.Value" />
                                </div>
                                <button class="btn-secondary" @onclick="() => RemoveCounter(counter)">Delete</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection ContentId="custom-announcement-settings"
                            Title="Announcements"
                            Description="Saved announcement configuration. Sending is handled separately."
                            InitiallyOpen="false">
            <div class="space-y-4 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-900">@config.Announcements.Count announcements</p>
                    <button class="btn-secondary" disabled="@(config.MessageEntries.Count == 0)" @onclick="AddAnnouncement">Add announcement</button>
                </div>

                @if (config.Announcements.Count == 0)
                {
                    <p class="surface-muted rounded-lg p-4 text-sm text-muted-foreground">No announcements yet.</p>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--settings space-y-3 pr-2">
                        @foreach (var announcement in config.Announcements)
                        {
                            <div @key="announcement" class="surface-muted space-y-3 rounded-lg p-3">
                                <div class="grid gap-3 xl:grid-cols-[minmax(0,1fr)_12rem_auto] xl:items-end">
                                    <Field Label="Name" @bind-Value="announcement.Name" Placeholder="Hydrate reminder" />
                                    <label class="control-surface mt-7 inline-flex h-10 items-center gap-2 rounded-lg px-3 text-sm font-medium xl:mt-0">
                                        <input class="h-4 w-4" type="checkbox" @bind="announcement.Enabled" />
                                        Enabled
                                    </label>
                                    <button class="btn-secondary" @onclick="() => RemoveAnnouncement(announcement)">Delete</button>
                                </div>
                                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                                    <div class="space-y-2">
                                        <label class="label">Message entry</label>
                                        <select class="input" @bind="announcement.MessageLibraryEntryId">
                                            @foreach (var entry in config.MessageEntries)
                                            {
                                                <option value="@entry.Id">@entry.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="label" for="@($"announcement-{announcement.Id}-schedule-kind")">Schedule type</label>
                                        <select id="@($"announcement-{announcement.Id}-schedule-kind")"
                                                class="input"
                                                @bind="announcement.ScheduleKind">
                                            @foreach (var type in AnnouncementScheduleKinds)
                                            {
                                                <option value="@type">@type</option>
                                            }
                                        </select>
                                    </div>
                                    @if (announcement.Schedule is IntervalCustomAnnouncementScheduleEditor interval)
                                    {
                                        <div class="space-y-2">
                                            <label class="label">Interval minutes</label>
                                            <input class="input" type="number" min="1" @bind="interval.IntervalMinutes" />
                                        </div>
                                    }
                                    else if (announcement.Schedule is IntervalAfterChatCustomAnnouncementScheduleEditor intervalAfterChat)
                                    {
                                        <div class="space-y-2">
                                            <label class="label" for="@($"announcement-{announcement.Id}-interval-minutes")">Interval minutes</label>
                                            <input id="@($"announcement-{announcement.Id}-interval-minutes")"
                                                   class="input"
                                                   type="number"
                                                   min="1"
                                                   @bind="intervalAfterChat.IntervalMinutes" />
                                        </div>
                                        <div class="space-y-2">
                                            <label class="label" for="@($"announcement-{announcement.Id}-required-chat-messages")">Required chat messages</label>
                                            <input id="@($"announcement-{announcement.Id}-required-chat-messages")"
                                                   class="input"
                                                   type="number"
                                                   min="1"
                                                   @bind="intervalAfterChat.RequiredChatMessages" />
                                        </div>
                                    }
                                    else if (announcement.Schedule is WeeklyCustomAnnouncementScheduleEditor weekly)
                                    {
                                        <div class="space-y-2">
                                            <label class="label">Weekly day</label>
                                            <select class="input" @bind="weekly.Day">
                                                @foreach (var day in DaysOfWeek)
                                                {
                                                    <option value="@day">@day</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="space-y-2">
                                            <label class="label">Weekly time</label>
                                            <input class="input" type="time" @bind="weekly.Time" />
                                        </div>
                                    }
                                    <div class="surface-row rounded-lg px-3 py-2">
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Last sent</p>
                                        <p class="mt-1 text-sm font-semibold text-slate-900">@FormatLastSent(announcement.LastSentAtUtc)</p>
                                    </div>
                                    <div class="surface-row rounded-lg px-3 py-2">
                                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Messages since last sent</p>
                                        <p class="mt-1 text-sm font-semibold text-slate-900">@announcement.ChatMessagesSinceLastSent</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Host timezone" Description="Timezone used when interpreting weekly announcement times." InitiallyOpen="false">
            <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_18rem]">
                <div class="space-y-2">
                    <label class="label">Timezone</label>
                    <select class="input" @bind="config.TimeZoneId">
                        @foreach (var timeZone in TimeZones)
                        {
                            <option value="@timeZone.Id">@timeZone.Id</option>
                        }
                    </select>
                </div>
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Current selection</p>
                    <p class="mt-1 break-words text-sm font-semibold text-slate-900">@config.TimeZoneId</p>
                </div>
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Alerts" Description="Current durable alert state for this channel." InitiallyOpen="false">
            <div class="space-y-3 p-4">
                <div class="surface-muted rounded-lg px-3 py-2.5">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Active alerts</p>
                    <p class="mt-1 text-sm font-semibold text-slate-900">@config.AlertSummary.ActiveCount</p>
                </div>
                @if (config.AlertSummary.ActiveAlerts.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No active alerts.</p>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var alert in config.AlertSummary.ActiveAlerts)
                        {
                            <div @key="alert" class="surface-row rounded-lg p-3">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <p class="text-sm font-bold text-slate-950">@alert.Title</p>
                                    <span class="inline-flex h-6 items-center rounded-full bg-slate-100 px-2.5 text-xs font-bold text-slate-600 ring-1 ring-slate-200">@alert.Severity</span>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">@alert.Message</p>
                                @if (!string.IsNullOrWhiteSpace(alert.LinkPath))
                                {
                                    <a class="mt-2 inline-flex text-sm font-semibold text-blue-700" href="@alert.LinkPath">Open alert</a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </CollapsibleSection>
    }
</div>

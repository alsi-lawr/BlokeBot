@page "/guessing/settings"
@using BlokeBot.Eventing
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject GuessingConfigurationService Configuration
@inject HostFeatureService Features
@inject EventBus<AppEventKind> Events
@inject ToastService Toasts

<PageTitle>BlokeBot | Guessing Settings</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Title="Round settings"
                Description="Round types, chat commands, accepted answers, and bot replies.">
        <button class="btn-primary" disabled="@(!featureEnabled || config is null)" @onclick="SaveAsync">Save changes</button>
    </PageHeader>

    @if (Host is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
    }
    else if (!featureEnabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Guessing game is off for this channel. Turn it on in Channel setup.</div>
    }
    else if (config is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Loading guessing settings...</div>
    }
    else
    {
        <div id="profiles">
            <ProfileSettingsSection Configuration="config"
                                    CreateProfile="CreateProfileAsync"
                                    DeleteProfile="DeleteProfileAsync"
                                    SelectProfile="SelectProfileAsync"
                                    @bind-NewProfileName="newProfileName" />
        </div>

        <div class="grid gap-6 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <div id="aliases">
                <CommandAliasSettingsSection Aliases="config.Aliases" />
            </div>

            <GuessOptionsSettingsSection Options="config.Profile.Options"
                                         WhisperResponsesEnabled="config.WhisperResponsesEnabled"
                                         AddOption="AddOption"
                                         RemoveOption="RemoveOption" />
        </div>

        <div id="replies">
            <ReplySettingsSection Replies="config.Profile.Replies"
                                  Delivery="config.ReplyDelivery"
                                  WhisperResponsesEnabled="config.WhisperResponsesEnabled" />
        </div>
    }
</div>

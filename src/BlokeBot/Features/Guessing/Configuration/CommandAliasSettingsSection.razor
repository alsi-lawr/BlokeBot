<CollapsibleSection Title="Command aliases" Description="Comma-separated command names." InitiallyOpen="true">
    <div class="grid gap-4 p-4">
        <Field Label="Start round" @bind-Value="Aliases.StartAliases" Placeholder="startguessing, start" />
        <Field Label="Stop guessing" @bind-Value="Aliases.StopAliases" Placeholder="stopguessing, close" />
        <Field Label="Declare winner" @bind-Value="Aliases.WinAliases" Placeholder="win, winner" />
        <Field Label="Player guess" @bind-Value="Aliases.GuessAliases" Placeholder="guess, vote" />
        <Field Label="Available guesses" @bind-Value="Aliases.GuessesAliases" Placeholder="guesses, options" />
    </div>
</CollapsibleSection>

@code {
    [Parameter, EditorRequired] public CommandAliasEditor Aliases { get; set; } = new();
}

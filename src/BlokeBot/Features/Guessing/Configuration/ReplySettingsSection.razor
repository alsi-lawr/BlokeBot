@using BlokeBot.Features.Guessing.Replies

<CollapsibleSection Title="Bot replies" Description="Messages the bot sends in chat." InitiallyOpen="false">
    <div class="grid gap-4 p-4 md:grid-cols-2">
        <ReplyTextAreaField Label="Round started" ReplyKey="@GuessingReplyKeys.RoundStarted" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.RoundStartedReply" />
        <ReplyTextAreaField Label="Round already open" ReplyKey="@GuessingReplyKeys.RoundAlreadyOpen" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.RoundAlreadyOpenReply" />
        <ReplyTextAreaField Label="No open round" ReplyKey="@GuessingReplyKeys.NoOpenRound" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.NoOpenRoundReply" />
        <ReplyTextAreaField Label="Guessing stopped" ReplyKey="@GuessingReplyKeys.GuessingStopped" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.GuessingStoppedReply" />
        <ReplyTextAreaField Label="Guessing already stopped" ReplyKey="@GuessingReplyKeys.GuessingAlreadyStopped" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.GuessingAlreadyStoppedReply" />
        <ReplyTextAreaField Label="Guessing closed" ReplyKey="@GuessingReplyKeys.GuessingClosed" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.GuessingClosedReply" />
        <ReplyTextAreaField Label="Invalid guess" ReplyKey="@GuessingReplyKeys.InvalidGuess" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.InvalidGuessReply" />
        <ReplyTextAreaField Label="Guess usage" ReplyKey="@GuessingReplyKeys.GuessUsage" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.GuessUsageReply" />
        <ReplyTextAreaField Label="Available guesses" ReplyKey="@GuessingReplyKeys.AvailableGuesses" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.AvailableGuessesReply" />
        <ReplyTextAreaField Label="Win usage" ReplyKey="@GuessingReplyKeys.WinUsage" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.WinUsageReply" />
        <ReplyTextAreaField Label="Moderator only" ReplyKey="@GuessingReplyKeys.ModeratorOnly" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.ModeratorOnlyReply" />
        <ReplyTextAreaField Label="Winner reply" ReplyKey="@GuessingReplyKeys.Winner" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.WinnerReply" />
        <ReplyTextAreaField Label="No winners reply" ReplyKey="@GuessingReplyKeys.NoWinners" Delivery="Delivery" WhisperDisabled="@WhisperDisabled" WhisperDisabledTooltip="@WhisperDisabledTooltip" @bind-Value="Replies.NoWinnersReply" />
    </div>
</CollapsibleSection>

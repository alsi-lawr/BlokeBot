@using BlokeBot.Features.Guessing.Profiles

<CollapsibleSection Title="Accepted answers" Description="Answers viewers can choose, with optional replies for each one." InitiallyOpen="true">
    <div class="space-y-3 p-4">
        <div class="motion-list scroll-panel scroll-panel--valid-guesses pr-2">
            @if (Options.Count == 0)
            {
                <p class="text-sm text-muted-foreground">No answers added yet.</p>
            }
            else
            {
                @for (var i = 0; i < Options.Count; i++)
                {
                    var option = Options[i];
                    <div @key="option" class="@OptionRowClass(option)">
                        <input class="input" placeholder="answer" @bind="option.Name" />
                        <input class="input" placeholder="reply text, supports {name} and {login}" @bind="option.ReplyText" />
                        <span class="self-center" title="@WhisperTitle">
                            <label class="@WhisperLabelClass">
                                <input class="h-4 w-4" type="checkbox" checked="@IsWhisper(option)" disabled="@WhisperDisabled" @onchange="args => SetOptionWhisper(option, args)" />
                                <span>Whisper</span>
                            </label>
                        </span>
                        <button class="btn-secondary" disabled="@pendingRemovals.Contains(option)" @onclick="() => RemoveOptionAsync(option)">Remove</button>
                    </div>
                }
            }
        </div>
        <button class="btn-secondary" @onclick="InvokeAddOptionAsync">Add answer</button>
    </div>
</CollapsibleSection>

<div class="live-round-summary scroll-panel" aria-label="Live round summary">
    <div class="live-round-summary__metric live-round-summary__metric--wide">
        <p class="live-round-summary__label">Round status</p>
        <p class="live-round-summary__value">@RoundStatusText</p>
        <p class="live-round-summary__detail">@RoundStartedText</p>
    </div>
    <div class="live-round-summary__metric">
        <p class="live-round-summary__label">Votes</p>
        <p class="live-round-summary__value">@State.Votes.Count</p>
        <p class="live-round-summary__detail">Unique players</p>
    </div>
    <div class="live-round-summary__metric">
        <p class="live-round-summary__label">Available answers</p>
        <p class="live-round-summary__value">@State.Options.Count</p>
        <p class="live-round-summary__detail">Chat answers</p>
    </div>
    <div class="live-round-summary__metric">
        <p class="live-round-summary__label">Winner</p>
        <p class="live-round-summary__value">@(State.CurrentRound?.WinningName ?? "None")</p>
        <p class="live-round-summary__detail">Chosen here or in chat</p>
    </div>
</div>

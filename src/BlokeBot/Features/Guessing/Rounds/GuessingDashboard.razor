@page "/guessing"
@using System.Globalization
@using BlokeBot.Commands
@using BlokeBot.Twitch
@using BlokeBot.Twitch.Auth
@using BlokeBot.Twitch.Runtime
@using BlokeBot.Eventing
@using BlokeBot.Features.HostedChannels
@using BlokeBot.Hosts
@using BlokeBot.Persistence.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "HostSelected")]
@inherits AuthenticatedPageComponent
@inject GuessingDashboardService Dashboard
@inject GuessingHistoryService History
@inject GuessingRoundService Rounds
@inject HostFeatureService Features
@inject EventBus<AppEventKind> Events
@inject ITwitchChatMessageSender Chat
@inject ToastService Toasts

<PageTitle>BlokeBot | Guessing</PageTitle>

<div class="mx-auto max-w-7xl space-y-6">
    <PageHeader Kicker="Dashboard"
                Title="Guessing game"
                Description="Run live rounds and look back at viewer results.">
        <button class="btn-primary" disabled="@(!featureEnabled)" @onclick="RefreshAsync">Refresh</button>
    </PageHeader>

    @if (Host is null)
    {
        <div class="card p-8 text-sm text-muted-foreground">Choose a channel to continue.</div>
    }
    else if (!featureEnabled)
    {
        <div class="card p-8 text-sm text-muted-foreground">Guessing game is off for this channel. Turn it on in Channel setup.</div>
    }
    else
    {

        <div id="live"
             class="@SegmentedControlClass"
             role="tablist"
             aria-label="Guessing dashboard view">
            <span class="segmented-motion__indicator" aria-hidden="true"></span>
            <button class="@TabClass(DashboardTab.Live)"
                    type="button"
                    role="tab"
                    aria-selected="@(activeTab == DashboardTab.Live)"
                    @onclick="() => ActivateTabAsync(DashboardTab.Live)">
                Live
            </button>
            <button class="@TabClass(DashboardTab.History)"
                    type="button"
                    role="tab"
                    aria-selected="@(activeTab == DashboardTab.History)"
                    @onclick="() => ActivateTabAsync(DashboardTab.History)">
                History
            </button>
            <button class="@TabClass(DashboardTab.Leaderboard)"
                    type="button"
                    role="tab"
                    aria-selected="@(activeTab == DashboardTab.Leaderboard)"
                    @onclick="() => ActivateTabAsync(DashboardTab.Leaderboard)">
                Leaderboard
            </button>
        </div>

        @if (activeTab == DashboardTab.Live)
        {
            @if (state is null)
            {
                <div class="card p-8 text-sm text-muted-foreground">Loading guessing game...</div>
            }
            else
            {
                <LiveRoundSummary State="state" RoundStartedText="@RoundStartedText" RoundStatusText="@RoundStatusText" />

                <div class="grid gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
                    <RoundOrchestrationPanel State="state"
                                             StartRound="StartRoundAsync"
                                             StopGuessing="StopGuessingAsync"
                                             DeclareWinner="DeclareWinnerAsync"
                                             @bind-SelectedProfileId="selectedProfileId"
                                             @bind-WinnerName="winnerName" />

                    <GuessVotesTable Votes="state.Votes" />
                </div>
            }
        }
        else if (activeTab == DashboardTab.History)
        {
            <section id="history" class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Recent rounds</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Past rounds for this channel.</p>
                </div>
                @if (recentRounds is null)
                {
                    <div class="p-8 text-sm text-muted-foreground">Loading recent rounds...</div>
                }
                else if (recentRounds.Count == 0)
                {
                    <div class="p-8 text-sm text-muted-foreground">No completed rounds yet.</div>
                }
                else
                {
                    <div class="scroll-panel scroll-panel--data-table overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                                <tr>
                                    <th class="px-5 py-3 font-semibold">Round</th>
                                    <th class="px-5 py-3 font-semibold">Winner</th>
                                    <th class="px-5 py-3 font-semibold">Guesses</th>
                                    <th class="px-5 py-3 font-semibold">Correct</th>
                                    <th class="px-5 py-3 font-semibold">Started</th>
                                    <th class="px-5 py-3 font-semibold">Ended</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var round in recentRounds)
                                {
                                    <tr @key="round.Id" class="motion-list__item">
                                        <td class="px-5 py-3 font-medium text-slate-900">@round.ProfileName</td>
                                        <td class="px-5 py-3 text-slate-700">@(round.WinningName ?? "None")</td>
                                        <td class="px-5 py-3 text-slate-700">@round.GuessCount</td>
                                        <td class="px-5 py-3 text-slate-700">@round.CorrectGuessCount</td>
                                        <td class="px-5 py-3 text-muted-foreground">@round.StartedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                        <td class="px-5 py-3 text-muted-foreground">@FormatEndedAt(round)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else
        {
            <section id="leaderboard" class="card">
                <div class="border-b border-slate-200 p-5">
                    <h2 class="text-lg font-semibold text-slate-950">Leaderboard</h2>
                    <p class="mt-1 text-sm text-muted-foreground">Rank viewers by correct guesses across past rounds.</p>
                </div>
                <div class="surface-band grid gap-4 border-b p-5 lg:grid-cols-4">
                    <div>
                        <label class="label" for="leaderboardFrom">From</label>
                        <input id="leaderboardFrom" class="input mt-2" type="date" @bind="leaderboardFromDate" @bind:after="ResetAndLoadLeaderboardAsync" />
                    </div>
                    <div>
                        <label class="label" for="leaderboardTo">To</label>
                        <input id="leaderboardTo" class="input mt-2" type="date" @bind="leaderboardToDate" @bind:after="ResetAndLoadLeaderboardAsync" />
                    </div>
                    <div>
                        <label class="label" for="leaderboardProfile">Round type</label>
                        <select id="leaderboardProfile" class="input mt-2" @bind="leaderboardProfileId" @bind:after="ResetAndLoadLeaderboardAsync">
                            <option value="0">All round types</option>
                            @foreach (var profile in state?.Profiles ?? [])
                            {
                                <option value="@profile.Id">@profile.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="label" for="leaderboardUsername">Username</label>
                        <input id="leaderboardUsername" class="input mt-2" placeholder="any player" @bind="leaderboardUsername" @bind:event="oninput" @bind:after="ResetAndLoadLeaderboardAsync" />
                    </div>
                </div>

                @if (leaderboard is null)
                {
                    <div class="p-8 text-sm text-muted-foreground">Loading leaderboard...</div>
                }
                else
                {
                    <div class="grid gap-4 border-b border-slate-200 p-5 md:grid-cols-2 xl:grid-cols-4">
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Players</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@leaderboard.TotalPlayers</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Guesses</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@leaderboard.TotalGuesses</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Correct</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@leaderboard.CorrectGuesses</p>
                        </div>
                        <div class="surface-row rounded-lg p-4">
                            <p class="text-sm font-medium text-muted-foreground">Page</p>
                            <p class="mt-2 text-2xl font-bold text-slate-950">@leaderboard.Page / @leaderboard.PageCount</p>
                        </div>
                    </div>

                    <div class="scroll-panel scroll-panel--data-table overflow-x-auto">
                        @if (leaderboard.Entries.Count == 0)
                        {
                            <div class="p-8 text-sm text-muted-foreground">No past guesses match these filters.</div>
                        }
                        else
                        {
                            <table class="w-full text-left text-sm">
                                <thead class="surface-band border-b text-xs uppercase tracking-wide text-muted-foreground">
                                    <tr>
                                        <th class="px-5 py-3 font-semibold">Rank</th>
                                        <th class="px-5 py-3 font-semibold">Player</th>
                                        <th class="px-5 py-3 font-semibold">Correct</th>
                                        <th class="px-5 py-3 font-semibold">Rounds</th>
                                        <th class="px-5 py-3 font-semibold">Accuracy</th>
                                        <th class="px-5 py-3 font-semibold">Latest</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in leaderboard.Entries)
                                    {
                                        <tr @key="entry" class="motion-list__item">
                                            <td class="px-5 py-3 font-semibold text-slate-900"><RankIndicator Rank="@entry.Rank" /></td>
                                            <td class="px-5 py-3 font-medium text-slate-900">@entry.Login</td>
                                            <td class="px-5 py-3 text-slate-700">@entry.CorrectGuesses</td>
                                            <td class="px-5 py-3 text-slate-700">@entry.RoundsPlayed</td>
                                            <td class="px-5 py-3 text-slate-700">@entry.HitRate.ToString("P0", CultureInfo.CurrentCulture)</td>
                                            <td class="px-5 py-3 text-muted-foreground">@entry.LastGuessAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="flex flex-col gap-3 border-t border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex items-center gap-3">
                            <label class="label" for="leaderboardPageSize">Rows</label>
                            <select id="leaderboardPageSize" class="control-surface h-9 rounded-md px-2 text-sm font-medium" @bind="leaderboardPageSize" @bind:after="ResetAndLoadLeaderboardAsync">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(leaderboard.Page <= 1)" @onclick="PreviousLeaderboardPageAsync">Previous</button>
                            <button class="btn-secondary disabled:cursor-not-allowed disabled:opacity-50" disabled="@(leaderboard.Page >= leaderboard.PageCount)" @onclick="NextLeaderboardPageAsync">Next</button>
                        </div>
                    </div>
                }
            </section>
        }
    }
</div>

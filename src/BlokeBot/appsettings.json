{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlokeBot": {
    "BotAdmins": [],
    "BotStateChangeCooldownSeconds": 5,
    "DatabasePath": "blokebot.db"
  },
  "TwitchWebAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/auth/twitch/callback",
    "CookieName": "BlokeBot.Auth"
  },
  "TwitchBot": {
    "Runtime": "EventSub",
    "ChatMessageSendIntervalSeconds": 1,
    "DuplicateChatMessageCooldownSeconds": 30,
    "MaxChatMessageLength": 500,
    "StartupMessage": "Beep boop.",
    "Connection": {
      "Host": "irc.chat.twitch.tv",
      "Port": 6667,
      "UseTls": false
    },
    "Identity": {
      "BotUsername": "",
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://localhost:7107/oauth/callback",
      "Scopes": ["user:read:chat", "user:write:chat", "user:bot", "moderator:read:followers", "user:read:moderated_channels"],
      "TokenCachePath": "blokebot.tokens.json"
    },
    "ChannelAuthorization": {
      "Scopes": ["channel:bot"]
    }
  }
}

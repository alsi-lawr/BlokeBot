{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlokeBot": {
    "BotAdmins": [],
    "BotStateChangeCooldownSeconds": 5,
    "CustomCommands": {
      "MinimumCooldownSeconds": 5,
      "AnnouncementSchedulerTickSeconds": 10
    },
    "Points": {
      "MinimumGamblingCooldownSeconds": 5
    },
    "DatabasePath": "blokebot.db"
  },
  "TwitchWebAuth": {
    "CallbackPath": "/auth/twitch/callback",
    "CookieName": "BlokeBot.Auth"
  },
  "TwitchBot": {
    "Runtime": "EventSub",
    "ChatMessageSendIntervalSeconds": 1,
    "DuplicateChatMessageCooldownSeconds": 30,
    "MaxChatMessageLength": 500,
    "StartupMessage": "Beep boop.",
    "PublicChatQueueAlerts": {
      "StuckAfterSeconds": 30
    },
    "Connection": {
      "Host": "irc.chat.twitch.tv",
      "Port": 6667,
      "UseTls": false
    },
    "Identity": {
      "BotUsername": "",
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://localhost:7107/oauth/callback",
      "Scopes": ["user:read:chat", "user:write:chat", "user:bot", "moderator:read:followers", "user:read:moderated_channels"],
      "TokenCachePath": "blokebot.tokens.json"
    },
    "ChannelAuthorization": {
      "Scopes": ["channel:bot"]
    },
    "Policies": {
      "IrcSession": {
        "AttemptLimit": 5,
        "Delay": "00:00:03",
        "MaximumDelay": "00:00:30",
        "DelayBackoffType": "Exponential",
        "AttemptTimeout": "00:02:00"
      },
      "EventSubSession": {
        "AttemptLimit": 5,
        "Delay": "00:00:05",
        "MaximumDelay": "00:01:00",
        "DelayBackoffType": "Exponential",
        "AttemptTimeout": "00:02:00"
      },
      "EventSubChannelRecovery": {
        "AttemptLimit": 5,
        "Delay": "00:00:05",
        "MaximumDelay": "00:01:00",
        "DelayBackoffType": "Exponential",
        "AttemptTimeout": "00:01:00"
      },
      "PublicChatRetry": {
        "AttemptLimit": 3,
        "Delay": "00:00:01",
        "MaximumDelay": "00:00:30",
        "DelayBackoffType": "Exponential"
      },
      "PublicChatDeliveryLifetime": {
        "MaximumAge": "00:00:30"
      },
      "PublicChatTerminalRetention": {
        "Duration": "7.00:00:00"
      }
    }
  }
}

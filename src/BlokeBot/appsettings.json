{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "BlokeBot": {
    "BotAdmins": [],
    "BotStateChangeCooldownSeconds": 5,
    "CustomCommands": {
      "MinimumCooldownSeconds": 5,
      "AnnouncementSchedulerTickSeconds": 10
    },
    "Points": {
      "MinimumGamblingCooldownSeconds": 5
    },
    "Overlays": {
      "Media": {
        "MaximumUploadBytes": 52428800,
        "MaximumHostStorageBytes": 524288000,
        "DisconnectedQueueExpirySeconds": 30,
        "AllowPrivateNetworkTargets": false
      }
    }
  },
  "TwitchEndpoints": {
    "OAuthOrigin": "https://id.twitch.tv/oauth2/",
    "HelixOrigin": "https://api.twitch.tv/helix/"
  },
  "TwitchWebAuth": {
    "CallbackPath": "/auth/twitch/callback",
    "CookieName": "BlokeBot.Auth"
  },
  "TwitchBot": {
    "Runtime": "EventSub",
    "ChatMessageSendIntervalSeconds": 1,
    "DuplicateChatMessageCooldownSeconds": 30,
    "MaxChatMessageLength": 500,
    "StartupMessage": "Beep boop.",
    "PublicChatQueueAlerts": {
      "StuckAfterSeconds": 30
    },
    "Connection": {
      "Host": "irc.chat.twitch.tv",
      "Port": 6667,
      "UseTls": false
    },
    "Identity": {
      "BotUsername": "",
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://localhost:7107/oauth/callback",
      "Scopes": ["user:read:chat", "user:write:chat", "user:bot", "moderator:read:followers", "moderator:read:chatters", "moderator:manage:announcements", "moderator:manage:chat_messages", "user:read:follows", "user:read:moderated_channels", "moderator:read:shoutouts", "moderator:manage:shoutouts"]
    },
    "ChannelAuthorization": {
      "Scopes": ["channel:bot"]
    },
    "Policies": {
      "IrcSession": {
        "AttemptLimit": 5,
        "Delay": "00:00:03",
        "MaximumDelay": "00:00:30",
        "DelayBackoffType": "Exponential",
        "AttemptTimeout": "00:02:00"
      },
      "EventSubChannelRecovery": {
        "AttemptLimit": 5,
        "Delay": "00:00:05",
        "MaximumDelay": "00:01:00",
        "DelayBackoffType": "Exponential",
        "AttemptTimeout": "00:01:00"
      },
      "PublicChatRetry": {
        "AttemptLimit": 3,
        "Delay": "00:00:01",
        "MaximumDelay": "00:00:30",
        "DelayBackoffType": "Exponential"
      },
      "PublicChatDeliveryLifetime": {
        "MaximumAge": "00:00:30"
      },
      "PublicChatTerminalRetention": {
        "Duration": "7.00:00:00"
      }
    }
  }
}

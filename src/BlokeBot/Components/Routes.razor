<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="routeAuth">
                <AuthorizeView>
                    <Authorized Context="signedInUser">
                        <main class="flex min-h-screen items-center justify-center bg-background px-4 text-foreground">
                            <section class="surface w-full max-w-md rounded-lg p-8 shadow-soft">
                                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">BlokeBot</p>
                                <h1 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">Host config</h1>
                                <a class="btn-primary mt-6 w-full" href="/host">Open host config</a>
                            </section>
                        </main>
                    </Authorized>
                    <NotAuthorized Context="anonymousUser">
                        <main class="flex min-h-screen items-center justify-center bg-background px-4 text-foreground">
                            <section class="surface w-full max-w-md rounded-lg p-8 shadow-soft">
                                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground">BlokeBot</p>
                                <h1 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">Authenticate with Twitch</h1>
                                <a class="btn-primary mt-6 w-full" href="/auth/login">
                                    Authenticate with Twitch
                                </a>
                            </section>
                        </main>
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

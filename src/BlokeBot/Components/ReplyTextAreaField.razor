<div class="space-y-2">
    <div class="flex items-center justify-between gap-3">
        <label class="label">@Label</label>
        <span title="@WhisperTitle">
            <label class="@WhisperLabelClass">
                <input class="h-4 w-4" type="checkbox" checked="@IsWhisper" disabled="@WhisperDisabled" @onchange="OnWhisperChanged" />
                <span>Whisper</span>
            </label>
        </span>
    </div>
    <textarea class="input min-h-24 resize-y" value="@Value" @oninput="OnInput"></textarea>
</div>

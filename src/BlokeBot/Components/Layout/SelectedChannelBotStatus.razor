@using BlokeBot.Auth.Sessions
@using BlokeBot.Features.HostedChannels.Runtime
@using BlokeBot.Hosts
@using BlokeBot.Persistence.Models
@implements IDisposable
@inject EventBus<AppEventKind> _events
@inject HostedChannelRuntimeStatusService _hostedChannels

@if (_selection is not null && _selectedHostStatus is not null)
{
    <div class="@_selectedBotStatusShellClass">
        @if (_selectedHostBotAuthorized)
        {
            <span class="@_selectedBotStatusDotClass"></span>
            <span>@_selectedBotStatusText</span>
        }
        else if (CanAuthorizeSelectedHost())
        {
            <span class="@_selectedBotStatusDotClass"></span>
            <AuthPopupButton Class="font-bold text-[#9146ff] transition hover:text-[#7c3aed] disabled:opacity-70"
                             Url="/oauth/channel-bot/start"
                             PopupName="blokebot-channel-oauth"
                             OpeningText="Opening..."
                             OnClosed="ReloadForEventAsync">
                @(_selectedHostStatus.IsChannelBotAuthorized ? "Reconnect bot" : "Connect bot")
            </AuthPopupButton>
        }
        else
        {
            <span class="@_selectedBotStatusDotClass"></span>
            <span>@_selectedBotStatusText</span>
        }
    </div>
}

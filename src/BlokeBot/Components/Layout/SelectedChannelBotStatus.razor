@using BlokeBot.Auth.Sessions
@using BlokeBot.Features.HostedChannels.Runtime
@using BlokeBot.Hosts
@using BlokeBot.Persistence.Models
@implements IDisposable
@inject EventBus<AppEventKind> Events
@inject HostedChannelRuntimeStatusService HostedChannels

@if (Selection is not null && selectedHostStatus is not null)
{
    <div class="@SelectedBotStatusShellClass">
        @if (SelectedHostBotAuthorized)
        {
            <span class="@SelectedBotStatusDotClass"></span>
            <span>@SelectedBotStatusText</span>
        }
        else if (CanAuthorizeSelectedHost())
        {
            <span class="@SelectedBotStatusDotClass"></span>
            <AuthPopupButton Class="font-bold text-[#9146ff] transition hover:text-[#7c3aed] disabled:opacity-70"
                             Url="/oauth/channel-bot/start"
                             PopupName="blokebot-channel-oauth"
                             OpeningText="Opening..."
                             OnClosed="ReloadForEventAsync">
                Authorize bot
            </AuthPopupButton>
        }
        else
        {
            <span class="@SelectedBotStatusDotClass"></span>
            <span>@SelectedBotStatusText</span>
        }
    </div>
}

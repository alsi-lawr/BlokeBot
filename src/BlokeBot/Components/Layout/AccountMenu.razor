@using BlokeBot.Auth.Sessions
@using BlokeBot.Hosts
@inject NavigationManager Navigation

<details class="group relative mr-2 min-w-0">
    <summary class="control-surface grid h-9 min-w-0 cursor-pointer list-none grid-cols-[1.75rem_minmax(8rem,1fr)_5.75rem_1.25rem] items-center gap-2 rounded-md pl-3 pr-4 marker:hidden">
        @if (AccountImageUrl() is { Length: > 0 } imageUrl)
        {
            <img class="h-7 w-7 rounded-full border border-slate-200 object-cover" src="@imageUrl" alt="" />
        }
        <span class="truncate text-sm font-semibold text-slate-900">@IdentityText()</span>
        <span class="@RoleBadgeClass(Role)">@Role</span>
        <svg class="h-5 w-5 shrink-0 fill-none stroke-current text-slate-500 transition group-open:rotate-180 [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2.25]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </summary>
    <div class="surface absolute right-0 z-50 mt-2 w-52 overflow-hidden rounded-md py-1 shadow-xl shadow-slate-200/70">
        @if (IsAdminEditing)
        {
            <a class="menu-item block w-full px-3 py-2 text-left text-sm font-semibold" href="@ExitImpersonationHref" data-enhance-nav="false">
                Exit impersonation
            </a>
        }
        <a class="menu-item block w-full px-3 py-2 text-left text-sm font-semibold" href="/auth/logout" data-enhance-nav="false">
            Sign out
        </a>
    </div>
</details>

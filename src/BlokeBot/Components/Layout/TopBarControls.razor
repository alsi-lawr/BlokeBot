@using BlokeBot.Auth.Sessions
@using BlokeBot.Hosts
@inject BlokeBotPageContextAccessor PageContext

<AuthorizeView>
    <Authorized Context="authState">
        @{
            var pageContext = PageContext.FromPrincipal(authState.User);
            var session = pageContext.Session;
            var selection = pageContext.HostSelection;
            var showHostSelector = ShowsHostSelector(session);
        }
        <div class="@ControlsGridClass(selection, session.IsAdminEditing, pageContext.IsBotAccount, showHostSelector)">
            @if (!pageContext.IsBotAccount)
            {
                <SelectedChannelBotStatus Session="session" />
            }
            @if (!session.IsAdminEditing && !pageContext.IsBotAccount)
            {
                <HostSelector Session="session" />
            }
            <AccountMenu Session="session" />
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="auth-action inline-flex h-9 w-full items-center justify-center rounded-md px-3 text-sm font-semibold transition sm:w-auto" href="/auth/login">
            Continue with Twitch
        </a>
    </NotAuthorized>
</AuthorizeView>

@rendermode InteractiveServer
@using BlokeBot.Auth.Sessions
@using BlokeBot.Hosts

<AuthorizeView>
    <Authorized Context="authState">
        @{
            var session = AuthenticatedSession.FromPrincipal(authState.User);
            var selection = session.HostSelection;
        }
        <div class="@ControlsGridClass(selection, session.IsAdminEditing, session.IsBotAccount)">
            @if (!session.IsBotAccount)
            {
                <SelectedChannelBotStatus Session="session" />
            }
            @if (!session.IsAdminEditing && !session.IsBotAccount)
            {
                <HostSelector Session="session" />
            }
            <AccountMenu Session="session" />
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="inline-flex h-9 items-center rounded-md bg-[#9146ff] px-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#7c3aed]" href="/auth/login">
            Authenticate with Twitch
        </a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string ControlsGridClass(BotHostSelection? selection, bool isAdminEditing, bool isBotAccount)
    {
        if (isBotAccount || selection is null)
            return "grid items-center gap-3 md:grid-cols-[minmax(18rem,auto)]";

        return isAdminEditing
            ? "grid items-center gap-3 md:grid-cols-[auto_minmax(18rem,auto)]"
            : "grid items-center gap-3 md:grid-cols-[auto_auto_minmax(18rem,auto)]";
    }
}

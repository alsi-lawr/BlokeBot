@using BlokeBot.Auth.Sessions
@using BlokeBot.Hosts
@inject BlokeBotPageContextAccessor _pageContext

<AuthorizeView>
    <Authorized Context="authState">
        @{
            var pageContext = _pageContext.FromPrincipal(authState.User);
            var session = pageContext.Session;
            var selection = session.State.Match<BotHostSelection?>(
                _ => null,
                selected => selected.Selection,
                _ => null
            );
            var showHostSelector = ShowsHostSelector(session);
        }
        <div class="@ControlsGridClass(selection, session.IsAdminEditing, pageContext.IsBotAccount, showHostSelector, _showAlertIndicator)">
            @if (_showAlertIndicator)
            {
                <button class="topbar-alert-button control-surface relative inline-flex h-9 w-9 items-center justify-center rounded-md text-amber-700 transition focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
                        type="button"
                        title="@_alertButtonLabel"
                        aria-label="@_alertButtonLabel"
                        @onclick="OpenAlerts">
                    <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10.3 4.3 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                    </svg>
                    <span class="absolute -right-1 -top-1 inline-flex min-w-4 items-center justify-center rounded-full bg-amber-500 px-1 text-[0.65rem] font-black leading-4 text-white">@_activeAlertCount</span>
                </button>
            }
            @if (!pageContext.IsBotAccount)
            {
                <SelectedChannelBotStatus Session="session" />
            }
            @if (!session.IsAdminEditing && !pageContext.IsBotAccount)
            {
                <HostSelector Session="session" />
            }
            <AccountMenu Session="session" />
        </div>
    </Authorized>
    <NotAuthorized>
        <a class="auth-action inline-flex h-9 w-full items-center justify-center rounded-md px-3 text-sm font-semibold transition sm:w-auto" href="/auth/login">
            Continue with Twitch
        </a>
    </NotAuthorized>
</AuthorizeView>

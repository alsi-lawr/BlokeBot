@inherits LayoutComponentBase
@using BlokeBot.Hosts

<div class="app-shell min-h-screen bg-background text-foreground">
    <div class="app-shell__sidebar fixed inset-y-0 left-0 z-30 hidden w-72 border-r border-slate-200 bg-white/90 backdrop-blur-xl lg:block">
        <NavMenu />
    </div>

    <div class="@_mobileDrawerOverlayClass" aria-hidden="true" @onclick="CloseMobileNavigation"></div>

    <aside class="@_mobileDrawerClass" aria-label="Main navigation" aria-hidden="@(!_mobileNavigationOpen)">
        <button class="mobile-drawer__close"
                type="button"
                aria-label="Close navigation menu"
                @onclick="CloseMobileNavigation">
            <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 6l12 12" />
                <path d="M18 6 6 18" />
            </svg>
        </button>
        <NavMenu OnNavigate="CloseMobileNavigation" />
    </aside>

    <main class="lg:pl-72">
        <header class="app-shell__topbar sticky top-0 z-20 border-b border-slate-200 bg-white/75 backdrop-blur-xl">
            <div class="app-topbar__inner px-4 sm:px-6 lg:px-8">
                <button class="mobile-nav-button lg:hidden"
                        type="button"
                        aria-label="Open navigation menu"
                        aria-expanded="@_mobileNavigationOpen"
                        @onclick="OpenMobileNavigation">
                    <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7h16" />
                        <path d="M4 12h16" />
                        <path d="M4 17h16" />
                    </svg>
                </button>
                <div class="app-topbar__identity min-w-0">
                    <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">Twitch channel tools</p>
                    <p class="truncate text-sm font-semibold text-slate-900">BlokeBot</p>
                </div>
                <div class="app-topbar__controls min-w-0">
                    <TopBarControls />
                </div>
                <div class="app-topbar__utility">
                    <ThemeToggle />
                    <PageHelpButton />
                </div>
            </div>
        </header>

        <article class="px-4 py-6 sm:px-6 lg:px-8">
            @Body
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload the page</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _mobileNavigationOpen;

    private string _mobileDrawerClass =>
        _mobileNavigationOpen
            ? "app-shell__mobile-drawer app-shell__mobile-drawer--open lg:hidden"
            : "app-shell__mobile-drawer lg:hidden";

    private string _mobileDrawerOverlayClass =>
        _mobileNavigationOpen
            ? "app-shell__drawer-overlay app-shell__drawer-overlay--open lg:hidden"
            : "app-shell__drawer-overlay lg:hidden";

    private void CloseMobileNavigation()
    {
        _mobileNavigationOpen = false;
    }

    private void OpenMobileNavigation()
    {
        _mobileNavigationOpen = true;
    }
}

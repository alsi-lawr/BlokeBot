@rendermode InteractiveServer
@using BlokeBot.Auth.Sessions
@using BlokeBot.Features.Admin.HostedChannels
@using BlokeBot.Hosts
@inject EventBus<AppEventKind> Events
@inject HostedChannelDirectoryService HostedChannels
@inject IJSRuntime Js
@inject BlokeBotPageContextAccessor PageContext
@implements IAsyncDisposable

<div class="nav-menu flex h-full flex-col">
    <div class="nav-menu__brand flex items-center gap-3 border-b px-5 py-5">
        <img class="h-11 w-11 rounded-xl border p-1 shadow-soft" src="/blokedroid.svg" alt="" />
        <div>
            <AuthorizeView>
                <Authorized Context="brandAuth">
                    <a class="block text-base font-bold text-slate-950" href="@BrandHref(PageContext.FromPrincipal(brandAuth.User))">BlokeBot</a>
                </Authorized>
                <NotAuthorized>
                    <a class="block text-base font-bold text-slate-950" href="guessing">BlokeBot</a>
                </NotAuthorized>
            </AuthorizeView>
            <p class="text-xs font-medium text-slate-500">Channel tools</p>
        </div>
    </div>

    <nav class="flex flex-1 flex-col gap-3 px-3 py-4">
        <AuthorizeView>
            <Authorized Context="navAuth">
                @{
                    var navContext = PageContext.FromPrincipal(navAuth.User);
                    var session = navContext.Session;
                    var selection = navContext.HostSelection;
                    var showHostConfig = session.CanOpenHostConfig(existingHostIds);
                    var showBotFunctions = session.CanUseBotFunctions(existingHostIds);
                }
                <AuthorizeView Policy="BotAdmin">
                    <Authorized>
                <div class="nav-menu__panel nav-menu__panel--admin rounded-xl p-1.5">
                    <NavLink class="nav-menu__link flex min-h-11 items-center gap-3 rounded-lg border border-transparent px-2.5 text-sm font-bold transition"
                             ActiveClass="nav-menu__item-active nav-menu__item-active--admin"
                             href="admin">
                        <span class="nav-menu__icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-blue-600">
                            <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.5 19 6v5.4c0 4.1-2.8 7.8-7 9.1-4.2-1.3-7-5-7-9.1V6l7-2.5Z" />
                            <path d="m9.5 12 1.7 1.7 3.6-4" />
                        </svg>
                        </span>
                        Admin
                    </NavLink>
                </div>
                    </Authorized>
                </AuthorizeView>

                @if (showHostConfig)
                {
                    <div class="nav-menu__panel rounded-xl p-1.5">
                        <NavLink class="nav-menu__link flex min-h-11 items-center gap-3 rounded-lg border border-transparent px-2.5 text-sm font-bold transition"
                                 ActiveClass="nav-menu__item-active nav-menu__item-active--host"
                                 href="host">
                            <span class="nav-menu__icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-blue-600">
                                <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 10.5 12 4l8 6.5V20H4Z" />
                                    <path d="M9 20v-6h6v6" />
                                </svg>
                            </span>
                            Host config
                        </NavLink>
                    </div>
                }

                @if (showBotFunctions)
                {
        <div class="px-2 text-[0.67rem] font-extrabold uppercase tracking-[0.16em] text-slate-500">Bot functions</div>
        <details class="nav-menu__panel nav-menu__section group rounded-xl p-1.5" data-nav-section="guessing" open="@guessingOpen">
            <summary class="nav-menu__summary flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-lg px-2.5 text-sm font-bold transition marker:hidden" @onclick="ToggleGuessingAsync">
                <span class="nav-menu__icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-blue-600">
                    <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8.5 4h7l4 4v8l-4 4h-7l-4-4V8l4-4Z" />
                        <path d="M9 9h.01" />
                        <path d="M15 9h.01" />
                        <path d="M12 12h.01" />
                        <path d="M9 15h.01" />
                        <path d="M15 15h.01" />
                    </svg>
                </span>
                <span class="min-w-0 flex-1">Guessing game</span>
                <svg class="nav-menu__section-chevron h-4 w-4 shrink-0 fill-none stroke-current text-slate-400 transition group-open:rotate-180 [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </summary>
            <div class="nav-menu__section-body mt-1 grid gap-1 border-t border-slate-100 pt-1">
                <NavLink class="nav-menu__sub-link flex min-h-10 items-center rounded-lg px-11 text-sm font-semibold transition"
                         ActiveClass="nav-menu__item-active"
                         Match="NavLinkMatch.All"
                         href="guessing">
                    Dashboard
                </NavLink>
                <NavLink class="nav-menu__sub-link flex min-h-10 items-center rounded-lg px-11 text-sm font-semibold transition"
                         ActiveClass="nav-menu__item-active"
                         href="guessing/settings">
                    Configuration
                </NavLink>
            </div>
        </details>
        <details class="nav-menu__panel nav-menu__section group rounded-xl p-1.5" data-nav-section="points" open="@pointsOpen">
            <summary class="nav-menu__summary flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-lg px-2.5 text-sm font-bold transition marker:hidden" @onclick="TogglePointsAsync">
                <span class="nav-menu__icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-emerald-600">
                    <svg class="h-4 w-4 fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:1.9]" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3v18" />
                        <path d="M17 7.5c0-1.4-1.6-2.5-5-2.5S7 6.1 7 7.5 8.6 10 12 10s5 1.1 5 2.5-1.6 2.5-5 2.5-5-1.1-5-2.5" />
                    </svg>
                </span>
                <span class="min-w-0 flex-1">Points</span>
                <svg class="nav-menu__section-chevron h-4 w-4 shrink-0 fill-none stroke-current text-slate-400 transition group-open:rotate-180 [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </summary>
            <div class="nav-menu__section-body mt-1 grid gap-1 border-t border-slate-100 pt-1">
                <NavLink class="nav-menu__sub-link flex min-h-10 items-center rounded-lg px-11 text-sm font-semibold transition"
                         ActiveClass="nav-menu__item-active"
                         Match="NavLinkMatch.All"
                         href="points">
                    Dashboard
                </NavLink>
                <NavLink class="nav-menu__sub-link flex min-h-10 items-center rounded-lg px-11 text-sm font-semibold transition"
                         ActiveClass="nav-menu__item-active"
                         href="points/settings">
                    Configuration
                </NavLink>
            </div>
        </details>
                }

                @if (selection is not null)
                {
                    <div class="nav-menu__active-channel mt-auto rounded-xl p-3">
                        <p class="text-sm font-bold text-slate-950">Active channel</p>
                        <p class="mt-1 text-xs leading-5 text-slate-500">Choose a channel from the top bar when you manage more than one.</p>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private const string GuessingOpenStorageKey = "blokebot.sidebar.guessing.open";
    private const string PointsOpenStorageKey = "blokebot.sidebar.points.open";

    private bool guessingOpen = true;
    private bool pointsOpen = true;
    private IDisposable? hostedChannelSubscription;
    private IReadOnlySet<int> existingHostIds = new HashSet<int>();
    private IJSObjectReference? module;

    private static string BrandHref(BlokeBotPageContext context)
    {
        if (context.IsBotAccount)
            return "admin";

        return context.Session.CanCreateHost && context.HostSelection is null
            ? "host"
            : "guessing";
    }

    protected override async Task OnInitializedAsync()
    {
        hostedChannelSubscription = Events.SubscribeForComponentRefresh(
            AppEventKind.HostedChannelsChanged,
            work => InvokeAsync(work),
            LoadHostedChannelIdsAsync,
            StateHasChanged
        );
        await LoadHostedChannelIdsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            module = await Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Layout/NavMenu.razor.js"
            );
            guessingOpen = await module.InvokeAsync<bool>(
                "readBoolean",
                GuessingOpenStorageKey,
                true
            );
            pointsOpen = await module.InvokeAsync<bool>(
                "readBoolean",
                PointsOpenStorageKey,
                true
            );
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        hostedChannelSubscription?.Dispose();

        if (module is null)
            return;

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ToggleGuessingAsync()
    {
        guessingOpen = !guessingOpen;
        if (module is not null)
            await module.InvokeVoidAsync("writeBoolean", GuessingOpenStorageKey, guessingOpen);
    }

    private async Task TogglePointsAsync()
    {
        pointsOpen = !pointsOpen;
        if (module is not null)
            await module.InvokeVoidAsync("writeBoolean", PointsOpenStorageKey, pointsOpen);
    }

    private async Task LoadHostedChannelIdsAsync()
    {
        existingHostIds = await HostedChannels.LoadHostedChannelIdsAsync(CancellationToken.None);
    }
}

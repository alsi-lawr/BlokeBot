<span class="@IndicatorClass" aria-label="@Label" title="@Label">
    <span class="rank-indicator__prefix">#</span>@Rank
</span>

@code {
    [Parameter]
    public int Rank { get; set; }

    private string IndicatorClass =>
        Rank switch
        {
            1 => "rank-indicator rank-indicator--gold",
            2 => "rank-indicator rank-indicator--silver",
            3 => "rank-indicator rank-indicator--bronze",
            _ => "rank-indicator",
        };

    private string Label =>
        Rank switch
        {
            1 => "First place",
            2 => "Second place",
            3 => "Third place",
            _ => $"Rank {Rank}",
        };
}

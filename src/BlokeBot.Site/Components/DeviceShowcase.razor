<figure class="device-showcase">
    <div class="device-showcase__stage">
        <span class="device-showcase__glow" aria-hidden="true"></span>
        <img class="device-showcase__laptop"
             data-theme-media
             data-theme-light-source="media/dashboard-scroll-laptop-light.webp"
             data-theme-dark-source="media/dashboard-scroll-laptop-dark.webp"
             width="1308"
             height="840"
             alt="BlokeBot scrolling through the channel dashboard in a laptop frame." />
        <img class="device-showcase__phone"
             data-theme-media
             data-theme-light-source="media/dashboard-scroll-phone-light.webp"
             data-theme-dark-source="media/dashboard-scroll-phone-dark.webp"
             width="462"
             height="956"
             alt="The same BlokeBot channel dashboard scrolling in its mobile layout." />
        <noscript>
            <img class="device-showcase__fallback"
                 src="media/dashboard-scroll-laptop-light.webp"
                 width="1308"
                 height="840"
                 alt="BlokeBot scrolling through the channel dashboard in a laptop frame." />
        </noscript>
    </div>
    <figcaption>One channel dashboard, shaped for the screen in front of you.</figcaption>
</figure>

@page "/guide"

<PageTitle>BlokeBot help guides</PageTitle>

<div class="guide-layout">
    <GuideSidebar />
    <article class="article-shell article-shell--wide guide-home">
        <header class="article-header article-header--split">
            <div>
                <p class="eyebrow">Help guides</p>
                <h1>Help topics</h1>
            </div>
            <p class="lede">Use the BlokeBot navigation label and dashboard text to select a guide for your current task.</p>
        </header>

        <section class="guide-launch" aria-labelledby="guide-start-heading">
            <div>
                <p class="eyebrow">Set up a new channel</p>
                <h2 id="guide-start-heading">Prepare a bot after Twitch sign-in</h2>
                <ol>
            <li>Select the correct Twitch account.</li>
            <li>Select a channel.</li>
            <li>Complete the actions on Channel setup.</li>
            <li>If Channel setup shows Ready, start the bot.</li>
</ol>
            </div>
            <a class="button button-primary" href="guide/getting-started"><SiteIcon Name="book" />Open the setup guide</a>
        </section>

        <section aria-labelledby="guide-topics-heading">
            <div class="section-intro">
                <p class="eyebrow">Guides by task</p>
                <h2 id="guide-topics-heading">Select the guide for your screen</h2>
            </div>
            <div class="guide-grid guide-grid--numbered">
                @foreach (var topic in SiteGuideCatalog.All.Skip(1).Select((topic, index) => (Topic: topic, Index: index + 1)))
                {
                    <article class="guide-card">
                        <span class="guide-card__number">@topic.Index.ToString("00")</span>
                        <p class="eyebrow">@topic.Topic.Eyebrow</p>
                        <h3><a href="@topic.Topic.Href">@topic.Topic.Title</a></h3>
                        <p>@topic.Topic.Summary</p>
                        <a class="guide-card__arrow" href="@topic.Topic.Href" aria-label="Open guide: @topic.Topic.Title"><SiteIcon Name="arrow" /></a>
                    </article>
                }
            </div>
        </section>

        <section class="help-grid" aria-labelledby="help-heading">
            <div>
                <p class="eyebrow">Resolve a problem</p>
                <h2 id="help-heading">Check the visible state first</h2>
                <ol>
            <li>First, check the selected channel.</li>
            <li>Then check Alerts and Bot status.</li>
            <li>Use the troubleshooting guide to select safe information for the server owner.</li>
</ol>
                <a class="text-link" href="troubleshooting">Open the troubleshooting guide</a>
            </div>
            <div>
                <p class="eyebrow">Server operations</p>
                <h2>Install or host BlokeBot</h2>
                <p>Use the server setup guide for these topics:</p>
<ul>
            <li>Twitch developer credentials.</li>
            <li>Callback URLs.</li>
            <li>HTTPS.</li>
            <li>Process state.</li>
            <li>Backups.</li>
</ul>
                <a class="text-link" href="server-owners">Open the server setup guide</a>
            </div>
        </section>
    </article>
</div>

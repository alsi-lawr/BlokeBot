@page "/"
@inject IOptions<BlokeBotSiteOptions> SiteOptions

<PageTitle>BlokeBot — Twitch channel tools you control</PageTitle>

<section class="hero section-shell" aria-labelledby="home-title">
    <div class="hero-copy">
        <p class="eyebrow">Self-hosted Twitch channel tools</p>
        <h1 id="home-title">Your channel. Your bot. Your rules.</h1>
        <p class="lede">BlokeBot puts commands, guessing games, points, giveaways and moderation-ready controls in one dashboard—without handing your community data to another service.</p>
        <div class="action-row" aria-label="Get started">
            <a class="button button-primary" href="guide/getting-started"><SiteIcon Name="book" />Set up a channel</a>
            <a class="button button-secondary" href="install"><SiteIcon Name="server" />Run your own copy</a>
        </div>
        <ul class="hero-facts" aria-label="BlokeBot at a glance">
            <li>Free and open source</li>
            <li>Desktop and mobile</li>
            <li>State stays on your server</li>
        </ul>
    </div>
    <DeviceShowcase
        LightPhoneSource="media/phone-light-home-scroll.webp"
        DarkPhoneSource="media/phone-dark-home-scroll.webp"
        LightLaptopSource="media/laptop-light-home-scroll.webp"
        DarkLaptopSource="media/laptop-dark-home-scroll.webp"
        PhoneAlt="BlokeBot scrolling the channel dashboard on mobile"
        LaptopAlt="BlokeBot scrolling the channel dashboard on a laptop"
        Caption="One channel dashboard, shaped for the screen in front of you."
        />
</section>

@if (SiteOptions.Value.LiveAppUri is { } liveAppUri)
{
    <section class="docs-callout section-shell" aria-labelledby="live-app-heading">
        <div>
            <p class="eyebrow">BlokeBot live</p>
            <h2 id="live-app-heading">Ready to check it out?</h2>
            <p>Open the live BlokeBot dashboard and see what is available for your channel.</p>
        </div>
        <div class="docs-callout__actions">
            <a class="button button-primary" href="@liveAppUri"><SiteIcon Name="arrow" />Check it out</a>
        </div>
    </section>
}

<section class="role-strip section-shell" aria-labelledby="choose-path-heading">
    <div class="section-intro">
        <p class="eyebrow">Start with your job</p>
        <h2 id="choose-path-heading">The right instructions, without the infrastructure detour</h2>
        <p>Most people using BlokeBot do not need to install anything. Pick the path that matches what you are doing today.</p>
    </div>
    <div class="path-grid">
        <a class="path-card path-card--owner" href="guide/getting-started">
            <span class="path-card__number"><SiteIcon Name="book" />01</span>
            <span>
                <strong>Channel owner</strong>
                <small>Sign in, connect Twitch and choose the tools your channel needs.</small>
            </span>
            <SiteIcon Name="arrow" />
        </a>
        <a class="path-card path-card--moderator" href="moderators">
            <span class="path-card__number"><SiteIcon Name="shield" />02</span>
            <span>
                <strong>Moderator</strong>
                <small>Learn what you can operate and why access can change while you are signed in.</small>
            </span>
            <SiteIcon Name="arrow" />
        </a>
        <a class="path-card path-card--server" href="server-owners">
            <span class="path-card__number"><SiteIcon Name="server" />03</span>
            <span>
                <strong>Server owner</strong>
                <small>Install, configure Twitch OAuth, provide HTTPS and protect state.</small>
            </span>
            <SiteIcon Name="arrow" />
        </a>
    </div>
</section>

<section class="feature-band" aria-labelledby="tools-heading">
    <div class="section-shell">
        <div class="section-intro section-intro--light">
            <p class="eyebrow">One dashboard, practical tools</p>
            <h2 id="tools-heading">Prepare calmly. Run live. Review afterwards.</h2>
        </div>
        <div class="bento-grid">
            <article class="bento-card bento-card--wide">
                <span class="feature-icon"><SiteIcon Name="alert" /></span>
                <h3>Readiness you can act on</h3>
                <p>Connection state, moderator authority, follower-only chat and delivery failures point to a next action instead of leaving the bot silently offline.</p>
                <a href="connect">Connect Twitch correctly</a>
            </article>
            <article class="bento-card">
                <span class="feature-icon"><SiteIcon Name="command" /></span>
                <h3>Commands &amp; messages</h3>
                <p>Reusable replies, aliases, counters, cooldowns, scheduled chat and native Twitch announcements.</p>
                <a href="commands">Build a command</a>
            </article>
            <article class="bento-card">
                <span class="feature-icon"><SiteIcon Name="trophy" /></span>
                <h3>Guessing games</h3>
                <p>Reusable round types, live votes, history and public rankings.</p>
                <a href="guessing">Run a round</a>
            </article>
            <article class="bento-card">
                <span class="feature-icon"><SiteIcon Name="coins" /></span>
                <h3>Points &amp; giveaways</h3>
                <p>Balances, transfers, gambling, prizes and controlled giveaway entry.</p>
                <a href="points">Manage points</a>
            </article>
            <article class="bento-card bento-card--accent">
                <span class="feature-icon"><SiteIcon Name="arrow" /></span>
                <h3>Public leaderboards</h3>
                <p>Share read-only results without giving viewers dashboard access.</p>
                <a href="leaderboards">Share a ranking</a>
            </article>
        </div>
    </div>
</section>

<section class="docs-callout section-shell" aria-labelledby="docs-heading">
    <div>
        <p class="eyebrow">Documentation that follows the product</p>
        <h2 id="docs-heading">From first sign-in to a backed-up production service</h2>
        <p>The user guide explains the screen in front of you. Installation and server setup cover the technical boundary separately, including Twitch callbacks, HTTPS, configuration and durable state.</p>
    </div>
    <div class="docs-callout__actions">
        <a class="button button-primary" href="guide"><SiteIcon Name="book" />Browse the user guide</a>
        <a class="text-link" href="troubleshooting">Something is not working</a>
    </div>
</section>

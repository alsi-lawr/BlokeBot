@page "/"
@inject IOptions<BlokeBotSiteOptions> SiteOptions

<PageTitle>BlokeBot | Twitch channel tools you control</PageTitle>

<section class="hero section-shell" aria-labelledby="home-title">
    <div class="hero-copy">
        <p class="hero-badge">Self-hosted Twitch channel tools</p>
        <h1 id="home-title">Your channel. Your bot. Your rules.</h1>
        <p class="lede">BlokeBot puts community progression, live games, commands, points and moderation-ready controls in one dashboard, without handing your community data to another service.</p>
        <div class="action-row" aria-label="Setup actions">
            <a class="button button-primary" href="guide/getting-started"><SiteIcon Name="book" />Open the channel setup guide</a>
            <a class="button button-secondary" href="install"><SiteIcon Name="server" />Run BlokeBot on your server</a>
            @if (SiteOptions.Value.LiveAppUri is not null)
            {
                <a class="text-link" href="@SiteOptions.Value.LiveAppUri">Open the live BlokeBot dashboard</a>
            }
        </div>
        <ul class="hero-facts" aria-label="BlokeBot facts">
            <li>Free and open source</li>
            <li>Desktop and mobile</li>
            <li>State stays on your server</li>
        </ul>
        <DeviceShowcase
            LightPhoneSource="media/dashboard/phone-light-channel-setup-scroll.webp"
            DarkPhoneSource="media/dashboard/phone-dark-channel-setup-scroll.webp"
            LightLaptopSource="media/dashboard/laptop-light-home-scroll.webp"
            DarkLaptopSource="media/dashboard/laptop-dark-home-scroll.webp"
            PhoneAlt="A phone shows the BlokeBot Channel setup page at a scrolled position"
            LaptopAlt="A laptop shows the BlokeBot channel dashboard at a scrolled position"
            Caption="One channel dashboard, shaped for the screen in front of you."
            />
    </div>
</section>

<section class="role-strip section-shell" aria-labelledby="choose-path-heading">
    <div class="section-intro">
        <p class="eyebrow">Choose your role</p>
        <h2 id="choose-path-heading">Use the instructions for your role</h2>
        <p>Most BlokeBot users do not install the application. Each path gives instructions for one role.</p>
    </div>
    <div class="path-grid">
        <a class="path-card path-card--owner" href="guide/getting-started">
            <span class="path-card__head">
                <span class="path-card__chip"><SiteIcon Name="book" /></span>
                <span class="path-card__number">01</span>
            </span>
            <span>
                <strong>Channel owner</strong>
                <small>If you manage the channel and its tools, use this path.</small>
            </span>
            <ul class="check-list path-card__list">
                <li>Complete the connections for chat and the Twitch integration</li>
                <li>Activate only the required tools</li>
                <li>Give moderators access to the dashboard</li>
            </ul>
            <span class="path-card__cta">Open the channel owner guide <SiteIcon Name="arrow" /></span>
        </a>
        <a class="path-card path-card--moderator" href="moderators">
            <span class="path-card__head">
                <span class="path-card__chip"><SiteIcon Name="shield" /></span>
                <span class="path-card__number">02</span>
            </span>
            <span>
                <strong>Moderator</strong>
                <small>If you operate tools for a channel owner, use this path.</small>
            </span>
            <ul class="check-list path-card__list">
                <li>Review your current tool access</li>
                <li>Learn why your access can change</li>
                <li>Respond to readiness warnings during a stream</li>
            </ul>
            <span class="path-card__cta">Open the moderator guide <SiteIcon Name="arrow" /></span>
        </a>
        <a class="path-card path-card--server" href="server-owners">
            <span class="path-card__head">
                <span class="path-card__chip"><SiteIcon Name="server" /></span>
                <span class="path-card__number">03</span>
            </span>
            <span>
                <strong>Server owner</strong>
                <small>If you install and maintain BlokeBot, use this path.</small>
            </span>
            <ul class="check-list path-card__list">
                <li>Install BlokeBot with Docker or a package</li>
                <li>Configure HTTPS and Twitch OAuth</li>
                <li>Create backups of durable state on your schedule</li>
            </ul>
            <span class="path-card__cta">Open the server owner guide <SiteIcon Name="arrow" /></span>
        </a>
    </div>
</section>

<section class="feature-band" aria-labelledby="tools-heading">
    <div class="section-shell">
        <div class="section-intro section-intro--light">
            <p class="eyebrow">One dashboard, practical tools</p>
            <h2 id="tools-heading">Prepare calmly. Run live. Review afterwards.</h2>
            <p>Every tool lives in the same dashboard and follows the same readiness rules, so nothing fails silently mid-stream.</p>
        </div>
        <div class="feature-spotlight">
            <div>
                <span class="feature-icon"><SiteIcon Name="alert" /></span>
                <h3>Use readiness information</h3>
                <p>The readiness panel shows problems that stop the bot. Each problem includes a next action.</p>
                <a href="connect">Open the Twitch connection guide</a>
            </div>
            <div class="status-demo" role="img" aria-label="Example channel readiness panel">
                <p class="status-demo__title">Channel readiness</p>
                <ul>
                    <li>Chat connected <span>Ready</span></li>
                    <li>Bot has moderator authority <span>Ready</span></li>
                    <li class="is-warn">Follower-only chat is on <span>Review</span></li>
                </ul>
            </div>
        </div>
        <div class="tool-grid">
            <article class="tool-card">
                <span class="feature-icon"><SiteIcon Name="command" /></span>
                <h3>Commands and messages</h3>
                <p>Commands provide reusable replies and aliases. They can use counters and cooldowns. BlokeBot can schedule chat messages and send native Twitch announcements.</p>
                <a href="commands">Create a command</a>
            </article>
            <article class="tool-card">
                <span class="feature-icon"><SiteIcon Name="trophy" /></span>
                <h3>Prediction games</h3>
                <p>Create reusable round types. View live votes and round history. Share public rankings.</p>
                <a href="guessing">Start a round</a>
            </article>
            <article class="tool-card">
                <span class="feature-icon"><SiteIcon Name="coins" /></span>
                <h3>Points and giveaways</h3>
                <p>Manage balances and transfers. Configure games of chance and prizes. Control entry to giveaways.</p>
                <a href="points">Open the points guide</a>
            </article>
            <article class="tool-card">
                <span class="feature-icon"><SiteIcon Name="trophy" /></span>
                <h3>Community progression</h3>
                <p>Use bounties and passports. Run tournaments and BlokeRaid. Coordinate Collectives and seasons. Track achievements and Stream-event Bingo.</p>
                <a href="community/progression">Configure community progress</a>
            </article>
            <article class="tool-card tool-card--accent">
                <span class="feature-icon"><SiteIcon Name="arrow" /></span>
                <h3>Public leaderboards</h3>
                <p>Public leaderboards show read-only results. Viewers do not get access to the dashboard.</p>
                <a href="leaderboards">Open the leaderboard guide</a>
            </article>
        </div>
    </div>
</section>

<section class="directory section-shell" aria-labelledby="docs-heading">
    <div class="section-intro">
        <p class="eyebrow">Help for each product page</p>
        <h2 id="docs-heading">Find help for the current page</h2>
        <p>The user guide follows the dashboard structure. Each guide explains one feature.</p>
    </div>
    <div class="directory-grid">
        @foreach (var group in SiteGuideCatalog.NavigationGroups)
        {
            <div>
                <p>@group.Label</p>
                <ul>
                    @foreach (var link in group.Links)
                    {
                        <li><a href="@link.Href">@link.Label</a></li>
                    }
                </ul>
            </div>
        }
    </div>
    <div class="directory-actions action-row">
        <a class="button button-primary" href="guide"><SiteIcon Name="book" />Open the user guide</a>
        <a class="text-link" href="troubleshooting">Open the troubleshooting guide</a>
    </div>
</section>

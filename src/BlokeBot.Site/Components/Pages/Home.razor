@page "/"

<PageTitle>BlokeBot — Own your channel tools</PageTitle>

<section class="hero section-shell" aria-labelledby="home-title">
    <div class="hero-copy">
        <p class="eyebrow">Twitch channel tools</p>
        <h1 id="home-title">Own your channel tools.</h1>
        <p class="lede">Run commands, guessing games, points and giveaways from one dashboard built around your Twitch channel.</p>
        <p class="availability">BlokeBot is free, open-source, easy to host, and available now.</p>
        <div class="action-row" aria-label="Get started">
            <a class="button button-primary" href="/how-it-works">See how it works</a>
            <a class="button button-secondary" href="/guide">Read the user guide</a>
        </div>
    </div>
    <MediaFigure
        Source="/media/blokebot-banner.svg"
        Alt="BlokeBot banner with illustrated chat and dashboard panels."
        Caption="One place for the channel tools you run with your community." />
</section>

<section class="section-shell split-section" aria-labelledby="dashboard-heading">
    <div>
        <p class="eyebrow">Built around your channel</p>
        <h2 id="dashboard-heading">See what is ready before you go live</h2>
        <p>The selected channel, connection status and enabled tools stay visible together, so owners and moderators can act on the right channel.</p>
        <p><a class="text-link" href="/dashboard">Explore the dashboard</a></p>
    </div>
    <MediaFigure
        Source="/media/dashboard-home.png"
        Alt="BlokeBot dashboard showing Sample Channel, channel setup and enabled chat tools."
        Caption="The dashboard keeps channel readiness and everyday tools close together." />
</section>

<section class="section-shell" aria-labelledby="tools-heading">
    <p class="eyebrow">Choose what fits</p>
    <h2 id="tools-heading">Practical tools for live communities</h2>
    <div class="card-grid">
        <article class="feature-card">
            <h3><a href="/commands">Commands</a></h3>
            <p>Save reusable replies, counters and announcements for your chat.</p>
        </article>
        <article class="feature-card">
            <h3><a href="/guessing">Guessing games</a></h3>
            <p>Prepare round types, collect guesses and record winners from one live view.</p>
        </article>
        <article class="feature-card">
            <h3><a href="/points">Points</a></h3>
            <p>Give viewers a channel balance with transfers, gambling and prizes.</p>
        </article>
        <article class="feature-card">
            <h3><a href="/giveaways">Giveaways</a></h3>
            <p>Run timed points giveaways with clear eligibility and winner controls.</p>
        </article>
    </div>
</section>

@page "/guide/getting-started"
@page "/dashboard"
@page "/channels"
@page "/connect"
@page "/tools"
@page "/commands"
@page "/guessing"
@page "/points"
@page "/giveaways"
@page "/leaderboards"
@page "/troubleshooting"
@page "/moderators"
@page "/server-owners"
@inject NavigationManager Navigation

<PageTitle>@_page.Title — BlokeBot guide</PageTitle>

<article class="article-shell guide-article">
    <header class="article-header">
        <p class="eyebrow">@_page.Eyebrow</p>
        <h1>@_page.Title</h1>
        <p class="lede">@_page.Summary</p>
    </header>

    @if (_page.Media is { } media)
    {
        <MediaFigure Source="@media.Source" Alt="@media.Alt" Caption="@media.Caption" />
    }

    @foreach (var section in _page.Sections)
    {
        <section>
            <h2>@section.Heading</h2>

            @foreach (var paragraph in section.Paragraphs)
            {
                <p>@paragraph</p>
            }

            @if (section.Steps.Count > 0)
            {
                <ol>
                    @foreach (var step in section.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
            }

            @if (section.Bullets.Count > 0)
            {
                <ul>
                    @foreach (var bullet in section.Bullets)
                    {
                        <li>@bullet</li>
                    }
                </ul>
            }

            @if (section.Links.Count > 0)
            {
                <ul class="link-list">
                    @foreach (var link in section.Links)
                    {
                        <li><a class="text-link" href="@link.Href">@link.Label</a></li>
                    }
                </ul>
            }
        </section>
    }

    @if (_page.Next.Count > 0)
    {
        <nav class="next-panel" aria-label="Continue through the guide">
            <h2>Continue</h2>
            <ul class="link-list">
                @foreach (var link in _page.Next)
                {
                    <li><a class="text-link" href="@link.Href">@link.Label</a></li>
                }
            </ul>
        </nav>
    }
</article>

@code {
    private SiteGuidePage _page = SiteGuideCatalog.Get("/guide/getting-started");

    protected override void OnParametersSet()
    {
        _page = SiteGuideCatalog.Get(new Uri(Navigation.Uri).AbsolutePath);
    }
}

@inject NavigationManager Navigation

<PageTitle>@_page.Title | BlokeBot guide</PageTitle>

<div class="guide-layout">
    <GuideSidebar />
    <article class="article-shell guide-article">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="guide">Help guides</a>
            <span aria-hidden="true">/</span>
            <span>@_page.Eyebrow</span>
        </nav>
        <header class="article-header">
            <p class="eyebrow">@_page.Eyebrow</p>
            <h1>@_page.Title</h1>
            <p class="lede">@_page.Summary</p>
            @if (_page.Sections.Count > 1)
            {
                <nav class="anchor-chips" aria-label="On this page">
                    @foreach (var section in _page.Sections)
                    {
                        <a href="@($"{new Uri(Navigation.Uri).AbsolutePath}#{section.Anchor}")">@section.Heading</a>
                    }
                </nav>
            }
        </header>

        @if (_page.Media is not null)
        {
            <div style="display: contents">
                <DeviceShowcase
                    DarkPhoneSource="@_page.Media.DarkPhoneSource"
                    LightPhoneSource="@_page.Media.LightPhoneSource"
                    PhoneAlt="@_page.Media.PhoneAlt"
                    DarkLaptopSource="@_page.Media.DarkLaptopSource"
                    LightLaptopSource="@_page.Media.LightLaptopSource"
                    LaptopAlt="@_page.Media.LaptopAlt"
                    Caption="@_page.Media.Caption" />
            </div>
        }

        @foreach (var section in _page.Sections)
        {
            <section id="@section.Anchor">
                @if (section.Media is not null)
                {
                    <div style="display: contents">
                        <DeviceShowcase
                            DarkPhoneSource="@section.Media.DarkPhoneSource"
                            LightPhoneSource="@section.Media.LightPhoneSource"
                            PhoneAlt="@section.Media.PhoneAlt"
                            DarkLaptopSource="@section.Media.DarkLaptopSource"
                            LightLaptopSource="@section.Media.LightLaptopSource"
                            LaptopAlt="@section.Media.LaptopAlt"
                            Caption="@section.Media.Caption" />
                    </div>
                }

                <h2>@section.Heading</h2>

                @if (section.MediaAfterHeading is not null)
                {
                    <div style="display: contents">
                        <DeviceShowcase
                            DarkPhoneSource="@section.MediaAfterHeading.DarkPhoneSource"
                            LightPhoneSource="@section.MediaAfterHeading.LightPhoneSource"
                            PhoneAlt="@section.MediaAfterHeading.PhoneAlt"
                            DarkLaptopSource="@section.MediaAfterHeading.DarkLaptopSource"
                            LightLaptopSource="@section.MediaAfterHeading.LightLaptopSource"
                            LaptopAlt="@section.MediaAfterHeading.LaptopAlt"
                            Caption="@section.MediaAfterHeading.Caption" />
                    </div>
                }

                @foreach (var paragraph in section.Paragraphs)
                {
                    <p>@paragraph</p>
                }

                @if (section.Steps.Count > 0)
                {
                    <ol>
                        @foreach (var step in section.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                }

                @if (section.Bullets.Count > 0)
                {
                    <ul>
                        @foreach (var bullet in section.Bullets)
                        {
                            <li>@bullet</li>
                        }
                    </ul>
                }

                @if (section.Facts.Count > 0)
                {
                    <dl class="guide-facts">
                        @foreach (var fact in section.Facts)
                        {
                            <div>
                                <dt>@fact.Term</dt>
                                <dd>@fact.Description</dd>
                            </div>
                        }
                    </dl>
                }

                @if (section.Links.Count > 0)
                {
                    <ul class="link-list">
                        @foreach (var link in section.Links)
                        {
                            <li><a class="text-link" href="@link.Href">@link.Label</a></li>
                        }
                    </ul>
                }

                @if (section.Code is not null)
                {
                    <pre class="code-block"><code>@section.Code</code></pre>
                }

                @if (section.Note is not null)
                {
                    <aside class="doc-note"><p>@section.Note</p></aside>
                }

                @if (section.MediaAfterContent is not null)
                {
                    <div style="display: contents">
                        <DeviceShowcase
                            DarkPhoneSource="@section.MediaAfterContent.DarkPhoneSource"
                            LightPhoneSource="@section.MediaAfterContent.LightPhoneSource"
                            PhoneAlt="@section.MediaAfterContent.PhoneAlt"
                            DarkLaptopSource="@section.MediaAfterContent.DarkLaptopSource"
                            LightLaptopSource="@section.MediaAfterContent.LightLaptopSource"
                            LaptopAlt="@section.MediaAfterContent.LaptopAlt"
                            Caption="@section.MediaAfterContent.Caption" />
                    </div>
                }
            </section>
        }

        @if (_page.Next.Count > 0)
        {
            <nav class="next-panel" aria-label="More help guides">
                <h2>Next guides</h2>
                <ul class="next-links">
                    @foreach (var link in _page.Next)
                    {
                        <li><a href="@link.Href">@link.Label</a></li>
                    }
                </ul>
            </nav>
        }
    </article>
</div>

<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(SiteLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(SiteLayout)">
            <article class="article-shell">
                <p class="eyebrow">Page not found</p>
                <h1>The page is not available.</h1>
                <p>Open the help guides to find the BlokeBot task that you need.</p>
                <p><a class="text-link" href="guide">Open the help guides</a></p>
            </article>
        </LayoutView>
    </NotFound>
</Router>

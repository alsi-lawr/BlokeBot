<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(SiteLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(SiteLayout)">
            <article class="article-shell">
                <p class="eyebrow">Page not found</p>
                <h1>That page is not here.</h1>
                <p>Use the guide to find the BlokeBot task you need.</p>
                <p><a class="text-link" href="/guide">Open the user guide</a></p>
            </article>
        </LayoutView>
    </NotFound>
</Router>

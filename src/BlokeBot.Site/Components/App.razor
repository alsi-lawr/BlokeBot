@inject NavigationManager Navigation
@{
    var baseHref = new Uri(Navigation.BaseUri).AbsolutePath;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="BlokeBot brings Twitch commands, guessing games, points and giveaways into one channel dashboard." />
    <base href="@baseHref" />
    <script>
        (() => {
            const storedTheme = () => {
                try {
                    return window.localStorage.getItem("blokebot.theme");
                } catch {
                    return null;
                }
            };
            const savedTheme = storedTheme();
            const theme = savedTheme === "dark" || savedTheme === "light"
                ? savedTheme
                : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;
        })();
    </script>
    <link rel="stylesheet" href="site.css" />
    <link rel="icon" type="image/svg+xml" href="blokebot-mark.svg" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script>
        (() => {
            const button = document.querySelector("[data-theme-toggle]");
            if (!button)
                return;

            const applyTheme = theme => {
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
                button.setAttribute("aria-pressed", String(theme === "dark"));
                button.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
                button.setAttribute("title", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");

                for (const media of document.querySelectorAll("[data-theme-media]")) {
                    const source = theme === "dark"
                        ? media.dataset.themeDarkSource
                        : media.dataset.themeLightSource;
                    if (source && media.getAttribute("src") !== source)
                        media.setAttribute("src", source);
                }
            };

            applyTheme(document.documentElement.dataset.theme);
            button.addEventListener("click", () => {
                const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
                try {
                    window.localStorage.setItem("blokebot.theme", theme);
                } catch {
                }
                applyTheme(theme);
            });
        })();
    </script>
</body>
</html>

@inject NavigationManager _navigation

<aside class="guide-sidebar">
    <nav aria-label="Help guides by feature">
        <p class="guide-sidebar__title">Help guides by feature</p>
        <details class="guide-sidebar__disclosure" open>
            <summary>
                <span>Browse the help guides</span>
                <span class="guide-sidebar__current">Current topic: <strong>@_currentTopicLabel</strong></span>
            </summary>
            <div class="guide-sidebar__links">
                <NavLink class="guide-sidebar__index" href="guide" Match="NavLinkMatch.All">
                    All help topics
                </NavLink>
                @foreach (var group in SiteGuideCatalog.NavigationGroups)
                {
                    <details class="guide-sidebar__group" open="@IsCurrentGroup(group)">
                        <summary>@group.Label</summary>
                        <ul>
                            @foreach (var link in group.Links)
                            {
                                <li>
                                    @if (link.Href.Contains('#'))
                                    {
                                        <a href="@link.Href">@link.Label</a>
                                    }
                                    else
                                    {
                                        <NavLink href="@link.Href" Match="NavLinkMatch.All">@link.Label</NavLink>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </details>
    </nav>
</aside>

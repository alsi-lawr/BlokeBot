<aside class="guide-sidebar">
    <nav aria-label="Guide features">
        <p class="guide-sidebar__title">Help by feature</p>
        <div class="guide-sidebar__links">
            <NavLink class="guide-sidebar__index" href="guide" Match="NavLinkMatch.All">
                All help topics
            </NavLink>
            @foreach (var group in SiteGuideCatalog.NavigationGroups)
            {
                <div class="guide-sidebar__group">
                    <p>@group.Label</p>
                    <ul>
                        @foreach (var link in group.Links)
                        {
                            <li>
                                <NavLink href="@link.Href" Match="NavLinkMatch.All">@link.Label</NavLink>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </nav>
</aside>
